<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

  <!-- Pia avatar — 28x28 rounded square containing the Pia mark, styled like an
       iOS app icon (~22% corner radius). The mark is drawn in the theme accent,
       so it stays legible on the light and the dark canvas.
       Targets ContentControl because Border has no Template DP. -->
  <Style x:Key="PiaAvatarStyle" TargetType="ContentControl">
    <Setter Property="Width"     Value="28"/>
    <Setter Property="Height"    Value="28"/>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ContentControl">
          <Border CornerRadius="6"
                  Background="{DynamicResource BgCanvasBrush}">
            <Border.Effect>
              <DropShadowEffect Color="#0F1729" Opacity="0.18"
                                BlurRadius="6" ShadowDepth="1"/>
            </Border.Effect>
            <!-- DynamicResource, not Static: this is the only cross-dictionary
                 lookup inside a ControlTemplate, and a StaticResource there
                 would depend on PiaLogo.xaml being merged first. -->
            <Path Data="{DynamicResource PiaMarkGeometry}"
                  Fill="{DynamicResource PiaAccentBrush}"
                  Stretch="Uniform"
                  Margin="5"/>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Chat bubbles -->

  <!-- Assistant bubble: no background, typography only. -->
  <Style x:Key="AssistantBubbleStyle" TargetType="Border">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Padding"    Value="0"/>
    <Setter Property="MaxWidth"   Value="820"/>
    <Setter Property="HorizontalAlignment" Value="Left"/>
  </Style>

  <!-- User bubble: solid accent, asymmetric corner radius. -->
  <Style x:Key="UserBubbleStyle" TargetType="Border">
    <Setter Property="Background"   Value="{DynamicResource PiaAccentBrush}"/>
    <Setter Property="CornerRadius" Value="14,14,4,14"/>
    <Setter Property="Padding"      Value="14,10"/>
    <Setter Property="MaxWidth"     Value="520"/>
    <Setter Property="HorizontalAlignment" Value="Right"/>
    <Setter Property="Effect">
      <Setter.Value>
        <DropShadowEffect Color="#1E2A4A" Opacity="0.10"
                          BlurRadius="8" ShadowDepth="1"/>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="UserBubbleTextStyle" TargetType="TextBlock">
    <Setter Property="Foreground"   Value="White"/>
    <Setter Property="FontSize"     Value="14"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
    <Setter Property="LineHeight"   Value="21"/>
  </Style>

  <!-- Generic elevated card. Used by ActionCard and inline panels. -->
  <Style x:Key="PiaCardStyle" TargetType="Border">
    <Setter Property="Background"      Value="{DynamicResource SurfaceBrush}"/>
    <Setter Property="BorderBrush"     Value="{DynamicResource BorderBrush_}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius"    Value="{StaticResource LargeRadius}"/>
    <Setter Property="Effect">
      <Setter.Value>
        <DropShadowEffect Color="#0F1729" Opacity="0.08"
                          BlurRadius="16" ShadowDepth="3"/>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Header stripe used at the top of cards. Rounds top corners, divides body. -->
  <Style x:Key="PiaCardHeaderStripeStyle" TargetType="Border">
    <Setter Property="Background"      Value="{DynamicResource SurfaceMutedBrush}"/>
    <Setter Property="BorderBrush"     Value="{DynamicResource BorderBrush_}"/>
    <Setter Property="BorderThickness" Value="0,0,0,1"/>
    <Setter Property="Padding"         Value="14,10"/>
    <Setter Property="CornerRadius"    Value="12,12,0,0"/>
  </Style>

  <!-- Round 22-square chip behind a header icon. -->
  <Style x:Key="PiaIconChipStyle" TargetType="Border">
    <Setter Property="Width"        Value="22"/>
    <Setter Property="Height"       Value="22"/>
    <Setter Property="CornerRadius" Value="{StaticResource SmallRadius}"/>
    <Setter Property="Background"   Value="{DynamicResource PiaAccentSoftBrush}"/>
  </Style>

  <!-- Small static label chip (a word or two, no interaction) — the geometry of
       Controls/Vault/PiaTypeChip.xaml, lifted so other surfaces can share the look.
       Background is deliberately NOT set: callers pick the tint that carries their meaning.
       PiaTypeChip itself is intentionally NOT refactored onto this style yet — it is hardwired to
       MemoryType through three converters, and rewiring it is how a contained addition becomes a
       memory-view regression. Deferred to its own change. -->
  <Style x:Key="PiaLabelChipStyle" TargetType="Border">
    <Setter Property="CornerRadius"      Value="4"/>
    <Setter Property="Padding"           Value="7,1"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>

  <!-- Composer / input bar card. -->
  <Style x:Key="PiaComposerCardStyle" TargetType="Border">
    <Setter Property="Background"      Value="{DynamicResource SurfaceBrush}"/>
    <Setter Property="BorderBrush"     Value="{DynamicResource BorderBrush_}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius"    Value="{StaticResource BubbleRadius}"/>
    <Setter Property="Effect">
      <Setter.Value>
        <DropShadowEffect Color="#0F1729" Opacity="0.08"
                          BlurRadius="18" ShadowDepth="3"/>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Chrome-less button (e.g. clickable category header). -->
  <Style x:Key="UnstyledButton" TargetType="Button">
    <Setter Property="Background"      Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding"         Value="0"/>
    <Setter Property="Cursor"          Value="Hand"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd"
                  Background="{TemplateBinding Background}"
                  Padding="{TemplateBinding Padding}"
                  CornerRadius="9">
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background"
                      Value="{DynamicResource SurfaceMutedBrush}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Dashed "+ tag" affordance. -->
  <Style x:Key="PiaDashedGhostButton" TargetType="Button">
    <Setter Property="Background"  Value="Transparent"/>
    <Setter Property="Foreground"  Value="{DynamicResource TextMutedBrush}"/>
    <Setter Property="Padding"     Value="8,3"/>
    <Setter Property="FontSize"    Value="11.5"/>
    <Setter Property="Cursor"      Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd"
                  CornerRadius="4"
                  Padding="{TemplateBinding Padding}"
                  Background="{TemplateBinding Background}"
                  BorderThickness="1"
                  BorderBrush="{DynamicResource BorderStrongBrush}"
                  SnapsToDevicePixels="True">
            <Border.OpacityMask>
              <VisualBrush>
                <VisualBrush.Visual>
                  <Border CornerRadius="4"
                          Background="Black"
                          Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Border}}"
                          Height="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Border}}"/>
                </VisualBrush.Visual>
              </VisualBrush>
            </Border.OpacityMask>
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                              TextBlock.FontSize="{TemplateBinding FontSize}"
                              TextBlock.Foreground="{TemplateBinding Foreground}"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="BorderBrush"
                      Value="{DynamicResource PiaAccentBrush}"/>
              <Setter Property="Foreground"
                      Value="{DynamicResource PiaAccentBrush}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Segmented selector pill (filter strip, JSON/Raw). Selected state uses
       solid accent fill so it reads clearly against the muted track. -->
  <Style x:Key="PiaSegmentedButton" TargetType="RadioButton">
    <Setter Property="Foreground"  Value="{DynamicResource TextMutedBrush}"/>
    <Setter Property="FontSize"    Value="12"/>
    <Setter Property="Padding"     Value="12,5"/>
    <Setter Property="Cursor"      Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Border x:Name="Bd"
                  CornerRadius="6"
                  Padding="{TemplateBinding Padding}"
                  Background="Transparent"
                  BorderBrush="Transparent"
                  BorderThickness="1">
            <ContentPresenter HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              TextBlock.Foreground="{TemplateBinding Foreground}"
                              TextBlock.FontSize="{TemplateBinding FontSize}"
                              TextBlock.FontWeight="Medium"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background"
                      Value="{DynamicResource SurfaceMutedBrush}"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Bd" Property="Background"
                      Value="{DynamicResource PiaAccentBrush}"/>
              <Setter TargetName="Bd" Property="BorderBrush"
                      Value="{DynamicResource PiaAccentBrush}"/>
              <Setter Property="Foreground" Value="White"/>
              <Setter TargetName="Bd" Property="Effect">
                <Setter.Value>
                  <DropShadowEffect Color="#1E2A4A" Opacity="0.18"
                                    BlurRadius="6" ShadowDepth="1"/>
                </Setter.Value>
              </Setter>
            </Trigger>
            <!-- Disabled (e.g. Chat/Agent lever on a no-tools persona): reads as unavailable. -->
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
              <Setter Property="Cursor" Value="Arrow"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Persona pickers — a combobox-like trigger that opens an emoji/colour popup.
       Stays a plain bordered field (no accent fill) so it reads as an input, not a button;
       border highlights on hover and turns accent while its popup is open. -->
  <Style x:Key="PiaPickerToggleStyle" TargetType="ToggleButton">
    <Setter Property="Cursor"                      Value="Hand"/>
    <Setter Property="Foreground"                  Value="{DynamicResource TextDefaultBrush}"/>
    <Setter Property="HorizontalContentAlignment"  Value="Left"/>
    <Setter Property="VerticalContentAlignment"    Value="Center"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border x:Name="Bd"
                  Background="{DynamicResource SurfaceMutedBrush}"
                  BorderBrush="{DynamicResource BorderBrush_}"
                  BorderThickness="1"
                  CornerRadius="6"
                  Padding="8,6"
                  MinHeight="34">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <ContentPresenter Grid.Column="0"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="Center"/>
              <ui:SymbolIcon x:Name="Chevron"
                             Grid.Column="1"
                             Symbol="ChevronDown24"
                             FontSize="14"
                             Margin="6,0,0,0"
                             RenderTransformOrigin="0.5,0.5"
                             Foreground="{DynamicResource TextMutedBrush}"/>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource PiaAccentBrush}"/>
              <Setter TargetName="Chevron" Property="RenderTransform">
                <Setter.Value>
                  <RotateTransform Angle="180"/>
                </Setter.Value>
              </Setter>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.5"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Colour swatch button. Keeps its fill at all times (the swatch colour comes in via
       Background); hover and the current selection are shown with a ring around the fill — so it
       never washes out to the default button mouse-over fill. Selection: bind Tag to a bool. -->
  <Style x:Key="PiaColorSwatchButtonStyle" TargetType="Button">
    <Setter Property="Width"  Value="28"/>
    <Setter Property="Height" Value="28"/>
    <Setter Property="Margin" Value="3"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid>
            <Ellipse x:Name="Ring"
                     Stroke="{DynamicResource PiaAccentBrush}"
                     StrokeThickness="2"
                     Visibility="Collapsed"/>
            <Ellipse x:Name="Fill"
                     Margin="3"
                     Fill="{TemplateBinding Background}"
                     Stroke="{DynamicResource BorderBrush_}"
                     StrokeThickness="1"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Ring" Property="Visibility" Value="Visible"/>
              <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource BorderStrongBrush}"/>
            </Trigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
              <Setter TargetName="Ring" Property="Visibility" Value="Visible"/>
              <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource PiaAccentBrush}"/>
            </DataTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Emoji swatch button. Transparent tile; hover lifts a muted fill, the current selection
       draws an accent border + soft fill. Bind Tag to a bool for selection. -->
  <Style x:Key="PiaEmojiSwatchButtonStyle" TargetType="Button">
    <Setter Property="Width"    Value="34"/>
    <Setter Property="Height"   Value="34"/>
    <Setter Property="Margin"   Value="2"/>
    <Setter Property="FontSize" Value="17"/>
    <Setter Property="Cursor"   Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd"
                  Background="Transparent"
                  BorderBrush="{DynamicResource BorderBrush_}"
                  BorderThickness="1"
                  CornerRadius="6">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background"  Value="{DynamicResource SurfaceMutedBrush}"/>
              <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}"/>
            </Trigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
              <Setter TargetName="Bd" Property="Background"  Value="{DynamicResource PiaAccentSoftBrush}"/>
              <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource PiaAccentBrush}"/>
            </DataTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Settings — section label above a field row. -->
  <Style x:Key="PiaSettingsSectionLabelStyle" TargetType="TextBlock">
    <Setter Property="FontSize"   Value="13"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{DynamicResource TextDefaultBrush}"/>
    <Setter Property="Margin"     Value="0,0,0,6"/>
  </Style>

  <!-- Settings — small muted explanation under a field. -->
  <Style x:Key="PiaSettingsDescriptionStyle" TargetType="TextBlock">
    <Setter Property="FontSize"     Value="12"/>
    <Setter Property="Foreground"   Value="{DynamicResource TextMutedBrush}"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
    <Setter Property="Margin"       Value="0,6,0,0"/>
  </Style>

  <!-- Large page title, shared by every top-level view header. -->
  <Style x:Key="PiaPageTitleStyle" TargetType="TextBlock">
    <Setter Property="FontSize"          Value="22"/>
    <Setter Property="FontWeight"        Value="SemiBold"/>
    <Setter Property="Foreground"        Value="{DynamicResource TextDefaultBrush}"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>

  <!-- Sentence under a page title. MaxWidth stays with the caller — it depends on the header layout. -->
  <Style x:Key="PiaPageSubtitleStyle" TargetType="TextBlock">
    <Setter Property="FontSize"            Value="12"/>
    <Setter Property="TextWrapping"        Value="Wrap"/>
    <Setter Property="HorizontalAlignment" Value="Left"/>
    <Setter Property="Foreground"          Value="{DynamicResource TextMutedBrush}"/>
    <Setter Property="Margin"              Value="0,8,0,0"/>
  </Style>

  <!-- Counts line under a page title. -->
  <Style x:Key="PiaPageStatsStyle" TargetType="TextBlock">
    <Setter Property="FontSize"   Value="12"/>
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
    <Setter Property="Margin"     Value="0,8,0,0"/>
  </Style>

  <!-- Row metadata — the small muted facts under a list row's title. -->
  <Style x:Key="PiaMetaTextStyle" TargetType="TextBlock">
    <Setter Property="FontSize"          Value="11"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Foreground"        Value="{DynamicResource TextMutedBrush}"/>
  </Style>

  <Style x:Key="PiaMetaSeparatorStyle" TargetType="TextBlock" BasedOn="{StaticResource PiaMetaTextStyle}">
    <Setter Property="Text"       Value="&#183;"/>
    <Setter Property="Margin"     Value="6,0"/>
    <Setter Property="Foreground" Value="{DynamicResource TextGhostBrush}"/>
  </Style>

  <!-- Read-only value in a detail pane. -->
  <Style x:Key="PiaDetailValueStyle" TargetType="TextBlock">
    <Setter Property="FontSize"     Value="12"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
    <Setter Property="Foreground"   Value="{DynamicResource TextSubtleBrush}"/>
  </Style>

  <!-- Inline notice strip between a page header and its content. -->
  <Style x:Key="PiaStatusBannerStyle" TargetType="Border">
    <Setter Property="Padding"      Value="12,8"/>
    <Setter Property="CornerRadius" Value="6"/>
    <Setter Property="Background"   Value="{DynamicResource SurfaceMutedBrush}"/>
  </Style>

  <!-- Settings — content card. Lighter than PiaCardStyle (no shadow) so that
       stacked rows in a section stay readable without competing for attention. -->
  <Style x:Key="PiaSettingsCardStyle" TargetType="Border">
    <Setter Property="Background"      Value="{DynamicResource SurfaceBrush}"/>
    <Setter Property="BorderBrush"     Value="{DynamicResource BorderBrush_}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius"    Value="{StaticResource LargeRadius}"/>
    <Setter Property="Padding"         Value="14,12"/>
  </Style>

  <!-- Settings — left sidebar item. Replaces the inline ListBoxItem template
       that used to live in SettingsView.xaml; same 3-px accent indicator
       vocabulary used elsewhere in the app. -->
  <Style x:Key="PiaSettingsSidebarItemStyle" TargetType="ListBoxItem">
    <Setter Property="Padding"      Value="10,8"/>
    <Setter Property="Margin"       Value="0,2"/>
    <Setter Property="Cursor"       Value="Hand"/>
    <Setter Property="Background"   Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Foreground"   Value="{DynamicResource TextMutedBrush}"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Border x:Name="Bd"
                  Background="{TemplateBinding Background}"
                  CornerRadius="8"
                  Padding="{TemplateBinding Padding}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Border x:Name="Indicator"
                      Grid.Column="0"
                      Width="3"
                      Height="16"
                      CornerRadius="1.5"
                      Background="{DynamicResource PiaAccentBrush}"
                      Margin="0,0,10,0"
                      VerticalAlignment="Center"
                      Visibility="Hidden"/>
              <ContentPresenter Grid.Column="1"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"/>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background"
                      Value="{DynamicResource SurfaceMutedBrush}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Bd" Property="Background"
                      Value="{DynamicResource SurfaceBrush}"/>
              <Setter TargetName="Indicator" Property="Visibility" Value="Visible"/>
              <Setter Property="Foreground" Value="{DynamicResource TextDefaultBrush}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.45"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Row card for a master-detail list (Routines, Personas). Cursor belongs here on the template
       Border, not on the container: set on a ListBoxItem it inherits into the content and cannot be
       taken back. Pairs with PiaMemoryRowItemStyle on the ItemContainerStyle. -->
  <Style x:Key="PiaMasterRowCardStyle" TargetType="Border" BasedOn="{StaticResource PiaCardStyle}">
    <Setter Property="Padding" Value="14,12"/>
    <Setter Property="Margin"  Value="0,0,0,10"/>
    <Setter Property="Cursor"  Value="Hand"/>
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}"/>
      </Trigger>
      <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                   Value="True">
        <Setter Property="Background"  Value="{DynamicResource PiaAccentSoftBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource PiaAccentBrush}"/>
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <!-- WPF-UI buttons keep the arrow cursor; Arrow again when disabled so a disabled action does not
       read as live. Re-declare implicitly per view (BasedOn this) rather than app-wide. -->
  <Style x:Key="PiaHandCursorButtonStyle" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
    <Setter Property="Cursor" Value="Hand"/>
    <Style.Triggers>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Cursor" Value="Arrow"/>
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- Memory row container: strips ListBoxItem chrome, draws the 3-px
       accent bar when selected (matches chat sidebar selection vocabulary). -->
  <Style x:Key="PiaMemoryRowItemStyle" TargetType="ListBoxItem">
    <Setter Property="Padding"         Value="0"/>
    <Setter Property="Margin"          Value="0"/>
    <Setter Property="Background"      Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="Focusable"       Value="True"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Grid>
            <Border x:Name="AccentBar"
                    HorizontalAlignment="Left"
                    Width="3"
                    Margin="8,8"
                    CornerRadius="1.5"
                    Background="{DynamicResource PiaAccentBrush}"
                    Visibility="Collapsed"/>
            <ContentPresenter/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="AccentBar" Property="Visibility" Value="Visible"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

</ResourceDictionary>

<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

  <!-- Pia avatar — 28x28 rounded square, gradient + centered "P".
       Targets ContentControl because Border has no Template DP. -->
  <Style x:Key="PiaAvatarStyle" TargetType="ContentControl">
    <Setter Property="Width"     Value="28"/>
    <Setter Property="Height"    Value="28"/>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ContentControl">
          <Border CornerRadius="8">
            <Border.Background>
              <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Offset="0" Color="{Binding Source={StaticResource PiaInkColor}}"/>
                <GradientStop Offset="1" Color="{Binding Source={StaticResource PiaAccentColor}}"/>
              </LinearGradientBrush>
            </Border.Background>
            <TextBlock Text="P"
                       FontFamily="{DynamicResource PiaDisplayFont}"
                       FontWeight="Bold"
                       FontSize="14"
                       Foreground="White"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Chat bubbles -->

  <!-- Assistant bubble: no background, typography only. -->
  <Style x:Key="AssistantBubbleStyle" TargetType="Border">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Padding"    Value="0"/>
    <Setter Property="MaxWidth"   Value="580"/>
    <Setter Property="HorizontalAlignment" Value="Left"/>
  </Style>

  <!-- User bubble: solid accent, asymmetric corner radius. -->
  <Style x:Key="UserBubbleStyle" TargetType="Border">
    <Setter Property="Background"   Value="{DynamicResource PiaAccentBrush}"/>
    <Setter Property="CornerRadius" Value="14,14,4,14"/>
    <Setter Property="Padding"      Value="14,10"/>
    <Setter Property="MaxWidth"     Value="520"/>
    <Setter Property="HorizontalAlignment" Value="Right"/>
    <Setter Property="Effect">
      <Setter.Value>
        <DropShadowEffect Color="#1E2A4A" Opacity="0.10"
                          BlurRadius="8" ShadowDepth="1"/>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="UserBubbleTextStyle" TargetType="TextBlock">
    <Setter Property="Foreground"   Value="White"/>
    <Setter Property="FontSize"     Value="14"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
    <Setter Property="LineHeight"   Value="21"/>
  </Style>

  <!-- Generic elevated card. Used by ActionCard and inline panels. -->
  <Style x:Key="PiaCardStyle" TargetType="Border">
    <Setter Property="Background"      Value="{DynamicResource SurfaceBrush}"/>
    <Setter Property="BorderBrush"     Value="{DynamicResource BorderBrush_}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius"    Value="{StaticResource LargeRadius}"/>
    <Setter Property="Effect">
      <Setter.Value>
        <DropShadowEffect Color="#0F1729" Opacity="0.08"
                          BlurRadius="16" ShadowDepth="3"/>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Header stripe used at the top of cards. Rounds top corners, divides body. -->
  <Style x:Key="PiaCardHeaderStripeStyle" TargetType="Border">
    <Setter Property="Background"      Value="{DynamicResource SurfaceMutedBrush}"/>
    <Setter Property="BorderBrush"     Value="{DynamicResource BorderBrush_}"/>
    <Setter Property="BorderThickness" Value="0,0,0,1"/>
    <Setter Property="Padding"         Value="14,10"/>
    <Setter Property="CornerRadius"    Value="12,12,0,0"/>
  </Style>

  <!-- Round 22-square chip behind a header icon. -->
  <Style x:Key="PiaIconChipStyle" TargetType="Border">
    <Setter Property="Width"        Value="22"/>
    <Setter Property="Height"       Value="22"/>
    <Setter Property="CornerRadius" Value="{StaticResource SmallRadius}"/>
    <Setter Property="Background"   Value="{DynamicResource PiaAccentSoftBrush}"/>
  </Style>

  <!-- Composer / input bar card. -->
  <Style x:Key="PiaComposerCardStyle" TargetType="Border">
    <Setter Property="Background"      Value="{DynamicResource SurfaceBrush}"/>
    <Setter Property="BorderBrush"     Value="{DynamicResource BorderBrush_}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius"    Value="{StaticResource BubbleRadius}"/>
    <Setter Property="Effect">
      <Setter.Value>
        <DropShadowEffect Color="#0F1729" Opacity="0.08"
                          BlurRadius="18" ShadowDepth="3"/>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Chrome-less button (e.g. clickable category header). -->
  <Style x:Key="UnstyledButton" TargetType="Button">
    <Setter Property="Background"      Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding"         Value="0"/>
    <Setter Property="Cursor"          Value="Hand"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd"
                  Background="{TemplateBinding Background}"
                  Padding="{TemplateBinding Padding}"
                  CornerRadius="9">
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background"
                      Value="{DynamicResource SurfaceMutedBrush}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Dashed "+ tag" affordance. -->
  <Style x:Key="PiaDashedGhostButton" TargetType="Button">
    <Setter Property="Background"  Value="Transparent"/>
    <Setter Property="Foreground"  Value="{DynamicResource TextMutedBrush}"/>
    <Setter Property="Padding"     Value="8,3"/>
    <Setter Property="FontSize"    Value="11.5"/>
    <Setter Property="Cursor"      Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd"
                  CornerRadius="4"
                  Padding="{TemplateBinding Padding}"
                  Background="{TemplateBinding Background}"
                  BorderThickness="1"
                  BorderBrush="{DynamicResource BorderStrongBrush}"
                  SnapsToDevicePixels="True">
            <Border.OpacityMask>
              <VisualBrush>
                <VisualBrush.Visual>
                  <Border CornerRadius="4"
                          Background="Black"
                          Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Border}}"
                          Height="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Border}}"/>
                </VisualBrush.Visual>
              </VisualBrush>
            </Border.OpacityMask>
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                              TextBlock.FontSize="{TemplateBinding FontSize}"
                              TextBlock.Foreground="{TemplateBinding Foreground}"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="BorderBrush"
                      Value="{DynamicResource PiaAccentBrush}"/>
              <Setter Property="Foreground"
                      Value="{DynamicResource PiaAccentBrush}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Segmented selector pill (filter strip, JSON/Raw). Selected state uses
       solid accent fill so it reads clearly against the muted track. -->
  <Style x:Key="PiaSegmentedButton" TargetType="RadioButton">
    <Setter Property="Foreground"  Value="{DynamicResource TextMutedBrush}"/>
    <Setter Property="FontSize"    Value="12"/>
    <Setter Property="Padding"     Value="12,5"/>
    <Setter Property="Cursor"      Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Border x:Name="Bd"
                  CornerRadius="6"
                  Padding="{TemplateBinding Padding}"
                  Background="Transparent"
                  BorderBrush="Transparent"
                  BorderThickness="1">
            <ContentPresenter HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              TextBlock.Foreground="{TemplateBinding Foreground}"
                              TextBlock.FontSize="{TemplateBinding FontSize}"
                              TextBlock.FontWeight="Medium"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background"
                      Value="{DynamicResource SurfaceMutedBrush}"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Bd" Property="Background"
                      Value="{DynamicResource PiaAccentBrush}"/>
              <Setter TargetName="Bd" Property="BorderBrush"
                      Value="{DynamicResource PiaAccentBrush}"/>
              <Setter Property="Foreground" Value="White"/>
              <Setter TargetName="Bd" Property="Effect">
                <Setter.Value>
                  <DropShadowEffect Color="#1E2A4A" Opacity="0.18"
                                    BlurRadius="6" ShadowDepth="1"/>
                </Setter.Value>
              </Setter>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Memory row container: strips ListBoxItem chrome, draws the 3-px
       accent bar when selected (matches chat sidebar selection vocabulary). -->
  <Style x:Key="PiaMemoryRowItemStyle" TargetType="ListBoxItem">
    <Setter Property="Padding"         Value="0"/>
    <Setter Property="Margin"          Value="0"/>
    <Setter Property="Background"      Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="Focusable"       Value="True"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Grid>
            <Border x:Name="AccentBar"
                    HorizontalAlignment="Left"
                    Width="3"
                    Margin="8,8"
                    CornerRadius="1.5"
                    Background="{DynamicResource PiaAccentBrush}"
                    Visibility="Collapsed"/>
            <ContentPresenter/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="AccentBar" Property="Visibility" Value="Visible"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

</ResourceDictionary>

<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:Pia.Controls"
                    xmlns:loc="clr-namespace:Pia.Localization">

    <!-- FlowDocument style for assistant messages.
         PiaMarkdownRenderer assigns Tag values to elements that match these triggers:
         Heading1-4 on Paragraph, Blockquote on Section, CodeSpan on Run,
         TableHeaderGroup on TableRowGroup, TableHeader/TableRowOdd on TableRow. -->
    <Style x:Key="PiaMarkdownStyle" TargetType="FlowDocument">
        <Setter Property="FontFamily" Value="{StaticResource DefaultFontFamily}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="PagePadding" Value="0" />
        <Setter Property="TextAlignment" Value="Left" />

        <Style.Resources>
            <!-- Paragraph: base + heading triggers -->
            <Style TargetType="Paragraph">
                <Setter Property="Margin" Value="0,0,0,8" />
                <Style.Triggers>
                    <Trigger Property="Tag" Value="Heading1">
                        <Setter Property="FontSize" Value="{StaticResource FontSizeH2}" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Setter Property="Margin" Value="0,8,0,4" />
                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                    </Trigger>
                    <Trigger Property="Tag" Value="Heading2">
                        <Setter Property="FontSize" Value="{StaticResource FontSizeH3}" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Setter Property="Margin" Value="0,6,0,4" />
                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                    </Trigger>
                    <Trigger Property="Tag" Value="Heading3">
                        <Setter Property="FontSize" Value="{StaticResource FontSizeH4}" />
                        <Setter Property="FontWeight" Value="Medium" />
                        <Setter Property="Margin" Value="0,4,0,4" />
                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                    </Trigger>
                    <Trigger Property="Tag" Value="Heading4">
                        <Setter Property="FontSize" Value="{StaticResource FontSizeH5}" />
                        <Setter Property="FontWeight" Value="Medium" />
                        <Setter Property="Margin" Value="0,4,0,4" />
                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- Section: blockquote trigger -->
            <Style TargetType="Section">
                <Setter Property="Margin" Value="0,0,0,4" />
                <Style.Triggers>
                    <Trigger Property="Tag" Value="Blockquote">
                        <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                        <Setter Property="BorderThickness" Value="3,0,0,0" />
                        <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
                        <Setter Property="Padding" Value="12,6,12,2" />
                        <Setter Property="Margin" Value="0,4,0,8" />
                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- Inline code chip -->
            <Style TargetType="Run">
                <Style.Triggers>
                    <Trigger Property="Tag" Value="CodeSpan">
                        <Setter Property="Background" Value="{DynamicResource ControlFillColorTertiaryBrush}" />
                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                        <Setter Property="FontFamily" Value="{StaticResource CodeFontFamily}" />
                        <Setter Property="FontSize" Value="{StaticResource CodeFontSize}" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- Lists -->
            <Style TargetType="List">
                <Setter Property="Margin" Value="0,0,0,8" />
                <Setter Property="Padding" Value="24,0,0,0" />
            </Style>

            <Style TargetType="ListItem">
                <Setter Property="Margin" Value="0,0,0,2" />
            </Style>

            <!-- Hyperlinks -->
            <Style TargetType="Hyperlink">
                <Setter Property="Foreground" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                <Setter Property="TextDecorations" Value="{x:Null}" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="TextDecorations" Value="Underline" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- Tables -->
            <Style TargetType="Table">
                <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CellSpacing" Value="0" />
                <Setter Property="Margin" Value="0,4,0,8" />
            </Style>

            <Style TargetType="TableRowGroup">
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                <Style.Triggers>
                    <Trigger Property="Tag" Value="TableHeaderGroup">
                        <Setter Property="Background" Value="{DynamicResource ControlFillColorTertiaryBrush}" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style TargetType="TableRow">
                <Style.Triggers>
                    <Trigger Property="Tag" Value="TableHeader">
                        <Setter Property="FontWeight" Value="SemiBold" />
                    </Trigger>
                    <Trigger Property="Tag" Value="TableRowOdd">
                        <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style TargetType="TableCell">
                <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="0,0,1,1" />
                <Setter Property="Padding" Value="8,5" />
            </Style>
        </Style.Resources>
    </Style>

    <!-- One menu for the whole app: declared inline it costs eight MenuItems per rendered transcript message.
         Sharing it leaves PlacementTarget as the only thing that says which message a command was opened over. -->
    <ContextMenu x:Key="MarkdownMessageContextMenu">
        <MenuItem Command="ApplicationCommands.Copy"
                  CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
        <Separator />
        <MenuItem Header="{loc:Str Assistant_AddToPiiList}" AutomationProperties.AutomationId="PiiMenu_Open">
            <MenuItem Header="{loc:Str PiiCategory_Person}" AutomationProperties.AutomationId="PiiMenu_Person"
                      Command="{x:Static controls:MarkdownMessageControl.AddToPiiCommand}" CommandParameter="Person"
                      CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            <MenuItem Header="{loc:Str PiiCategory_Nickname}" AutomationProperties.AutomationId="PiiMenu_Nickname"
                      Command="{x:Static controls:MarkdownMessageControl.AddToPiiCommand}" CommandParameter="Nickname"
                      CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            <MenuItem Header="{loc:Str PiiCategory_Email}" AutomationProperties.AutomationId="PiiMenu_Email"
                      Command="{x:Static controls:MarkdownMessageControl.AddToPiiCommand}" CommandParameter="Email"
                      CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            <MenuItem Header="{loc:Str PiiCategory_Phone}" AutomationProperties.AutomationId="PiiMenu_Phone"
                      Command="{x:Static controls:MarkdownMessageControl.AddToPiiCommand}" CommandParameter="Phone"
                      CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            <MenuItem Header="{loc:Str PiiCategory_Address}" AutomationProperties.AutomationId="PiiMenu_Address"
                      Command="{x:Static controls:MarkdownMessageControl.AddToPiiCommand}" CommandParameter="Address"
                      CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            <MenuItem Header="{loc:Str PiiCategory_Date}" AutomationProperties.AutomationId="PiiMenu_Date"
                      Command="{x:Static controls:MarkdownMessageControl.AddToPiiCommand}" CommandParameter="Date"
                      CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            <MenuItem Header="{loc:Str PiiCategory_Custom}" AutomationProperties.AutomationId="PiiMenu_Custom"
                      Command="{x:Static controls:MarkdownMessageControl.AddToPiiCommand}" CommandParameter="Custom"
                      CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
        </MenuItem>
    </ContextMenu>

</ResourceDictionary>

<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                    xmlns:controls="clr-namespace:Pia.Views.Controls">

  <!-- BooleanToVisibilityConverter for button text → visibility -->
  <BooleanToVisibilityConverter x:Key="OverlayBoolToVis" />

  <Style TargetType="{x:Type controls:OverlayDialogPanel}">
    <Setter Property="Focusable" Value="True" />
    <Setter Property="KeyboardNavigation.TabNavigation" Value="Cycle" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type controls:OverlayDialogPanel}">
          <Border Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                  CornerRadius="12"
                  Padding="28,24"
                  MaxWidth="{TemplateBinding MaxPanelWidth}"
                  MaxHeight="{TemplateBinding MaxPanelHeight}"
                  MinWidth="{TemplateBinding MinPanelWidth}">
            <Border.Effect>
              <DropShadowEffect ShadowDepth="0"
                                BlurRadius="24"
                                Opacity="0.4"
                                Color="Black" />
            </Border.Effect>

            <!-- Grid, not StackPanel: the button row has to stay pinned while the body scrolls. -->
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>

              <!-- Disabled horizontally so the body measures at the viewport width and text wraps. -->
              <ScrollViewer Grid.Row="0"
                            VerticalScrollBarVisibility="Auto"
                            HorizontalScrollBarVisibility="Disabled"
                            Focusable="False">
                <ContentPresenter />
              </ScrollViewer>

              <StackPanel Grid.Row="1"
                          Orientation="Horizontal"
                          HorizontalAlignment="Right"
                          Margin="0,20,0,0">
                <ui:Button x:Name="PART_SecondaryButton"
                           Content="{TemplateBinding SecondaryButtonText}"
                           Icon="{TemplateBinding SecondaryButtonIcon}"
                           Appearance="Secondary"
                           Margin="0,0,8,0"
                           Padding="16,8"
                           IsEnabled="{TemplateBinding IsSecondaryButtonEnabled}">
                  <ui:Button.Style>
                    <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                      <Setter Property="Visibility" Value="Visible" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding SecondaryButtonText, RelativeSource={RelativeSource TemplatedParent}}" Value="{x:Null}">
                          <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding SecondaryButtonText, RelativeSource={RelativeSource TemplatedParent}}" Value="">
                          <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </ui:Button.Style>
                </ui:Button>

                <ui:Button x:Name="PART_PrimaryButton"
                           Content="{TemplateBinding PrimaryButtonText}"
                           Icon="{TemplateBinding PrimaryButtonIcon}"
                           Appearance="Primary"
                           Margin="0,0,8,0"
                           Padding="16,8"
                           IsEnabled="{TemplateBinding IsPrimaryButtonEnabled}">
                  <ui:Button.Style>
                    <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                      <Setter Property="Visibility" Value="Visible" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding PrimaryButtonText, RelativeSource={RelativeSource TemplatedParent}}" Value="{x:Null}">
                          <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding PrimaryButtonText, RelativeSource={RelativeSource TemplatedParent}}" Value="">
                          <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </ui:Button.Style>
                </ui:Button>

                <ui:Button x:Name="PART_CloseButton"
                           Content="{TemplateBinding CloseButtonText}"
                           Icon="{TemplateBinding CloseButtonIcon}"
                           Appearance="Secondary"
                           Padding="16,8">
                  <ui:Button.Style>
                    <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                      <Setter Property="Visibility" Value="Visible" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding CloseButtonText, RelativeSource={RelativeSource TemplatedParent}}" Value="{x:Null}">
                          <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding CloseButtonText, RelativeSource={RelativeSource TemplatedParent}}" Value="">
                          <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </ui:Button.Style>
                </ui:Button>
              </StackPanel>
            </Grid>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>

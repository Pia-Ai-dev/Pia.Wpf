<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

  <Style x:Key="NavigationIconStyle" TargetType="ui:SymbolIcon">
    <Setter Property="FontSize" Value="18" />
    <Setter Property="Margin" Value="0,0,12,0" />
  </Style>

  <!-- ItemsControl items surface in UIA as a DataItem peer that hides the item's own patterns,
       so a NavigationViewItem can never expose Invoke — an invokable element must live in its
       content. Chromeless: the item itself supplies all hover/press feedback. -->
  <Style x:Key="NavItemInvokeButtonStyle" TargetType="Button">
    <!-- Button's theme style pins Foreground to the classic system control text, which stays black under a
         dark app theme and outranks inheritance. Dropping it is what lets the label take the item's colour. -->
    <Setter Property="OverridesDefaultStyle" Value="True" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="KeyboardNavigation.IsTabStop" Value="False" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <ContentPresenter />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="ModeToggleStyle" TargetType="Button">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="8" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border Background="{TemplateBinding Background}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  Padding="{TemplateBinding Padding}"
                  CornerRadius="4">
            <ContentPresenter HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{DynamicResource ControlSecondaryBackgroundBrush}" />
      </Trigger>
      <Trigger Property="IsPressed" Value="True">
        <Setter Property="Background" Value="{DynamicResource ControlTertiaryBackgroundBrush}" />
      </Trigger>
    </Style.Triggers>
  </Style>

</ResourceDictionary>

<Application x:Class="Pia.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Pia"
              xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
              xmlns:views="clr-namespace:Pia.Views"
              xmlns:viewModels="clr-namespace:Pia.ViewModels"
              xmlns:converters="clr-namespace:Pia.Converters"
              xmlns:loc="clr-namespace:Pia.Localization">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <!-- WPF-UI Theme -->
        <ui:ThemesDictionary />
        <ui:ControlsDictionary />

        <!-- Pia design tokens (light baseline; ThemeService swaps to Dark at runtime).
             Must load BEFORE PiaStyles so its StaticResource lookups resolve. -->
        <ResourceDictionary Source="Resources/Theme/PiaTokens.Light.xaml" />

        <!-- Logo geometry, shared by the avatar, title bars and persona glyphs. -->
        <ResourceDictionary Source="Resources/Icons/PiaLogo.xaml" />
        <ResourceDictionary Source="Resources/Theme/PiaStyles.xaml" />

        <!-- Custom Styles -->
        <ResourceDictionary Source="Resources/Styles/Typography.xaml" />
        <ResourceDictionary Source="Resources/Styles/Layout.xaml" />
        <ResourceDictionary Source="Resources/Styles/Controls.xaml" />
        <ResourceDictionary Source="Resources/Styles/Navigation.xaml" />
        <ResourceDictionary Source="Resources/Styles/MarkdownStyles.xaml" />
        <ResourceDictionary Source="Resources/Styles/OverlayDialog.xaml" />
        <ResourceDictionary Source="Resources/Styles/Snackbar.xaml" />
        <ResourceDictionary Source="Resources/Styles/BrandIcons.xaml" />
      </ResourceDictionary.MergedDictionaries>

      <!-- Converters -->
      <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
      <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" />
      <converters:ZeroToVisibilityConverter x:Key="ZeroToVisibilityConverter" />
      <converters:NullToBoolConverter x:Key="NullToBoolConverter" />
      <converters:InverseBooleanConverter x:Key="InverseBooleanConverter" />
      <converters:ToolScopeToBoolConverter x:Key="ToolScopeToBoolConverter" />
      <converters:ToolScopeToInverseVisibilityConverter x:Key="ToolScopeToInverseVisibilityConverter" />
      <converters:StepStatusToGlyphConverter x:Key="StepStatusToGlyphConverter" />
      <converters:StepStatusToBrushConverter x:Key="StepStatusToBrushConverter" />
      <converters:StepStatusToBrushConverter x:Key="StepStatusToTitleBrush" Kind="Title" />
      <converters:StepStatusToBrushConverter x:Key="StepStatusToSegmentBrush" Kind="Segment" />
      <converters:StepStatusToTitleWeightConverter x:Key="StepStatusToTitleWeightConverter" />
      <converters:BoolToFontWeightConverter x:Key="BoolToFontWeightConverter" />
      <converters:RunStateToLabelConverter x:Key="RunStateToLabelConverter" />
      <converters:RunStateToBrushConverter x:Key="RunStateToBrushConverter" />
      <converters:RunStateToSpinnerVisibilityConverter x:Key="RunStateToSpinnerVisibilityConverter" />
      <converters:RunStateToStateIconVisibilityConverter x:Key="RunStateToStateIconVisibilityConverter" />
      <converters:RunStateToIconConverter x:Key="RunStateToIconConverter" />
      <converters:RunStateToIconFilledConverter x:Key="RunStateToIconFilledConverter" />
      <converters:RunStateToBandBrushConverter x:Key="RunStateToBandBg" Kind="Background" />
      <converters:RunStateToBandBrushConverter x:Key="RunStateToBandBorder" Kind="Border" />
      <converters:RunStateToCardBorderBrushConverter x:Key="RunStateToCardBorderBrushConverter" />
      <converters:RunStateToLeadWeightConverter x:Key="RunStateToLeadWeightConverter" />
      <converters:RunStateToSubLineBrushConverter x:Key="RunStateToSubLineBrushConverter" />
      <converters:DecisionSeverityToBrushConverter x:Key="DecisionSeverityToBrushFg" Kind="Foreground" />
      <converters:DecisionSeverityToBrushConverter x:Key="DecisionSeverityToBrushBg" Kind="Background" />
      <converters:DecisionSeverityToBrushConverter x:Key="DecisionSeverityToBrushBorder" Kind="Border" />
      <converters:BoolToRunningRowBrushConverter x:Key="BoolToRunningRowBrushConverter" />
      <converters:IdEqualsVisibilityConverter x:Key="IdEqualsVisibilityConverter" />
      <converters:ProviderTypeToVisibilityConverter x:Key="ProviderTypeToVisibilityConverter" />
      <converters:LanguageToFlagConverter x:Key="LanguageToFlagConverter" />
      <converters:WindowModeToVisibilityConverter x:Key="WindowModeToVisibilityConverter" />
      <converters:VoiceModeStateToVisibilityConverter x:Key="VoiceModeStateToVisibilityConverter" />
      <converters:StringEqualsBoolConverter x:Key="StringEqualsBoolConverter" />
      <converters:MultiStringEqualsBoolConverter x:Key="MultiStringEqualsBoolConverter" />
      <converters:StringNotNullOrEmptyToBoolConverter x:Key="StringNotNullOrEmptyToBoolConverter" />
      <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
      <converters:InverseNullToVisibilityConverter x:Key="InverseNullToVisibilityConverter" />
      <converters:MultiplyConverter x:Key="MultiplyConverter" />
      <converters:SpeakerToDisplayNameConverter x:Key="SpeakerToDisplayNameConverter" />
      <converters:DateTimeOffsetToShortTimeConverter x:Key="DateTimeOffsetToShortTimeConverter" />
      <converters:UtcToLocalDateTimeConverter x:Key="UtcToLocalDateTimeConverter" />
      <converters:BoolToAngleConverter x:Key="BoolToAngleConverter" />
      <converters:SingleLineConverter x:Key="SingleLineConverter" />
      <converters:WikiLinkConverter x:Key="WikiLinkConverter" />
      <converters:IntToVisibilityConverter x:Key="IntToVisibilityConverter" />
      <converters:BoolToReflowMarginConverter x:Key="BoolToReflowMarginConverter" />
      <converters:MemoryTypeToLabelConverter x:Key="MemoryTypeToLabelConverter" />
      <converters:MemoryTypeToBrushConverter x:Key="MemoryTypeToBrushBg" Kind="Background" />
      <converters:MemoryTypeToBrushConverter x:Key="MemoryTypeToBrushFg" Kind="Foreground" />
      <converters:VaultCategoryColorConverter x:Key="VaultCategoryBrushBg" Kind="Background" />
      <converters:VaultCategoryColorConverter x:Key="VaultCategoryBrushFg" Kind="Foreground" />
      <converters:FractionToWidthConverter x:Key="FractionToWidthConverter" />
      <converters:ReminderStatusToBrushConverter x:Key="ReminderStatusToBrushBg" Kind="Background" />
      <converters:ReminderStatusToBrushConverter x:Key="ReminderStatusToBrushFg" Kind="Foreground" />
      <converters:ReminderStatusToLabelConverter x:Key="ReminderStatusToLabelConverter" />
      <converters:NextFireAtToShortStringConverter x:Key="NextFireAtToShortStringConverter" />
      <converters:HexToBrushConverter x:Key="HexToBrushConverter" />
      <converters:ChatStateToBrushConverter x:Key="ChatStateToBrushBg" Kind="Background" />
      <converters:ChatStateToBrushConverter x:Key="ChatStateToBrushFg" Kind="Foreground" />
      <converters:ChatStateToGlyphConverter x:Key="ChatStateToGlyphConverter" />
      <converters:ChatStateToLabelConverter x:Key="ChatStateToLabelConverter" />
      <converters:ChatStateIsBadgeVisibleConverter x:Key="ChatStateIsBadgeVisibleConverter" />

      <!-- DataTemplate mappings for Views and ViewModels -->
      <DataTemplate DataType="{x:Type viewModels:OptimizeViewModel}">
        <views:OptimizeView />
      </DataTemplate>
      <DataTemplate DataType="{x:Type viewModels:SettingsViewModel}">
        <views:SettingsView />
      </DataTemplate>
      <DataTemplate DataType="{x:Type viewModels:HistoryViewModel}">
        <views:HistoryView />
      </DataTemplate>
      <DataTemplate DataType="{x:Type viewModels:AssistantViewModel}">
        <views:AssistantView />
      </DataTemplate>
      <DataTemplate DataType="{x:Type viewModels:AssistantHistoryViewModel}">
        <views:AssistantHistoryView />
      </DataTemplate>
      <DataTemplate DataType="{x:Type viewModels:VaultViewModel}">
        <views:VaultView />
      </DataTemplate>
      <DataTemplate DataType="{x:Type viewModels:RemindersViewModel}">
        <views:RemindersView />
      </DataTemplate>
      <DataTemplate DataType="{x:Type viewModels:TodoViewModel}">
        <views:TodoView />
      </DataTemplate>
      <DataTemplate DataType="{x:Type viewModels:AssignmentsViewModel}">
        <views:AssignmentsView />
      </DataTemplate>
      <DataTemplate DataType="{x:Type viewModels:RoutinesViewModel}">
        <views:RoutinesView />
      </DataTemplate>
    </ResourceDictionary>
  </Application.Resources>
</Application>

<ui:ContentDialog x:Class="Pia.Views.Dialogs.OptOutConfirmContentDialog"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:local="clr-namespace:Pia.Views.Dialogs"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                  xmlns:loc="clr-namespace:Pia.Localization"
                  Title="{Binding Title}"
                  PrimaryButtonText="{Binding ConfirmText}"
                  CloseButtonText="{loc:Str Common_Cancel}"
                  DefaultButton="Close"
                  DialogMaxWidth="520">
  <ui:ContentDialog.Resources>
    <Style BasedOn="{StaticResource {x:Type ui:ContentDialog}}"
           TargetType="{x:Type local:OptOutConfirmContentDialog}" />
  </ui:ContentDialog.Resources>

  <StackPanel MaxWidth="440" Margin="0,8,0,0">
    <TextBlock Text="{Binding Message}"
               TextWrapping="Wrap"
               LineHeight="20"
               Margin="0,0,0,16" />
    <CheckBox Content="{loc:Str Dialog_DontAskAgain}"
              IsChecked="{Binding DontAskAgain}"
              AutomationProperties.AutomationId="OptOutConfirm_DontAskAgain" />
  </StackPanel>
</ui:ContentDialog>

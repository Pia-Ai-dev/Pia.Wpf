<ui:ContentDialog x:Class="Pia.Views.Dialogs.DeviceApprovalContentDialog"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:local="clr-namespace:Pia.Views.Dialogs"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                  xmlns:loc="clr-namespace:Pia.Localization"
                  Title="{loc:Str Settings_E2EE_ApproveDevice_Title}"
                  PrimaryButtonText="{loc:Str Settings_E2EE_ApproveDevice_Approve}"
                  CloseButtonText="{loc:Str Settings_E2EE_ApproveDevice_Decline}"
                  DefaultButton="Close"
                  DialogMaxWidth="560"
                  DialogMaxHeight="680">
  <ui:ContentDialog.Resources>
    <Style BasedOn="{StaticResource {x:Type ui:ContentDialog}}"
           TargetType="{x:Type local:DeviceApprovalContentDialog}" />

    <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,0,16,0" />
    </Style>
  </ui:ContentDialog.Resources>

  <StackPanel Margin="0,8,0,0" Width="460">
    <TextBlock Text="{loc:Str Settings_E2EE_ApproveDevice_Intro}"
               TextWrapping="Wrap"
               Foreground="{DynamicResource TextDefaultBrush}"
               Margin="0,0,0,12" />

    <Border Background="{DynamicResource WarnSoftBrush}"
            BorderBrush="{DynamicResource WarnBorderBrush}"
            BorderThickness="1"
            CornerRadius="6"
            Padding="12,8"
            Margin="0,0,0,12"
            Visibility="{Binding NameHadHiddenCharacters, Converter={StaticResource BooleanToVisibilityConverter}}">
      <TextBlock Text="{loc:Str Settings_E2EE_ApproveDevice_NameSanitized}"
                 AutomationProperties.AutomationId="DeviceApproval_NameSanitized"
                 TextWrapping="Wrap"
                 Foreground="{DynamicResource TextDefaultBrush}" />
    </Border>

    <TextBlock Text="{loc:Str Settings_E2EE_ApproveDevice_RequestingSection}"
               Style="{StaticResource PiaSettingsSectionLabelStyle}" />
    <Border Style="{StaticResource PiaSettingsCardStyle}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="12" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0"
                   Text="{loc:Str Settings_E2EE_ApproveDevice_NameLabel}"
                   Style="{StaticResource FieldLabelStyle}" />
        <!-- The name is attacker-chosen: cap it at two lines so it can never push the fingerprint away. -->
        <TextBlock Grid.Row="0" Grid.Column="1"
                   Text="{Binding DeviceName}"
                   AutomationProperties.AutomationId="DeviceApproval_DeviceName"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource TextDefaultBrush}"
                   TextWrapping="Wrap"
                   TextTrimming="CharacterEllipsis"
                   LineStackingStrategy="BlockLineHeight"
                   LineHeight="20"
                   MaxHeight="40"
                   ClipToBounds="True"
                   VerticalAlignment="Center" />

        <TextBlock Grid.Row="2" Grid.Column="0"
                   Text="{loc:Str Settings_E2EE_ApproveDevice_FingerprintLabel}"
                   Style="{StaticResource FieldLabelStyle}" />
        <TextBlock Grid.Row="2" Grid.Column="1"
                   Text="{Binding DeviceFingerprint}"
                   AutomationProperties.AutomationId="DeviceApproval_DeviceFingerprint"
                   Style="{StaticResource PiaFingerprintTextStyle}" />
      </Grid>
    </Border>
    <TextBlock Text="{loc:Str Settings_E2EE_ApproveDevice_CompareHint}"
               Style="{StaticResource PiaSettingsDescriptionStyle}"
               Margin="0,6,0,16" />

    <TextBlock Text="{loc:Str Settings_E2EE_ApproveDevice_ThisDeviceSection}"
               Style="{StaticResource PiaSettingsSectionLabelStyle}" />
    <Border Style="{StaticResource PiaStatusBannerStyle}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0"
                   Text="{loc:Str Settings_E2EE_ApproveDevice_FingerprintLabel}"
                   Style="{StaticResource FieldLabelStyle}" />
        <TextBlock Grid.Column="1"
                   Text="{Binding OwnFingerprint}"
                   AutomationProperties.AutomationId="DeviceApproval_OwnFingerprint"
                   Style="{StaticResource PiaFingerprintTextStyle}"
                   FontSize="14" />
      </Grid>
    </Border>
    <TextBlock Text="{loc:Str Settings_E2EE_ApproveDevice_ThisDeviceHint}"
               Style="{StaticResource PiaSettingsDescriptionStyle}" />
  </StackPanel>
</ui:ContentDialog>

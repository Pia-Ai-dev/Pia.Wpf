<ui:ContentDialog x:Class="Pia.Views.Dialogs.ProviderEditContentDialog"
                  xmlns:local="clr-namespace:Pia.Views.Dialogs"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                  xmlns:models="clr-namespace:Pia.Models"
                  xmlns:loc="clr-namespace:Pia.Localization"
                  Title="{loc:Str Dialog_ProviderEdit_Title}"
                  PrimaryButtonText="{loc:Str Common_Save}"
                  CloseButtonText="{loc:Str Common_Cancel}"
                  DefaultButton="Primary"
                  IsPrimaryButtonEnabled="{Binding CanSave}">
 
  <ui:ContentDialog.Resources>
    <Style BasedOn="{StaticResource {x:Type ui:ContentDialog}}"
           TargetType="{x:Type local:ProviderEditContentDialog}" />
  </ui:ContentDialog.Resources>

  <StackPanel Margin="0,8,0,0" Width="400">
    <!-- ContentDialog hides the primary button when it is disabled, so the reason has to live here.
         A Border/TextBlock rather than ui:InfoBar, which renders but exposes no automation peer. -->
    <Border Style="{StaticResource PiaRequiredHintStyle}"
            Visibility="{Binding CanSave, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
      <TextBlock Text="{loc:Str Dialog_Edit_RequiredHint}"
                 AutomationProperties.AutomationId="Dialog_RequiredHint"
                 TextWrapping="Wrap" />
    </Border>

    <TextBlock Text="{loc:Str Dialog_ProviderEdit_Name}"
               FontWeight="SemiBold"
               Margin="0,0,0,4" />
    <ui:TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                AutomationProperties.AutomationId="ProviderEdit_Name"
                Margin="0,0,0,16" />

    <TextBlock Text="{loc:Str Dialog_ProviderEdit_ProviderType}"
               FontWeight="SemiBold"
               Margin="0,0,0,4" />
    <ComboBox ItemsSource="{Binding EditableProviderTypes}"
              SelectedItem="{Binding ProviderType}"
              AutomationProperties.AutomationId="ProviderEdit_ProviderType"
              AutomationProperties.Name="{loc:Str Dialog_ProviderEdit_ProviderType}"
              Margin="0,0,0,16" />

    <StackPanel Visibility="{Binding ProviderType, Converter={StaticResource ProviderTypeToVisibilityConverter}, ConverterParameter=Endpoint}">
      <TextBlock Text="{loc:Str Dialog_ProviderEdit_Endpoint}"
                 FontWeight="SemiBold"
                 Margin="0,0,0,4" />
      <ui:TextBox Text="{Binding Endpoint, UpdateSourceTrigger=PropertyChanged}"
                  PlaceholderText="http://localhost:11434/v1"
                  AutomationProperties.AutomationId="ProviderEdit_Endpoint"
                  Margin="0,0,0,16" />
    </StackPanel>

    <StackPanel Visibility="{Binding ProviderType, Converter={StaticResource ProviderTypeToVisibilityConverter}, ConverterParameter=ApiKey}">
      <TextBlock Text="{loc:Str Dialog_ProviderEdit_ApiKey}"
                 FontWeight="SemiBold"
                 Margin="0,0,0,4" />
      <ui:PasswordBox x:Name="ApiKeyPasswordBox"
                      AutomationProperties.AutomationId="ProviderEdit_ApiKey"
                      Margin="0,0,0,16" />
    </StackPanel>

    <StackPanel Visibility="{Binding ProviderType, Converter={StaticResource ProviderTypeToVisibilityConverter}, ConverterParameter=ModelName}">
      <TextBlock Text="{loc:Str Dialog_ProviderEdit_ModelName}"
                 FontWeight="SemiBold"
                 Margin="0,0,0,4" />
      <Grid Margin="0,0,0,4">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <ComboBox x:Name="ModelNameComboBox"
                  Grid.Column="0"
                  AutomationProperties.AutomationId="ProviderEdit_ModelName"
                  IsEditable="True"
                  Text="{Binding ModelName, UpdateSourceTrigger=PropertyChanged}"
                  ItemsSource="{Binding AvailableModels}" />
        <ui:Button x:Name="FetchModelsButton"
                   Grid.Column="1"
                   AutomationProperties.AutomationId="ProviderEdit_FetchModels"
                   Margin="8,0,0,0"
                   VerticalAlignment="Stretch"
                   AutomationProperties.Name="{loc:Str Dialog_ProviderEdit_FetchModels}"
                   ToolTip="{loc:Str Dialog_ProviderEdit_FetchModels}"
                   IsEnabled="{Binding IsFetchingModels, Converter={StaticResource InverseBooleanConverter}}">
          <Grid>
            <ui:SymbolIcon Symbol="ArrowSync24" FontSize="16"
                           Visibility="{Binding IsFetchingModels, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
            <ui:ProgressRing IsIndeterminate="True" Width="16" Height="16"
                             Visibility="{Binding IsFetchingModels, Converter={StaticResource BooleanToVisibilityConverter}}" />
          </Grid>
        </ui:Button>
      </Grid>
      <TextBlock x:Name="FetchModelsErrorText"
                 Text="{Binding FetchModelsError}"
                 Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                 TextWrapping="Wrap"
                 Visibility="Collapsed"
                 Margin="0,4,0,0" />
      <StackPanel Height="12" Margin="0,0,0,0" />
    </StackPanel>

    <StackPanel Visibility="{Binding ProviderType, Converter={StaticResource ProviderTypeToVisibilityConverter}, ConverterParameter=AzureDeployment}">
      <TextBlock Text="{loc:Str Dialog_ProviderEdit_AzureDeploymentName}"
                 FontWeight="SemiBold"
                 Margin="0,0,0,4" />
      <ui:TextBox Text="{Binding AzureDeploymentName, UpdateSourceTrigger=PropertyChanged}"
                  Margin="0,0,0,16" />
    </StackPanel>

    <StackPanel Visibility="{Binding ProviderType, Converter={StaticResource ProviderTypeToVisibilityConverter}, ConverterParameter=ReasoningEffort}">
      <TextBlock Text="Reasoning effort"
                 FontWeight="SemiBold"
                 Margin="0,0,0,4" />
      <ComboBox ItemsSource="{Binding ReasoningEffortOptions}"
                SelectedItem="{Binding ReasoningEffort, Mode=TwoWay}"
                Margin="0,0,0,16" />
    </StackPanel>

    <StackPanel Visibility="{Binding ProviderType, Converter={StaticResource ProviderTypeToVisibilityConverter}, ConverterParameter=WebSearch}">
      <CheckBox Content="{loc:Str Dialog_ProviderEdit_WebSearch}"
                IsChecked="{Binding EnableWebSearch}"
                Margin="0,0,0,16" />
    </StackPanel>

    <StackPanel Visibility="{Binding ProviderType, Converter={StaticResource ProviderTypeToVisibilityConverter}, ConverterParameter=MistralAgentId}">
      <TextBlock Text="{loc:Str Dialog_ProviderEdit_MistralAgentId}"
                 FontWeight="SemiBold"
                 Margin="0,0,0,4" />
      <TextBox Text="{Binding MistralAgentId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
               Margin="0,0,0,16" />
    </StackPanel>

    <StackPanel Visibility="{Binding IsMistralWebSearchAvailable, Converter={StaticResource BooleanToVisibilityConverter}}">
      <CheckBox Content="{loc:Str Dialog_ProviderEdit_WebSearch}"
                IsChecked="{Binding EnableWebSearch}"
                Margin="0,0,0,16" />
    </StackPanel>

    <TextBlock Text="{loc:Str Dialog_ProviderEdit_Timeout}"
               FontWeight="SemiBold"
               Margin="0,0,0,4" />
    <ui:NumberBox Value="{Binding TimeoutSeconds}"
                  Minimum="1"
                  Maximum="300"
                  Margin="0,0,0,16" />

    <StackPanel Visibility="{Binding ProviderType, Converter={StaticResource ProviderTypeToVisibilityConverter}, ConverterParameter=ContextWindow}">
      <TextBlock Text="{loc:Str Dialog_ProviderEdit_ContextWindowTokens}"
                 FontWeight="SemiBold"
                 Margin="0,0,0,4" />
      <ui:NumberBox Value="{Binding MaxContextWindowTokens}"
                    Minimum="0"
                    Maximum="2000000"
                    Margin="0,0,0,16" />
    </StackPanel>

    <TextBlock Text="{loc:Str Dialog_ProviderEdit_MaxOutputTokens}"
               FontWeight="SemiBold"
               Margin="0,0,0,4" />
    <ui:NumberBox Value="{Binding MaxOutputTokens}"
                  Minimum="0"
                  Maximum="200000"
                  Margin="0,0,0,4" />
    <TextBlock Text="{loc:Str Dialog_ProviderEdit_ContextBudgetHint}"
               Opacity="0.6"
               TextWrapping="Wrap"
               Margin="0,0,0,16" />
  </StackPanel>
</ui:ContentDialog>

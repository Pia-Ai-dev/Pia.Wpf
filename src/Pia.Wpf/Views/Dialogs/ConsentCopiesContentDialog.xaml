<ui:ContentDialog x:Class="Pia.Views.Dialogs.ConsentCopiesContentDialog"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:local="clr-namespace:Pia.Views.Dialogs"
                  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                  xmlns:loc="clr-namespace:Pia.Localization"
                  Title="{loc:Str ConsentCopies_Title}"
                  CloseButtonText="{loc:Str ConsentCopies_Close}"
                  DefaultButton="Close"
                  DialogMaxWidth="620"
                  DialogMaxHeight="760">
  <ui:ContentDialog.Resources>
    <Style BasedOn="{StaticResource {x:Type ui:ContentDialog}}"
           TargetType="{x:Type local:ConsentCopiesContentDialog}" />
  </ui:ContentDialog.Resources>

  <local:ConsentCopiesView />
</ui:ContentDialog>

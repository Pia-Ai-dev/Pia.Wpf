<ui:ContentDialog x:Class="Pia.Views.Dialogs.RecoveryCodeContentDialog"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:local="clr-namespace:Pia.Views.Dialogs"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                  xmlns:loc="clr-namespace:Pia.Localization"
                  Title="{loc:Str Dialog_Recovery_Title}"
                  PrimaryButtonText="{loc:Str Common_Done}"
                  DefaultButton="Primary"
                  IsPrimaryButtonEnabled="{Binding HasConfirmedRecoveryCode}"
                  DialogMaxWidth="600">
  <ui:ContentDialog.Resources>
    <Style BasedOn="{StaticResource {x:Type ui:ContentDialog}}"
           TargetType="{x:Type local:RecoveryCodeContentDialog}" />
  </ui:ContentDialog.Resources>

  <StackPanel MaxWidth="520" Margin="0,8,0,0">

    <ui:SymbolIcon Symbol="ShieldKeyhole24"
                   FontSize="48"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,16"
                   Foreground="{DynamicResource SystemAccentColorPrimaryBrush}" />

    <TextBlock Text="{loc:Str Dialog_Recovery_Heading}"
               Style="{StaticResource H1TextStyle}"
               HorizontalAlignment="Center"
               Margin="0,0,0,8" />

    <TextBlock TextWrapping="Wrap"
               TextAlignment="Center"
               Opacity="0.8"
               Margin="0,0,0,16"
               LineHeight="22"
               Text="{loc:Str Dialog_Recovery_Description}" />

    <Border Background="{DynamicResource ControlFillColorDefaultBrush}"
            CornerRadius="8"
            Padding="20"
            Margin="0,0,0,12">
      <TextBlock Text="{Binding RecoveryCode}"
                 FontFamily="Consolas"
                 FontSize="20"
                 FontWeight="Bold"
                 TextAlignment="Center"
                 TextWrapping="Wrap" />
    </Border>

    <ui:Button Content="{loc:Str Enum_CopyToClipboard}"
               Icon="{ui:SymbolIcon Copy24}"
               Command="{Binding CopyRecoveryCodeCommand}"
               AutomationProperties.AutomationId="RecoveryCode_Copy"
               HorizontalAlignment="Center"
               Margin="0,0,0,16" />

    <ui:InfoBar IsOpen="True"
                IsClosable="False"
                Severity="Warning"
                Margin="0,0,0,16"
                Title="{loc:Str Dialog_Recovery_Warning_Title}"
                Message="{loc:Str Dialog_Recovery_Warning_Message}" />

    <CheckBox Content="{loc:Str Dialog_Recovery_Confirm}"
              IsChecked="{Binding HasConfirmedRecoveryCode, Mode=TwoWay}"
              AutomationProperties.AutomationId="RecoveryCode_Confirm"
              HorizontalAlignment="Center" />
  </StackPanel>
</ui:ContentDialog>

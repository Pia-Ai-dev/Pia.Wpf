<ui:ContentDialog x:Class="Pia.Views.Dialogs.VaultHelpContentDialog"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:local="clr-namespace:Pia.Views.Dialogs"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                  xmlns:loc="clr-namespace:Pia.Localization"
                  Title="{loc:Str Memory_Help_Title}"
                  CloseButtonText="{loc:Str Common_Close}"
                  DefaultButton="Close"
                  DialogMaxWidth="600">
  <ui:ContentDialog.Resources>
    <Style BasedOn="{StaticResource {x:Type ui:ContentDialog}}"
           TargetType="{x:Type local:VaultHelpContentDialog}" />
  </ui:ContentDialog.Resources>

  <StackPanel MaxWidth="520" Margin="0,8,0,0">
    <TextBlock Text="{loc:Str Memory_Help_What}"
               FontSize="13"
               TextWrapping="Wrap"
               Foreground="{DynamicResource TextMutedBrush}"/>
    <TextBlock Text="{loc:Str Memory_Help_Auto}"
               FontSize="13"
               TextWrapping="Wrap"
               Margin="0,8,0,0"
               Foreground="{DynamicResource TextMutedBrush}"/>
    <TextBlock Text="{loc:Str Memory_Help_Control}"
               FontSize="13"
               TextWrapping="Wrap"
               Margin="0,8,0,0"
               Foreground="{DynamicResource TextMutedBrush}"/>
    <TextBlock Text="{loc:Str Memory_Help_Search}"
               FontSize="13"
               TextWrapping="Wrap"
               Margin="0,8,0,0"
               Foreground="{DynamicResource TextMutedBrush}"/>
    <TextBlock Text="{loc:Str Memory_Help_Files}"
               FontSize="13"
               TextWrapping="Wrap"
               Margin="0,8,0,0"
               Foreground="{DynamicResource TextMutedBrush}"/>
    <TextBlock Text="{loc:Str Memory_Help_Sources}"
               FontSize="13"
               TextWrapping="Wrap"
               Margin="0,8,0,0"
               Foreground="{DynamicResource TextMutedBrush}"/>

    <ui:HyperlinkButton Command="{Binding OpenVaultFolderCommand}"
                        HorizontalAlignment="Left"
                        Margin="0,12,0,0">
      <StackPanel Orientation="Horizontal">
        <ui:SymbolIcon Symbol="FolderOpen24"
                       FontSize="16"
                       Margin="0,0,6,0"
                       VerticalAlignment="Center"/>
        <TextBlock Text="{loc:Str Memory_OpenFolder}" VerticalAlignment="Center"/>
      </StackPanel>
    </ui:HyperlinkButton>
  </StackPanel>
</ui:ContentDialog>

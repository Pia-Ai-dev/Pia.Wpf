<ui:ContentDialog x:Class="Pia.Views.Dialogs.ReauthenticationContentDialog"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:local="clr-namespace:Pia.Views.Dialogs"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                  xmlns:loc="clr-namespace:Pia.Localization"
                  Title="{loc:Str Reauth_Title}"
                  PrimaryButtonText="{loc:Str Reauth_Confirm}"
                  PrimaryButtonAppearance="Primary"
                  CloseButtonText="{loc:Str Common_Cancel}"
                  DefaultButton="Primary"
                  IsPrimaryButtonEnabled="{Binding CanConfirm}"
                  DialogMaxWidth="480">
  <ui:ContentDialog.Resources>
    <Style BasedOn="{StaticResource {x:Type ui:ContentDialog}}"
           TargetType="{x:Type local:ReauthenticationContentDialog}" />
  </ui:ContentDialog.Resources>

  <StackPanel Margin="0,8,0,0" Width="400">
    <TextBlock Text="{loc:Str Reauth_Intro}"
               TextWrapping="Wrap"
               Foreground="{DynamicResource TextDefaultBrush}"
               Margin="0,0,0,12" />

    <TextBlock Text="{Binding ErrorMessage}"
               AutomationProperties.AutomationId="Reauth_Error"
               TextWrapping="Wrap"
               Foreground="{DynamicResource PiaDangerBrush}"
               Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibilityConverter}}"
               Margin="0,0,0,8" />

    <TextBlock Text="{loc:Str Reauth_Password_Label}"
               FontSize="12"
               Foreground="{DynamicResource TextMutedBrush}"
               Margin="0,0,0,4" />
    <PasswordBox x:Name="PasswordInput"
                 AutomationProperties.AutomationId="Reauth_Password" />

    <StackPanel Visibility="{Binding IsCodeRequired, Converter={StaticResource BooleanToVisibilityConverter}}"
                Margin="0,12,0,0">
      <TextBlock Text="{loc:Str Reauth_Code_Label}"
                 TextWrapping="Wrap"
                 FontSize="12"
                 Foreground="{DynamicResource TextMutedBrush}"
                 Margin="0,0,0,4" />
      <ui:TextBox Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}"
                  AutomationProperties.AutomationId="Reauth_Code" />
    </StackPanel>
  </StackPanel>
</ui:ContentDialog>

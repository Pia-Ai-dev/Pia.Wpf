<ui:ContentDialog x:Class="Pia.Views.Dialogs.MeetingSaveContentDialog"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:local="clr-namespace:Pia.Views.Dialogs"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                  xmlns:loc="clr-namespace:Pia.Localization"
                  Title="{loc:Str MeetingSave_DialogTitle}"
                  PrimaryButtonText="{loc:Str Common_Save}"
                  CloseButtonText="{loc:Str Common_Cancel}"
                  DefaultButton="Primary"
                  IsPrimaryButtonEnabled="{Binding CanSave}"
                  DialogMaxWidth="560"
                  DialogMaxHeight="620">
  <ui:ContentDialog.Resources>
    <Style BasedOn="{StaticResource {x:Type ui:ContentDialog}}"
           TargetType="{x:Type local:MeetingSaveContentDialog}" />
  </ui:ContentDialog.Resources>

  <StackPanel Margin="0,8,0,0" Width="460">
    <TextBlock Text="{loc:Str MeetingSave_Title_Label}"
               FontSize="12"
               Foreground="{DynamicResource TextMutedBrush}"
               Margin="0,0,0,4" />
    <ui:TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                PlaceholderText="{loc:Str MeetingSave_Title_Placeholder}"
                PlaceholderEnabled="True"
                Margin="0,0,0,12" />

    <TextBlock Text="{loc:Str MeetingSave_Attendees_Label}"
               FontSize="12"
               Foreground="{DynamicResource TextMutedBrush}"
               Margin="0,0,0,4" />
    <ui:TextBox Text="{Binding Attendees, UpdateSourceTrigger=PropertyChanged}"
                PlaceholderText="{loc:Str MeetingSave_Attendees_Placeholder}"
                PlaceholderEnabled="True"
                Margin="0,0,0,12" />

    <Grid Margin="0,0,0,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <StackPanel Grid.Column="0" Margin="0,0,6,0">
        <TextBlock Text="{loc:Str MeetingSave_Tags_Label}"
                   FontSize="12"
                   Foreground="{DynamicResource TextMutedBrush}"
                   Margin="0,0,0,4" />
        <ui:TextBox Text="{Binding Tags, UpdateSourceTrigger=PropertyChanged}"
                    PlaceholderText="{loc:Str MeetingSave_Tags_Placeholder}"
                    PlaceholderEnabled="True" />
      </StackPanel>

      <StackPanel Grid.Column="1" Margin="6,0,0,0">
        <TextBlock Text="{loc:Str MeetingSave_Project_Label}"
                   FontSize="12"
                   Foreground="{DynamicResource TextMutedBrush}"
                   Margin="0,0,0,4" />
        <ui:TextBox Text="{Binding Project, UpdateSourceTrigger=PropertyChanged}"
                    PlaceholderText="{loc:Str MeetingSave_Project_Placeholder}"
                    PlaceholderEnabled="True" />
      </StackPanel>
    </Grid>

    <TextBlock Text="{loc:Str MeetingSave_Notes_Label}"
               FontSize="12"
               Foreground="{DynamicResource TextMutedBrush}"
               Margin="0,0,0,4" />
    <ui:TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                PlaceholderText="{loc:Str MeetingSave_Notes_Placeholder}"
                PlaceholderEnabled="True"
                AcceptsReturn="True"
                TextWrapping="Wrap"
                MinHeight="80"
                MaxHeight="160"
                VerticalScrollBarVisibility="Auto"
                Margin="0,0,0,12" />

    <TextBlock Text="{loc:Str MeetingSave_TargetPath_Label}"
               FontSize="12"
               Foreground="{DynamicResource TextMutedBrush}"
               Margin="0,0,0,2" />
    <TextBlock Text="{Binding TargetReference}"
               FontSize="12"
               FontFamily="Consolas"
               TextTrimming="CharacterEllipsis"
               Foreground="{DynamicResource TextDefaultBrush}" />
  </StackPanel>
</ui:ContentDialog>

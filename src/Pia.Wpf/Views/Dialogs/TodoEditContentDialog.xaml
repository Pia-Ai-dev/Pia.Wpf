<ui:ContentDialog x:Class="Pia.Views.Dialogs.TodoEditContentDialog"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:local="clr-namespace:Pia.Views.Dialogs"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                  xmlns:loc="clr-namespace:Pia.Localization"
                  Title="{loc:Str Todo_EditTitle}"
                  PrimaryButtonText="{loc:Str Common_Save}"
                  CloseButtonText="{loc:Str Common_Cancel}"
                  DefaultButton="Primary"
                  IsPrimaryButtonEnabled="True"
                  DialogMaxWidth="520"
                  DialogMaxHeight="560">
  <ui:ContentDialog.Resources>
    <Style BasedOn="{StaticResource {x:Type ui:ContentDialog}}"
           TargetType="{x:Type local:TodoEditContentDialog}" />
  </ui:ContentDialog.Resources>

  <StackPanel Margin="0,8,0,0" Width="420">
    <TextBlock Text="{loc:Str Todo_TitleLabel}"
               FontSize="12"
               Foreground="{DynamicResource TextMutedBrush}"
               Margin="0,0,0,4" />
    <ui:TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                PlaceholderText="{loc:Str Todo_TitlePlaceholder}"
                PlaceholderEnabled="True"
                Margin="0,0,0,12" />

    <TextBlock Text="{loc:Str Todo_NotesLabel}"
               FontSize="12"
               Foreground="{DynamicResource TextMutedBrush}"
               Margin="0,0,0,4" />
    <ui:TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                PlaceholderText="{loc:Str Todo_NotesPlaceholder}"
                PlaceholderEnabled="True"
                AcceptsReturn="True"
                TextWrapping="Wrap"
                MinHeight="80"
                MaxHeight="160"
                VerticalScrollBarVisibility="Auto"
                Margin="0,0,0,12" />

    <Grid Margin="0,0,0,4">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <StackPanel Grid.Column="0" Margin="0,0,6,0">
        <TextBlock Text="{loc:Str Todo_PriorityLabel}"
                   FontSize="12"
                   Foreground="{DynamicResource TextMutedBrush}"
                   Margin="0,0,0,4" />
        <ComboBox ItemsSource="{Binding Priorities}"
                  SelectedItem="{Binding Priority}" />
      </StackPanel>

      <StackPanel Grid.Column="1" Margin="6,0,0,0">
        <TextBlock Text="{loc:Str Todo_DueDateLabel}"
                   FontSize="12"
                   Foreground="{DynamicResource TextMutedBrush}"
                   Margin="0,0,0,4" />
        <DatePicker SelectedDate="{Binding DueDate}" />
      </StackPanel>
    </Grid>
  </StackPanel>
</ui:ContentDialog>

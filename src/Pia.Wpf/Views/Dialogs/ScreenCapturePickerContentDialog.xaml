<ui:ContentDialog x:Class="Pia.Views.Dialogs.ScreenCapturePickerContentDialog"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:local="clr-namespace:Pia.Views.Dialogs"
                  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                  xmlns:loc="clr-namespace:Pia.Localization"
                  Title="{Binding DialogTitle}"
                  PrimaryButtonText="{Binding ConfirmText}"
                  CloseButtonText="{loc:Str Common_Cancel}"
                  DefaultButton="Primary"
                  IsPrimaryButtonEnabled="{Binding CanCapture}"
                  DialogMaxWidth="820"
                  DialogMaxHeight="700">
  <ui:ContentDialog.Resources>
    <Style BasedOn="{StaticResource {x:Type ui:ContentDialog}}"
           TargetType="{x:Type local:ScreenCapturePickerContentDialog}" />
  </ui:ContentDialog.Resources>

  <local:ScreenCapturePickerView />
</ui:ContentDialog>

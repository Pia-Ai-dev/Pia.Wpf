<!-- Style is set explicitly because the app-level one is implicit and keys on the exact type,
     which would leave this subclass untemplated. -->
<controls:OverlayDialogPanel x:Class="Pia.Views.Dialogs.Overlay.AdvancedCreationOverlayPanel"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  xmlns:loc="clr-namespace:Pia.Localization"
  xmlns:sys="clr-namespace:System;assembly=System.Runtime"
  xmlns:behaviors="clr-namespace:Pia.Behaviors"
  xmlns:piacontrols="clr-namespace:Pia.Controls"
  xmlns:controls="clr-namespace:Pia.Views.Controls"
  xmlns:overlay="clr-namespace:Pia.Views.Dialogs.Overlay"
  mc:Ignorable="d"
  Style="{StaticResource {x:Type controls:OverlayDialogPanel}}"
  MinPanelWidth="560"
  MaxPanelWidth="760"
  MaxPanelHeight="880"
  PrimaryButtonText="{Binding PrimaryLabel}"
  IsPrimaryButtonEnabled="{Binding CanPrimary}"
  SecondaryButtonText="{Binding SecondaryLabel}"
  IsSecondaryButtonEnabled="{Binding CanSecondary}"
  CloseButtonText="{loc:Str Common_Cancel}">

  <controls:OverlayDialogPanel.Resources>
    <!-- What DroppedFileImporter can turn into text. Declared per surface, as the other drop targets do:
         the Assistant also takes images, which would insert nothing here. -->
    <sys:String x:Key="DroppableExtensions">.txt,.md,.json,.xml,.yaml,.yml,.csv,.log,.ini,.cs,.js,.ts,.py,.html,.htm,.css,.sql,.sh,.ps1,.bat,.cmd,.toml,.docx,.xlsx,.xlsm,.pdf,.eml,.msg</sys:String>

    <Style TargetType="ContentControl" x:Key="DropHighlight">
      <Setter Property="IsHitTestVisible" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ContentControl">
            <Border CornerRadius="6"
                    BorderThickness="2"
                    BorderBrush="{DynamicResource AccentFillColorDefaultBrush}"
                    Background="{DynamicResource AcrylicBackgroundFillColorBaseBrush}">
              <StackPanel Orientation="Horizontal"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center">
                <ui:SymbolIcon Symbol="ArrowDownload24"
                               FontSize="20"
                               Foreground="{DynamicResource AccentFillColorDefaultBrush}"/>
                <TextBlock Text="{loc:Str FileDrop_Overlay_Hint}"
                           Margin="8,0,0,0"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap"/>
              </StackPanel>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="TextBlock" x:Key="QuestionLabel">
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="Foreground" Value="{DynamicResource TextDefaultBrush}"/>
    </Style>
    <Style TargetType="TextBlock" x:Key="QuestionHelp">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="Margin" Value="0,2,0,0"/>
      <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
    </Style>

    <DataTemplate x:Key="QuestionHeader">
      <StackPanel>
        <TextBlock Text="{Binding Label}" Style="{StaticResource QuestionLabel}"/>
        <TextBlock Text="{Binding Help}"
                   Style="{StaticResource QuestionHelp}"
                   Visibility="{Binding HasHelp, Converter={StaticResource BooleanToVisibilityConverter}}"/>
      </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="TextQuestion">
      <StackPanel Margin="0,0,0,16">
        <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource QuestionHeader}"/>
        <Grid x:Name="DropHost"
              Margin="0,6,0,0"
              behaviors:FileDropBehavior.IsEnabled="True"
              behaviors:FileDropBehavior.AcceptedExtensions="{StaticResource DroppableExtensions}"
              behaviors:FileDropBehavior.FilesDroppedCommand="{Binding FilesDroppedCommand}">
          <ui:TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                      AutomationProperties.AutomationId="{Binding AutomationId, StringFormat='AdvancedCreation_Q_{0}'}"
                      AutomationProperties.Name="{Binding Label}"/>
          <ContentControl Style="{StaticResource DropHighlight}"
                          Visibility="{Binding Path=(behaviors:FileDropBehavior.IsDragOver), ElementName=DropHost, Converter={StaticResource BooleanToVisibilityConverter}}"/>
        </Grid>
      </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="LongTextQuestion">
      <StackPanel Margin="0,0,0,16">
        <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource QuestionHeader}"/>
        <Grid x:Name="DropHost"
              Margin="0,6,0,0"
              behaviors:FileDropBehavior.IsEnabled="True"
              behaviors:FileDropBehavior.AcceptedExtensions="{StaticResource DroppableExtensions}"
              behaviors:FileDropBehavior.FilesDroppedCommand="{Binding FilesDroppedCommand}">
          <ui:TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                      TextWrapping="Wrap"
                      AcceptsReturn="True"
                      MinHeight="80"
                      AutomationProperties.AutomationId="{Binding AutomationId, StringFormat='AdvancedCreation_Q_{0}'}"
                      AutomationProperties.Name="{Binding Label}"/>
          <ContentControl Style="{StaticResource DropHighlight}"
                          Visibility="{Binding Path=(behaviors:FileDropBehavior.IsDragOver), ElementName=DropHost, Converter={StaticResource BooleanToVisibilityConverter}}"/>
        </Grid>
      </StackPanel>
    </DataTemplate>

    <!-- Taller than LongText and monospaced: this one holds pasted source material, not prose about it. -->
    <DataTemplate x:Key="SampleQuestion">
      <StackPanel Margin="0,0,0,16">
        <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource QuestionHeader}"/>
        <Grid x:Name="DropHost"
              Margin="0,6,0,0"
              behaviors:FileDropBehavior.IsEnabled="True"
              behaviors:FileDropBehavior.AcceptedExtensions="{StaticResource DroppableExtensions}"
              behaviors:FileDropBehavior.FilesDroppedCommand="{Binding FilesDroppedCommand}">
          <ui:TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                      TextWrapping="Wrap"
                      AcceptsReturn="True"
                      MinHeight="120"
                      FontFamily="Consolas"
                      FontSize="12"
                      VerticalScrollBarVisibility="Auto"
                      AutomationProperties.AutomationId="{Binding AutomationId, StringFormat='AdvancedCreation_Q_{0}'}"
                      AutomationProperties.Name="{Binding Label}"/>
          <ContentControl Style="{StaticResource DropHighlight}"
                          Visibility="{Binding Path=(behaviors:FileDropBehavior.IsDragOver), ElementName=DropHost, Converter={StaticResource BooleanToVisibilityConverter}}"/>
        </Grid>
      </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="ChoiceQuestion">
      <StackPanel Margin="0,0,0,16">
        <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource QuestionHeader}"/>
        <ComboBox ItemsSource="{Binding Question.Options}"
                  SelectedItem="{Binding SelectedOption}"
                  HorizontalAlignment="Left"
                  MinWidth="260"
                  AutomationProperties.AutomationId="{Binding AutomationId, StringFormat='AdvancedCreation_Q_{0}'}"
                  AutomationProperties.Name="{Binding Label}"
                  Margin="0,6,0,0"/>
      </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="MultiChoiceQuestion">
      <StackPanel Margin="0,0,0,16">
        <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource QuestionHeader}"/>
        <ItemsControl ItemsSource="{Binding Options}" Margin="0,6,0,0">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <CheckBox Content="{Binding Label}"
                        IsChecked="{Binding IsSelected}"
                        AutomationProperties.AutomationId="{Binding Label, StringFormat='AdvancedCreation_Opt_{0}'}"
                        Margin="0,0,0,4"/>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </DataTemplate>

    <overlay:AdvancedCreationQuestionTemplateSelector x:Key="QuestionSelector"
                                                      TextTemplate="{StaticResource TextQuestion}"
                                                      LongTextTemplate="{StaticResource LongTextQuestion}"
                                                      SampleTemplate="{StaticResource SampleQuestion}"
                                                      ChoiceTemplate="{StaticResource ChoiceQuestion}"
                                                      MultiChoiceTemplate="{StaticResource MultiChoiceQuestion}"/>
  </controls:OverlayDialogPanel.Resources>

  <StackPanel>
    <!-- Header: title and the growing turn indicator -->
    <Grid Margin="0,0,0,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0" Orientation="Horizontal">
        <ui:SymbolIcon Symbol="Sparkle24" FontSize="20" VerticalAlignment="Center" Margin="0,0,10,0"/>
        <TextBlock Text="{Binding Title}"
                   FontSize="18"
                   FontWeight="SemiBold"
                   VerticalAlignment="Center"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource TextDefaultBrush}"/>
      </StackPanel>
      <ItemsControl Grid.Column="1"
                    ItemsSource="{Binding Dots}"
                    VerticalAlignment="Center">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Orientation="Horizontal"/>
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Ellipse Width="8" Height="8" Margin="3,0"
                     Fill="{DynamicResource ControlStrongStrokeColorDefaultBrush}">
              <Ellipse.Style>
                <Style TargetType="Ellipse">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding}" Value="True">
                      <Setter Property="Width" Value="10"/>
                      <Setter Property="Height" Value="10"/>
                      <Setter Property="Fill" Value="{DynamicResource SystemAccentColorPrimaryBrush}"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Ellipse.Style>
            </Ellipse>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Grid>

    <!-- What the model has understood so far -->
    <Border Background="{DynamicResource ControlFillColorDefaultBrush}"
            CornerRadius="6"
            Padding="10,8"
            Margin="0,0,0,12"
            Visibility="{Binding HasSummary, Converter={StaticResource BooleanToVisibilityConverter}}">
      <TextBlock Text="{Binding Summary}"
                 FontSize="12"
                 TextWrapping="Wrap"
                 AutomationProperties.AutomationId="AdvancedCreation_Summary"
                 Foreground="{DynamicResource TextSubtleBrush}"/>
    </Border>

    <!-- Inline, not a snackbar or a dialog: the host holds one panel, so anything else evicts this one. -->
    <Border Style="{StaticResource PiaRequiredHintStyle}"
            Margin="0,0,0,12"
            Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
      <StackPanel>
        <TextBlock Text="{Binding ErrorMessage}"
                   AutomationProperties.AutomationId="AdvancedCreation_Error"
                   TextWrapping="Wrap"/>
        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
          <ui:Button Content="{loc:Str AdvancedCreation_Retry}"
                     Appearance="Secondary"
                     Margin="0,0,8,0"
                     AutomationProperties.AutomationId="AdvancedCreation_RetryButton"
                     Command="{Binding RetryCommand}"/>
          <ui:Button Content="{loc:Str Common_Cancel}"
                     Appearance="Secondary"
                     AutomationProperties.AutomationId="AdvancedCreation_DismissError"
                     Command="{Binding DismissErrorCommand}"/>
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- A file that could not be read. Dismiss-only: unlike the error banner above, there is no model turn
         to retry. -->
    <Border Style="{StaticResource PiaRequiredHintStyle}"
            Margin="0,0,0,12"
            Visibility="{Binding HasDropNotice, Converter={StaticResource BooleanToVisibilityConverter}}">
      <StackPanel>
        <TextBlock Text="{Binding DropNotice}"
                   AutomationProperties.AutomationId="AdvancedCreation_DropNotice"
                   TextWrapping="Wrap"/>
        <ui:Button Content="{loc:Str Common_Cancel}"
                   Appearance="Secondary"
                   Margin="0,8,0,0"
                   HorizontalAlignment="Left"
                   AutomationProperties.AutomationId="AdvancedCreation_DismissDropNotice"
                   Command="{Binding DismissDropNoticeCommand}"/>
      </StackPanel>
    </Border>

    <!-- Discard confirmation, for the same reason: Escape cannot raise a second dialog over this one. -->
    <Border Style="{StaticResource PiaRequiredHintStyle}"
            Margin="0,0,0,12"
            Visibility="{Binding IsConfirmingDiscard, Converter={StaticResource BooleanToVisibilityConverter}}">
      <StackPanel>
        <TextBlock Text="{loc:Str AdvancedCreation_DiscardPrompt}"
                   AutomationProperties.AutomationId="AdvancedCreation_DiscardPrompt"
                   TextWrapping="Wrap"/>
        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
          <ui:Button Content="{loc:Str AdvancedCreation_Discard}"
                     Appearance="Secondary"
                     Foreground="{DynamicResource PiaDangerBrush}"
                     Margin="0,0,8,0"
                     AutomationProperties.AutomationId="AdvancedCreation_ConfirmDiscard"
                     Click="OnConfirmDiscard"/>
          <ui:Button Content="{loc:Str AdvancedCreation_KeepEditing}"
                     Appearance="Secondary"
                     AutomationProperties.AutomationId="AdvancedCreation_KeepEditing"
                     Command="{Binding KeepEditingCommand}"/>
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- Opening: the one prompt the whole interview starts from -->
    <StackPanel Visibility="{Binding ShowsOpening, Converter={StaticResource BooleanToVisibilityConverter}}">
      <TextBlock Text="{Binding OpeningLabel}"
                 Style="{StaticResource QuestionLabel}"/>
      <TextBlock Text="{loc:Str AdvancedCreation_OpeningHint}"
                 Style="{StaticResource QuestionHelp}"/>
      <Grid x:Name="OpeningDropHost"
            Margin="0,8,0,0"
            behaviors:FileDropBehavior.IsEnabled="True"
            behaviors:FileDropBehavior.AcceptedExtensions="{StaticResource DroppableExtensions}"
            behaviors:FileDropBehavior.FilesDroppedCommand="{Binding OpeningFilesDroppedCommand}">
        <ui:TextBox x:Name="OpeningBox"
                    Text="{Binding Opening, UpdateSourceTrigger=PropertyChanged}"
                    TextWrapping="Wrap"
                    AcceptsReturn="True"
                    MinHeight="90"
                    AutomationProperties.AutomationId="AdvancedCreation_Opening"/>
        <ContentControl Style="{StaticResource DropHighlight}"
                        Visibility="{Binding Path=(behaviors:FileDropBehavior.IsDragOver), ElementName=OpeningDropHost, Converter={StaticResource BooleanToVisibilityConverter}}"/>
      </Grid>

      <TextBlock Text="{loc:Str AdvancedCreation_Persona}"
                 Style="{StaticResource QuestionLabel}"
                 Margin="0,16,0,0"/>
      <TextBlock Text="{loc:Str AdvancedCreation_Persona_Hint}"
                 Style="{StaticResource QuestionHelp}"/>
      <!-- The Assistant's own picker, item template and all, so one persona list is learned once. -->
      <ComboBox ItemsSource="{Binding AvailablePersonas}"
                SelectedItem="{Binding SelectedPersona, Mode=TwoWay}"
                HorizontalAlignment="Left"
                MinWidth="260"
                MaxWidth="320"
                AutomationProperties.AutomationId="AdvancedCreation_Persona"
                Margin="0,6,0,0">
        <ComboBox.ItemTemplate>
          <DataTemplate>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <piacontrols:PersonaGlyph Grid.Column="0"
                                        PersonaId="{Binding Id}"
                                        Emoji="{Binding Emoji}"
                                        GlyphSize="14"
                                        Margin="0,0,6,0"
                                        VerticalAlignment="Center"/>
              <TextBlock Grid.Column="1"
                         Text="{Binding Name}"
                         VerticalAlignment="Center"
                         TextTrimming="CharacterEllipsis"/>
              <Ellipse Grid.Column="2"
                       Width="10"
                       Height="10"
                       Margin="8,0,0,0"
                       VerticalAlignment="Center"
                       Fill="{Binding AccentColor, Converter={StaticResource HexToBrushConverter}}"
                       Stroke="{DynamicResource BorderBrush_}"
                       StrokeThickness="1"
                       Visibility="{Binding AccentColor, Converter={StaticResource NullToVisibilityConverter}}"
                       ToolTip="{Binding AccentColor}"/>
              <Border Grid.Column="3"
                      Style="{StaticResource PiaLabelChipStyle}"
                      Background="{DynamicResource PiaAccentSoftBrush}"
                      Margin="6,0,0,0"
                      Visibility="{Binding IsManaged, Converter={StaticResource BooleanToVisibilityConverter}}"
                      ToolTip="{loc:Str Personas_ManagedTooltip}">
                <TextBlock Text="{loc:Str Personas_Managed}"
                           FontSize="10.5"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource PiaInkBrush}"/>
              </Border>
            </Grid>
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
    </StackPanel>

    <!-- Asking -->
    <StackPanel Visibility="{Binding ShowsQuestions, Converter={StaticResource BooleanToVisibilityConverter}}">
      <ItemsControl ItemsSource="{Binding Questions}"
                    ItemTemplateSelector="{StaticResource QuestionSelector}"/>
    </StackPanel>

    <!-- Done -->
    <StackPanel Orientation="Horizontal"
                Visibility="{Binding ShowsDone, Converter={StaticResource BooleanToVisibilityConverter}}">
      <ui:SymbolIcon Symbol="CheckmarkCircle24" FontSize="18" Margin="0,0,8,0"
                     Foreground="{DynamicResource PiaSuccessBrush}"/>
      <TextBlock Text="{Binding DoneMessage}"
                 TextWrapping="Wrap"
                 VerticalAlignment="Center"
                 AutomationProperties.AutomationId="AdvancedCreation_DoneMessage"/>
    </StackPanel>

    <!-- Working -->
    <StackPanel Orientation="Horizontal"
                Margin="0,4,0,0"
                Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
      <ui:ProgressRing IsIndeterminate="True" Width="18" Height="18" Margin="0,0,10,0"/>
      <TextBlock Text="{loc:Str AdvancedCreation_Thinking}"
                 VerticalAlignment="Center"
                 AutomationProperties.AutomationId="AdvancedCreation_Thinking"/>
    </StackPanel>
  </StackPanel>
</controls:OverlayDialogPanel>

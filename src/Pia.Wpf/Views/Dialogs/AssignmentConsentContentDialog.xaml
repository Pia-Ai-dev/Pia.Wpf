<ui:ContentDialog x:Class="Pia.Views.Dialogs.AssignmentConsentContentDialog"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:local="clr-namespace:Pia.Views.Dialogs"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                  xmlns:loc="clr-namespace:Pia.Localization"
                  Title="{loc:Str AssignmentConsent_Title}"
                  PrimaryButtonText="{loc:Str AssignmentConsent_Send}"
                  CloseButtonText="{loc:Str Common_Cancel}"
                  DefaultButton="Close"
                  IsPrimaryButtonEnabled="{Binding CanSend}"
                  DialogMaxWidth="620"
                  DialogMaxHeight="760">
  <ui:ContentDialog.Resources>
    <Style BasedOn="{StaticResource {x:Type ui:ContentDialog}}"
           TargetType="{x:Type local:AssignmentConsentContentDialog}" />
  </ui:ContentDialog.Resources>

  <StackPanel Margin="0,8,0,0" Width="520">
    <StackPanel Visibility="{Binding ShowSkillPicker, Converter={StaticResource BooleanToVisibilityConverter}}"
                Margin="0,0,0,12">
      <TextBlock Text="{loc:Str AssignmentConsent_Skill_Label}"
                 FontSize="12"
                 Foreground="{DynamicResource TextMutedBrush}"
                 Margin="0,0,0,4" />
      <ComboBox ItemsSource="{Binding Skills}"
                SelectedItem="{Binding SelectedSkill}"
                DisplayMemberPath="DisplayName"
                HorizontalAlignment="Stretch" />
    </StackPanel>

    <TextBlock Margin="0,0,0,12"
               FontSize="12"
               Foreground="{DynamicResource TextMutedBrush}"
               TextTrimming="CharacterEllipsis">
      <Run Text="{loc:Str AssignmentConsent_Mode_Label}" />
      <Run Text="{Binding SelectedSkill.Mode, Mode=OneWay}" />
    </TextBlock>

    <TextBlock Text="{loc:Str AssignmentConsent_Prompt_Label}"
               FontSize="12"
               Foreground="{DynamicResource TextMutedBrush}"
               Margin="0,0,0,4" />
    <ui:TextBox Text="{Binding Prompt, UpdateSourceTrigger=PropertyChanged}"
                PlaceholderText="{loc:Str AssignmentConsent_Prompt_Placeholder}"
                PlaceholderEnabled="True"
                MaxLength="{Binding PromptMaxLength, Mode=OneTime}"
                AcceptsReturn="True"
                TextWrapping="Wrap"
                MinHeight="72"
                MaxHeight="120"
                VerticalScrollBarVisibility="Auto"
                Margin="0,0,0,14" />

    <TextBlock Text="{loc:Str AssignmentConsent_Records_PromptOnly}"
               Visibility="{Binding IsPromptOnly, Converter={StaticResource BooleanToVisibilityConverter}}"
               FontSize="12"
               TextWrapping="Wrap"
               Foreground="{DynamicResource TextMutedBrush}"
               Margin="0,0,0,12" />

    <Border Background="{DynamicResource SurfaceMutedBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="4"
            Padding="12"
            Margin="0,0,0,12">
      <StackPanel>
        <TextBlock Text="{loc:Str AssignmentConsent_Destination}"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource TextDefaultBrush}" />
        <TextBlock Text="{loc:Str AssignmentConsent_Retention}"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource TextDefaultBrush}"
                   Margin="0,8,0,0" />
        <TextBlock Text="{loc:Str AssignmentConsent_Residual}"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource WarnBrush}"
                   Margin="0,8,0,0" />
      </StackPanel>
    </Border>

    <StackPanel Visibility="{Binding OffersRecords, Converter={StaticResource BooleanToVisibilityConverter}}"
                Margin="0,0,0,12">
      <Grid Margin="0,0,0,6">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0"
                   Text="{loc:Str AssignmentConsent_Records_Label}"
                   FontSize="12"
                   Foreground="{DynamicResource TextMutedBrush}" />
        <TextBlock Grid.Column="1"
                   Text="{Binding SelectionSummary}"
                   FontSize="12"
                   Foreground="{DynamicResource TextSubtleBrush}" />
      </Grid>

      <TextBlock Text="{loc:Str AssignmentConsent_Records_Loading}"
                 Visibility="{Binding IsLoadingRecords, Converter={StaticResource BooleanToVisibilityConverter}}"
                 FontSize="12"
                 Foreground="{DynamicResource TextMutedBrush}" />

      <TextBlock Text="{loc:Str AssignmentConsent_Records_None}"
                 Visibility="{Binding HasNoOfferableRecords, Converter={StaticResource BooleanToVisibilityConverter}}"
                 FontSize="12"
                 TextWrapping="Wrap"
                 Foreground="{DynamicResource TextMutedBrush}" />

      <TextBlock Text="{loc:Str AssignmentConsent_Records_Unavailable}"
                 Visibility="{Binding RecordsUnavailable, Converter={StaticResource BooleanToVisibilityConverter}}"
                 FontSize="12"
                 TextWrapping="Wrap"
                 Foreground="{DynamicResource WarnBrush}" />

      <Border BorderBrush="{DynamicResource BorderBrush}"
              BorderThickness="1"
              CornerRadius="4"
              MaxHeight="220">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <ItemsControl ItemsSource="{Binding Records}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid Margin="8,6">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>

                  <CheckBox Grid.Column="0"
                            IsChecked="{Binding IsSelected}"
                            IsEnabled="{Binding CanSelect}"
                            VerticalAlignment="Top"
                            Margin="0,0,4,0" />

                  <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding Title}"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextDefaultBrush}" />
                    <TextBlock FontSize="11"
                               Foreground="{DynamicResource TextMutedBrush}">
                      <Run Text="{Binding TypeLabel, Mode=OneWay}" />
                      <Run Text="·" />
                      <Run Text="{Binding SizeLabel, Mode=OneWay}" />
                      <Run Text="·" />
                      <Run Text="{Binding UpdatedAt, Mode=OneWay, StringFormat=g}" />
                    </TextBlock>
                    <TextBlock Text="{Binding UnsendableReason}"
                               Visibility="{Binding UnsendableReason, Converter={StaticResource NullToVisibilityConverter}}"
                               FontSize="11"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource PiaDangerBrush}" />
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Border>

      <TextBlock Text="{Binding CapNotice}"
                 Visibility="{Binding CapNotice, Converter={StaticResource NullToVisibilityConverter}}"
                 FontSize="12"
                 TextWrapping="Wrap"
                 Foreground="{DynamicResource WarnBrush}"
                 Margin="0,6,0,0" />
    </StackPanel>

    <CheckBox IsChecked="{Binding IsAffirmed}">
      <TextBlock Text="{loc:Str AssignmentConsent_Affirm}"
                 TextWrapping="Wrap" />
    </CheckBox>
  </StackPanel>
</ui:ContentDialog>

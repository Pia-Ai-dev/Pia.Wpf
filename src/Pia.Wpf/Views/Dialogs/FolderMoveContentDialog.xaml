<ui:ContentDialog x:Class="Pia.Views.Dialogs.FolderMoveContentDialog"
                  xmlns:local="clr-namespace:Pia.Views.Dialogs"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                  xmlns:loc="clr-namespace:Pia.Localization"
                  Title="{loc:Str Dialog_FolderMove_Title}"
                  DefaultButton="None"
                  DialogMaxWidth="420">
  <ui:ContentDialog.Resources>
    <Style BasedOn="{StaticResource {x:Type ui:ContentDialog}}"
           TargetType="{x:Type local:FolderMoveContentDialog}" />
  </ui:ContentDialog.Resources>

  <StackPanel Margin="0,16,0,8" HorizontalAlignment="Stretch">
    <TextBlock x:Name="PhaseText"
               Text="{loc:Str Dialog_FolderMove_Copying}"
               FontSize="16"
               FontWeight="SemiBold"
               TextAlignment="Center"
               Margin="0,0,0,16"/>

    <ProgressBar x:Name="MoveProgressBar"
                 Value="0"
                 Maximum="100"
                 Height="24"
                 Margin="0,0,0,8"/>

    <TextBlock x:Name="PercentText"
               Text="0%"
               Opacity="0.7"
               HorizontalAlignment="Center"/>
  </StackPanel>
</ui:ContentDialog>

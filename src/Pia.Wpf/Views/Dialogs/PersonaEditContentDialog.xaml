<ui:ContentDialog x:Class="Pia.Views.Dialogs.PersonaEditContentDialog"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:local="clr-namespace:Pia.Views.Dialogs"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                  xmlns:loc="clr-namespace:Pia.Localization"
                  xmlns:controls="clr-namespace:Pia.Controls"
                  Title="{loc:Str Dialog_PersonaEdit_Title}"
                  PrimaryButtonText="{loc:Str Common_Save}"
                  CloseButtonText="{loc:Str Common_Cancel}"
                  DefaultButton="Primary"
                  IsPrimaryButtonEnabled="True"
                  DialogMaxWidth="640"
                  DialogMaxHeight="720">
  <ui:ContentDialog.Resources>
    <Style BasedOn="{StaticResource {x:Type ui:ContentDialog}}"
           TargetType="{x:Type local:PersonaEditContentDialog}" />
  </ui:ContentDialog.Resources>

  <!-- The ContentDialog supplies its own scroll viewer (bounded by DialogMaxHeight), so the content
       must NOT add a second one — otherwise two vertical scrollbars stack up. -->
  <StackPanel Margin="0,4,0,0" Width="440">

      <!-- AI-assist: draft from a description -->
      <TextBlock Text="{loc:Str Dialog_PersonaEdit_Describe}"
                 FontWeight="SemiBold"
                 Margin="0,0,0,4" />
      <TextBlock Text="{loc:Str Dialog_PersonaEdit_DescribeHint}"
                 Opacity="0.7"
                 FontSize="12"
                 Margin="0,0,0,8" />
      <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
               TextWrapping="Wrap"
               AcceptsReturn="True"
               Height="64"
               VerticalScrollBarVisibility="Auto"
               IsReadOnly="{Binding IsGenerating}"
               Margin="0,0,0,8" />
      <ui:Button Command="{Binding GenerateDraftCommand}"
                 IsEnabled="{Binding IsGenerating, Converter={StaticResource InverseBooleanConverter}}"
                 Margin="0,0,0,16">
        <Grid>
          <StackPanel Orientation="Horizontal"
                      Visibility="{Binding IsGenerating, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
            <ui:SymbolIcon Symbol="Sparkle24" FontSize="16" Margin="0,0,8,0" />
            <TextBlock Text="{loc:Str Dialog_PersonaEdit_Draft}" />
          </StackPanel>
          <StackPanel Orientation="Horizontal"
                      Visibility="{Binding IsGenerating, Converter={StaticResource BooleanToVisibilityConverter}}">
            <ui:ProgressRing IsIndeterminate="True" Width="16" Height="16" Margin="0,0,8,0" />
            <TextBlock Text="{loc:Str Dialog_PersonaEdit_Drafting}" />
          </StackPanel>
        </Grid>
      </ui:Button>

      <!-- Name -->
      <TextBlock Text="{loc:Str Dialog_PersonaEdit_Name}"
                 FontWeight="SemiBold"
                 Margin="0,0,0,4" />
      <ui:TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                  Margin="0,0,0,16" />

      <!-- Tagline -->
      <TextBlock Text="{loc:Str Dialog_PersonaEdit_Tagline}"
                 FontWeight="SemiBold"
                 Margin="0,0,0,4" />
      <ui:TextBox Text="{Binding Tagline, UpdateSourceTrigger=PropertyChanged}"
                  Margin="0,0,0,16" />

      <!-- System prompt -->
      <TextBlock Text="{loc:Str Dialog_PersonaEdit_SystemPrompt}"
                 FontWeight="SemiBold"
                 Margin="0,0,0,4" />
      <TextBlock Text="{loc:Str Dialog_PersonaEdit_SystemPromptHint}"
                 Opacity="0.7"
                 FontSize="12"
                 Margin="0,0,0,8" />
      <TextBox Text="{Binding SystemPrompt, UpdateSourceTrigger=PropertyChanged}"
               TextWrapping="Wrap"
               AcceptsReturn="True"
               Height="120"
               VerticalScrollBarVisibility="Auto"
               IsReadOnly="{Binding IsGenerating}"
               Margin="0,0,0,16" />

      <!-- Guardrails -->
      <TextBlock Text="{loc:Str Dialog_PersonaEdit_Guardrails}"
                 FontWeight="SemiBold"
                 Margin="0,0,0,4" />
      <TextBlock Text="{loc:Str Dialog_PersonaEdit_GuardrailsHint}"
                 Opacity="0.7"
                 FontSize="12"
                 Margin="0,0,0,8" />
      <TextBox Text="{Binding Guardrails, UpdateSourceTrigger=PropertyChanged}"
               TextWrapping="Wrap"
               AcceptsReturn="True"
               Height="64"
               VerticalScrollBarVisibility="Auto"
               Margin="0,0,0,16" />

      <!-- Archetype + Tool scope -->
      <Grid Margin="0,0,0,16">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="16" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0">
          <TextBlock Text="{loc:Str Dialog_PersonaEdit_Archetype}" FontWeight="SemiBold" Margin="0,0,0,4" />
          <ComboBox ItemsSource="{Binding ArchetypeOptions}"
                    SelectedItem="{Binding Archetype}"
                    HorizontalAlignment="Stretch" />
        </StackPanel>
        <StackPanel Grid.Column="2">
          <TextBlock Text="{loc:Str Dialog_PersonaEdit_ToolScope}" FontWeight="SemiBold" Margin="0,0,0,4" />
          <ComboBox ItemsSource="{Binding ToolScopeOptions}"
                    SelectedItem="{Binding ToolScope}"
                    HorizontalAlignment="Stretch" />
        </StackPanel>
      </Grid>

      <!-- Expertise -->
      <TextBlock Text="{loc:Str Dialog_PersonaEdit_Expertise}"
                 FontWeight="SemiBold"
                 Margin="0,0,0,4" />
      <TextBlock Text="{loc:Str Dialog_PersonaEdit_ExpertiseHint}"
                 Opacity="0.7"
                 FontSize="12"
                 Margin="0,0,0,8" />
      <ui:TextBox Text="{Binding Expertise, UpdateSourceTrigger=PropertyChanged}"
                  Margin="0,0,0,16" />

      <!-- Emoji + accent colour (each opens a popup picker) -->
      <Grid Margin="0,0,0,16">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="16" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Emoji -->
        <StackPanel Grid.Column="0">
          <TextBlock Text="{loc:Str Dialog_PersonaEdit_Emoji}" FontWeight="SemiBold" Margin="0,0,0,4" />
          <ToggleButton x:Name="EmojiToggle"
                        Style="{StaticResource PiaPickerToggleStyle}">
            <Grid>
              <controls:EmojiPresenter Emoji="{Binding Emoji}"
                                       GlyphSize="16"
                                       Visibility="{Binding Emoji, Converter={StaticResource NullToVisibilityConverter}}" />
              <controls:EmojiPresenter Emoji="🙂"
                                       GlyphSize="16"
                                       Opacity="0.4"
                                       Visibility="{Binding Emoji, Converter={StaticResource InverseNullToVisibilityConverter}}" />
            </Grid>
          </ToggleButton>
        </StackPanel>

        <!-- Accent colour -->
        <StackPanel Grid.Column="2">
          <TextBlock Text="{loc:Str Dialog_PersonaEdit_AccentColor}" FontWeight="SemiBold" Margin="0,0,0,4" />
          <ToggleButton x:Name="ColorToggle"
                        Style="{StaticResource PiaPickerToggleStyle}">
            <StackPanel Orientation="Horizontal">
              <Ellipse Width="16" Height="16"
                       Margin="0,0,8,0"
                       StrokeThickness="1"
                       Stroke="{DynamicResource BorderBrush_}"
                       Fill="{Binding AccentColor, Converter={StaticResource HexToBrushConverter}}" />
              <Grid VerticalAlignment="Center">
                <TextBlock Text="{Binding AccentColor}"
                           Visibility="{Binding AccentColor, Converter={StaticResource NullToVisibilityConverter}}" />
                <TextBlock Text="#RRGGBB"
                           Opacity="0.4"
                           Visibility="{Binding AccentColor, Converter={StaticResource InverseNullToVisibilityConverter}}" />
              </Grid>
            </StackPanel>
          </ToggleButton>
        </StackPanel>
      </Grid>

      <!-- Emoji picker popup: custom-entry field + quick-pick grid -->
      <Popup x:Name="EmojiPopup"
             PlacementTarget="{Binding ElementName=EmojiToggle}"
             Placement="Bottom"
             StaysOpen="False"
             AllowsTransparency="True"
             PopupAnimation="Fade"
             IsOpen="{Binding IsChecked, ElementName=EmojiToggle, Mode=TwoWay}">
        <Border Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush_}"
                BorderThickness="1"
                CornerRadius="10"
                Margin="0,6,0,0"
                Padding="10"
                Width="280">
          <Border.Effect>
            <DropShadowEffect Color="#0F1729" Opacity="0.25" BlurRadius="16" ShadowDepth="3" />
          </Border.Effect>
          <StackPanel>
            <ui:TextBox Text="{Binding Emoji, UpdateSourceTrigger=PropertyChanged}"
                        FontFamily="{StaticResource EmojiCapableFontFamily}"
                        MaxLength="8"
                        PlaceholderText="🙂"
                        Margin="0,0,0,8" />
            <ItemsControl ItemsSource="{Binding EmojiChoices}"
                          ButtonBase.Click="OnEmojiPicked">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button Style="{StaticResource PiaEmojiSwatchButtonStyle}"
                          Command="{Binding DataContext.PickEmojiCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                          CommandParameter="{Binding}">
                    <controls:EmojiPresenter Emoji="{Binding}" GlyphSize="20" />
                    <Button.Tag>
                      <MultiBinding Converter="{StaticResource MultiStringEqualsBoolConverter}">
                        <Binding />
                        <Binding Path="DataContext.Emoji" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                      </MultiBinding>
                    </Button.Tag>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
      </Popup>

      <!-- Accent-colour picker popup: swatch grid + custom hex field -->
      <Popup x:Name="ColorPopup"
             PlacementTarget="{Binding ElementName=ColorToggle}"
             Placement="Bottom"
             StaysOpen="False"
             AllowsTransparency="True"
             PopupAnimation="Fade"
             IsOpen="{Binding IsChecked, ElementName=ColorToggle, Mode=TwoWay}">
        <Border Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush_}"
                BorderThickness="1"
                CornerRadius="10"
                Margin="0,6,0,0"
                Padding="10"
                Width="232">
          <Border.Effect>
            <DropShadowEffect Color="#0F1729" Opacity="0.25" BlurRadius="16" ShadowDepth="3" />
          </Border.Effect>
          <StackPanel>
            <ItemsControl ItemsSource="{Binding AccentSwatches}"
                          ButtonBase.Click="OnAccentPicked">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button Style="{StaticResource PiaColorSwatchButtonStyle}"
                          Background="{Binding Converter={StaticResource HexToBrushConverter}}"
                          Command="{Binding DataContext.PickAccentColorCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                          CommandParameter="{Binding}"
                          ToolTip="{Binding}">
                    <Button.Tag>
                      <MultiBinding Converter="{StaticResource MultiStringEqualsBoolConverter}">
                        <Binding />
                        <Binding Path="DataContext.AccentColor" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                      </MultiBinding>
                    </Button.Tag>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <ui:TextBox Text="{Binding AccentColor, UpdateSourceTrigger=PropertyChanged}"
                        MaxLength="7"
                        PlaceholderText="#RRGGBB"
                        Margin="0,8,0,0" />
          </StackPanel>
        </Border>
      </Popup>

      <!-- Preferred provider + reasoning effort -->
      <TextBlock Text="{loc:Str Dialog_PersonaEdit_Provider}"
                 FontWeight="SemiBold"
                 Margin="0,0,0,4" />
      <ComboBox ItemsSource="{Binding ProviderChoices}"
                SelectedItem="{Binding SelectedProvider}"
                DisplayMemberPath="Name"
                HorizontalAlignment="Stretch"
                Margin="0,0,0,16" />

      <TextBlock Text="{loc:Str Dialog_PersonaEdit_ReasoningEffort}"
                 FontWeight="SemiBold"
                 Margin="0,0,0,4" />
      <ComboBox ItemsSource="{Binding ReasoningEffortOptions}"
                SelectedItem="{Binding SelectedReasoningEffort}"
                DisplayMemberPath="Display"
                HorizontalAlignment="Stretch" />
  </StackPanel>
</ui:ContentDialog>

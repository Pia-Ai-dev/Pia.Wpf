<UserControl x:Class="Pia.Views.Dialogs.ScreenCapturePickerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:loc="clr-namespace:Pia.Localization"
             xmlns:vm="clr-namespace:Pia.ViewModels.Models"
             PreviewKeyDown="Picker_PreviewKeyDown">
  <UserControl.Resources>
    <Style x:Key="ScreenCaptureTargetCardStyle" TargetType="RadioButton">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="Bd"
                    CornerRadius="{StaticResource SmallRadius}"
                    Padding="8"
                    Background="{DynamicResource SurfaceMutedBrush}"
                    BorderBrush="Transparent"
                    BorderThickness="2">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource ControlElevationBorderBrush}" />
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource PiaAccentBrush}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <DataTemplate x:Key="ScreenCaptureTargetTemplate" DataType="{x:Type vm:ScreenCaptureTargetViewModel}">
      <RadioButton x:Name="TargetCard"
                   GroupName="ScreenCapturePickerTarget"
                   Style="{StaticResource ScreenCaptureTargetCardStyle}"
                   Width="232"
                   Margin="0,0,8,8"
                   GotKeyboardFocus="TargetCard_GotKeyboardFocus"
                   IsChecked="{Binding IsSelected, Mode=TwoWay}"
                   IsEnabled="{Binding IsMinimized, Converter={StaticResource InverseBooleanConverter}}"
                   AutomationProperties.Name="{Binding Label}"
                   AutomationProperties.AutomationId="{Binding AutomationKey, StringFormat='ScreenCapturePicker_Target_{0}'}">
        <StackPanel>
          <Border Height="126"
                  CornerRadius="{StaticResource SmallRadius}"
                  Background="{DynamicResource SurfaceSunkBrush}">
            <Grid>
              <Image Source="{Binding Thumbnail}" Stretch="Uniform" Margin="4" />
              <ui:ProgressRing IsIndeterminate="True"
                               Width="20"
                               Height="20"
                               Visibility="{Binding IsPreviewPending, Converter={StaticResource BooleanToVisibilityConverter}}" />
              <TextBlock Text="{Binding PreviewHint}"
                         TextWrapping="Wrap"
                         TextAlignment="Center"
                         FontSize="11"
                         Margin="8"
                         VerticalAlignment="Center"
                         Foreground="{DynamicResource TextMutedBrush}"
                         Visibility="{Binding PreviewHint, Converter={StaticResource NullToVisibilityConverter}}" />
            </Grid>
          </Border>
          <TextBlock Text="{Binding Label}"
                     TextTrimming="CharacterEllipsis"
                     FontWeight="SemiBold"
                     Margin="0,6,0,0"
                     Foreground="{DynamicResource TextDefaultBrush}" />
          <TextBlock Text="{Binding Detail}"
                     FontSize="11"
                     Foreground="{DynamicResource TextMutedBrush}" />
        </StackPanel>
      </RadioButton>
    </DataTemplate>
  </UserControl.Resources>

  <Grid Width="740" MinHeight="320" MaxHeight="520">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" Margin="0,0,0,10">
      <TextBlock Text="{Binding Hint}"
                 TextWrapping="Wrap"
                 FontSize="12"
                 Foreground="{DynamicResource TextMutedBrush}"
                 Margin="0,0,56,0" />
      <ui:Button HorizontalAlignment="Right"
                 VerticalAlignment="Top"
                 Appearance="Secondary"
                 Padding="6,4"
                 Command="{Binding RefreshCommand}"
                 AutomationProperties.Name="{loc:Str Common_Refresh}"
                 AutomationProperties.AutomationId="ScreenCapturePicker_Refresh"
                 ToolTip="{loc:Str Common_Refresh}">
        <ui:SymbolIcon Symbol="ArrowSync24" FontSize="14" />
      </ui:Button>
    </Grid>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <TextBlock Text="{loc:Str ScreenCapturePicker_Loading}"
                   Foreground="{DynamicResource TextMutedBrush}"
                   Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}" />
        <TextBlock Text="{loc:Str ScreenCapturePicker_Empty}"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource TextMutedBrush}"
                   Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}" />

        <TextBlock Text="{loc:Str ScreenCapturePicker_Monitors}"
                   Style="{StaticResource PiaSettingsSectionLabelStyle}"
                   Visibility="{Binding HasMonitors, Converter={StaticResource BooleanToVisibilityConverter}}" />
        <ItemsControl x:Name="MonitorList"
                      ItemsSource="{Binding MonitorTargets}"
                      ItemTemplate="{StaticResource ScreenCaptureTargetTemplate}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
        </ItemsControl>

        <TextBlock Text="{loc:Str ScreenCapturePicker_Windows}"
                   Style="{StaticResource PiaSettingsSectionLabelStyle}"
                   Margin="0,8,0,6"
                   Visibility="{Binding HasWindows, Converter={StaticResource BooleanToVisibilityConverter}}" />
        <ItemsControl x:Name="WindowList"
                      ItemsSource="{Binding WindowTargets}"
                      ItemTemplate="{StaticResource ScreenCaptureTargetTemplate}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>

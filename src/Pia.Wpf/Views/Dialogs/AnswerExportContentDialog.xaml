<ui:ContentDialog x:Class="Pia.Views.Dialogs.AnswerExportContentDialog"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:local="clr-namespace:Pia.Views.Dialogs"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                  xmlns:loc="clr-namespace:Pia.Localization"
                  Title="{loc:Str AnswerExport_DialogTitle}"
                  PrimaryButtonText="{loc:Str AnswerExport_StoreInVault}"
                  SecondaryButtonText="{loc:Str AnswerExport_External}"
                  CloseButtonText="{loc:Str Common_Cancel}"
                  DefaultButton="Primary"
                  IsPrimaryButtonEnabled="{Binding CanSave}"
                  IsSecondaryButtonEnabled="{Binding CanSave}"
                  DialogMaxWidth="520">
  <ui:ContentDialog.Resources>
    <Style BasedOn="{StaticResource {x:Type ui:ContentDialog}}"
           TargetType="{x:Type local:AnswerExportContentDialog}" />
  </ui:ContentDialog.Resources>

  <StackPanel Margin="0,8,0,0" Width="440">
    <TextBlock Text="{loc:Str AnswerExport_FileName_Label}"
               FontSize="12"
               Foreground="{DynamicResource TextMutedBrush}"
               Margin="0,0,0,4" />
    <ui:TextBox Text="{Binding FileName, UpdateSourceTrigger=PropertyChanged}"
                PlaceholderText="{loc:Str AnswerExport_FileName_Placeholder}"
                PlaceholderEnabled="True"
                AutomationProperties.AutomationId="AnswerExport_FileName"
                Margin="0,0,0,12" />

    <CheckBox Content="{loc:Str AnswerExport_OpenAfterStorage}"
              IsChecked="{Binding OpenAfterStorage}"
              AutomationProperties.AutomationId="AnswerExport_OpenAfterStorage"
              Margin="0,0,0,12" />

    <!-- The two buttons write different formats to different places; nothing on them says so. -->
    <TextBlock Text="{loc:Str AnswerExport_Destinations_Hint}"
               FontSize="12"
               TextWrapping="Wrap"
               Foreground="{DynamicResource TextMutedBrush}" />
  </StackPanel>
</ui:ContentDialog>

<UserControl x:Class="Pia.Views.LiveTranscriptionOverlay"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  xmlns:loc="clr-namespace:Pia.Localization"
  xmlns:models="clr-namespace:Pia.Models"
  xmlns:controls="clr-namespace:Pia.Views.Controls"
  mc:Ignorable="d"
  d:DesignHeight="500" d:DesignWidth="600">

  <Grid Background="{DynamicResource ApplicationBackgroundBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Header: title + close button -->
    <Border Grid.Row="0"
            BorderThickness="0,0,0,1"
            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
            Padding="20,12">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0"
                    Orientation="Vertical"
                    VerticalAlignment="Center">
          <TextBlock Text="{loc:Str LiveTrans_Title}"
                     FontSize="16"
                     FontWeight="SemiBold" />
          <TextBlock Text="{Binding StatusText}"
                     FontSize="12"
                     Margin="0,2,0,0"
                     Foreground="{DynamicResource TextPlaceholderColorBrush}" />
          <Border Margin="0,4,0,0"
                  Padding="8,2"
                  CornerRadius="8"
                  HorizontalAlignment="Left"
                  Background="{DynamicResource ControlFillColorSecondaryBrush}"
                  BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                  BorderThickness="1">
            <Border.Style>
              <Style TargetType="Border">
                <Setter Property="Visibility" Value="Visible" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding ConsentBadge}" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Border.Style>
            <TextBlock Text="{Binding ConsentBadge}"
                       FontSize="11"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
          </Border>
        </StackPanel>

        <ui:Button Grid.Column="1"
                   Command="{Binding CloseCommand}"
                   Width="36"
                   Height="36"
                   Padding="0"
                   Appearance="Secondary"
                   ToolTip="{loc:Str LiveTrans_Close}">
          <ui:SymbolIcon Symbol="Dismiss24" FontSize="14" />
        </ui:Button>
      </Grid>
    </Border>

    <!-- Disclaimer panel (visible until the user accepts and starts) -->
    <Border Grid.Row="1"
            Padding="32,24"
            Visibility="{Binding IsDisclaimerVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
      <StackPanel MaxWidth="480"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center">
        <ui:SymbolIcon Symbol="Info24"
                       FontSize="32"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,12" />
        <TextBlock Text="{loc:Str LiveTrans_Disclaimer_Title}"
                   FontSize="18"
                   FontWeight="SemiBold"
                   TextAlignment="Center"
                   Margin="0,0,0,8" />
        <TextBlock Text="{loc:Str LiveTrans_Disclaimer_Body}"
                   FontSize="13"
                   TextWrapping="Wrap"
                   TextAlignment="Center"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   Margin="0,0,0,20" />
        <ui:ToggleSwitch Content="{loc:Str LiveTrans_Disclaimer_Accept}"
                         IsChecked="{Binding DisclaimerAccepted}"
                         HorizontalAlignment="Center"
                         Margin="0,0,0,16" />
        <TextBlock Text="{loc:Str LiveTrans_Status_Preparing}"
                   FontSize="11"
                   HorizontalAlignment="Center"
                   Foreground="{DynamicResource TextPlaceholderColorBrush}"
                   Margin="0,0,0,12"
                   Visibility="{Binding IsPreparing, Converter={StaticResource BooleanToVisibilityConverter}}" />
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Center">
          <ui:Button Command="{Binding CloseCommand}"
                     Padding="20,10"
                     Margin="0,0,8,0"
                     Appearance="Secondary"
                     Icon="{ui:SymbolIcon Dismiss24}"
                     Content="{loc:Str LiveTrans_Close}" />
          <ui:Button Command="{Binding StartCommand}"
                     Padding="20,10"
                     Appearance="Primary"
                     Icon="{ui:SymbolIcon Play24}"
                     Content="{loc:Str LiveTrans_Start}" />
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- Bubble list -->
    <ScrollViewer x:Name="BubbleScroll"
                  Grid.Row="1"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="20,16,20,8"
                  Visibility="{Binding IsDisclaimerVisible, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
      <ItemsControl ItemsSource="{Binding Bubbles}">
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="{x:Type models:TranscriptBubble}">
            <Grid Margin="0,0,0,10">
              <!-- "You" (right-aligned, accent) -->
              <StackPanel HorizontalAlignment="Right"
                          MaxWidth="{Binding ActualWidth, ElementName=BubbleScroll, Converter={StaticResource MultiplyConverter}, ConverterParameter=0.65}">
                <StackPanel.Style>
                  <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding Speaker}" Value="{x:Static models:TranscriptSpeaker.You}">
                        <Setter Property="Visibility" Value="Visible" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </StackPanel.Style>
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,0,4,2">
                  <TextBlock Text="{Binding StartTimestamp, Converter={StaticResource DateTimeOffsetToShortTimeConverter}}"
                             FontSize="11"
                             Margin="0,0,8,0"
                             Foreground="{DynamicResource TextPlaceholderColorBrush}" />
                  <TextBlock FontSize="11"
                             Foreground="{DynamicResource TextPlaceholderColorBrush}">
                    <TextBlock.Text>
                      <MultiBinding Converter="{StaticResource SpeakerToDisplayNameConverter}">
                        <Binding Path="Speaker" />
                        <Binding Path="SpeakerLabel" />
                      </MultiBinding>
                    </TextBlock.Text>
                  </TextBlock>
                </StackPanel>
                <Border Padding="12,8"
                        CornerRadius="12,12,0,12"
                        Background="{DynamicResource AccentFillColorDefaultBrush}">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="{Binding Text}"
                               TextWrapping="Wrap"
                               FontSize="14"
                               Foreground="White" />
                    <controls:ListeningIndicator Grid.Column="1"
                                                 Margin="8,0,0,0"
                                                 VerticalAlignment="Center"
                                                 Visibility="{Binding IsListening, Converter={StaticResource BooleanToVisibilityConverter}}" />
                  </Grid>
                </Border>
              </StackPanel>

              <!-- "Them" (left-aligned, secondary) -->
              <StackPanel HorizontalAlignment="Left"
                          MaxWidth="{Binding ActualWidth, ElementName=BubbleScroll, Converter={StaticResource MultiplyConverter}, ConverterParameter=0.65}">
                <StackPanel.Style>
                  <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding Speaker}" Value="{x:Static models:TranscriptSpeaker.Them}">
                        <Setter Property="Visibility" Value="Visible" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </StackPanel.Style>
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Left"
                            Margin="4,0,0,2">
                  <ui:Button Padding="4,2"
                             Margin="-4,-2,4,-2"
                             Appearance="Transparent"
                             BorderThickness="0"
                             Cursor="Hand"
                             ToolTip="{loc:Str LiveTrans_RenameSpeaker_MenuItem}"
                             Command="{Binding DataContext.RenameSpeakerLabelCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                             CommandParameter="{Binding SpeakerLabel}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                      <TextBlock FontSize="11"
                                 VerticalAlignment="Center"
                                 Foreground="{DynamicResource TextPlaceholderColorBrush}">
                        <TextBlock.Text>
                          <MultiBinding Converter="{StaticResource SpeakerToDisplayNameConverter}">
                            <Binding Path="Speaker" />
                            <Binding Path="SpeakerLabel" />
                          </MultiBinding>
                        </TextBlock.Text>
                      </TextBlock>
                      <ui:SymbolIcon Symbol="Edit24"
                                     FontSize="11"
                                     Margin="4,0,0,0"
                                     VerticalAlignment="Center"
                                     Foreground="{DynamicResource TextPlaceholderColorBrush}" />
                    </StackPanel>
                  </ui:Button>
                  <TextBlock Text="{Binding StartTimestamp, Converter={StaticResource DateTimeOffsetToShortTimeConverter}}"
                             FontSize="11"
                             VerticalAlignment="Center"
                             Foreground="{DynamicResource TextPlaceholderColorBrush}" />
                </StackPanel>
                <Border Padding="12,8"
                        CornerRadius="12,12,12,0">
                  <Border.Style>
                    <Style TargetType="Border">
                      <Setter Property="Background" Value="{DynamicResource SpeakerBubbleBackground1Brush}" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding ColorIndex}" Value="1">
                          <Setter Property="Background" Value="{DynamicResource SpeakerBubbleBackground2Brush}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ColorIndex}" Value="2">
                          <Setter Property="Background" Value="{DynamicResource SpeakerBubbleBackground3Brush}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ColorIndex}" Value="3">
                          <Setter Property="Background" Value="{DynamicResource SpeakerBubbleBackground4Brush}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ColorIndex}" Value="4">
                          <Setter Property="Background" Value="{DynamicResource SpeakerBubbleBackground5Brush}" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Border.Style>
                  <Border.ContextMenu>
                    <ContextMenu>
                      <MenuItem Header="{loc:Str LiveTrans_RenameSpeaker_MenuItem}"
                                Command="{Binding PlacementTarget.Tag.RenameSpeakerLabelCommand,
                                           RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                CommandParameter="{Binding PlacementTarget.DataContext.SpeakerLabel,
                                                    RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                    </ContextMenu>
                  </Border.ContextMenu>
                  <Border.Tag>
                    <Binding Path="DataContext" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                  </Border.Tag>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="{Binding Text}"
                               TextWrapping="Wrap"
                               FontSize="14" />
                    <controls:ListeningIndicator Grid.Column="1"
                                                 Margin="8,0,0,0"
                                                 VerticalAlignment="Center"
                                                 Visibility="{Binding IsListening, Converter={StaticResource BooleanToVisibilityConverter}}" />
                  </Grid>
                </Border>
              </StackPanel>
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <!-- Footer: stop / save+resume buttons (hidden during the disclaimer) -->
    <Border Grid.Row="2"
            BorderThickness="0,1,0,0"
            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
            Padding="20,12"
            Visibility="{Binding IsDisclaimerVisible, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
      <StackPanel HorizontalAlignment="Center"
                  Orientation="Horizontal">
        <ui:Button Command="{Binding CloseCommand}"
                   Margin="0,0,8,0"
                   Padding="20,10"
                   Appearance="Secondary"
                   Icon="{ui:SymbolIcon Dismiss24}"
                   Content="{loc:Str LiveTrans_Close}" />
        <ui:Button Command="{Binding StopCommand}"
                   Padding="20,10"
                   Appearance="Danger"
                   Icon="{ui:SymbolIcon Stop24}"
                   Content="{loc:Str LiveTrans_Stop}"
                   Visibility="{Binding IsRunning, Converter={StaticResource BooleanToVisibilityConverter}}" />
        <ui:Button Command="{Binding SaveTranscriptCommand}"
                   Margin="0,0,8,0"
                   Padding="20,10"
                   Appearance="Secondary"
                   Icon="{ui:SymbolIcon Save24}"
                   Content="{loc:Str LiveTrans_Save}"
                   Visibility="{Binding IsRunning, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
        <ui:Button Command="{Binding SaveAndSummarizeCommand}"
                   Margin="0,0,8,0"
                   Padding="20,10"
                   Appearance="Primary"
                   Icon="{ui:SymbolIcon Sparkle24}"
                   Content="{loc:Str LiveTrans_SaveAndSummarize}"
                   Visibility="{Binding IsRunning, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
        <ui:Button Command="{Binding StartCommand}"
                   Padding="20,10"
                   Appearance="Primary"
                   Icon="{ui:SymbolIcon Play24}"
                   Content="{loc:Str LiveTrans_Resume}"
                   Visibility="{Binding IsRunning, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>

<UserControl x:Class="Pia.Views.Settings.SecurityModeSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Pia.Localization"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
  <StackPanel>
    <TextBlock Text="{loc:Str SecurityMode_Title}"
               FontWeight="SemiBold"
               FontSize="16"
               Margin="0,0,0,8"/>
    <TextBlock Text="{loc:Str SecurityMode_Description}"
               Opacity="0.7"
               FontSize="12"
               TextWrapping="Wrap"
               Margin="0,0,0,12"/>

    <ui:Card Padding="12" Margin="0,0,0,8">
      <StackPanel>
        <RadioButton GroupName="SecurityMode"
                     IsChecked="{Binding IsStrictSelected, Mode=TwoWay}"
                     Content="{loc:Str SecurityMode_Strict}"
                     FontWeight="SemiBold"/>
        <TextBlock Text="{loc:Str SecurityMode_Strict_Description}"
                   Opacity="0.7" FontSize="12" TextWrapping="Wrap" Margin="22,2,0,0"/>
      </StackPanel>
    </ui:Card>

    <ui:Card Padding="12" Margin="0,0,0,8">
      <StackPanel>
        <RadioButton GroupName="SecurityMode"
                     IsChecked="{Binding IsStandardSelected, Mode=TwoWay}"
                     Content="{loc:Str SecurityMode_Standard}"
                     FontWeight="SemiBold"/>
        <TextBlock Text="{loc:Str SecurityMode_Standard_Description}"
                   Opacity="0.7" FontSize="12" TextWrapping="Wrap" Margin="22,2,0,0"/>
      </StackPanel>
    </ui:Card>

    <ui:Card Padding="12" Margin="0,0,0,8">
      <StackPanel>
        <RadioButton GroupName="SecurityMode"
                     IsChecked="{Binding IsPermissiveSelected, Mode=TwoWay}"
                     Content="{loc:Str SecurityMode_Permissive}"
                     FontWeight="SemiBold"/>
        <TextBlock Text="{loc:Str SecurityMode_Permissive_Description}"
                   Opacity="0.7" FontSize="12" TextWrapping="Wrap" Margin="22,2,0,0"/>
      </StackPanel>
    </ui:Card>
  </StackPanel>
</UserControl>

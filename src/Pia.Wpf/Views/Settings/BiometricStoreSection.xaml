<UserControl x:Class="Pia.Views.Settings.BiometricStoreSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
  <StackPanel>
    <TextBlock Text="Gespeicherte Stimmprofile"
               FontWeight="SemiBold"
               FontSize="16"
               Margin="0,0,0,8"/>
    <TextBlock Text="Stimmen, deren Sprecher der dauerhaften Speicherung zugestimmt haben (Phase 5, max. 12 Monate)."
               Opacity="0.7"
               FontSize="12"
               TextWrapping="Wrap"
               Margin="0,0,0,12"/>

    <Button Content="Alle gespeicherten Stimmen löschen"
            Command="{Binding DeleteAllCommand}"
            HorizontalAlignment="Left"
            Margin="0,0,0,12"/>

    <TextBlock Text="Keine gespeicherten Stimmprofile."
               Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibilityConverter}}"
               Opacity="0.7"
               FontStyle="Italic"
               Margin="0,0,0,12"/>

    <ItemsControl ItemsSource="{Binding Entries}">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <ui:Card Padding="12" Margin="0,0,0,8">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0">
                <TextBox Text="{Binding DisplayName, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                         FontWeight="SemiBold"
                         BorderThickness="0"
                         Background="Transparent"/>
                <TextBlock Margin="0,4,0,0" FontSize="11" Opacity="0.7">
                  <Run Text="Erteilt:"/>
                  <Run Text="{Binding GrantedAt, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}"/>
                  <Run Text="  ·  Läuft ab:"/>
                  <Run Text="{Binding ExpiresAt, StringFormat='{}{0:yyyy-MM-dd}'}"/>
                  <Run Text="  ·  Prompt:"/>
                  <Run Text="{Binding PromptVersionHash}"/>
                </TextBlock>
              </StackPanel>
              <Button Grid.Column="1"
                      Content="Löschen"
                      Command="{Binding DataContext.DeleteCommand,
                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                      CommandParameter="{Binding}"
                      VerticalAlignment="Center"/>
            </Grid>
          </ui:Card>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </StackPanel>
</UserControl>

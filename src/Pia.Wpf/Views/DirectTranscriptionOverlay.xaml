<UserControl x:Class="Pia.Views.DirectTranscriptionOverlay"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  xmlns:loc="clr-namespace:Pia.Localization"
  xmlns:models="clr-namespace:Pia.Models"
  xmlns:vmmodels="clr-namespace:Pia.ViewModels.Models"
  xmlns:controls="clr-namespace:Pia.Views.Controls"
  mc:Ignorable="d"
  d:DesignHeight="700" d:DesignWidth="900">

  <Grid Background="{DynamicResource ApplicationBackgroundBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Header: title + status + stats toggle + close. -->
    <Border Grid.Row="0"
            BorderThickness="0,0,0,1"
            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
            Padding="20,12">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0"
                    Orientation="Vertical"
                    VerticalAlignment="Center">
          <TextBlock Text="{loc:Str DirectTrans_Title}"
                     FontSize="16"
                     FontWeight="SemiBold" />
          <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
            <TextBlock Text="{Binding StatusText}"
                       FontSize="12"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource TextPlaceholderColorBrush}" />
            <!-- Microphone voice activity. Lives in the header rather than on a bubble so activity can be
                 shown without materializing an empty bubble for speech that may produce no text at all. -->
            <controls:ListeningIndicator Margin="8,0,0,0"
                                         VerticalAlignment="Center"
                                         Visibility="{Binding IsMicListening, Converter={StaticResource BooleanToVisibilityConverter}}" />
          </StackPanel>
        </StackPanel>

        <ui:Button Grid.Column="1"
                   Command="{Binding ToggleStatsCommand}"
                   Width="36"
                   Height="36"
                   Padding="0"
                   Margin="0,0,8,0"
                   Appearance="Secondary"
                   ToolTip="{loc:Str DirectTrans_Stats_Toggle_Tooltip}"
                   Visibility="{Binding IsDisclaimerVisible, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
          <ui:SymbolIcon Symbol="TaskListSquareLtr24" FontSize="14" />
        </ui:Button>

        <ui:Button Grid.Column="2"
                   Command="{Binding CloseCommand}"
                   Width="36"
                   Height="36"
                   Padding="0"
                   Appearance="Secondary"
                   ToolTip="{loc:Str DirectTrans_Close}">
          <ui:SymbolIcon Symbol="Dismiss24" FontSize="14" />
        </ui:Button>
      </Grid>
    </Border>

    <!-- Disclaimer panel (visible until the user accepts and starts). -->
    <Border Grid.Row="1"
            Padding="32,24"
            Visibility="{Binding IsDisclaimerVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="560"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
          <ui:SymbolIcon Symbol="Info24"
                         FontSize="32"
                         HorizontalAlignment="Center"
                         Margin="0,0,0,12" />
          <TextBlock Text="{loc:Str DirectTrans_Disclaimer_Title}"
                     FontSize="18"
                     FontWeight="SemiBold"
                     TextAlignment="Center"
                     Margin="0,0,0,8" />
          <TextBlock Text="{loc:Str DirectTrans_Disclaimer_Body}"
                     FontSize="13"
                     TextWrapping="Wrap"
                     TextAlignment="Center"
                     Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                     Margin="0,0,0,10" />
          <TextBlock Text="{loc:Str DirectTrans_Disclaimer_ConsentExplainer}"
                     FontSize="13"
                     TextWrapping="Wrap"
                     TextAlignment="Center"
                     Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                     Margin="0,0,0,10" />
          <TextBlock Text="{loc:Str DirectTrans_Disclaimer_CrossTalkLimitation}"
                     FontSize="12"
                     TextWrapping="Wrap"
                     TextAlignment="Center"
                     Foreground="{DynamicResource TextPlaceholderColorBrush}"
                     Margin="0,0,0,6" />
          <TextBlock Text="{loc:Str DirectTrans_Disclaimer_ShortUtteranceLimitation}"
                     FontSize="12"
                     TextWrapping="Wrap"
                     TextAlignment="Center"
                     Foreground="{DynamicResource TextPlaceholderColorBrush}"
                     Margin="0,0,0,16" />

          <!-- The consent sentence a participant can say, shown in all three supported languages so the
               host can read it aloud or share it (design §3.9). -->
          <Border Background="{DynamicResource ControlFillColorSecondaryBrush}"
                  BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                  BorderThickness="1"
                  CornerRadius="8"
                  Padding="14,10"
                  Margin="0,0,0,16">
            <StackPanel>
              <TextBlock Text="{loc:Str DirectTrans_Disclaimer_ConsentSentence_Heading}"
                         FontSize="11"
                         FontWeight="SemiBold"
                         Margin="0,0,0,6"
                         Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
              <TextBlock Text="{loc:Str DirectTrans_Disclaimer_ConsentSentence_En}"
                         FontSize="12"
                         TextWrapping="Wrap"
                         FontStyle="Italic"
                         Margin="0,0,0,4" />
              <TextBlock Text="{loc:Str DirectTrans_Disclaimer_ConsentSentence_De}"
                         FontSize="12"
                         TextWrapping="Wrap"
                         FontStyle="Italic"
                         Margin="0,0,0,4" />
              <TextBlock Text="{loc:Str DirectTrans_Disclaimer_ConsentSentence_Fr}"
                         FontSize="12"
                         TextWrapping="Wrap"
                         FontStyle="Italic" />
            </StackPanel>
          </Border>

          <ui:ToggleSwitch Content="{loc:Str DirectTrans_Disclaimer_Accept}"
                           IsChecked="{Binding DisclaimerAccepted}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,16" />
          <TextBlock Text="{loc:Str DirectTrans_Status_Preparing}"
                     FontSize="11"
                     HorizontalAlignment="Center"
                     Foreground="{DynamicResource TextPlaceholderColorBrush}"
                     Margin="0,0,0,12"
                     Visibility="{Binding IsPreparing, Converter={StaticResource BooleanToVisibilityConverter}}" />
          <StackPanel Orientation="Horizontal"
                      HorizontalAlignment="Center">
            <ui:Button Command="{Binding CloseCommand}"
                       Padding="20,10"
                       Margin="0,0,8,0"
                       Appearance="Secondary"
                       Icon="{ui:SymbolIcon Dismiss24}"
                       Content="{loc:Str DirectTrans_Close}" />
            <ui:Button Command="{Binding StartCommand}"
                       Padding="20,10"
                       Appearance="Primary"
                       Icon="{ui:SymbolIcon Mic24}"
                       Content="{loc:Str DirectTrans_Start}" />
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </Border>

    <!-- Body: consent chips bar + bubble list (hidden while the disclaimer shows). -->
    <Grid Grid.Row="1"
          Visibility="{Binding IsDisclaimerVisible, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <!-- Per-speaker consent chips: one per detected loopback speaker, muted while awaiting consent,
           accented once granted (design §3.9 — replaces the old single global consent badge). -->
      <ItemsControl Grid.Row="0"
                    ItemsSource="{Binding ConsentChips}"
                    Margin="20,10,20,0"
                    Visibility="{Binding ConsentChips.Count, Converter={StaticResource IntToVisibilityConverter}}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel Orientation="Horizontal" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="{x:Type vmmodels:SpeakerConsentChip}">
            <Border Padding="10,5"
                    Margin="0,0,8,8"
                    CornerRadius="12"
                    BorderThickness="1"
                    Cursor="Hand"
                    ToolTip="{Binding StatusText}">
              <Border.Style>
                <Style TargetType="Border">
                  <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                  <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsConsented}" Value="True">
                      <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                      <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Border.Style>
              <Border.ContextMenu>
                <ContextMenu>
                  <MenuItem Header="{loc:Str DirectTrans_RenameSpeaker_MenuItem}"
                            Command="{Binding PlacementTarget.Tag.RenameSpeakerLabelCommand,
                                       RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                            CommandParameter="{Binding PlacementTarget.DataContext.SpeakerLabel,
                                                RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                  <MenuItem Header="{loc:Str DirectTrans_RevokeSpeaker_MenuItem}"
                            Command="{Binding PlacementTarget.Tag.RevokeSpeakerCommand,
                                       RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                            CommandParameter="{Binding PlacementTarget.DataContext.SpeakerLabel,
                                                RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                </ContextMenu>
              </Border.ContextMenu>
              <Border.Tag>
                <Binding Path="DataContext" RelativeSource="{RelativeSource AncestorType=UserControl}" />
              </Border.Tag>
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding DisplayName}"
                           FontSize="12"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock">
                      <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsConsented}" Value="True">
                          <Setter Property="Foreground" Value="White" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
                <ui:SymbolIcon Symbol="CheckmarkCircle20"
                               FontSize="12"
                               Margin="6,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="White"
                               Visibility="{Binding IsConsented, Converter={StaticResource BooleanToVisibilityConverter}}" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <!-- Voice-stats flyout: floats above the bubble list; toggled from the header button. -->
      <Border Grid.Row="0" Grid.RowSpan="2"
              HorizontalAlignment="Right"
              VerticalAlignment="Top"
              Margin="0,8,20,0"
              Padding="14,10"
              MinWidth="220"
              CornerRadius="8"
              Background="{DynamicResource SurfaceBrush}"
              BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
              BorderThickness="1"
              Panel.ZIndex="1"
              Visibility="{Binding AreStatsVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
          <StackPanel>
            <TextBlock Text="{loc:Str DirectTrans_Stats_Title}"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Margin="0,0,0,8" />
            <ItemsControl ItemsSource="{Binding VoiceStats}">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type models:SpeakerVoiceStats}">
                  <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal">
                      <TextBlock FontSize="12">
                        <TextBlock.Text>
                          <MultiBinding Converter="{StaticResource SpeakerToDisplayNameConverter}">
                            <Binding Path="Speaker" />
                            <Binding Path="SpeakerLabel" />
                            <Binding Path="DataContext.CounterpartName"
                                     RelativeSource="{RelativeSource AncestorType=UserControl}" />
                          </MultiBinding>
                        </TextBlock.Text>
                      </TextBlock>
                    </StackPanel>
                    <TextBlock Grid.Column="1"
                               FontSize="11"
                               Foreground="{DynamicResource TextMutedBrush}"
                               Text="{Binding TotalSpeechSeconds, StringFormat={}{0:0.#}s}" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
      </Border>

      <!-- Bubble list. -->
      <ScrollViewer x:Name="BubbleScroll"
                    Grid.Row="1"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled"
                    Padding="20,12,20,8">
        <ItemsControl ItemsSource="{Binding Bubbles}">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type models:TranscriptBubble}">
              <Grid Margin="0,0,0,10">
                <!-- "Me" (the local microphone side; right-aligned, accent). -->
                <StackPanel HorizontalAlignment="Right"
                            MaxWidth="{Binding ActualWidth, ElementName=BubbleScroll, Converter={StaticResource MultiplyConverter}, ConverterParameter=0.65}">
                  <StackPanel.Style>
                    <Style TargetType="StackPanel">
                      <Setter Property="Visibility" Value="Collapsed" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding Speaker}" Value="{x:Static models:TranscriptSpeaker.You}">
                          <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </StackPanel.Style>
                  <StackPanel Orientation="Horizontal"
                              HorizontalAlignment="Right"
                              Margin="0,0,4,2">
                    <TextBlock Text="{Binding StartTimestamp, Converter={StaticResource DateTimeOffsetToShortTimeConverter}}"
                               FontSize="11"
                               Margin="0,0,8,0"
                               Foreground="{DynamicResource TextPlaceholderColorBrush}" />
                    <TextBlock FontSize="11"
                               Foreground="{DynamicResource TextPlaceholderColorBrush}">
                      <TextBlock.Text>
                        <MultiBinding Converter="{StaticResource SpeakerToDisplayNameConverter}">
                          <Binding Path="Speaker" />
                          <Binding Path="SpeakerLabel" />
                          <Binding Path="DataContext.CounterpartName"
                                   RelativeSource="{RelativeSource AncestorType=UserControl}" />
                        </MultiBinding>
                      </TextBlock.Text>
                    </TextBlock>
                  </StackPanel>
                  <Border Padding="12,8"
                          CornerRadius="12,12,0,12"
                          Background="{DynamicResource AccentFillColorDefaultBrush}">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Grid.Column="0"
                                 Text="{Binding Text}"
                                 TextWrapping="Wrap"
                                 FontSize="14"
                                 Foreground="White" />
                      <controls:ListeningIndicator Grid.Column="1"
                                                   Margin="8,0,0,0"
                                                   VerticalAlignment="Center"
                                                   Visibility="{Binding IsListening, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </Grid>
                  </Border>
                </StackPanel>

                <!-- Consented loopback speaker (left-aligned, per-speaker colour). Unconsented speakers
                     never reach this template — the forward loop drops their utterances before they
                     ever become a bubble. -->
                <StackPanel HorizontalAlignment="Left"
                            MaxWidth="{Binding ActualWidth, ElementName=BubbleScroll, Converter={StaticResource MultiplyConverter}, ConverterParameter=0.65}">
                  <StackPanel.Style>
                    <Style TargetType="StackPanel">
                      <Setter Property="Visibility" Value="Collapsed" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding Speaker}" Value="{x:Static models:TranscriptSpeaker.Them}">
                          <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </StackPanel.Style>
                  <StackPanel Orientation="Horizontal"
                              HorizontalAlignment="Left"
                              Margin="4,0,0,2">
                    <!-- CRITICAL: this MultiBinding needs all THREE bindings (Speaker, SpeakerLabel,
                         CounterpartName) — with only two, Convert returns string.Empty and every name
                         silently renders blank. -->
                    <ui:Button Padding="4,2"
                               Margin="-4,-2,4,-2"
                               Appearance="Transparent"
                               BorderThickness="0"
                               Cursor="Hand"
                               ToolTip="{loc:Str DirectTrans_RenameSpeaker_MenuItem}"
                               Command="{Binding DataContext.RenameSpeakerLabelCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                               CommandParameter="{Binding SpeakerLabel}">
                      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock FontSize="11"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextPlaceholderColorBrush}">
                          <TextBlock.Text>
                            <MultiBinding Converter="{StaticResource SpeakerToDisplayNameConverter}">
                              <Binding Path="Speaker" />
                              <Binding Path="SpeakerLabel" />
                              <Binding Path="DataContext.CounterpartName"
                                       RelativeSource="{RelativeSource AncestorType=UserControl}" />
                            </MultiBinding>
                          </TextBlock.Text>
                        </TextBlock>
                        <ui:SymbolIcon Symbol="Edit24"
                                       FontSize="11"
                                       Margin="4,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextPlaceholderColorBrush}" />
                      </StackPanel>
                    </ui:Button>
                    <TextBlock Text="{Binding StartTimestamp, Converter={StaticResource DateTimeOffsetToShortTimeConverter}}"
                               FontSize="11"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextPlaceholderColorBrush}" />
                  </StackPanel>
                  <Border Padding="12,8"
                          CornerRadius="12,12,12,0">
                    <!-- Per-speaker colouring MUST live in the Style (default Setter + ColorIndex
                         DataTriggers) — a local Background attribute would override the triggers and
                         silently force one colour for every bubble. -->
                    <Border.Style>
                      <Style TargetType="Border">
                        <Setter Property="Background" Value="{DynamicResource SpeakerBubbleBackground1Brush}" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding ColorIndex}" Value="1">
                            <Setter Property="Background" Value="{DynamicResource SpeakerBubbleBackground2Brush}" />
                          </DataTrigger>
                          <DataTrigger Binding="{Binding ColorIndex}" Value="2">
                            <Setter Property="Background" Value="{DynamicResource SpeakerBubbleBackground3Brush}" />
                          </DataTrigger>
                          <DataTrigger Binding="{Binding ColorIndex}" Value="3">
                            <Setter Property="Background" Value="{DynamicResource SpeakerBubbleBackground4Brush}" />
                          </DataTrigger>
                          <DataTrigger Binding="{Binding ColorIndex}" Value="4">
                            <Setter Property="Background" Value="{DynamicResource SpeakerBubbleBackground5Brush}" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Border.Style>
                    <Border.ContextMenu>
                      <ContextMenu>
                        <MenuItem Header="{loc:Str DirectTrans_RenameSpeaker_MenuItem}"
                                  Command="{Binding PlacementTarget.Tag.RenameSpeakerLabelCommand,
                                             RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding PlacementTarget.DataContext.SpeakerLabel,
                                                      RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        <MenuItem Header="{loc:Str DirectTrans_RevokeSpeaker_MenuItem}"
                                  Command="{Binding PlacementTarget.Tag.RevokeSpeakerCommand,
                                             RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding PlacementTarget.DataContext.SpeakerLabel,
                                                      RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                      </ContextMenu>
                    </Border.ContextMenu>
                    <Border.Tag>
                      <Binding Path="DataContext" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                    </Border.Tag>
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Grid.Column="0"
                                 Text="{Binding Text}"
                                 TextWrapping="Wrap"
                                 FontSize="14"
                                 Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                      <controls:ListeningIndicator Grid.Column="1"
                                                   Margin="8,0,0,0"
                                                   VerticalAlignment="Center"
                                                   Visibility="{Binding IsListening, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </Grid>
                  </Border>
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Grid>

    <!-- Footer: Stop / Resume / Save / Save to vault / Save & Summarize (hidden during the disclaimer). -->
    <Border Grid.Row="2"
            BorderThickness="0,1,0,0"
            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
            Padding="20,12"
            Visibility="{Binding IsDisclaimerVisible, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
      <StackPanel HorizontalAlignment="Center"
                  Orientation="Horizontal">
        <ui:Button Command="{Binding CloseCommand}"
                   Margin="0,0,8,0"
                   Padding="20,10"
                   Appearance="Secondary"
                   Icon="{ui:SymbolIcon Dismiss24}"
                   Content="{loc:Str DirectTrans_Close}" />
        <ui:Button Command="{Binding StopCommand}"
                   Margin="0,0,8,0"
                   Padding="20,10"
                   Appearance="Danger"
                   Icon="{ui:SymbolIcon Stop24}"
                   Content="{loc:Str DirectTrans_Stop}"
                   Visibility="{Binding IsRunning, Converter={StaticResource BooleanToVisibilityConverter}}" />
        <ui:Button Command="{Binding ResumeCommand}"
                   Margin="0,0,8,0"
                   Padding="20,10"
                   Appearance="Primary"
                   Icon="{ui:SymbolIcon Play24}"
                   Content="{loc:Str DirectTrans_Resume}"
                   Visibility="{Binding IsRunning, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
        <ui:Button Command="{Binding SaveTranscriptCommand}"
                   Margin="0,0,8,0"
                   Padding="20,10"
                   Appearance="Secondary"
                   Icon="{ui:SymbolIcon Save24}"
                   Content="{loc:Str DirectTrans_Save}"
                   Visibility="{Binding IsRunning, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
        <ui:Button Command="{Binding SaveToVaultCommand}"
                   Margin="0,0,8,0"
                   Padding="20,10"
                   Appearance="Secondary"
                   Icon="{ui:SymbolIcon BookAdd24}"
                   Content="{loc:Str DirectTrans_SaveToVault}"
                   Visibility="{Binding IsRunning, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
        <ui:Button Command="{Binding SummarizeWithAssistantCommand}"
                   Padding="20,10"
                   Appearance="Primary"
                   Icon="{ui:SymbolIcon Sparkle24}"
                   Content="{loc:Str DirectTrans_SaveAndSummarize}"
                   Visibility="{Binding IsRunning, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>

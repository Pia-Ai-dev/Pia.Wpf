<UserControl x:Class="Pia.Views.MemoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:mem="clr-namespace:Pia.Controls.Memory"
             xmlns:loc="clr-namespace:Pia.Localization"
             xmlns:nav="clr-namespace:Pia.Navigation"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1200"
             nav:ViewModelLocator.AutoWireViewModel="True">
  <Grid Background="Transparent">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <mem:PiaMemoryHeader Grid.Row="0" Margin="24,20,24,14"/>

    <!-- Capped like the MeetingAttendeeOverlay requirements card — an unconstrained
         full-width strip of 12px prose reads wrong on a wide window. -->
    <mem:PiaMemoryHelpCard Grid.Row="1"
                           Margin="24,0,24,14"
                           MaxWidth="560"
                           HorizontalAlignment="Left"
                           Visibility="{Binding IsHelpVisible, Converter={StaticResource BooleanToVisibilityConverter}}"/>

    <mem:PiaMemorySearchBar Grid.Row="2"
                            Margin="24,0,24,14"
                            Query="{Binding SearchQuery, Mode=TwoWay}"/>

    <Grid Grid.Row="3" Margin="24,0,24,14">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="420"/>
        <ColumnDefinition Width="14"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
        <Grid>
          <ui:ProgressRing IsIndeterminate="True"
                           Width="40" Height="40"
                           VerticalAlignment="Top"
                           HorizontalAlignment="Center"
                           Margin="0,60,0,0"
                           Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"/>

          <StackPanel HorizontalAlignment="Center"
                      VerticalAlignment="Top"
                      Margin="0,60,0,0"
                      Visibility="{Binding MemoryGroups.Count, Converter={StaticResource ZeroToVisibilityConverter}}">
            <ui:SymbolIcon Symbol="BrainCircuit24"
                           FontSize="48"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,16"
                           Foreground="{DynamicResource TextSubtleBrush}"/>
            <TextBlock Text="{loc:Str Memory_EmptyState}"
                       FontSize="14"
                       HorizontalAlignment="Center"
                       Foreground="{DynamicResource TextMutedBrush}"/>
            <TextBlock Text="{loc:Str Memory_EmptyStateHint}"
                       FontSize="12"
                       HorizontalAlignment="Center"
                       Margin="0,4,0,0"
                       Foreground="{DynamicResource TextSubtleBrush}"/>
          </StackPanel>

          <ItemsControl ItemsSource="{Binding MemoryGroups}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Vertical"/>
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <mem:PiaMemoryCategoryCard Margin="0,0,0,10"/>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Grid>
      </ScrollViewer>

      <mem:PiaMemoryInspector Grid.Column="2"
                              DataContext="{Binding SelectedMemory}"
                              Visibility="{Binding RelativeSource={RelativeSource Self},
                                                   Path=DataContext,
                                                   Converter={StaticResource NullToVisibilityConverter}}"/>

      <!-- No selection + non-empty vault: composition-by-category overview (inherits the MemoryViewModel
           DataContext, so it binds VaultComposition). -->
      <mem:PiaVaultOverview Grid.Column="2"
                            Visibility="{Binding IsVaultOverviewVisible,
                                                 Converter={StaticResource BooleanToVisibilityConverter}}"/>

      <!-- No selection + empty vault: the plain placeholder. -->
      <mem:PiaInspectorEmptyState Grid.Column="2"
                                  Visibility="{Binding IsInspectorPlaceholderVisible,
                                                       Converter={StaticResource BooleanToVisibilityConverter}}"/>
    </Grid>

    <mem:PiaMemoryStatusBar Grid.Row="4"/>
  </Grid>
</UserControl>

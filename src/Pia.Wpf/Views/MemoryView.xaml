<UserControl x:Class="Pia.Views.MemoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mem="clr-namespace:Pia.Controls.Memory"
             xmlns:shared="clr-namespace:Pia.Controls.Shared"
             xmlns:loc="clr-namespace:Pia.Localization"
             xmlns:nav="clr-namespace:Pia.Navigation"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1200"
             nav:ViewModelLocator.AutoWireViewModel="True">
  <Grid Background="Transparent">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <mem:PiaMemoryHeader Grid.Row="0" Margin="24,20,24,14"/>

    <mem:PiaMemorySearchBar Grid.Row="1"
                            Margin="24,0,24,14"
                            Query="{Binding SearchQuery, Mode=TwoWay}"
                            IsBusy="{Binding IsLoading}"/>

    <Grid Grid.Row="2" Margin="24,0,24,14">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="420"/>
        <ColumnDefinition Width="14"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
        <Grid>
          <shared:PiaEmptyState Symbol="BrainCircuit24"
                                IconBrush="{DynamicResource TextSubtleBrush}"
                                Title="{loc:Str Memory_EmptyState}"
                                Hint="{loc:Str Memory_EmptyStateHint}"
                                Visibility="{Binding MemoryGroups.Count, Converter={StaticResource ZeroToVisibilityConverter}}"/>

          <ItemsControl ItemsSource="{Binding MemoryGroups}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Vertical"/>
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <mem:PiaMemoryCategoryCard Margin="0,0,0,10"/>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Grid>
      </ScrollViewer>

      <mem:PiaMemoryInspector Grid.Column="2"
                              DataContext="{Binding SelectedMemory}"
                              Visibility="{Binding RelativeSource={RelativeSource Self},
                                                   Path=DataContext,
                                                   Converter={StaticResource NullToVisibilityConverter}}"/>

      <!-- No selection + non-empty vault: composition-by-category overview (inherits the MemoryViewModel
           DataContext, so it binds VaultComposition). -->
      <mem:PiaVaultOverview Grid.Column="2"
                            Visibility="{Binding IsVaultOverviewVisible,
                                                 Converter={StaticResource BooleanToVisibilityConverter}}"/>

      <!-- No selection + empty vault: the plain placeholder. -->
      <mem:PiaInspectorEmptyState Grid.Column="2"
                                  Visibility="{Binding IsInspectorPlaceholderVisible,
                                                       Converter={StaticResource BooleanToVisibilityConverter}}"/>
    </Grid>

    <mem:PiaMemoryStatusBar Grid.Row="3"/>
  </Grid>
</UserControl>

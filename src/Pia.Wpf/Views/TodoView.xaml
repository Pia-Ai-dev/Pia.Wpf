<UserControl x:Class="Pia.Views.TodoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:Pia.Views"
             xmlns:loc="clr-namespace:Pia.Localization"
             xmlns:models="clr-namespace:Pia.Models"
             xmlns:nav="clr-namespace:Pia.Navigation"
             xmlns:behaviors="clr-namespace:Pia.Behaviors"
             xmlns:vm="clr-namespace:Pia.ViewModels.Models"
             xmlns:todo="clr-namespace:Pia.Controls.Todo"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1100"
             nav:ViewModelLocator.AutoWireViewModel="True">

  <UserControl.Resources>
    <Style x:Key="PriorityDotStyle" TargetType="Ellipse">
      <Setter Property="Width" Value="10" />
      <Setter Property="Height" Value="10" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,0,8,0" />
      <Setter Property="Fill" Value="{DynamicResource TextSubtleBrush}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding Priority}" Value="{x:Static models:TodoPriority.High}">
          <Setter Property="Fill" Value="{DynamicResource TodoPriorityHighBrush}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Priority}" Value="{x:Static models:TodoPriority.Medium}">
          <Setter Property="Fill" Value="{DynamicResource TodoPriorityMediumBrush}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Priority}" Value="{x:Static models:TodoPriority.Low}">
          <Setter Property="Fill" Value="{DynamicResource TodoPriorityLowBrush}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="ColumnResizeThumbStyle" TargetType="Thumb">
      <Setter Property="Width" Value="6"/>
      <Setter Property="Cursor" Value="SizeWE"/>
      <Setter Property="HorizontalAlignment" Value="Right"/>
      <Setter Property="VerticalAlignment" Value="Stretch"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Thumb">
            <Border Background="Transparent">
              <Rectangle x:Name="GripLine"
                         Width="1"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Stretch"
                         Margin="0,12"
                         Fill="Transparent"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="GripLine" Property="Fill" Value="{DynamicResource BorderStrongBrush}"/>
              </Trigger>
              <Trigger Property="IsDragging" Value="True">
                <Setter TargetName="GripLine" Property="Fill" Value="{DynamicResource BorderStrongBrush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>

  <Grid Background="Transparent">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <todo:PiaTodoHeader Grid.Row="0" Margin="24,20,24,14"/>

    <todo:PiaTodoSearchBar Grid.Row="1"
                          Margin="24,0,24,12"
                          Query="{Binding SearchQuery, Mode=TwoWay}"/>

    <Border Grid.Row="2" Margin="24,0,24,12">
      <ProgressBar Value="{Binding ProgressPercentage}"
                   Maximum="100"
                   Minimum="0"
                   Height="4"
                   Background="{DynamicResource SurfaceMutedBrush}"
                   Foreground="{DynamicResource PiaAccentBrush}"
                   BorderThickness="0"/>
    </Border>

    <Grid Grid.Row="3" Margin="24,0,24,14">
      <ui:ProgressRing IsIndeterminate="True"
                       Width="40" Height="40"
                       Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}" />

      <ScrollViewer HorizontalScrollBarVisibility="Auto"
                    VerticalScrollBarVisibility="Disabled"
                    Padding="0">
        <ItemsControl ItemsSource="{Binding Columns}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal"/>
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type vm:KanbanColumnViewModel}">
              <Grid>
                <Border x:Name="ClosedCollapsedBorder"
                        Width="44"
                        Margin="0,0,12,0"
                        Background="{DynamicResource SurfaceMutedBrush}"
                        BorderBrush="{DynamicResource BorderBrush_}"
                        BorderThickness="1"
                        CornerRadius="9"
                        Cursor="Hand"
                        MouseLeftButtonUp="OnClosedColumnClick"
                        AllowDrop="True"
                        DragEnter="OnClosedCollapsedDragEnter"
                        DragOver="OnClosedCollapsedDragOver"
                        DragLeave="OnClosedCollapsedDragLeave"
                        Drop="OnClosedCollapsedDrop"
                        Tag="{Binding}"
                        Visibility="Collapsed">
                  <StackPanel VerticalAlignment="Center"
                              HorizontalAlignment="Center">
                    <TextBlock Text="CLOSED"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSubtleBrush}"
                               RenderTransformOrigin="0.5,0.5">
                      <TextBlock.LayoutTransform>
                        <RotateTransform Angle="90"/>
                      </TextBlock.LayoutTransform>
                    </TextBlock>
                    <Border Background="{DynamicResource PiaAccentBrush}"
                            CornerRadius="9"
                            Padding="6,2"
                            Margin="0,8,0,0"
                            HorizontalAlignment="Center">
                      <TextBlock Text="{Binding Todos.Count}"
                                 FontSize="10"
                                 Foreground="White"
                                 HorizontalAlignment="Center"/>
                    </Border>
                  </StackPanel>
                </Border>

                <Border x:Name="ColumnBorder"
                        Width="{Binding Width, Mode=TwoWay}"
                        MinWidth="200"
                        MaxWidth="600"
                        Margin="0,0,12,0"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush_}"
                        BorderThickness="1"
                        CornerRadius="9">
                  <Grid>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Padding="12,10"
                            BorderBrush="{DynamicResource BorderBrush_}"
                            BorderThickness="0,0,0,1">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto"/>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="Auto"/>
                          <ColumnDefinition Width="Auto"/>
                          <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="&#x2605;"
                                   FontSize="12"
                                   Foreground="{DynamicResource WarnBrush}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,6,0">
                          <TextBlock.Style>
                            <Style TargetType="TextBlock">
                              <Setter Property="Visibility" Value="Collapsed"/>
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDefaultView}" Value="True">
                                  <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </TextBlock.Style>
                        </TextBlock>

                        <TextBlock Grid.Column="1"
                                   Text="{Binding Name}"
                                   FontWeight="SemiBold"
                                   FontSize="14"
                                   Foreground="{DynamicResource TextDefaultBrush}"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>

                        <Border Grid.Column="2"
                                Background="{DynamicResource SurfaceMutedBrush}"
                                CornerRadius="10"
                                Padding="8,2"
                                Margin="6,0"
                                VerticalAlignment="Center">
                          <TextBlock Text="{Binding Todos.Count}"
                                     FontSize="11"
                                     Foreground="{DynamicResource TextMutedBrush}"
                                     HorizontalAlignment="Center"/>
                        </Border>

                        <ui:Button Grid.Column="3"
                                   Appearance="Transparent"
                                   Padding="4"
                                   FontSize="14"
                                   VerticalAlignment="Center"
                                   Click="OnColumnMenuClick">
                          <ui:Button.Style>
                            <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                              <Setter Property="Visibility" Value="Visible"/>
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding IsClosedColumn}" Value="True">
                                  <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </ui:Button.Style>
                          <ui:SymbolIcon Symbol="MoreHorizontal24" FontSize="14"/>
                          <ui:Button.ContextMenu>
                            <ContextMenu>
                              <MenuItem Header="{loc:Str Kanban_SetDefault}"
                                        Click="OnSetDefaultColumnClick"
                                        Tag="{Binding}"/>
                              <MenuItem Header="{loc:Str Kanban_RenameColumn}"
                                        Click="OnRenameColumnClick"
                                        Tag="{Binding}"/>
                              <Separator/>
                              <MenuItem Header="{loc:Str Kanban_DeleteColumn}"
                                        Click="OnDeleteColumnClick"
                                        Tag="{Binding}"/>
                            </ContextMenu>
                          </ui:Button.ContextMenu>
                        </ui:Button>

                        <ui:Button x:Name="CollapseButton"
                                   Grid.Column="4"
                                   Appearance="Transparent"
                                   Padding="4"
                                   Click="OnCollapseClosedClick">
                          <ui:Button.Style>
                            <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                              <Setter Property="Visibility" Value="Collapsed"/>
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding IsClosedColumn}" Value="True">
                                  <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </ui:Button.Style>
                          <ui:SymbolIcon Symbol="ChevronRight24" FontSize="14"/>
                        </ui:Button>
                      </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Padding="6">
                      <Grid MinHeight="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
                        <ItemsControl ItemsSource="{Binding Todos}"
                                      Background="Transparent"
                                      Loaded="OnColumnTodoListLoaded"
                                      behaviors:KanbanDragDropBehavior.IsEnabled="True"
                                      behaviors:KanbanDragDropBehavior.ColumnId="{Binding Id}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:TodoItem}">
                              <Border x:Name="TodoCardBorder"
                                      Margin="0,0,0,6"
                                      Padding="10,8"
                                      Background="{DynamicResource SurfaceMutedBrush}"
                                      BorderBrush="{DynamicResource BorderBrush_}"
                                      BorderThickness="1"
                                      CornerRadius="6"
                                      Opacity="0">
                                <Border.Triggers>
                                  <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard>
                                      <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                         From="0" To="1" Duration="0:0:0.2">
                                          <DoubleAnimation.EasingFunction>
                                            <CubicEase EasingMode="EaseOut"/>
                                          </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                      </Storyboard>
                                    </BeginStoryboard>
                                  </EventTrigger>
                                </Border.Triggers>
                                <Grid>
                                  <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                  </Grid.ColumnDefinitions>

                                  <CheckBox Grid.Column="0"
                                            VerticalAlignment="Center"
                                            Margin="0,0,6,0"
                                            Loaded="OnTodoCheckBoxLoaded"
                                            Checked="OnTodoCheckBoxChecked"
                                            Unchecked="OnTodoCheckBoxUnchecked"
                                            Tag="{Binding}">
                                    <CheckBox.RenderTransform>
                                      <ScaleTransform ScaleX="1" ScaleY="1"/>
                                    </CheckBox.RenderTransform>
                                  </CheckBox>

                                  <Ellipse Grid.Column="1"
                                           Style="{StaticResource PriorityDotStyle}"/>

                                  <StackPanel Grid.Column="2"
                                              VerticalAlignment="Center">
                                    <Grid>
                                      <TextBlock x:Name="TodoTitle"
                                                 Text="{Binding Title}"
                                                 FontSize="13"
                                                 Foreground="{DynamicResource TextDefaultBrush}"
                                                 TextTrimming="CharacterEllipsis"/>
                                      <Line x:Name="StrikethroughLine"
                                            Y1="0.5" Y2="0.5"
                                            X1="0" X2="0"
                                            Stroke="{DynamicResource TextSubtleBrush}"
                                            StrokeThickness="1.5"
                                            VerticalAlignment="Center"
                                            Stretch="None"
                                            Visibility="Collapsed"/>
                                    </Grid>
                                    <TextBlock Text="{Binding Notes}"
                                               FontSize="10"
                                               TextTrimming="CharacterEllipsis"
                                               MaxHeight="14"
                                               Foreground="{DynamicResource TextSubtleBrush}"
                                               ToolTip="{Binding Notes}"
                                               Margin="0,2,0,0">
                                      <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                          <Setter Property="Visibility" Value="Collapsed"/>
                                          <Style.Triggers>
                                            <DataTrigger Binding="{Binding Notes, Converter={StaticResource StringNotNullOrEmptyToBoolConverter}}" Value="True">
                                              <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                          </Style.Triggers>
                                        </Style>
                                      </TextBlock.Style>
                                    </TextBlock>
                                    <StackPanel Orientation="Horizontal"
                                                Margin="0,2,0,0">
                                      <TextBlock FontSize="10"
                                                 Foreground="{DynamicResource TextSubtleBrush}">
                                        <TextBlock.Style>
                                          <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                              <DataTrigger Binding="{Binding DueDate, Converter={StaticResource NullToBoolConverter}}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                              </DataTrigger>
                                            </Style.Triggers>
                                          </Style>
                                        </TextBlock.Style>
                                        <Run Text="{loc:Str Todo_DuePrefix}"/>
                                        <Run Text="{Binding DueDate, StringFormat='{}{0:d}', Mode=OneWay}"/>
                                      </TextBlock>
                                    </StackPanel>
                                  </StackPanel>

                                  <StackPanel Grid.Column="3"
                                              Orientation="Horizontal"
                                              VerticalAlignment="Center">
                                    <ui:Button Appearance="Transparent"
                                               Padding="3"
                                               ToolTip="{loc:Str Todo_Edit}"
                                               Command="{Binding DataContext.StartEditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                               CommandParameter="{Binding}">
                                      <ui:Button.Style>
                                        <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                          <Setter Property="Opacity" Value="0"/>
                                          <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMouseOver, ElementName=TodoCardBorder}" Value="True">
                                              <Setter Property="Opacity" Value="1"/>
                                            </DataTrigger>
                                          </Style.Triggers>
                                        </Style>
                                      </ui:Button.Style>
                                      <ui:SymbolIcon Symbol="Edit24" FontSize="12"/>
                                    </ui:Button>

                                    <ui:Button Appearance="Transparent"
                                               Padding="3"
                                               ToolTip="{loc:Str Todo_Delete}"
                                               Command="{Binding DataContext.DeleteTodoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                               CommandParameter="{Binding}">
                                      <ui:Button.Style>
                                        <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                          <Setter Property="Opacity" Value="0"/>
                                          <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMouseOver, ElementName=TodoCardBorder}" Value="True">
                                              <Setter Property="Opacity" Value="1"/>
                                            </DataTrigger>
                                          </Style.Triggers>
                                        </Style>
                                      </ui:Button.Style>
                                      <ui:SymbolIcon Symbol="Delete24" FontSize="12"/>
                                    </ui:Button>
                                  </StackPanel>
                                </Grid>
                              </Border>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </Grid>
                    </ScrollViewer>

                    <Thumb Grid.RowSpan="2"
                           Style="{StaticResource ColumnResizeThumbStyle}"
                           DragDelta="OnColumnResizeThumbDragDelta"
                           DataContext="{Binding}"/>
                  </Grid>
                </Border>
              </Grid>
              <DataTemplate.Triggers>
                <MultiDataTrigger>
                  <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsClosedColumn}" Value="True"/>
                    <Condition Binding="{Binding IsExpanded}" Value="False"/>
                  </MultiDataTrigger.Conditions>
                  <Setter TargetName="ClosedCollapsedBorder" Property="Visibility" Value="Visible"/>
                  <Setter TargetName="ColumnBorder" Property="Visibility" Value="Collapsed"/>
                </MultiDataTrigger>
              </DataTemplate.Triggers>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

    </Grid>

    <Border Grid.Row="4"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush_}"
            BorderThickness="1"
            CornerRadius="9"
            Margin="24,0,24,20"
            Padding="12,8">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <ui:TextBox Grid.Column="0"
                    Text="{Binding NewTodoTitle, UpdateSourceTrigger=PropertyChanged}"
                    PlaceholderText="{loc:Str Todo_AddPlaceholder}"
                    PlaceholderEnabled="True"
                    ClearButtonEnabled="False"
                    Margin="0,0,8,0">
          <ui:TextBox.InputBindings>
            <KeyBinding Key="Return"
                        Command="{Binding AddTodoCommand}"/>
          </ui:TextBox.InputBindings>
        </ui:TextBox>

        <ComboBox Grid.Column="1"
                  ItemsSource="{Binding Priorities}"
                  SelectedItem="{Binding NewTodoPriority}"
                  Width="120"
                  Margin="0,0,8,0"
                  ToolTip="{loc:Str Todo_PriorityTooltip}"/>

        <DatePicker Grid.Column="2"
                    SelectedDate="{Binding NewTodoDueDate}"
                    Width="130"
                    Margin="0,0,8,0"
                    ToolTip="{loc:Str Todo_DueDateTooltip}"/>

        <ui:Button Grid.Column="3"
                   Command="{Binding RecordTodoCommand}"
                   Appearance="Secondary"
                   Width="36"
                   Height="36"
                   Padding="0"
                   Margin="0,0,8,0"
                   ToolTip="{loc:Str TodoPanel_Record}">
          <ui:SymbolIcon Symbol="Record24" FontSize="16"/>
        </ui:Button>

        <ui:Button Grid.Column="4"
                   Command="{Binding AddTodoCommand}"
                   Appearance="Primary"
                   ToolTip="{loc:Str Todo_AddTooltip}">
          <StackPanel Orientation="Horizontal">
            <ui:SymbolIcon Symbol="Add24" FontSize="16" Margin="0,0,6,0"/>
            <TextBlock Text="{loc:Str Todo_Add}"/>
          </StackPanel>
        </ui:Button>
      </Grid>
    </Border>
  </Grid>
</UserControl>

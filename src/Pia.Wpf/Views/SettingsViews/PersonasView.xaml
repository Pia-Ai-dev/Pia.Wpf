<UserControl x:Class="Pia.Views.SettingsViews.PersonasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:controls="clr-namespace:Pia.Controls"
             xmlns:loc="clr-namespace:Pia.Localization">
  <!-- Horizontal scroll disabled so the ColumnsPanel is measured at a finite width and can pick its column count. -->
  <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <StackPanel MaxWidth="1080" HorizontalAlignment="Left">

      <!-- Personas section header -->
      <Grid Margin="0,0,0,8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock Text="{loc:Str Settings_Tab_Personas}"
                   FontSize="14"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource TextDefaultBrush}"
                   VerticalAlignment="Center"/>
        <ui:Button Grid.Column="1"
                   Appearance="Secondary"
                   Command="{Binding AddPersonaCommand}">
          <StackPanel Orientation="Horizontal">
            <ui:SymbolIcon Symbol="Add24" FontSize="16" Margin="0,0,6,0"/>
            <TextBlock Text="{loc:Str Personas_AddPersona}"/>
          </StackPanel>
        </ui:Button>
      </Grid>

      <TextBlock Text="{loc:Str Personas_Subtitle}"
                 FontSize="12"
                 Foreground="{DynamicResource TextMutedBrush}"
                 TextWrapping="Wrap"
                 Margin="0,0,0,12"/>

      <ItemsControl ItemsSource="{Binding Personas}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <controls:ColumnsPanel MaxColumns="3" MinColumnWidth="260" ColumnSpacing="10" RowSpacing="10" UniformRowHeight="True" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Style="{StaticResource PiaSettingsCardStyle}"
                    Padding="14,12">
              <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Top">
                <StackPanel Orientation="Horizontal">
                  <controls:PersonaGlyph PersonaId="{Binding Id}"
                                         Emoji="{Binding Emoji}"
                                         GlyphSize="16"
                                         VerticalAlignment="Center"
                                         Margin="0,0,8,0"/>
                  <TextBlock FontSize="14"
                             FontWeight="SemiBold"
                             VerticalAlignment="Center"
                             Foreground="{DynamicResource TextDefaultBrush}"
                             Text="{Binding Name}"/>
                  <!-- Accent colour swatch (hidden when the persona has no accent set). -->
                  <Ellipse Width="10"
                           Height="10"
                           Margin="8,0,0,0"
                           VerticalAlignment="Center"
                           Fill="{Binding AccentColor, Converter={StaticResource HexToBrushConverter}}"
                           Stroke="{DynamicResource BorderBrush_}"
                           StrokeThickness="1"
                           Visibility="{Binding AccentColor, Converter={StaticResource NullToVisibilityConverter}}"
                           ToolTip="{Binding AccentColor}"/>
                </StackPanel>
                <TextBlock Text="{Binding Tagline}"
                           FontSize="12"
                           Foreground="{DynamicResource TextMutedBrush}"
                           Margin="0,2,0,0"
                           TextWrapping="Wrap"/>
                </StackPanel>
                <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:Button Command="{Binding DataContext.DuplicatePersonaCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                               CommandParameter="{Binding}"
                               Appearance="Secondary"
                               Height="30"
                               Padding="8,0"
                               FontSize="12"
                               Margin="0,0,4,0">
                      <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Copy24" FontSize="14" Margin="0,0,4,0"/>
                        <TextBlock Text="{loc:Str Personas_Duplicate}" FontSize="12"/>
                      </StackPanel>
                    </ui:Button>
                    <ui:Button Command="{Binding DataContext.EditPersonaCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                               CommandParameter="{Binding}"
                               Appearance="Secondary"
                               Width="30"
                               Height="30"
                               Padding="0"
                               Margin="0,0,4,0"
                               Visibility="{Binding IsBuiltIn, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                      <ui:SymbolIcon Symbol="Edit24" FontSize="14"/>
                      <ui:Button.ToolTip>
                        <ToolTip Content="{loc:Str Common_Edit}"/>
                      </ui:Button.ToolTip>
                    </ui:Button>
                    <ui:Button Command="{Binding DataContext.DeletePersonaCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                               CommandParameter="{Binding}"
                               Appearance="Secondary"
                               Width="30"
                               Height="30"
                               Padding="0"
                               Visibility="{Binding IsBuiltIn, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                      <ui:SymbolIcon Symbol="Delete24" FontSize="14"
                                     Foreground="{DynamicResource PiaDangerBrush}"/>
                      <ui:Button.ToolTip>
                        <ToolTip Content="{loc:Str Common_Delete}"/>
                      </ui:Button.ToolTip>
                    </ui:Button>
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:Badge Content="{loc:Str Personas_BuiltIn}"
                              Visibility="{Binding IsBuiltIn, Converter={StaticResource BooleanToVisibilityConverter}}"
                              Appearance="Caution"
                              Margin="0,0,8,0"/>
                  </StackPanel>
                </DockPanel>
              </DockPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>

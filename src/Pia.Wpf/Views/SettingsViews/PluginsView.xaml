<UserControl x:Class="Pia.Views.SettingsViews.PluginsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:converters="clr-namespace:Pia.Converters"
             xmlns:loc="clr-namespace:Pia.Localization">
  <UserControl.Resources>
    <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>
  </UserControl.Resources>
  <Grid Margin="16">
    <!-- Not connected overlay -->
    <StackPanel VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Visibility="{Binding IsCloudConnected, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
      <ui:SymbolIcon Symbol="CloudDismiss24" FontSize="48" Margin="0,0,0,16"
                     HorizontalAlignment="Center" Opacity="0.5"/>
      <TextBlock Text="{loc:Str Plugins_NotConnected}"
                 FontSize="14" Opacity="0.7"
                 HorizontalAlignment="Center" Margin="0,0,0,12"/>
      <Button Content="{loc:Str Plugins_GoToAccount}"
              Command="{Binding GoToAccountCommand}"
              HorizontalAlignment="Center"
              Style="{DynamicResource AccentButtonStyle}"/>
    </StackPanel>

    <!-- Plugin list -->
    <ScrollViewer Visibility="{Binding IsCloudConnected, Converter={StaticResource BooleanToVisibilityConverter}}">
      <StackPanel MaxWidth="600" HorizontalAlignment="Left">
        <TextBlock Text="{loc:Str Settings_Tab_Plugins}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,4"/>
        <TextBlock Text="{loc:Str Plugins_Subtitle}" Opacity="0.7" FontSize="12" Margin="0,0,0,20"/>

        <!-- Loading -->
        <ui:ProgressRing IsIndeterminate="True" Width="32" Height="32"
                         Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"
                         HorizontalAlignment="Center" Margin="0,24,0,0"/>

        <!-- Plugin items -->
        <ItemsControl ItemsSource="{Binding Plugins}"
                      Visibility="{Binding IsLoading, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Background="{DynamicResource ControlFillColorDefaultBrush}"
                      CornerRadius="8"
                      Padding="16"
                      Margin="0,0,0,8">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>

                  <!-- Icon -->
                  <Border Grid.Column="0" Width="32" Height="32" CornerRadius="6"
                          Background="{DynamicResource ControlFillColorSecondaryBrush}"
                          VerticalAlignment="Top" Margin="0,2,0,0">
                    <Grid>
                      <Image Source="{Binding IconImage}" Width="24" Height="24"
                             RenderOptions.BitmapScalingMode="HighQuality"
                             Visibility="{Binding HasIcon, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                      <ui:SymbolIcon Symbol="{Binding FallbackIcon}" FontSize="20"
                                     Visibility="{Binding HasIcon, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                    </Grid>
                  </Border>

                  <!-- Info -->
                  <StackPanel Grid.Column="1" Margin="8,0,12,0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14"
                                 VerticalAlignment="Center"/>
                      <Border Background="{DynamicResource ControlFillColorSecondaryBrush}"
                              CornerRadius="4" Padding="6,2" Margin="8,0,0,0"
                              VerticalAlignment="Center">
                        <TextBlock Text="{Binding KindBadge}" FontSize="11" Opacity="0.8"/>
                      </Border>
                      <TextBlock Text="{Binding Version}" FontSize="11" Opacity="0.5"
                                 Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="{Binding Description}" FontSize="12" Opacity="0.7"
                               TextWrapping="Wrap" Margin="0,0,0,4"/>
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="{Binding StatusText}" FontSize="11" Opacity="0.6"/>
                      <ui:ProgressRing IsIndeterminate="True" Width="12" Height="12"
                                       Margin="8,0,0,0"
                                       Visibility="{Binding IsActivating, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    </StackPanel>
                  </StackPanel>

                  <!-- Toggle -->
                  <ui:ToggleSwitch Grid.Column="2" VerticalAlignment="Top"
                                   IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                   Command="{Binding DataContext.TogglePluginCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                   CommandParameter="{Binding}"/>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>

<UserControl x:Class="Pia.Views.SettingsViews.E2EEOnboardingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:Pia.ViewModels"
             xmlns:loc="clr-namespace:Pia.Localization"
             xmlns:models="clr-namespace:Pia.Models">
  <StackPanel MaxWidth="640" HorizontalAlignment="Left">
    <TextBlock Text="{loc:Str E2EE_Onboarding_Title}"
               FontSize="18"
               FontWeight="SemiBold"
               Foreground="{DynamicResource TextDefaultBrush}"
               Margin="0,0,0,4"/>
    <TextBlock Text="{loc:Str E2EE_Onboarding_Subtitle}"
               FontSize="12"
               Foreground="{DynamicResource TextMutedBrush}"
               Margin="0,0,0,16"
               TextWrapping="Wrap"/>

    <!-- State: Initial — choose path -->
    <StackPanel>
      <StackPanel.Style>
        <Style TargetType="StackPanel">
          <Setter Property="Visibility" Value="Collapsed"/>
          <Style.Triggers>
            <DataTrigger Binding="{Binding OnboardingViewModel.State}" Value="{x:Static models:OnboardingState.Initial}">
              <Setter Property="Visibility" Value="Visible"/>
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </StackPanel.Style>

      <Border Style="{StaticResource PiaSettingsCardStyle}"
              Padding="16"
              Margin="0,0,0,10">
        <StackPanel>
          <TextBlock Text="{loc:Str E2EE_Onboarding_Approve_Title}"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource TextDefaultBrush}"
                     Margin="0,0,0,4"/>
          <TextBlock Text="{loc:Str E2EE_Onboarding_Approve_Description}"
                     FontSize="12"
                     Foreground="{DynamicResource TextMutedBrush}"
                     TextWrapping="Wrap"
                     Margin="0,0,0,12"/>
          <ui:Button Content="{loc:Str E2EE_Onboarding_Approve_Button}"
                     Appearance="Primary"
                     HorizontalAlignment="Left"
                     Command="{Binding OnboardingViewModel.StartDeviceApprovalCommand}"
                     AutomationProperties.AutomationId="E2EEOnboarding_StartApproval"/>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource PiaSettingsCardStyle}"
              Padding="16"
              Margin="0,0,0,10">
        <StackPanel>
          <TextBlock Text="{loc:Str E2EE_Onboarding_Recovery_Title}"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource TextDefaultBrush}"
                     Margin="0,0,0,4"/>
          <TextBlock Text="{loc:Str E2EE_Onboarding_Recovery_Description}"
                     FontSize="12"
                     Foreground="{DynamicResource TextMutedBrush}"
                     TextWrapping="Wrap"
                     Margin="0,0,0,12"/>
          <ui:Button Content="{loc:Str E2EE_Onboarding_Recovery_Button}"
                     Appearance="Secondary"
                     HorizontalAlignment="Left"
                     Command="{Binding OnboardingViewModel.ShowRecoveryCodeEntryCommand}"
                     AutomationProperties.AutomationId="E2EEOnboarding_ShowRecoveryEntry"/>
        </StackPanel>
      </Border>
    </StackPanel>

    <!-- State: Waiting for approval -->
    <StackPanel>
      <StackPanel.Style>
        <Style TargetType="StackPanel">
          <Setter Property="Visibility" Value="Collapsed"/>
          <Style.Triggers>
            <DataTrigger Binding="{Binding OnboardingViewModel.State}" Value="{x:Static models:OnboardingState.WaitingForApproval}">
              <Setter Property="Visibility" Value="Visible"/>
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </StackPanel.Style>

      <Border Style="{StaticResource PiaSettingsCardStyle}"
              Padding="16"
              Margin="0,0,0,10">
        <StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
            <ui:ProgressRing IsIndeterminate="True"
                             Width="20" Height="20"
                             Margin="0,0,8,0"/>
            <TextBlock Text="{Binding OnboardingViewModel.StatusMessage}"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource TextDefaultBrush}"/>
          </StackPanel>

          <TextBlock Text="{loc:Str E2EE_Onboarding_Waiting_FingerprintLabel}"
                     FontSize="12"
                     Foreground="{DynamicResource TextMutedBrush}"
                     Margin="0,0,0,4"/>
          <TextBlock Text="{Binding OnboardingViewModel.DeviceFingerprint}"
                     FontFamily="{StaticResource PiaMonoFont}"
                     FontSize="16"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource TextDefaultBrush}"
                     Margin="0,0,0,12"/>
          <TextBlock Text="{loc:Str E2EE_Onboarding_Waiting_VerifyInstruction}"
                     FontSize="12"
                     Foreground="{DynamicResource TextMutedBrush}"
                     TextWrapping="Wrap"
                     Margin="0,0,0,12"/>

          <StackPanel Orientation="Horizontal">
            <ui:Button Content="{loc:Str E2EE_Onboarding_Cancel}"
                       Appearance="Secondary"
                       Command="{Binding OnboardingViewModel.GoBackCommand}"
                       AutomationProperties.AutomationId="E2EEOnboarding_WaitingCancel"
                       Margin="0,0,8,0"/>
            <ui:Button Content="{loc:Str E2EE_Onboarding_UseRecoveryInstead}"
                       Appearance="Secondary"
                       Command="{Binding OnboardingViewModel.ShowRecoveryCodeEntryCommand}"
                       AutomationProperties.AutomationId="E2EEOnboarding_WaitingShowRecoveryEntry"/>
          </StackPanel>
        </StackPanel>
      </Border>
    </StackPanel>

    <!-- State: Entering recovery code -->
    <StackPanel>
      <StackPanel.Style>
        <Style TargetType="StackPanel">
          <Setter Property="Visibility" Value="Collapsed"/>
          <Style.Triggers>
            <DataTrigger Binding="{Binding OnboardingViewModel.State}" Value="{x:Static models:OnboardingState.EnteringRecoveryCode}">
              <Setter Property="Visibility" Value="Visible"/>
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </StackPanel.Style>

      <Border Style="{StaticResource PiaSettingsCardStyle}"
              Padding="16"
              Margin="0,0,0,10">
        <StackPanel>
          <TextBlock Text="{loc:Str E2EE_Onboarding_Recovery_EnterTitle}"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource TextDefaultBrush}"
                     Margin="0,0,0,4"/>
          <TextBlock Text="{loc:Str E2EE_Onboarding_Recovery_EnterDescription}"
                     FontSize="12"
                     Foreground="{DynamicResource TextMutedBrush}"
                     TextWrapping="Wrap"
                     Margin="0,0,0,12"/>

          <ui:TextBox PlaceholderText="XXXX-XXXX-XXXX-XXXX-XXXX-XXXX"
                      Text="{Binding OnboardingViewModel.RecoveryCodeInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                      AutomationProperties.AutomationId="E2EEOnboarding_RecoveryCodeInput"
                      FontFamily="{StaticResource PiaMonoFont}"
                      FontSize="14"
                      Margin="0,0,0,8"/>

          <!-- Error message -->
          <TextBlock Text="{Binding OnboardingViewModel.ErrorMessage}"
                     Foreground="{DynamicResource PiaDangerBrush}"
                     FontSize="12"
                     TextWrapping="Wrap"
                     Margin="0,0,0,8"
                     Visibility="{Binding OnboardingViewModel.ErrorMessage, Converter={StaticResource NullToVisibilityConverter}}"/>

          <StackPanel Orientation="Horizontal">
            <ui:Button Content="{loc:Str E2EE_Onboarding_Recovery_Activate}"
                       Appearance="Primary"
                       Command="{Binding OnboardingViewModel.ActivateWithRecoveryCodeCommand}"
                       AutomationProperties.AutomationId="E2EEOnboarding_ActivateWithRecoveryCode"
                       Margin="0,0,8,0"/>
            <ui:Button Content="{loc:Str E2EE_Onboarding_Back}"
                       Appearance="Secondary"
                       Command="{Binding OnboardingViewModel.GoBackCommand}"
                       AutomationProperties.AutomationId="E2EEOnboarding_RecoveryBack"/>
          </StackPanel>
        </StackPanel>
      </Border>
    </StackPanel>

    <!-- State: Activating -->
    <StackPanel>
      <StackPanel.Style>
        <Style TargetType="StackPanel">
          <Setter Property="Visibility" Value="Collapsed"/>
          <Style.Triggers>
            <DataTrigger Binding="{Binding OnboardingViewModel.State}" Value="{x:Static models:OnboardingState.Activating}">
              <Setter Property="Visibility" Value="Visible"/>
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </StackPanel.Style>

      <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
        <ui:ProgressRing IsIndeterminate="True"
                         Width="20" Height="20"
                         Margin="0,0,8,0"/>
        <TextBlock Text="{Binding OnboardingViewModel.StatusMessage}"
                   VerticalAlignment="Center"
                   Foreground="{DynamicResource TextDefaultBrush}"/>
      </StackPanel>
    </StackPanel>

    <!-- State: Success -->
    <StackPanel>
      <StackPanel.Style>
        <Style TargetType="StackPanel">
          <Setter Property="Visibility" Value="Collapsed"/>
          <Style.Triggers>
            <DataTrigger Binding="{Binding OnboardingViewModel.State}" Value="{x:Static models:OnboardingState.Success}">
              <Setter Property="Visibility" Value="Visible"/>
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </StackPanel.Style>

      <Border Style="{StaticResource PiaSettingsCardStyle}"
              Padding="16"
              Margin="0,0,0,10">
        <StackPanel>
          <TextBlock Text="{loc:Str E2EE_Onboarding_Success_Title}"
                     FontWeight="SemiBold"
                     FontSize="16"
                     Foreground="{DynamicResource TextDefaultBrush}"
                     Margin="0,0,0,4"/>
          <TextBlock Text="{loc:Str E2EE_Onboarding_Success_Description}"
                     FontSize="12"
                     Foreground="{DynamicResource TextMutedBrush}"
                     Margin="0,0,0,8"/>
          <TextBlock FontSize="12"
                     Foreground="{DynamicResource TextMutedBrush}">
            <Run Text="{loc:Str E2EE_Onboarding_FingerprintPrefix}"/>
            <Run Text="{Binding OnboardingViewModel.DeviceFingerprint, Mode=OneWay}" FontFamily="{StaticResource PiaMonoFont}"/>
          </TextBlock>
        </StackPanel>
      </Border>
    </StackPanel>

    <!-- State: Error -->
    <StackPanel>
      <StackPanel.Style>
        <Style TargetType="StackPanel">
          <Setter Property="Visibility" Value="Collapsed"/>
          <Style.Triggers>
            <DataTrigger Binding="{Binding OnboardingViewModel.State}" Value="{x:Static models:OnboardingState.Error}">
              <Setter Property="Visibility" Value="Visible"/>
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </StackPanel.Style>

      <Border Style="{StaticResource PiaSettingsCardStyle}"
              Padding="16"
              Margin="0,0,0,10">
        <StackPanel>
          <TextBlock Text="{Binding OnboardingViewModel.ErrorMessage}"
                     Foreground="{DynamicResource PiaDangerBrush}"
                     TextWrapping="Wrap"
                     Margin="0,0,0,12"/>
          <ui:Button Content="{loc:Str E2EE_Onboarding_TryAgain}"
                     Appearance="Secondary"
                     HorizontalAlignment="Left"
                     Command="{Binding OnboardingViewModel.GoBackCommand}"
                     AutomationProperties.AutomationId="E2EEOnboarding_ErrorTryAgain"/>
        </StackPanel>
      </Border>
    </StackPanel>
  </StackPanel>
</UserControl>

<UserControl x:Class="Pia.Views.SettingsViews.AssistantView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:converters="clr-namespace:Pia.Converters"
             xmlns:controls="clr-namespace:Pia.Controls"
             xmlns:local="clr-namespace:Pia.Views.SettingsViews"
             xmlns:loc="clr-namespace:Pia.Localization"
             xmlns:shared="clr-namespace:Pia.Controls.Shared">
  <UserControl.Resources>
    <converters:EnumToLocalizedStringConverter x:Key="EnumToLocalizedStringConverter"/>

    <!-- Shared by the standing and session grant rows; only the trailing button differs between them. -->
    <DataTemplate x:Key="ToolGrantRowDetailsTemplate">
      <StackPanel VerticalAlignment="Center">
        <TextBlock FontWeight="SemiBold"
                   Foreground="{DynamicResource TextDefaultBrush}"
                   Text="{Binding ToolName}"/>
        <TextBlock FontSize="11"
                   Foreground="{DynamicResource TextMutedBrush}"
                   Margin="0,2,0,0">
          <Run Text="{loc:Str ToolPermissions_Column_Plugin}"/>
          <Run Text=" "/>
          <Run Text="{Binding PluginName, Mode=OneWay}"/>
        </TextBlock>
        <TextBlock FontSize="11"
                   Foreground="{DynamicResource TextSubtleBrush}"
                   Margin="0,2,0,0">
          <Run Text="{loc:Str ToolPermissions_Column_GrantedAt}"/>
          <Run Text=" "/>
          <Run Text="{Binding GrantedAt, StringFormat='{}{0:g}', Mode=OneWay}"/>
        </TextBlock>
      </StackPanel>
    </DataTemplate>
  </UserControl.Resources>
  <Grid>
    <TabControl SelectedIndex="{Binding SelectedInnerTabIndex}" Style="{DynamicResource SettingsInnerTabControlStyle}">
      <!-- General tab -->
      <TabItem Header="{loc:Str Settings_InnerTab_General}" Style="{DynamicResource SettingsInnerTabItemStyle}"
               AutomationProperties.AutomationId="Settings_Assistant_Tab_General">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel MaxWidth="640" HorizontalAlignment="Left">
      <!-- Provider hint (the default provider for this mode is set on the Providers tab) -->
      <StackPanel Margin="0,0,0,20">
        <TextBlock Text="{loc:Str Settings_Tab_Providers}"
                   Style="{StaticResource PiaSettingsSectionLabelStyle}"/>
        <TextBlock Text="{loc:Str Settings_ProviderHint}"
                   Style="{StaticResource PiaSettingsDescriptionStyle}"/>
        <ui:HyperlinkButton Content="{loc:Str Settings_ProviderHint_Link}"
                            Command="{Binding ProvidersVm.GoToProvidersTabCommand}"
                            AutomationProperties.AutomationId="Settings_Assistant_GoToProvidersTab"
                            HorizontalAlignment="Left"
                            Margin="0,4,0,0"/>
      </StackPanel>

      <!-- Assistant behavior -->
      <TextBlock Text="{loc:Str Settings_Assistant_BehaviorSection}"
                 Style="{StaticResource PiaSettingsSectionLabelStyle}"
                 Margin="0,0,0,8"/>

      <!-- Default Window Mode -->
      <StackPanel Margin="0,0,0,20">
        <TextBlock Text="{loc:Str Settings_DefaultWindowMode}"
                   Style="{StaticResource PiaSettingsSectionLabelStyle}"/>
        <ComboBox ItemsSource="{Binding WindowModes}"
                  SelectedItem="{Binding DefaultWindowMode}"
                  IsEnabled="{Binding Policy[DefaultWindowMode]}"
                  AutomationProperties.AutomationId="Settings_Assistant_DefaultWindowMode"
                  Width="400"
                  HorizontalAlignment="Left">
          <ComboBox.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding Converter={StaticResource EnumToLocalizedStringConverter}}"/>
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <TextBlock Text="{loc:Str Settings_DefaultWindowMode_Description}"
                   Style="{StaticResource PiaSettingsDescriptionStyle}"/>
      </StackPanel>

      <!-- Follow-up Suggestion Chips -->
      <StackPanel Margin="0,0,0,20">
        <CheckBox Content="{loc:Str Settings_AssistantSuggestions}"
                  IsChecked="{Binding SuggestionsEnabled}"
                  IsEnabled="{Binding Policy[AssistantSuggestionsEnabled]}"
                  AutomationProperties.AutomationId="Settings_Assistant_SuggestionsEnabled"/>
        <TextBlock Text="{loc:Str Settings_AssistantSuggestions_Description}"
                   Style="{StaticResource PiaSettingsDescriptionStyle}"
                   Margin="22,4,0,0"/>
      </StackPanel>

      <!-- Files Folder (sandboxed) + nested memory vault -->
      <StackPanel Margin="0,0,0,20">
        <TextBlock Text="{loc:Str Settings_AssistantFilesFolder}"
                   Style="{StaticResource PiaSettingsSectionLabelStyle}"/>
        <Grid HorizontalAlignment="Left">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="400"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <ui:TextBox Grid.Column="0"
                      Text="{Binding FilesFolder}"
                      AutomationProperties.AutomationId="Settings_Assistant_FilesFolder"
                      IsReadOnly="True"
                      PlaceholderText="{loc:Str Settings_AssistantFilesFolder_Placeholder}"
                      PlaceholderEnabled="True"/>
          <ui:Button Grid.Column="1"
                     Content="{loc:Str Settings_AssistantFilesFolder_Change}"
                     Command="{Binding ChangeFilesFolderCommand}"
                     AutomationProperties.AutomationId="Settings_Assistant_ChangeFilesFolder"
                     Margin="8,0,0,0"/>
        </Grid>
        <TextBlock Text="{Binding VaultLocationDisplay}"
                   Style="{StaticResource PiaSettingsDescriptionStyle}"
                   Margin="0,6,0,0"/>
        <CheckBox Content="{loc:Str Settings_AssistantFileToolsEnabled}"
                  IsChecked="{Binding FileToolsEnabled}"
                  IsEnabled="{Binding Policy[AssistantFileToolsEnabled]}"
                  AutomationProperties.AutomationId="Settings_Assistant_FileToolsEnabled"
                  Margin="0,10,0,0"/>
        <CheckBox Content="{loc:Str Settings_AssistantGitToolsEnabled}"
                  IsChecked="{Binding GitToolsEnabled}"
                  AutomationProperties.AutomationId="Settings_Assistant_GitToolsEnabled"
                  IsEnabled="{Binding GitToolsEditable}"
                  Margin="0,10,0,0"/>
        <TextBlock Text="{loc:Str Settings_AssistantGitToolsUnavailable}"
                   Style="{StaticResource PiaSettingsDescriptionStyle}"
                   Visibility="{Binding GitToolsAvailable, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                   Margin="22,2,0,0"/>
        <TextBlock Text="{loc:Str Settings_AssistantFilesFolder_Description}"
                   Style="{StaticResource PiaSettingsDescriptionStyle}"
                   Margin="22,4,0,0"/>
      </StackPanel>

      <!-- Default working directory for new chats (relative to the files folder) -->
      <StackPanel Margin="0,0,0,20">
        <TextBlock Text="{loc:Str Settings_Assistant_DefaultWorkingDirectory}"
                   Style="{StaticResource PiaSettingsSectionLabelStyle}"/>
        <ComboBox Width="400"
                  HorizontalAlignment="Left"
                  IsEditable="True"
                  Text="{Binding DefaultWorkingDirectory, UpdateSourceTrigger=LostFocus}"
                  IsEnabled="{Binding Policy[AssistantDefaultWorkingDirectory]}"
                  ItemsSource="{Binding AvailableWorkingDirectories}"
                  AutomationProperties.AutomationId="Settings_Assistant_DefaultWorkingDirectory"/>
        <TextBlock Text="{loc:Str Settings_Assistant_DefaultWorkingDirectory_Description}"
                   Style="{StaticResource PiaSettingsDescriptionStyle}"
                   Margin="0,6,0,0"/>
      </StackPanel>

      <!-- Chat history -->
      <TextBlock Text="{loc:Str Settings_Chat_Section}"
                 Style="{StaticResource PiaSettingsSectionLabelStyle}"
                 Margin="0,8,0,8"/>

      <StackPanel Margin="0,0,0,20">
        <CheckBox Content="{loc:Str Settings_Chat_HistoryEnabled}"
                  IsChecked="{Binding ChatHistoryEnabled}"
                  IsEnabled="{Binding Policy[ChatHistoryEnabled]}"
                  AutomationProperties.AutomationId="Settings_Assistant_ChatHistoryEnabled"/>
        <TextBlock Text="{loc:Str Settings_Chat_HistoryEnabled_Description}"
                   Style="{StaticResource PiaSettingsDescriptionStyle}"
                   Margin="22,4,0,0"/>
      </StackPanel>

      <StackPanel Margin="0,0,0,20"
                  IsEnabled="{Binding ChatHistoryEnabled}">
        <TextBlock Text="{loc:Str Settings_Chat_RetentionDays_Label}"
                   Style="{StaticResource PiaSettingsSectionLabelStyle}"/>
        <Slider HorizontalAlignment="Left"
                Width="400"
                Minimum="1"
                Maximum="365"
                TickFrequency="1"
                IsSnapToTickEnabled="True"
                Value="{Binding ChatHistoryRetentionDays, Mode=TwoWay}"
                IsEnabled="{Binding Policy[ChatHistoryRetentionDays]}"
                AutomationProperties.AutomationId="Settings_Assistant_ChatHistoryRetentionDays"
                VerticalAlignment="Center"/>
        <TextBlock Text="{Binding RetentionDaysDisplay}"
                   Style="{StaticResource PiaSettingsDescriptionStyle}"/>
      </StackPanel>

      <StackPanel Margin="0,0,0,20">
        <CheckBox Content="{loc:Str Settings_Chat_AutoTitle}"
                  IsChecked="{Binding ChatAutoTitleEnabled}"
                  IsEnabled="{Binding Policy[ChatAutoTitleEnabled]}"
                  AutomationProperties.AutomationId="Settings_Assistant_ChatAutoTitleEnabled"/>
        <TextBlock Text="{loc:Str Settings_Chat_AutoTitle_Hint}"
                   Style="{StaticResource PiaSettingsDescriptionStyle}"
                   Margin="22,4,0,0"/>
      </StackPanel>

      <StackPanel Margin="0,0,0,20">
        <ui:Button Content="{loc:Str Settings_Chat_DeleteAllNow}"
                   Command="{Binding DeleteAllChatHistoryCommand}"
                   AutomationProperties.AutomationId="Settings_Assistant_DeleteAllChatHistory"
                   Appearance="Caution"
                   HorizontalAlignment="Left"/>
      </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- Personas tab -->
      <TabItem Header="{loc:Str Settings_Tab_Personas}" Style="{DynamicResource SettingsInnerTabItemStyle}"
               AutomationProperties.AutomationId="Settings_Assistant_Tab_Personas">
        <local:PersonasView DataContext="{Binding PersonasVm}"/>
      </TabItem>

      <!-- Tool access tab: the revocation surface and the pre-approval catalogue -->
      <TabItem Header="{loc:Str Settings_Tab_ToolPermissions}" Style="{DynamicResource SettingsInnerTabItemStyle}"
               AutomationProperties.AutomationId="Settings_Assistant_Tab_ToolPermissions">
        <ScrollViewer VerticalScrollBarVisibility="Auto" DataContext="{Binding ToolPermissionsVm}">
          <StackPanel MaxWidth="640" HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
              <TextBlock Text="{loc:Str Settings_ToolPermissions_Page_Title}"
                         Style="{StaticResource PiaSettingsSectionLabelStyle}"
                         FontSize="15"
                         Margin="0"
                         VerticalAlignment="Center"/>
              <shared:PiaHelpHint Text="{loc:Str Settings_ToolPermissions_Page_Description}"
                                  AutomationProperties.AutomationId="Settings_ToolPermissions_Page_Help"/>
            </StackPanel>

            <TextBlock Text="{loc:Str Settings_ToolPermissions_Autonomy_Section}"
                       Style="{StaticResource PiaSettingsSectionLabelStyle}"
                       Margin="0,0,0,4"/>
            <StackPanel Margin="0,0,0,20">
              <!-- The ScrollViewer re-roots at ToolPermissionsVm, but this switch lives on the parent VM and
                   must stay ONE property with ONE save path, so it binds up past the re-root. -->
              <CheckBox Content="{loc:Str Settings_Agent_AutoApproveBuiltInWrites}"
                        IsChecked="{Binding DataContext.AgentRunAutoApproveBuiltInWrites, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}"
                        AutomationProperties.AutomationId="Settings_Assistant_ToolPermissions_AutoApproveBuiltInWrites"/>
              <TextBlock Text="{loc:Str Settings_Agent_AutoApproveBuiltInWrites_Description}"
                         Style="{StaticResource PiaSettingsDescriptionStyle}"
                         Margin="22,4,0,0"/>
              <TextBlock Text="{loc:Str Settings_ToolPermissions_Autonomy_Covers}"
                         Style="{StaticResource PiaSettingsDescriptionStyle}"
                         Margin="22,4,0,0"/>
            </StackPanel>

            <!-- Session tier: hidden entirely when empty rather than carrying its own empty state. -->
            <StackPanel Margin="0,0,0,20"
                        Visibility="{Binding HasSessionGrants, Converter={StaticResource BooleanToVisibilityConverter}}">
              <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <TextBlock Text="{loc:Str Settings_ToolPermissions_Session_Title}"
                           Style="{StaticResource PiaSettingsSectionLabelStyle}"
                           Margin="0"
                           VerticalAlignment="Center"/>
                <shared:PiaHelpHint Text="{loc:Str Settings_ToolPermissions_Session_Description}"
                                    IconSize="14"
                                    AutomationProperties.AutomationId="Settings_ToolPermissions_Session_Help"/>
              </StackPanel>

              <ItemsControl ItemsSource="{Binding SessionGrants}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Style="{StaticResource PiaSettingsCardStyle}"
                            Padding="14,12"
                            Margin="0,0,0,8">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <ContentPresenter Grid.Column="0"
                                          Content="{Binding}"
                                          ContentTemplate="{StaticResource ToolGrantRowDetailsTemplate}"/>

                        <ui:Button Grid.Column="1"
                                   Content="{loc:Str ToolPermissions_Forget}"
                                   Appearance="Secondary"
                                   AutomationProperties.AutomationId="{Binding ToolName, StringFormat='Settings_Assistant_ForgetSession_{0}'}"
                                   VerticalAlignment="Center"
                                   Command="{Binding DataContext.ForgetSessionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                   CommandParameter="{Binding}"/>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
              <TextBlock Text="{loc:Str Settings_ToolPermissions_Title}"
                         Style="{StaticResource PiaSettingsSectionLabelStyle}"
                         Margin="0"
                         VerticalAlignment="Center"/>
              <shared:PiaHelpHint Text="{loc:Str Settings_ToolPermissions_Description}"
                                  IconSize="14"
                                  AutomationProperties.AutomationId="Settings_ToolPermissions_Help"/>
            </StackPanel>

            <!-- Empty state -->
            <TextBlock Text="{loc:Str ToolPermissions_Empty}"
                       Style="{StaticResource PiaSettingsDescriptionStyle}"
                       Visibility="{Binding HasGrants, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>

            <!-- Grant list -->
            <ItemsControl ItemsSource="{Binding Grants}"
                          Visibility="{Binding HasGrants, Converter={StaticResource BooleanToVisibilityConverter}}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Style="{StaticResource PiaSettingsCardStyle}"
                          Padding="14,12"
                          Margin="0,0,0,8">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>

                      <ContentPresenter Grid.Column="0"
                                        Content="{Binding}"
                                        ContentTemplate="{StaticResource ToolGrantRowDetailsTemplate}"/>

                      <ui:Button Grid.Column="1"
                                 Content="{loc:Str ToolPermissions_Revoke}"
                                 Appearance="Secondary"
                                 Foreground="{DynamicResource PiaDangerBrush}"
                                 AutomationProperties.AutomationId="{Binding ToolName, StringFormat='Settings_Assistant_Revoke_{0}'}"
                                 VerticalAlignment="Center"
                                 Command="{Binding DataContext.RevokeCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                 CommandParameter="{Binding}"/>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Pre-approval catalogue. The toggles bind to the row's own state, never to a command through an
                 ancestor, because the ancestor inside the group template is the INNER ItemsControl. -->
            <ui:CardExpander IsExpanded="False"
                             AutomationProperties.AutomationId="Settings_Assistant_ToolCatalog"
                             Margin="0,20,0,0"
                             Visibility="{Binding HasCatalog, Converter={StaticResource BooleanToVisibilityConverter}}">
              <ui:CardExpander.Header>
                <StackPanel>
                  <TextBlock Text="{loc:Str Settings_ToolPermissions_Catalog_Title}"
                             Style="{StaticResource PiaSettingsSectionLabelStyle}"
                             Margin="0,0,0,4"/>
                  <TextBlock Text="{loc:Str Settings_ToolPermissions_Catalog_Description}"
                             Style="{StaticResource PiaSettingsDescriptionStyle}"/>
                </StackPanel>
              </ui:CardExpander.Header>

              <ItemsControl ItemsSource="{Binding ToolCatalog}"
                            Margin="0,8,0,0">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Margin="0,0,0,14">
                      <TextBlock Text="{Binding PluginName}"
                                 FontWeight="SemiBold"
                                 Foreground="{DynamicResource TextDefaultBrush}"
                                 Margin="0,0,0,6"/>

                      <ItemsControl ItemsSource="{Binding Tools}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Grid Margin="0,0,0,10">
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                              </Grid.ColumnDefinitions>

                              <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="{Binding ToolName}"
                                           Foreground="{DynamicResource TextDefaultBrush}"/>
                                <TextBlock Text="{Binding CautionText}"
                                           FontSize="11"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextSubtleBrush}"
                                           Margin="0,2,0,0"
                                           Visibility="{Binding HasCaution, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                              </StackPanel>

                              <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <CheckBox Content="{loc:Str ToolCatalog_UntilClose}"
                                          IsChecked="{Binding AllowedForSession, Mode=TwoWay}"
                                          AutomationProperties.AutomationId="{Binding ToolName, StringFormat='Settings_Assistant_AllowedForSession_{0}'}"
                                          Margin="0,0,12,0"/>
                                <CheckBox Content="{loc:Str ToolCatalog_Always}"
                                          IsChecked="{Binding AllowedAlways, Mode=TwoWay}"
                                          AutomationProperties.AutomationId="{Binding ToolName, StringFormat='Settings_Assistant_AllowedAlways_{0}'}"/>
                              </StackPanel>
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ui:CardExpander>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- Meeting tab (beta) -->
      <TabItem Style="{DynamicResource SettingsInnerTabItemStyle}"
               AutomationProperties.AutomationId="Settings_Assistant_Tab_Meeting">
        <TabItem.Header>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="{loc:Str Settings_Meeting_Tab}" VerticalAlignment="Center"/>
            <Border Background="{DynamicResource WarnSoftBrush}"
                    CornerRadius="4"
                    Padding="5,0"
                    Margin="6,0,0,0"
                    VerticalAlignment="Center">
              <TextBlock Text="{loc:Str Settings_Beta_Badge}"
                         Foreground="{DynamicResource WarnBrush}"
                         FontSize="9.5"
                         FontWeight="SemiBold"/>
            </Border>
          </StackPanel>
        </TabItem.Header>
        <ScrollViewer VerticalScrollBarVisibility="Auto" DataContext="{Binding MeetingVm}">
          <StackPanel MaxWidth="640" HorizontalAlignment="Left">
            <!-- Per-speaker diarization (meetings) -->
            <StackPanel Margin="0,0,0,20">
              <TextBlock Text="{loc:Str Settings_Diarization_Section}"
                         Style="{StaticResource PiaSettingsSectionLabelStyle}"/>
              <CheckBox Content="{loc:Str Settings_Diarization_Enable}"
                        IsChecked="{Binding EnableMeetingDiarization}"
                        IsEnabled="{Binding Policy[EnableMeetingDiarization]}"
                        AutomationProperties.AutomationId="Settings_Assistant_EnableMeetingDiarization"
                        Margin="0,4,0,0"/>
              <TextBlock Text="{loc:Str Settings_Diarization_Enable_Description}"
                         Style="{StaticResource PiaSettingsDescriptionStyle}"
                         Margin="22,4,0,0"/>
              <CheckBox Content="{loc:Str Settings_Diarization_SmartAuto}"
                        IsChecked="{Binding MeetingSmartSpeakerDetection}"
                        AutomationProperties.AutomationId="Settings_Assistant_MeetingSmartSpeakerDetection"
                        IsEnabled="{Binding SmartSpeakerDetectionEditable}"
                        Margin="0,12,0,0"/>
              <TextBlock Text="{loc:Str Settings_Diarization_SmartAuto_Description}"
                         Style="{StaticResource PiaSettingsDescriptionStyle}"
                         Margin="22,4,0,0"/>
              <CheckBox Content="{loc:Str Settings_Diarization_SuppressLabels}"
                        IsChecked="{Binding MeetingSuppressSpeakerLabels}"
                        AutomationProperties.AutomationId="Settings_Assistant_MeetingSuppressSpeakerLabels"
                        IsEnabled="{Binding EnableMeetingDiarization}"
                        Margin="0,12,0,0"/>
              <TextBlock Text="{loc:Str Settings_Diarization_SuppressLabels_Description}"
                         Style="{StaticResource PiaSettingsDescriptionStyle}"
                         Margin="22,4,0,0"/>
            </StackPanel>

            <!-- Speaker-matching threshold -->
            <StackPanel Margin="0,0,0,20"
                        IsEnabled="{Binding EnableMeetingDiarization}"
                        Visibility="{Binding ShowManualTuning, Converter={StaticResource BooleanToVisibilityConverter}}">
              <TextBlock Text="{loc:Str Settings_Diarization_Threshold_Label}"
                         Style="{StaticResource PiaSettingsSectionLabelStyle}"/>
              <Slider HorizontalAlignment="Left"
                      Width="400"
                      Minimum="0.30"
                      Maximum="0.95"
                      TickFrequency="0.05"
                      IsSnapToTickEnabled="True"
                      Value="{Binding SpeakerEmbeddingThreshold, Mode=TwoWay}"
                      IsEnabled="{Binding Policy[SpeakerEmbeddingThreshold]}"
                      AutomationProperties.AutomationId="Settings_Assistant_SpeakerEmbeddingThreshold"
                      VerticalAlignment="Center"/>
              <TextBlock Text="{Binding SpeakerEmbeddingThresholdDisplay}"
                         Style="{StaticResource PiaSettingsDescriptionStyle}"/>
              <TextBlock Text="{loc:Str Settings_Diarization_Threshold_Description}"
                         Style="{StaticResource PiaSettingsDescriptionStyle}"
                         Margin="0,8,0,0"/>
            </StackPanel>

            <!-- Max speakers cap -->
            <StackPanel Margin="0,0,0,20"
                        IsEnabled="{Binding EnableMeetingDiarization}"
                        Visibility="{Binding ShowManualTuning, Converter={StaticResource BooleanToVisibilityConverter}}">
              <TextBlock Text="{loc:Str Settings_Diarization_MaxSpeakers_Label}"
                         Style="{StaticResource PiaSettingsSectionLabelStyle}"/>
              <Slider HorizontalAlignment="Left"
                      Width="400"
                      Minimum="0"
                      Maximum="12"
                      TickFrequency="1"
                      IsSnapToTickEnabled="True"
                      Value="{Binding MeetingMaxSpeakers, Mode=TwoWay}"
                      IsEnabled="{Binding Policy[MeetingMaxSpeakers]}"
                      AutomationProperties.AutomationId="Settings_Assistant_MeetingMaxSpeakers"
                      VerticalAlignment="Center"/>
              <TextBlock Text="{Binding MeetingMaxSpeakersDisplay}"
                         Style="{StaticResource PiaSettingsDescriptionStyle}"/>
              <TextBlock Text="{loc:Str Settings_Diarization_MaxSpeakers_Description}"
                         Style="{StaticResource PiaSettingsDescriptionStyle}"
                         Margin="0,8,0,0"/>
            </StackPanel>

            <!-- Minimum speech length -->
            <StackPanel Margin="0,0,0,20"
                        IsEnabled="{Binding EnableMeetingDiarization}"
                        Visibility="{Binding ShowManualTuning, Converter={StaticResource BooleanToVisibilityConverter}}">
              <TextBlock Text="{loc:Str Settings_Diarization_MinSpeech_Label}"
                         Style="{StaticResource PiaSettingsSectionLabelStyle}"/>
              <Slider HorizontalAlignment="Left"
                      Width="400"
                      Minimum="1.0"
                      Maximum="4.0"
                      TickFrequency="0.5"
                      IsSnapToTickEnabled="True"
                      Value="{Binding MeetingMinSpeechSeconds, Mode=TwoWay}"
                      IsEnabled="{Binding Policy[MeetingMinSpeechSeconds]}"
                      AutomationProperties.AutomationId="Settings_Assistant_MeetingMinSpeechSeconds"
                      VerticalAlignment="Center"/>
              <TextBlock Text="{Binding MeetingMinSpeechDisplay}"
                         Style="{StaticResource PiaSettingsDescriptionStyle}"/>
              <TextBlock Text="{loc:Str Settings_Diarization_MinSpeech_Description}"
                         Style="{StaticResource PiaSettingsDescriptionStyle}"
                         Margin="0,8,0,0"/>
            </StackPanel>

            <!-- Meeting browser -->
            <StackPanel Margin="0,0,0,20">
              <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <TextBlock Text="{loc:Str Settings_MeetingBrowser_Section}"
                           Style="{StaticResource PiaSettingsSectionLabelStyle}"
                           Margin="0"
                           VerticalAlignment="Center"/>
                <shared:PiaHelpHint Text="{loc:Str Settings_MeetingBrowser_Description}"
                                    IconSize="14"
                                    AutomationProperties.AutomationId="Settings_MeetingBrowser_Help"/>
              </StackPanel>
              <ComboBox ItemsSource="{Binding MeetingBrowserSelections}"
                        SelectedItem="{Binding MeetingBrowserSelection}"
                        IsEnabled="{Binding Policy[MeetingBrowserSelection]}"
                        AutomationProperties.AutomationId="Settings_Assistant_MeetingBrowser"
                        Width="400"
                        HorizontalAlignment="Left">
                <ComboBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding Converter={StaticResource EnumToLocalizedStringConverter}}"/>
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <CheckBox Content="{loc:Str Settings_MeetingBrowser_ShowWindow}"
                        IsChecked="{Binding MeetingAttendeeShowBrowserWindow}"
                        IsEnabled="{Binding Policy[MeetingAttendeeShowBrowserWindow]}"
                        AutomationProperties.AutomationId="Settings_Assistant_MeetingAttendeeShowBrowserWindow"
                        Margin="0,8,0,0"/>
              <TextBlock Text="{loc:Str Settings_MeetingBrowser_ShowWindow_Description}"
                         Style="{StaticResource PiaSettingsDescriptionStyle}"
                         Margin="22,4,0,0"/>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- Agent runs tab: the budget envelope an interactive Agent (Planned) run stops at (§5). -->
      <TabItem Header="{loc:Str Settings_Agent_Tab}" Style="{DynamicResource SettingsInnerTabItemStyle}"
               AutomationProperties.AutomationId="Settings_Assistant_Tab_Agent">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="4,8,16,16">
            <TextBlock Text="{loc:Str Settings_Agent_Section_Description}"
                       Style="{StaticResource PiaSettingsDescriptionStyle}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,16"/>

            <StackPanel Margin="0,0,0,20">
              <TextBlock Text="{loc:Str Settings_Agent_MaxSteps_Label}"
                         Style="{StaticResource PiaSettingsSectionLabelStyle}"/>
              <Slider HorizontalAlignment="Left" Width="400"
                      Minimum="1" Maximum="48"
                      TickFrequency="1" IsSnapToTickEnabled="True"
                      Value="{Binding AgentMaxSteps, Mode=TwoWay}"
                      IsEnabled="{Binding Policy[AgentMaxSteps]}"
                      AutomationProperties.AutomationId="Settings_Assistant_AgentMaxSteps"/>
              <TextBlock Text="{Binding AgentMaxStepsDisplay}"
                         Style="{StaticResource PiaSettingsDescriptionStyle}"/>
              <TextBlock Text="{loc:Str Settings_Agent_MaxSteps_Description}"
                         Style="{StaticResource PiaSettingsDescriptionStyle}"
                         TextWrapping="Wrap" Margin="0,2,0,0"/>
            </StackPanel>

            <StackPanel Margin="0,0,0,20">
              <TextBlock Text="{loc:Str Settings_Agent_MaxToolRounds_Label}"
                         Style="{StaticResource PiaSettingsSectionLabelStyle}"/>
              <Slider HorizontalAlignment="Left" Width="400"
                      Minimum="1" Maximum="48"
                      TickFrequency="1" IsSnapToTickEnabled="True"
                      Value="{Binding MaxToolRoundsPerStep, Mode=TwoWay}"
                      IsEnabled="{Binding Policy[MaxToolRoundsPerStep]}"
                      AutomationProperties.AutomationId="Settings_Assistant_MaxToolRoundsPerStep"/>
              <TextBlock Text="{Binding MaxToolRoundsDisplay}"
                         Style="{StaticResource PiaSettingsDescriptionStyle}"/>
              <TextBlock Text="{loc:Str Settings_Agent_MaxToolRounds_Description}"
                         Style="{StaticResource PiaSettingsDescriptionStyle}"
                         TextWrapping="Wrap" Margin="0,2,0,0"/>
            </StackPanel>

            <StackPanel Margin="0,0,0,20">
              <TextBlock Text="{loc:Str Settings_Agent_WallClock_Label}"
                         Style="{StaticResource PiaSettingsSectionLabelStyle}"/>
              <Slider HorizontalAlignment="Left" Width="400"
                      Minimum="1" Maximum="120"
                      TickFrequency="1" IsSnapToTickEnabled="True"
                      Value="{Binding AgentWallClockMinutes, Mode=TwoWay}"
                      IsEnabled="{Binding Policy[AgentWallClockMinutes]}"
                      AutomationProperties.AutomationId="Settings_Assistant_AgentWallClockMinutes"/>
              <TextBlock Text="{Binding AgentWallClockDisplay}"
                         Style="{StaticResource PiaSettingsDescriptionStyle}"/>
              <TextBlock Text="{loc:Str Settings_Agent_WallClock_Description}"
                         Style="{StaticResource PiaSettingsDescriptionStyle}"
                         TextWrapping="Wrap" Margin="0,2,0,0"/>
            </StackPanel>

            <StackPanel Margin="0,0,0,20">
              <TextBlock Text="{loc:Str Settings_Agent_MaxReplans_Label}"
                         Style="{StaticResource PiaSettingsSectionLabelStyle}"/>
              <Slider HorizontalAlignment="Left" Width="400"
                      Minimum="0" Maximum="5"
                      TickFrequency="1" IsSnapToTickEnabled="True"
                      Value="{Binding AgentMaxReplans, Mode=TwoWay}"
                      IsEnabled="{Binding Policy[AgentMaxReplans]}"
                      AutomationProperties.AutomationId="Settings_Assistant_AgentMaxReplans"/>
              <TextBlock Text="{Binding AgentMaxReplansDisplay}"
                         Style="{StaticResource PiaSettingsDescriptionStyle}"/>
              <TextBlock Text="{loc:Str Settings_Agent_MaxReplans_Description}"
                         Style="{StaticResource PiaSettingsDescriptionStyle}"
                         TextWrapping="Wrap" Margin="0,2,0,0"/>
            </StackPanel>

            <!-- Planning: global, applies to interactive AND unattended runs. -->
            <TextBlock Text="{loc:Str Settings_Agent_Planning_Section_Header}"
                       Style="{StaticResource PiaSettingsSectionLabelStyle}"
                       Margin="0,12,0,0"/>
            <StackPanel Margin="0,0,0,20">
              <CheckBox Content="{loc:Str Settings_Agent_PlanReasoningTurn}"
                        IsChecked="{Binding AgentPlanReasoningTurnEnabled}"
                        IsEnabled="{Binding Policy[AgentPlanReasoningTurnEnabled]}"
                        AutomationProperties.AutomationId="Settings_Assistant_AgentPlanReasoningTurnEnabled"
                        Margin="0,8,0,0"/>
              <TextBlock Text="{loc:Str Settings_Agent_PlanReasoningTurn_Description}"
                         Style="{StaticResource PiaSettingsDescriptionStyle}"
                         TextWrapping="Wrap"
                         Margin="22,4,0,0"/>
            </StackPanel>

            <!-- Autonomy (Batch 04): global; applies to interactive AND unattended agent runs. Placed BEFORE
                 the scheduled block so a global toggle does not read as a fourth unattended option. -->
            <TextBlock Text="{loc:Str Settings_Agent_Autonomy_Section_Header}"
                       Style="{StaticResource PiaSettingsSectionLabelStyle}"
                       Margin="0,12,0,0"/>
            <StackPanel Margin="0,0,0,20">
              <CheckBox Content="{loc:Str Settings_Agent_AutoApproveBuiltInWrites}"
                        IsChecked="{Binding AgentRunAutoApproveBuiltInWrites}"
                        IsEnabled="{Binding Policy[AgentRunAutoApproveBuiltInWrites]}"
                        AutomationProperties.AutomationId="Settings_Assistant_Agent_AutoApproveBuiltInWrites"
                        Margin="0,8,0,0"/>
              <TextBlock Text="{loc:Str Settings_Agent_AutoApproveBuiltInWrites_Description}"
                         Style="{StaticResource PiaSettingsDescriptionStyle}"
                         TextWrapping="Wrap"
                         Margin="22,4,0,0"/>
            </StackPanel>

            <!-- Step specialists (Batch 07): global; the roster IS the opt-in for per-step personas (D1),
                 so it is placed with the other global Agent knobs, before the Scheduled section, for the
                 same reason the Autonomy block above is (R28). -->
            <StackPanel Orientation="Horizontal" Margin="0,12,0,6">
              <TextBlock Text="{loc:Str Settings_Agent_Roster_Section_Header}"
                         Style="{StaticResource PiaSettingsSectionLabelStyle}"
                         Margin="0"
                         VerticalAlignment="Center"/>
              <shared:PiaHelpHint Text="{loc:Str Settings_Agent_Roster_Description}"
                                  IconSize="14"
                                  AutomationProperties.AutomationId="Settings_Agent_Roster_Help"/>
            </StackPanel>
            <StackPanel Margin="0,0,0,20">
              <TextBlock Text="{loc:Str Settings_Agent_Roster_Empty}"
                         Style="{StaticResource PiaSettingsDescriptionStyle}"
                         FontStyle="Italic"
                         TextWrapping="Wrap"
                         Margin="0,0,0,8"
                         Visibility="{Binding HasSelectedRoster, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
              <ItemsControl ItemsSource="{Binding AgentRosterOptions}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                              AutomationProperties.AutomationId="{Binding Id, StringFormat='Settings_Assistant_AgentRoster_{0}'}"
                              Margin="0,4,0,0">
                      <StackPanel Orientation="Horizontal">
                        <controls:PersonaGlyph PersonaId="{Binding Id}"
                                               Emoji="{Binding Emoji}"
                                               GlyphSize="16"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding Name}"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextDefaultBrush}"/>
                      </StackPanel>
                    </CheckBox>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <!-- Scheduled / background-run budget (§17.5): the separate envelope an unattended run stops at. -->
            <StackPanel Orientation="Horizontal" Margin="0,12,0,16">
              <TextBlock Text="{loc:Str Settings_Scheduled_Section_Header}"
                         Style="{StaticResource PiaSettingsSectionLabelStyle}"
                         Margin="0"
                         VerticalAlignment="Center"/>
              <shared:PiaHelpHint Text="{loc:Str Settings_Scheduled_Section_Description}"
                                  IconSize="14"
                                  AutomationProperties.AutomationId="Settings_Scheduled_Help"/>
            </StackPanel>

            <StackPanel Margin="0,0,0,20">
              <TextBlock Text="{loc:Str Settings_Scheduled_MaxSteps_Label}"
                         Style="{StaticResource PiaSettingsSectionLabelStyle}"/>
              <Slider HorizontalAlignment="Left" Width="400"
                      Minimum="1" Maximum="48"
                      TickFrequency="1" IsSnapToTickEnabled="True"
                      Value="{Binding ScheduledMaxSteps, Mode=TwoWay}"
                      IsEnabled="{Binding Policy[ScheduledMaxSteps]}"
                      AutomationProperties.AutomationId="Settings_Assistant_ScheduledMaxSteps"/>
              <TextBlock Text="{Binding ScheduledMaxStepsDisplay}"
                         Style="{StaticResource PiaSettingsDescriptionStyle}"/>
            </StackPanel>

            <StackPanel Margin="0,0,0,20">
              <TextBlock Text="{loc:Str Settings_Scheduled_WallClock_Label}"
                         Style="{StaticResource PiaSettingsSectionLabelStyle}"/>
              <Slider HorizontalAlignment="Left" Width="400"
                      Minimum="1" Maximum="120"
                      TickFrequency="1" IsSnapToTickEnabled="True"
                      Value="{Binding ScheduledWallClockMinutes, Mode=TwoWay}"
                      IsEnabled="{Binding Policy[ScheduledWallClockMinutes]}"
                      AutomationProperties.AutomationId="Settings_Assistant_ScheduledWallClockMinutes"/>
              <TextBlock Text="{Binding ScheduledWallClockDisplay}"
                         Style="{StaticResource PiaSettingsDescriptionStyle}"/>
            </StackPanel>

            <StackPanel Margin="0,0,0,20">
              <TextBlock Text="{loc:Str Settings_Scheduled_MaxReplans_Label}"
                         Style="{StaticResource PiaSettingsSectionLabelStyle}"/>
              <Slider HorizontalAlignment="Left" Width="400"
                      Minimum="0" Maximum="5"
                      TickFrequency="1" IsSnapToTickEnabled="True"
                      Value="{Binding ScheduledMaxReplans, Mode=TwoWay}"
                      IsEnabled="{Binding Policy[ScheduledMaxReplans]}"
                      AutomationProperties.AutomationId="Settings_Assistant_ScheduledMaxReplans"/>
              <TextBlock Text="{Binding ScheduledMaxReplansDisplay}"
                         Style="{StaticResource PiaSettingsDescriptionStyle}"/>
            </StackPanel>

            <!-- T1-1: a WIDTH, not a budget — how many unattended runs execute at once. Min/Max mirror
                 AppSettings.MinParallelBackgroundRuns / MaxParallelBackgroundRunsCap; the ViewModel clamps on
                 the same pair, and the launcher's pool resizes live on the save this slider triggers. -->
            <StackPanel Margin="0,0,0,20">
              <TextBlock Text="{loc:Str Settings_Scheduled_ParallelRuns_Label}"
                         Style="{StaticResource PiaSettingsSectionLabelStyle}"/>
              <Slider HorizontalAlignment="Left" Width="400"
                      Minimum="1" Maximum="8"
                      TickFrequency="1" IsSnapToTickEnabled="True"
                      Value="{Binding MaxParallelBackgroundRuns, Mode=TwoWay}"
                      IsEnabled="{Binding Policy[MaxParallelBackgroundRuns]}"
                      AutomationProperties.AutomationId="Settings_Assistant_MaxParallelBackgroundRuns"/>
              <TextBlock Text="{Binding MaxParallelBackgroundRunsDisplay}"
                         Style="{StaticResource PiaSettingsDescriptionStyle}"/>
              <TextBlock Text="{loc:Str Settings_Scheduled_ParallelRuns_Description}"
                         Style="{StaticResource PiaSettingsDescriptionStyle}"
                         TextWrapping="Wrap"/>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>
  </Grid>
</UserControl>

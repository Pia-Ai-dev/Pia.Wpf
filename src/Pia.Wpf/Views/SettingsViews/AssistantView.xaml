<UserControl x:Class="Pia.Views.SettingsViews.AssistantView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:converters="clr-namespace:Pia.Converters"
             xmlns:controls="clr-namespace:Pia.Controls"
             xmlns:local="clr-namespace:Pia.Views.SettingsViews"
             xmlns:loc="clr-namespace:Pia.Localization">
  <UserControl.Resources>
    <converters:EnumToLocalizedStringConverter x:Key="EnumToLocalizedStringConverter"/>
  </UserControl.Resources>
  <Grid>
    <TabControl SelectedIndex="{Binding SelectedInnerTabIndex}" Style="{DynamicResource SettingsInnerTabControlStyle}">
      <!-- General tab -->
      <TabItem Header="{loc:Str Settings_InnerTab_General}" Style="{DynamicResource SettingsInnerTabItemStyle}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel MaxWidth="640" HorizontalAlignment="Left">
      <!-- Provider hint (the default provider for this mode is set on the Providers tab) -->
      <StackPanel Margin="0,0,0,20">
        <TextBlock Text="{loc:Str Settings_Tab_Providers}"
                   Style="{StaticResource PiaSettingsSectionLabelStyle}"/>
        <TextBlock Text="{loc:Str Settings_ProviderHint}"
                   Style="{StaticResource PiaSettingsDescriptionStyle}"/>
        <ui:HyperlinkButton Content="{loc:Str Settings_ProviderHint_Link}"
                            Command="{Binding ProvidersVm.GoToProvidersTabCommand}"
                            HorizontalAlignment="Left"
                            Margin="0,4,0,0"/>
      </StackPanel>

      <!-- Assistant behavior -->
      <TextBlock Text="{loc:Str Settings_Assistant_BehaviorSection}"
                 Style="{StaticResource PiaSettingsSectionLabelStyle}"
                 Margin="0,0,0,8"/>

      <!-- Default Window Mode -->
      <StackPanel Margin="0,0,0,20">
        <TextBlock Text="{loc:Str Settings_DefaultWindowMode}"
                   Style="{StaticResource PiaSettingsSectionLabelStyle}"/>
        <ComboBox ItemsSource="{Binding WindowModes}"
                  SelectedItem="{Binding DefaultWindowMode}"
                  Width="400"
                  HorizontalAlignment="Left">
          <ComboBox.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding Converter={StaticResource EnumToLocalizedStringConverter}}"/>
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <TextBlock Text="{loc:Str Settings_DefaultWindowMode_Description}"
                   Style="{StaticResource PiaSettingsDescriptionStyle}"/>
      </StackPanel>

      <!-- Follow-up Suggestion Chips -->
      <StackPanel Margin="0,0,0,20">
        <CheckBox Content="{loc:Str Settings_AssistantSuggestions}"
                  IsChecked="{Binding SuggestionsEnabled}"/>
        <TextBlock Text="{loc:Str Settings_AssistantSuggestions_Description}"
                   Style="{StaticResource PiaSettingsDescriptionStyle}"
                   Margin="22,4,0,0"/>
      </StackPanel>

      <!-- Files Folder (sandboxed) + nested memory vault -->
      <StackPanel Margin="0,0,0,20">
        <TextBlock Text="{loc:Str Settings_AssistantFilesFolder}"
                   Style="{StaticResource PiaSettingsSectionLabelStyle}"/>
        <Grid HorizontalAlignment="Left">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="400"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <ui:TextBox Grid.Column="0"
                      Text="{Binding FilesFolder}"
                      IsReadOnly="True"
                      PlaceholderText="{loc:Str Settings_AssistantFilesFolder_Placeholder}"
                      PlaceholderEnabled="True"/>
          <ui:Button Grid.Column="1"
                     Content="{loc:Str Settings_AssistantFilesFolder_Change}"
                     Command="{Binding ChangeFilesFolderCommand}"
                     Margin="8,0,0,0"/>
        </Grid>
        <TextBlock Text="{Binding VaultLocationDisplay}"
                   Style="{StaticResource PiaSettingsDescriptionStyle}"
                   Margin="0,6,0,0"/>
        <CheckBox Content="{loc:Str Settings_AssistantFileToolsEnabled}"
                  IsChecked="{Binding FileToolsEnabled}"
                  Margin="0,10,0,0"/>
        <CheckBox Content="{loc:Str Settings_AssistantGitToolsEnabled}"
                  IsChecked="{Binding GitToolsEnabled}"
                  IsEnabled="{Binding GitToolsAvailable}"
                  Margin="0,10,0,0"/>
        <TextBlock Text="{loc:Str Settings_AssistantGitToolsUnavailable}"
                   Style="{StaticResource PiaSettingsDescriptionStyle}"
                   Visibility="{Binding GitToolsAvailable, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                   Margin="22,2,0,0"/>
        <TextBlock Text="{loc:Str Settings_AssistantFilesFolder_Description}"
                   Style="{StaticResource PiaSettingsDescriptionStyle}"
                   Margin="22,4,0,0"/>
      </StackPanel>

      <!-- Default working directory for new chats (relative to the files folder) -->
      <StackPanel Margin="0,0,0,20">
        <TextBlock Text="{loc:Str Settings_Assistant_DefaultWorkingDirectory}"
                   Style="{StaticResource PiaSettingsSectionLabelStyle}"/>
        <ComboBox Width="400"
                  HorizontalAlignment="Left"
                  IsEditable="True"
                  Text="{Binding DefaultWorkingDirectory, UpdateSourceTrigger=LostFocus}"
                  ItemsSource="{Binding AvailableWorkingDirectories}"/>
        <TextBlock Text="{loc:Str Settings_Assistant_DefaultWorkingDirectory_Description}"
                   Style="{StaticResource PiaSettingsDescriptionStyle}"
                   Margin="0,6,0,0"/>
      </StackPanel>

      <!-- Chat history -->
      <TextBlock Text="{loc:Str Settings_Chat_Section}"
                 Style="{StaticResource PiaSettingsSectionLabelStyle}"
                 Margin="0,8,0,8"/>

      <StackPanel Margin="0,0,0,20">
        <CheckBox Content="{loc:Str Settings_Chat_HistoryEnabled}"
                  IsChecked="{Binding ChatHistoryEnabled}"/>
        <TextBlock Text="{loc:Str Settings_Chat_HistoryEnabled_Description}"
                   Style="{StaticResource PiaSettingsDescriptionStyle}"
                   Margin="22,4,0,0"/>
      </StackPanel>

      <StackPanel Margin="0,0,0,20"
                  IsEnabled="{Binding ChatHistoryEnabled}">
        <TextBlock Text="{loc:Str Settings_Chat_RetentionDays_Label}"
                   Style="{StaticResource PiaSettingsSectionLabelStyle}"/>
        <Slider HorizontalAlignment="Left"
                Width="400"
                Minimum="1"
                Maximum="365"
                TickFrequency="1"
                IsSnapToTickEnabled="True"
                Value="{Binding ChatHistoryRetentionDays, Mode=TwoWay}"
                VerticalAlignment="Center"/>
        <TextBlock Text="{Binding RetentionDaysDisplay}"
                   Style="{StaticResource PiaSettingsDescriptionStyle}"/>
      </StackPanel>

      <StackPanel Margin="0,0,0,20">
        <CheckBox Content="{loc:Str Settings_Chat_AutoTitle}"
                  IsChecked="{Binding ChatAutoTitleEnabled}"/>
        <TextBlock Text="{loc:Str Settings_Chat_AutoTitle_Hint}"
                   Style="{StaticResource PiaSettingsDescriptionStyle}"
                   Margin="22,4,0,0"/>
      </StackPanel>

      <StackPanel Margin="0,0,0,20">
        <ui:Button Content="{loc:Str Settings_Chat_DeleteAllNow}"
                   Command="{Binding DeleteAllChatHistoryCommand}"
                   Appearance="Caution"
                   HorizontalAlignment="Left"/>
      </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- Personas tab -->
      <TabItem Header="{loc:Str Settings_Tab_Personas}" Style="{DynamicResource SettingsInnerTabItemStyle}">
        <local:PersonasView DataContext="{Binding PersonasVm}"/>
      </TabItem>

      <!-- Tool access tab (tool-permission revocation surface — design §7) -->
      <TabItem Header="{loc:Str Settings_Tab_ToolPermissions}" Style="{DynamicResource SettingsInnerTabItemStyle}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" DataContext="{Binding ToolPermissionsVm}">
          <StackPanel MaxWidth="640" HorizontalAlignment="Left">
            <TextBlock Text="{loc:Str Settings_ToolPermissions_Title}"
                       Style="{StaticResource PiaSettingsSectionLabelStyle}"
                       Margin="0,0,0,4"/>
            <TextBlock Text="{loc:Str Settings_ToolPermissions_Description}"
                       Style="{StaticResource PiaSettingsDescriptionStyle}"
                       Margin="0,0,0,12"/>

            <!-- Empty state -->
            <TextBlock Text="{loc:Str ToolPermissions_Empty}"
                       Style="{StaticResource PiaSettingsDescriptionStyle}"
                       Visibility="{Binding HasGrants, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>

            <!-- Grant list -->
            <ItemsControl ItemsSource="{Binding Grants}"
                          Visibility="{Binding HasGrants, Converter={StaticResource BooleanToVisibilityConverter}}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Style="{StaticResource PiaSettingsCardStyle}"
                          Padding="14,12"
                          Margin="0,0,0,8">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>

                      <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextDefaultBrush}"
                                   Text="{Binding ToolName}"/>
                        <TextBlock FontSize="11"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   Margin="0,2,0,0">
                          <Run Text="{loc:Str ToolPermissions_Column_Plugin}"/>
                          <Run Text=" "/>
                          <Run Text="{Binding PluginName, Mode=OneWay}"/>
                        </TextBlock>
                        <TextBlock FontSize="11"
                                   Foreground="{DynamicResource TextSubtleBrush}"
                                   Margin="0,2,0,0">
                          <Run Text="{loc:Str ToolPermissions_Column_GrantedAt}"/>
                          <Run Text=" "/>
                          <Run Text="{Binding GrantedAt, StringFormat='{}{0:g}', Mode=OneWay}"/>
                        </TextBlock>
                      </StackPanel>

                      <ui:Button Grid.Column="1"
                                 Content="{loc:Str ToolPermissions_Revoke}"
                                 Appearance="Secondary"
                                 Foreground="{DynamicResource PiaDangerBrush}"
                                 VerticalAlignment="Center"
                                 Command="{Binding DataContext.RevokeCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                 CommandParameter="{Binding}"/>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- Meeting tab (beta) -->
      <TabItem Style="{DynamicResource SettingsInnerTabItemStyle}">
        <TabItem.Header>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="{loc:Str Settings_Meeting_Tab}" VerticalAlignment="Center"/>
            <Border Background="{DynamicResource WarnSoftBrush}"
                    CornerRadius="4"
                    Padding="5,0"
                    Margin="6,0,0,0"
                    VerticalAlignment="Center">
              <TextBlock Text="{loc:Str Settings_Beta_Badge}"
                         Foreground="{DynamicResource WarnBrush}"
                         FontSize="9.5"
                         FontWeight="SemiBold"/>
            </Border>
          </StackPanel>
        </TabItem.Header>
        <ScrollViewer VerticalScrollBarVisibility="Auto" DataContext="{Binding MeetingVm}">
          <StackPanel MaxWidth="640" HorizontalAlignment="Left">
            <!-- Per-speaker diarization (meetings) -->
            <StackPanel Margin="0,0,0,20">
              <TextBlock Text="{loc:Str Settings_Diarization_Section}"
                         Style="{StaticResource PiaSettingsSectionLabelStyle}"/>
              <CheckBox Content="{loc:Str Settings_Diarization_Enable}"
                        IsChecked="{Binding EnableMeetingDiarization}"
                        Margin="0,4,0,0"/>
              <TextBlock Text="{loc:Str Settings_Diarization_Enable_Description}"
                         Style="{StaticResource PiaSettingsDescriptionStyle}"
                         Margin="22,4,0,0"/>
              <CheckBox Content="{loc:Str Settings_Diarization_SmartAuto}"
                        IsChecked="{Binding MeetingSmartSpeakerDetection}"
                        IsEnabled="{Binding EnableMeetingDiarization}"
                        Margin="0,12,0,0"/>
              <TextBlock Text="{loc:Str Settings_Diarization_SmartAuto_Description}"
                         Style="{StaticResource PiaSettingsDescriptionStyle}"
                         Margin="22,4,0,0"/>
            </StackPanel>

            <!-- Speaker-matching threshold -->
            <StackPanel Margin="0,0,0,20"
                        IsEnabled="{Binding EnableMeetingDiarization}"
                        Visibility="{Binding ShowManualTuning, Converter={StaticResource BooleanToVisibilityConverter}}">
              <TextBlock Text="{loc:Str Settings_Diarization_Threshold_Label}"
                         Style="{StaticResource PiaSettingsSectionLabelStyle}"/>
              <Slider HorizontalAlignment="Left"
                      Width="400"
                      Minimum="0.30"
                      Maximum="0.95"
                      TickFrequency="0.05"
                      IsSnapToTickEnabled="True"
                      Value="{Binding SpeakerEmbeddingThreshold, Mode=TwoWay}"
                      VerticalAlignment="Center"/>
              <TextBlock Text="{Binding SpeakerEmbeddingThresholdDisplay}"
                         Style="{StaticResource PiaSettingsDescriptionStyle}"/>
              <TextBlock Text="{loc:Str Settings_Diarization_Threshold_Description}"
                         Style="{StaticResource PiaSettingsDescriptionStyle}"
                         Margin="0,8,0,0"/>
            </StackPanel>

            <!-- Max speakers cap -->
            <StackPanel Margin="0,0,0,20"
                        IsEnabled="{Binding EnableMeetingDiarization}"
                        Visibility="{Binding ShowManualTuning, Converter={StaticResource BooleanToVisibilityConverter}}">
              <TextBlock Text="{loc:Str Settings_Diarization_MaxSpeakers_Label}"
                         Style="{StaticResource PiaSettingsSectionLabelStyle}"/>
              <Slider HorizontalAlignment="Left"
                      Width="400"
                      Minimum="0"
                      Maximum="12"
                      TickFrequency="1"
                      IsSnapToTickEnabled="True"
                      Value="{Binding MeetingMaxSpeakers, Mode=TwoWay}"
                      VerticalAlignment="Center"/>
              <TextBlock Text="{Binding MeetingMaxSpeakersDisplay}"
                         Style="{StaticResource PiaSettingsDescriptionStyle}"/>
              <TextBlock Text="{loc:Str Settings_Diarization_MaxSpeakers_Description}"
                         Style="{StaticResource PiaSettingsDescriptionStyle}"
                         Margin="0,8,0,0"/>
            </StackPanel>

            <!-- Minimum speech length -->
            <StackPanel Margin="0,0,0,20"
                        IsEnabled="{Binding EnableMeetingDiarization}"
                        Visibility="{Binding ShowManualTuning, Converter={StaticResource BooleanToVisibilityConverter}}">
              <TextBlock Text="{loc:Str Settings_Diarization_MinSpeech_Label}"
                         Style="{StaticResource PiaSettingsSectionLabelStyle}"/>
              <Slider HorizontalAlignment="Left"
                      Width="400"
                      Minimum="1.0"
                      Maximum="4.0"
                      TickFrequency="0.5"
                      IsSnapToTickEnabled="True"
                      Value="{Binding MeetingMinSpeechSeconds, Mode=TwoWay}"
                      VerticalAlignment="Center"/>
              <TextBlock Text="{Binding MeetingMinSpeechDisplay}"
                         Style="{StaticResource PiaSettingsDescriptionStyle}"/>
              <TextBlock Text="{loc:Str Settings_Diarization_MinSpeech_Description}"
                         Style="{StaticResource PiaSettingsDescriptionStyle}"
                         Margin="0,8,0,0"/>
            </StackPanel>

            <!-- Meeting browser -->
            <StackPanel Margin="0,0,0,20">
              <TextBlock Text="{loc:Str Settings_MeetingBrowser_Section}"
                         Style="{StaticResource PiaSettingsSectionLabelStyle}"/>
              <ComboBox ItemsSource="{Binding MeetingBrowserSelections}"
                        SelectedItem="{Binding MeetingBrowserSelection}"
                        Width="400"
                        HorizontalAlignment="Left">
                <ComboBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding Converter={StaticResource EnumToLocalizedStringConverter}}"/>
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <TextBlock Text="{loc:Str Settings_MeetingBrowser_Description}"
                         Style="{StaticResource PiaSettingsDescriptionStyle}"/>
              <CheckBox Content="{loc:Str Settings_MeetingBrowser_ShowWindow}"
                        IsChecked="{Binding MeetingAttendeeShowBrowserWindow}"
                        Margin="0,8,0,0"/>
              <TextBlock Text="{loc:Str Settings_MeetingBrowser_ShowWindow_Description}"
                         Style="{StaticResource PiaSettingsDescriptionStyle}"
                         Margin="22,4,0,0"/>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- Agent runs tab: the budget envelope an interactive Agent (Planned) run stops at (§5). -->
      <TabItem Header="{loc:Str Settings_Agent_Tab}" Style="{DynamicResource SettingsInnerTabItemStyle}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="4,8,16,16">
            <TextBlock Text="{loc:Str Settings_Agent_Section_Description}"
                       Style="{StaticResource PiaSettingsDescriptionStyle}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,16"/>

            <StackPanel Margin="0,0,0,20">
              <TextBlock Text="{loc:Str Settings_Agent_MaxSteps_Label}"
                         Style="{StaticResource PiaSettingsSectionLabelStyle}"/>
              <Slider HorizontalAlignment="Left" Width="400"
                      Minimum="1" Maximum="48"
                      TickFrequency="1" IsSnapToTickEnabled="True"
                      Value="{Binding AgentMaxSteps, Mode=TwoWay}"/>
              <TextBlock Text="{Binding AgentMaxStepsDisplay}"
                         Style="{StaticResource PiaSettingsDescriptionStyle}"/>
              <TextBlock Text="{loc:Str Settings_Agent_MaxSteps_Description}"
                         Style="{StaticResource PiaSettingsDescriptionStyle}"
                         TextWrapping="Wrap" Margin="0,2,0,0"/>
            </StackPanel>

            <StackPanel Margin="0,0,0,20">
              <TextBlock Text="{loc:Str Settings_Agent_WallClock_Label}"
                         Style="{StaticResource PiaSettingsSectionLabelStyle}"/>
              <Slider HorizontalAlignment="Left" Width="400"
                      Minimum="1" Maximum="120"
                      TickFrequency="1" IsSnapToTickEnabled="True"
                      Value="{Binding AgentWallClockMinutes, Mode=TwoWay}"/>
              <TextBlock Text="{Binding AgentWallClockDisplay}"
                         Style="{StaticResource PiaSettingsDescriptionStyle}"/>
              <TextBlock Text="{loc:Str Settings_Agent_WallClock_Description}"
                         Style="{StaticResource PiaSettingsDescriptionStyle}"
                         TextWrapping="Wrap" Margin="0,2,0,0"/>
            </StackPanel>

            <StackPanel Margin="0,0,0,20">
              <TextBlock Text="{loc:Str Settings_Agent_MaxReplans_Label}"
                         Style="{StaticResource PiaSettingsSectionLabelStyle}"/>
              <Slider HorizontalAlignment="Left" Width="400"
                      Minimum="0" Maximum="5"
                      TickFrequency="1" IsSnapToTickEnabled="True"
                      Value="{Binding AgentMaxReplans, Mode=TwoWay}"/>
              <TextBlock Text="{Binding AgentMaxReplansDisplay}"
                         Style="{StaticResource PiaSettingsDescriptionStyle}"/>
              <TextBlock Text="{loc:Str Settings_Agent_MaxReplans_Description}"
                         Style="{StaticResource PiaSettingsDescriptionStyle}"
                         TextWrapping="Wrap" Margin="0,2,0,0"/>
            </StackPanel>

            <!-- Planning: global, applies to interactive AND unattended runs. -->
            <TextBlock Text="{loc:Str Settings_Agent_Planning_Section_Header}"
                       Style="{StaticResource PiaSettingsSectionLabelStyle}"
                       Margin="0,12,0,0"/>
            <StackPanel Margin="0,0,0,20">
              <CheckBox Content="{loc:Str Settings_Agent_PlanReasoningTurn}"
                        IsChecked="{Binding AgentPlanReasoningTurnEnabled}"
                        Margin="0,8,0,0"/>
              <TextBlock Text="{loc:Str Settings_Agent_PlanReasoningTurn_Description}"
                         Style="{StaticResource PiaSettingsDescriptionStyle}"
                         TextWrapping="Wrap"
                         Margin="22,4,0,0"/>
            </StackPanel>

            <!-- Autonomy (Batch 04): global; applies to interactive AND unattended agent runs. Placed BEFORE
                 the scheduled block so a global toggle does not read as a fourth unattended option. -->
            <TextBlock Text="{loc:Str Settings_Agent_Autonomy_Section_Header}"
                       Style="{StaticResource PiaSettingsSectionLabelStyle}"
                       Margin="0,12,0,0"/>
            <StackPanel Margin="0,0,0,20">
              <CheckBox Content="{loc:Str Settings_Agent_AutoApproveBuiltInWrites}"
                        IsChecked="{Binding AgentRunAutoApproveBuiltInWrites}"
                        Margin="0,8,0,0"/>
              <TextBlock Text="{loc:Str Settings_Agent_AutoApproveBuiltInWrites_Description}"
                         Style="{StaticResource PiaSettingsDescriptionStyle}"
                         TextWrapping="Wrap"
                         Margin="22,4,0,0"/>
            </StackPanel>

            <!-- Step specialists (Batch 07): global; the roster IS the opt-in for per-step personas (D1),
                 so it is placed with the other global Agent knobs, before the Scheduled section, for the
                 same reason the Autonomy block above is (R28). -->
            <TextBlock Text="{loc:Str Settings_Agent_Roster_Section_Header}"
                       Style="{StaticResource PiaSettingsSectionLabelStyle}"
                       Margin="0,12,0,0"/>
            <StackPanel Margin="0,0,0,20">
              <TextBlock Text="{loc:Str Settings_Agent_Roster_Description}"
                         Style="{StaticResource PiaSettingsDescriptionStyle}"
                         TextWrapping="Wrap"
                         Margin="0,4,0,8"/>
              <TextBlock Text="{loc:Str Settings_Agent_Roster_Empty}"
                         Style="{StaticResource PiaSettingsDescriptionStyle}"
                         FontStyle="Italic"
                         TextWrapping="Wrap"
                         Margin="0,0,0,8"
                         Visibility="{Binding HasSelectedRoster, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
              <ItemsControl ItemsSource="{Binding AgentRosterOptions}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                              Margin="0,4,0,0">
                      <StackPanel Orientation="Horizontal">
                        <controls:PersonaGlyph PersonaId="{Binding Id}"
                                               Emoji="{Binding Emoji}"
                                               GlyphSize="16"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding Name}"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextDefaultBrush}"/>
                      </StackPanel>
                    </CheckBox>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <!-- Scheduled / background-run budget (§17.5): the separate envelope an unattended run stops at. -->
            <TextBlock Text="{loc:Str Settings_Scheduled_Section_Header}"
                       Style="{StaticResource PiaSettingsSectionLabelStyle}"
                       Margin="0,12,0,0"/>
            <TextBlock Text="{loc:Str Settings_Scheduled_Section_Description}"
                       Style="{StaticResource PiaSettingsDescriptionStyle}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,16"/>

            <StackPanel Margin="0,0,0,20">
              <TextBlock Text="{loc:Str Settings_Scheduled_MaxSteps_Label}"
                         Style="{StaticResource PiaSettingsSectionLabelStyle}"/>
              <Slider HorizontalAlignment="Left" Width="400"
                      Minimum="1" Maximum="48"
                      TickFrequency="1" IsSnapToTickEnabled="True"
                      Value="{Binding ScheduledMaxSteps, Mode=TwoWay}"/>
              <TextBlock Text="{Binding ScheduledMaxStepsDisplay}"
                         Style="{StaticResource PiaSettingsDescriptionStyle}"/>
            </StackPanel>

            <StackPanel Margin="0,0,0,20">
              <TextBlock Text="{loc:Str Settings_Scheduled_WallClock_Label}"
                         Style="{StaticResource PiaSettingsSectionLabelStyle}"/>
              <Slider HorizontalAlignment="Left" Width="400"
                      Minimum="1" Maximum="120"
                      TickFrequency="1" IsSnapToTickEnabled="True"
                      Value="{Binding ScheduledWallClockMinutes, Mode=TwoWay}"/>
              <TextBlock Text="{Binding ScheduledWallClockDisplay}"
                         Style="{StaticResource PiaSettingsDescriptionStyle}"/>
            </StackPanel>

            <StackPanel Margin="0,0,0,20">
              <TextBlock Text="{loc:Str Settings_Scheduled_MaxReplans_Label}"
                         Style="{StaticResource PiaSettingsSectionLabelStyle}"/>
              <Slider HorizontalAlignment="Left" Width="400"
                      Minimum="0" Maximum="5"
                      TickFrequency="1" IsSnapToTickEnabled="True"
                      Value="{Binding ScheduledMaxReplans, Mode=TwoWay}"/>
              <TextBlock Text="{Binding ScheduledMaxReplansDisplay}"
                         Style="{StaticResource PiaSettingsDescriptionStyle}"/>
            </StackPanel>

            <!-- T1-1: a WIDTH, not a budget — how many unattended runs execute at once. Min/Max mirror
                 AppSettings.MinParallelBackgroundRuns / MaxParallelBackgroundRunsCap; the ViewModel clamps on
                 the same pair, and the launcher's pool resizes live on the save this slider triggers. -->
            <StackPanel Margin="0,0,0,20">
              <TextBlock Text="{loc:Str Settings_Scheduled_ParallelRuns_Label}"
                         Style="{StaticResource PiaSettingsSectionLabelStyle}"/>
              <Slider HorizontalAlignment="Left" Width="400"
                      Minimum="1" Maximum="8"
                      TickFrequency="1" IsSnapToTickEnabled="True"
                      Value="{Binding MaxParallelBackgroundRuns, Mode=TwoWay}"/>
              <TextBlock Text="{Binding MaxParallelBackgroundRunsDisplay}"
                         Style="{StaticResource PiaSettingsDescriptionStyle}"/>
              <TextBlock Text="{loc:Str Settings_Scheduled_ParallelRuns_Description}"
                         Style="{StaticResource PiaSettingsDescriptionStyle}"
                         TextWrapping="Wrap"/>
            </StackPanel>

            <!-- Scheduled jobs (Batch 09). Re-rooted to its own sub-ViewModel, the same shape PersonasVm,
                 ToolPermissionsVm and MeetingVm use. Placed directly under the budget sliders on purpose:
                 those sliders ARE this section's budget (D1 — budget and autonomy are global, not per job),
                 so the read-only context the spec asks for is the block immediately above rather than a
                 duplicate set of fields. -->
            <StackPanel DataContext="{Binding ScheduledJobsVm}" Margin="0,8,0,20">
              <TextBlock Text="{loc:Str Settings_ScheduledJobs_Section_Header}"
                         Style="{StaticResource PiaSettingsSectionLabelStyle}"/>
              <TextBlock Text="{loc:Str Settings_ScheduledJobs_Section_Description}"
                         Style="{StaticResource PiaSettingsDescriptionStyle}"
                         TextWrapping="Wrap"
                         Margin="0,4,0,8"/>

              <TextBlock Text="{Binding StatusMessage}"
                         Style="{StaticResource PiaSettingsDescriptionStyle}"
                         TextWrapping="Wrap"
                         Margin="0,0,0,8"
                         Visibility="{Binding HasStatusMessage, Converter={StaticResource BooleanToVisibilityConverter}}"/>

              <TextBlock Text="{loc:Str Settings_ScheduledJobs_Empty}"
                         Style="{StaticResource PiaSettingsDescriptionStyle}"
                         FontStyle="Italic"
                         Margin="0,0,0,8"
                         Visibility="{Binding HasJobs, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>

              <ItemsControl ItemsSource="{Binding Jobs}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Padding="8" Margin="0,0,0,6"
                            CornerRadius="{StaticResource SmallRadius}"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource ControlStrokeBrush}">
                      <StackPanel>
                        <TextBlock Text="{Binding Name}"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextDefaultBrush}"/>
                        <TextBlock Text="{Binding Query}"
                                   Style="{StaticResource PiaSettingsDescriptionStyle}"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,2,0,0"/>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                          <TextBlock Text="{Binding KindLabel}"
                                     Style="{StaticResource PiaSettingsDescriptionStyle}"
                                     Margin="0,0,12,0"/>
                          <TextBlock Text="{Binding RecurrenceLabel}"
                                     Style="{StaticResource PiaSettingsDescriptionStyle}"
                                     Margin="0,0,12,0"/>
                          <TextBlock Text="{Binding StatusLabel}"
                                     Style="{StaticResource PiaSettingsDescriptionStyle}"
                                     Margin="0,0,12,0"/>
                          <TextBlock Text="{Binding NextFireAt, StringFormat=g}"
                                     Style="{StaticResource PiaSettingsDescriptionStyle}"/>
                        </StackPanel>
                        <!-- T2-18 per-job run history: the summary is the visible line, the firings themselves
                             are the tooltip. Hidden entirely when nothing has been recorded, so a job that has
                             never fired says nothing rather than "0 runs". -->
                        <TextBlock Text="{Binding RecentRunsSummary}"
                                   ToolTip="{Binding RecentRunsDetail}"
                                   Style="{StaticResource PiaSettingsDescriptionStyle}"
                                   Margin="0,4,0,0"
                                   Visibility="{Binding HasRecentRuns, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        <TextBlock Text="{loc:Str Settings_ScheduledJobs_NotOwnedHere}"
                                   Style="{StaticResource PiaSettingsDescriptionStyle}"
                                   FontStyle="Italic"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,0"
                                   Visibility="{Binding OwnedByThisDevice, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                          <ui:Button Content="{loc:Str Settings_ScheduledJobs_Edit}"
                                     Margin="0,0,6,0"
                                     Command="{Binding DataContext.StartEditCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                     CommandParameter="{Binding}"/>
                          <ui:Button Content="{Binding ToggleLabel}"
                                     Margin="0,0,6,0"
                                     IsEnabled="{Binding StatusIsKnown}"
                                     Command="{Binding DataContext.ToggleEnabledCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                     CommandParameter="{Binding}"/>
                          <ui:Button Content="{loc:Str Settings_ScheduledJobs_RunNow}"
                                     Margin="0,0,6,0"
                                     IsEnabled="{Binding CanRunNow}"
                                     Command="{Binding DataContext.RunNowCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                     CommandParameter="{Binding}"/>
                          <ui:Button Content="{loc:Str Settings_ScheduledJobs_Delete}"
                                     Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                     CommandParameter="{Binding}"/>
                        </StackPanel>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <ui:Button Content="{loc:Str Settings_ScheduledJobs_Add}"
                         HorizontalAlignment="Left"
                         Margin="0,4,0,0"
                         Command="{Binding StartCreateCommand}"/>

              <!-- The editor. Inline rather than a dialog, so it inherits this page's DataContext and its
                   binding paths are covered by SettingsAssistantViewParseTests along with everything else. -->
              <StackPanel Margin="0,12,0,0"
                          Visibility="{Binding IsEditorOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="{loc:Str Settings_ScheduledJobs_Field_Name}"
                           Style="{StaticResource PiaSettingsSectionLabelStyle}"/>
                <ui:TextBox Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}"
                            Margin="0,2,0,8"/>

                <TextBlock Text="{loc:Str Settings_ScheduledJobs_Field_Goal}"
                           Style="{StaticResource PiaSettingsSectionLabelStyle}"/>
                <ui:TextBox Text="{Binding EditQuery, UpdateSourceTrigger=PropertyChanged}"
                            AcceptsReturn="True"
                            TextWrapping="Wrap"
                            MinHeight="60"
                            Margin="0,2,0,8"/>

                <TextBlock Text="{loc:Str Settings_ScheduledJobs_Field_Kind}"
                           Style="{StaticResource PiaSettingsSectionLabelStyle}"/>
                <!-- SelectedValuePath, not SelectedItem: the list carries localized (value, label) pairs so
                     the ComboBox does not render the C# enum identifier in every locale, while the VM keeps
                     holding the enum itself. -->
                <ComboBox ItemsSource="{Binding JobKinds}"
                          DisplayMemberPath="Label"
                          SelectedValuePath="Value"
                          SelectedValue="{Binding EditKind, Mode=TwoWay}"
                          HorizontalAlignment="Left" Width="240"
                          Margin="0,2,0,8"/>

                <TextBlock Text="{loc:Str Settings_ScheduledJobs_Field_Recurrence}"
                           Style="{StaticResource PiaSettingsSectionLabelStyle}"/>
                <ComboBox ItemsSource="{Binding Recurrences}"
                          DisplayMemberPath="Label"
                          SelectedValuePath="Value"
                          SelectedValue="{Binding EditRecurrence, Mode=TwoWay}"
                          HorizontalAlignment="Left" Width="240"
                          Margin="0,2,0,8"/>

                <TextBlock Text="{loc:Str Settings_ScheduledJobs_Field_Time}"
                           Style="{StaticResource PiaSettingsSectionLabelStyle}"/>
                <ui:TextBox Text="{Binding EditTimeOfDay, UpdateSourceTrigger=PropertyChanged}"
                            HorizontalAlignment="Left" Width="120"
                            Margin="0,2,0,8"/>

                <StackPanel Visibility="{Binding EditorWantsSpecificDate, Converter={StaticResource BooleanToVisibilityConverter}}">
                  <TextBlock Text="{loc:Str Settings_ScheduledJobs_Field_Date}"
                             Style="{StaticResource PiaSettingsSectionLabelStyle}"/>
                  <DatePicker SelectedDate="{Binding EditSpecificDate, Mode=TwoWay}"
                              HorizontalAlignment="Left" Width="240"
                              Margin="0,2,0,8"/>
                </StackPanel>

                <TextBlock Text="{loc:Str Settings_ScheduledJobs_Field_Provider}"
                           Style="{StaticResource PiaSettingsSectionLabelStyle}"/>
                <ComboBox ItemsSource="{Binding ProviderChoices}"
                          SelectedItem="{Binding EditProvider, Mode=TwoWay}"
                          DisplayMemberPath="Name"
                          HorizontalAlignment="Left" Width="240"
                          Margin="0,2,0,8"/>

                <TextBlock Text="{loc:Str Settings_ScheduledJobs_Field_GrantedTools}"
                           Style="{StaticResource PiaSettingsSectionLabelStyle}"/>
                <ui:TextBox Text="{Binding EditGrantedTools, UpdateSourceTrigger=PropertyChanged}"
                            Margin="0,2,0,8"/>

                <!-- T2-18 quiet mode. The label says SUCCESS out loud: failures always notify. -->
                <CheckBox Content="{loc:Str Settings_ScheduledJobs_Field_QuietOnSuccess}"
                          IsChecked="{Binding EditQuietOnSuccess, Mode=TwoWay}"
                          Margin="0,2,0,4"/>
                <TextBlock Text="{loc:Str Settings_ScheduledJobs_Field_QuietOnSuccess_Hint}"
                           Style="{StaticResource PiaSettingsDescriptionStyle}"
                           Margin="0,0,0,8"/>

                <StackPanel Orientation="Horizontal">
                  <ui:Button Content="{loc:Str Settings_ScheduledJobs_Save}"
                             Appearance="Primary"
                             Margin="0,0,6,0"
                             Command="{Binding SaveCommand}"/>
                  <ui:Button Content="{loc:Str Settings_ScheduledJobs_Cancel}"
                             Command="{Binding CancelEditCommand}"/>
                </StackPanel>
              </StackPanel>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>
  </Grid>
</UserControl>

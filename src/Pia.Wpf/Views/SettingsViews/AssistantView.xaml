<UserControl x:Class="Pia.Views.SettingsViews.AssistantView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:converters="clr-namespace:Pia.Converters"
             xmlns:local="clr-namespace:Pia.Views.SettingsViews"
             xmlns:loc="clr-namespace:Pia.Localization">
  <UserControl.Resources>
    <converters:EnumToLocalizedStringConverter x:Key="EnumToLocalizedStringConverter"/>
    <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>
  </UserControl.Resources>
  <Grid>
    <TabControl SelectedIndex="{Binding SelectedInnerTabIndex}" Style="{DynamicResource SettingsInnerTabControlStyle}">
      <!-- General tab -->
      <TabItem Header="{loc:Str Settings_InnerTab_General}" Style="{DynamicResource SettingsInnerTabItemStyle}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel MaxWidth="640" HorizontalAlignment="Left">
      <!-- Provider selector for Assistant mode -->
      <StackPanel Margin="0,0,0,20">
        <TextBlock Text="{loc:Str Settings_Tab_Providers}"
                   Style="{StaticResource PiaSettingsSectionLabelStyle}"/>
        <ComboBox ItemsSource="{Binding ProvidersVm.Providers}"
                  SelectedValue="{Binding ProvidersVm.AssistantProviderId}"
                  SelectedValuePath="Id"
                  DisplayMemberPath="Name"
                  Width="400"
                  HorizontalAlignment="Left"/>
      </StackPanel>

      <!-- Default Window Mode -->
      <StackPanel Margin="0,0,0,20">
        <TextBlock Text="{loc:Str Settings_DefaultWindowMode}"
                   Style="{StaticResource PiaSettingsSectionLabelStyle}"/>
        <ComboBox ItemsSource="{Binding WindowModes}"
                  SelectedItem="{Binding DefaultWindowMode}"
                  Width="400"
                  HorizontalAlignment="Left">
          <ComboBox.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding Converter={StaticResource EnumToLocalizedStringConverter}}"/>
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <TextBlock Text="{loc:Str Settings_DefaultWindowMode_Description}"
                   Style="{StaticResource PiaSettingsDescriptionStyle}"/>
      </StackPanel>

      <!-- Todo Panel Toggle -->
      <StackPanel Margin="0,0,0,20">
        <CheckBox Content="{loc:Str Settings_ShowTodoPanelButton}"
                  IsChecked="{Binding ShowTodoPanelButton}"/>
        <TextBlock Text="{loc:Str Settings_ShowTodoPanelButton_Description}"
                   Style="{StaticResource PiaSettingsDescriptionStyle}"
                   Margin="22,4,0,0"/>
      </StackPanel>

      <!-- Follow-up Suggestion Chips -->
      <StackPanel Margin="0,0,0,20">
        <CheckBox Content="{loc:Str Settings_AssistantSuggestions}"
                  IsChecked="{Binding SuggestionsEnabled}"/>
        <TextBlock Text="{loc:Str Settings_AssistantSuggestions_Description}"
                   Style="{StaticResource PiaSettingsDescriptionStyle}"
                   Margin="22,4,0,0"/>
      </StackPanel>

      <!-- Files Folder (sandboxed) -->
      <StackPanel Margin="0,0,0,20">
        <TextBlock Text="{loc:Str Settings_AssistantFilesFolder}"
                   Style="{StaticResource PiaSettingsSectionLabelStyle}"/>
        <Grid HorizontalAlignment="Left">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="400"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <ui:TextBox Grid.Column="0"
                      Text="{Binding FilesFolder, UpdateSourceTrigger=PropertyChanged}"
                      PlaceholderText="{loc:Str Settings_AssistantFilesFolder_Placeholder}"
                      PlaceholderEnabled="True"/>
          <ui:Button Grid.Column="1"
                     Content="{loc:Str Settings_AssistantFilesFolder_Browse}"
                     Command="{Binding BrowseFilesFolderCommand}"
                     Margin="8,0,0,0"/>
          <ui:Button Grid.Column="2"
                     Content="{loc:Str Settings_AssistantFilesFolder_Clear}"
                     Command="{Binding ClearFilesFolderCommand}"
                     Appearance="Secondary"
                     Margin="4,0,0,0"/>
        </Grid>
        <TextBlock Text="{loc:Str Settings_AssistantFilesFolder_Description}"
                   Style="{StaticResource PiaSettingsDescriptionStyle}"/>
      </StackPanel>

      <!-- Chat history -->
      <TextBlock Text="{loc:Str Settings_Chat_Section}"
                 Style="{StaticResource PiaSettingsSectionLabelStyle}"
                 Margin="0,8,0,8"/>

      <StackPanel Margin="0,0,0,20">
        <CheckBox Content="{loc:Str Settings_Chat_HistoryEnabled}"
                  IsChecked="{Binding ChatHistoryEnabled}"/>
        <TextBlock Text="{loc:Str Settings_Chat_HistoryEnabled_Description}"
                   Style="{StaticResource PiaSettingsDescriptionStyle}"
                   Margin="22,4,0,0"/>
      </StackPanel>

      <StackPanel Margin="0,0,0,20"
                  IsEnabled="{Binding ChatHistoryEnabled}">
        <TextBlock Text="{loc:Str Settings_Chat_RetentionDays_Label}"
                   Style="{StaticResource PiaSettingsSectionLabelStyle}"/>
        <Slider HorizontalAlignment="Left"
                Width="400"
                Minimum="1"
                Maximum="365"
                TickFrequency="1"
                IsSnapToTickEnabled="True"
                Value="{Binding ChatHistoryRetentionDays, Mode=TwoWay}"
                VerticalAlignment="Center"/>
        <TextBlock Text="{Binding RetentionDaysDisplay}"
                   Style="{StaticResource PiaSettingsDescriptionStyle}"/>
      </StackPanel>

      <StackPanel Margin="0,0,0,20">
        <CheckBox Content="{loc:Str Settings_Chat_AutoTitle}"
                  IsChecked="{Binding ChatAutoTitleEnabled}"/>
        <TextBlock Text="{loc:Str Settings_Chat_AutoTitle_Hint}"
                   Style="{StaticResource PiaSettingsDescriptionStyle}"
                   Margin="22,4,0,0"/>
      </StackPanel>

      <StackPanel Margin="0,0,0,20">
        <ui:Button Content="{loc:Str Settings_Chat_DeleteAllNow}"
                   Command="{Binding DeleteAllChatHistoryCommand}"
                   Appearance="Caution"
                   HorizontalAlignment="Left"/>
      </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- Personas tab -->
      <TabItem Header="{loc:Str Settings_Tab_Personas}" Style="{DynamicResource SettingsInnerTabItemStyle}">
        <local:PersonasView DataContext="{Binding PersonasVm}"/>
      </TabItem>

      <!-- Tool access tab (tool-permission revocation surface — design §7) -->
      <TabItem Header="{loc:Str Settings_Tab_ToolPermissions}" Style="{DynamicResource SettingsInnerTabItemStyle}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" DataContext="{Binding ToolPermissionsVm}">
          <StackPanel MaxWidth="640" HorizontalAlignment="Left">
            <TextBlock Text="{loc:Str Settings_ToolPermissions_Title}"
                       Style="{StaticResource PiaSettingsSectionLabelStyle}"
                       Margin="0,0,0,4"/>
            <TextBlock Text="{loc:Str Settings_ToolPermissions_Description}"
                       Style="{StaticResource PiaSettingsDescriptionStyle}"
                       Margin="0,0,0,12"/>

            <!-- Empty state -->
            <TextBlock Text="{loc:Str ToolPermissions_Empty}"
                       Style="{StaticResource PiaSettingsDescriptionStyle}"
                       Visibility="{Binding HasGrants, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>

            <!-- Grant list -->
            <ItemsControl ItemsSource="{Binding Grants}"
                          Visibility="{Binding HasGrants, Converter={StaticResource BooleanToVisibilityConverter}}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Style="{StaticResource PiaSettingsCardStyle}"
                          Padding="14,12"
                          Margin="0,0,0,8">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>

                      <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextDefaultBrush}"
                                   Text="{Binding ToolName}"/>
                        <TextBlock FontSize="11"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   Margin="0,2,0,0">
                          <Run Text="{loc:Str ToolPermissions_Column_Plugin}"/>
                          <Run Text=" "/>
                          <Run Text="{Binding PluginName, Mode=OneWay}"/>
                        </TextBlock>
                        <TextBlock FontSize="11"
                                   Foreground="{DynamicResource TextSubtleBrush}"
                                   Margin="0,2,0,0">
                          <Run Text="{loc:Str ToolPermissions_Column_GrantedAt}"/>
                          <Run Text=" "/>
                          <Run Text="{Binding GrantedAt, StringFormat='{}{0:g}', Mode=OneWay}"/>
                        </TextBlock>
                      </StackPanel>

                      <ui:Button Grid.Column="1"
                                 Content="{loc:Str ToolPermissions_Revoke}"
                                 Appearance="Secondary"
                                 Foreground="{DynamicResource PiaDangerBrush}"
                                 VerticalAlignment="Center"
                                 Command="{Binding DataContext.RevokeCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                 CommandParameter="{Binding}"/>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>
  </Grid>
</UserControl>

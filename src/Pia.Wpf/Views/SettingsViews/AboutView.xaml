<UserControl x:Class="Pia.Views.SettingsViews.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:loc="clr-namespace:Pia.Localization">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel MaxWidth="640" HorizontalAlignment="Left">
      <TextBlock Text="{loc:Str About_Title}"
                 FontSize="18"
                 FontWeight="SemiBold"
                 Foreground="{DynamicResource TextDefaultBrush}"
                 Margin="0,0,0,16"/>

      <StackPanel Margin="0,0,0,20">
        <TextBlock Text="{loc:Str About_Version_Label}"
                   Style="{StaticResource PiaSettingsSectionLabelStyle}"/>
        <TextBlock Text="{Binding Version}"
                   AutomationProperties.AutomationId="About_Version"
                   Foreground="{DynamicResource TextDefaultBrush}"/>
        <TextBlock Text="{loc:Str About_Publisher}"
                   Style="{StaticResource PiaSettingsDescriptionStyle}"/>
      </StackPanel>

      <StackPanel Margin="0,0,0,20">
        <TextBlock Text="{loc:Str About_AiNotice_Title}"
                   Style="{StaticResource PiaSettingsSectionLabelStyle}"/>
        <TextBlock Text="{loc:Str About_AiNotice_Text}"
                   AutomationProperties.AutomationId="About_AiNotice"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource TextDefaultBrush}"/>
      </StackPanel>

      <StackPanel Margin="0,0,0,20">
        <TextBlock Text="{loc:Str About_AiFeedback_Title}"
                   Style="{StaticResource PiaSettingsSectionLabelStyle}"/>
        <TextBlock Text="{loc:Str About_AiFeedback_Text}"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource TextDefaultBrush}"/>
        <ui:HyperlinkButton Content="{Binding AiFeedbackAddress}"
                            NavigateUri="{Binding AiFeedbackMailto}"
                            AutomationProperties.AutomationId="About_Link_AiFeedback"
                            HorizontalAlignment="Left"/>
      </StackPanel>

      <StackPanel Margin="0,0,0,20">
        <TextBlock Text="{loc:Str About_Legal_Title}"
                   Style="{StaticResource PiaSettingsSectionLabelStyle}"/>
        <ui:HyperlinkButton Content="{loc:Str About_Link_Imprint}"
                            NavigateUri="{Binding ImprintUrl}"
                            AutomationProperties.AutomationId="About_Link_Imprint"
                            HorizontalAlignment="Left"/>
        <ui:HyperlinkButton Content="{loc:Str About_Link_Privacy}"
                            NavigateUri="{Binding PrivacyPolicyUrl}"
                            AutomationProperties.AutomationId="About_Link_Privacy"
                            HorizontalAlignment="Left"/>
        <ui:HyperlinkButton Content="{loc:Str About_Link_Docs}"
                            NavigateUri="{Binding DocumentationUrl}"
                            AutomationProperties.AutomationId="About_Link_Docs"
                            HorizontalAlignment="Left"/>
        <ui:HyperlinkButton Content="{loc:Str About_Link_Website}"
                            NavigateUri="{Binding WebsiteUrl}"
                            AutomationProperties.AutomationId="About_Link_Website"
                            HorizontalAlignment="Left"/>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>

<UserControl x:Class="Pia.Views.SettingsViews.DeviceManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:converters="clr-namespace:Pia.Converters"
             Loaded="OnLoaded">
  <UserControl.Resources>
    <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
  </UserControl.Resources>
  <Grid Background="{DynamicResource BgCanvasBrush}" Margin="24,20,24,20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- Header -->
    <StackPanel Grid.Row="0">
      <TextBlock Text="Device Management"
                 Style="{StaticResource PiaSettingsPageTitleStyle}"/>
      <TextBlock FontSize="12"
                 Foreground="{DynamicResource TextMutedBrush}"
                 Margin="0,6,0,0">
        <Run Text="This device: "/>
        <Run Text="{Binding CurrentFingerprint, Mode=OneWay}" FontFamily="{StaticResource PiaMonoFont}"/>
      </TextBlock>
    </StackPanel>

    <!-- Refresh button -->
    <ui:Button Grid.Row="1"
               Content="Refresh"
               Icon="{ui:SymbolIcon ArrowSync24}"
               Appearance="Secondary"
               Command="{Binding LoadDevicesCommand}"
               HorizontalAlignment="Left"
               Margin="0,14,0,14"/>

    <!-- Loading indicator -->
    <ui:ProgressRing Grid.Row="2"
                     IsIndeterminate="True"
                     Width="32" Height="32"
                     Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Top"
                     Margin="0,16,0,0"/>

    <!-- Device list -->
    <ItemsControl Grid.Row="2"
                  ItemsSource="{Binding Devices}">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Border Style="{StaticResource PiaSettingsCardStyle}"
                  Padding="14,12"
                  Margin="0,0,0,8">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>

              <StackPanel Grid.Column="0">
                <TextBlock FontWeight="SemiBold"
                           Foreground="{DynamicResource TextDefaultBrush}">
                  <Run Text="{Binding DeviceName, Mode=OneWay}"/>
                  <Run Text=" — "/>
                  <Run Text="{Binding Status, Mode=OneWay}"/>
                </TextBlock>
                <TextBlock FontSize="11"
                           Foreground="{DynamicResource TextMutedBrush}"
                           FontFamily="{StaticResource PiaMonoFont}"
                           Margin="0,4,0,0">
                  <Run Text="Fingerprint: "/>
                  <Run Text="{Binding Fingerprint, Mode=OneWay}"/>
                </TextBlock>
                <TextBlock FontSize="11"
                           Foreground="{DynamicResource TextSubtleBrush}"
                           Margin="0,2,0,0">
                  <Run Text="Last seen: "/>
                  <Run Text="{Binding LastSeenAt, StringFormat='{}{0:g}', Mode=OneWay}"/>
                </TextBlock>
              </StackPanel>

              <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <ui:Button Content="Revoke"
                           Appearance="Secondary"
                           Foreground="{DynamicResource PiaDangerBrush}"
                           Command="{Binding DataContext.RevokeDeviceCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                           CommandParameter="{Binding}"/>
              </StackPanel>
            </Grid>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </Grid>
</UserControl>

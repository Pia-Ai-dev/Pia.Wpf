<UserControl x:Class="Pia.Views.SettingsViews.OptimizeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:converters="clr-namespace:Pia.Converters"
             xmlns:localSettings="clr-namespace:Pia.Views.SettingsViews"
             xmlns:loc="clr-namespace:Pia.Localization">
  <UserControl.Resources>
    <converters:EnumToLocalizedStringConverter x:Key="EnumToLocalizedStringConverter"/>
    <converters:InverseBooleanConverter x:Key="InverseBooleanConverter"/>
  </UserControl.Resources>
  <Grid>
    <TabControl Style="{DynamicResource SettingsInnerTabControlStyle}">
      <TabItem Header="{loc:Str Settings_InnerTab_General}" Style="{DynamicResource SettingsInnerTabItemStyle}"
               AutomationProperties.AutomationId="Settings_Optimize_Tab_General">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
          <StackPanel MaxWidth="1080" HorizontalAlignment="Left">
      <!-- Provider hint (the default provider for this mode is set on the Providers tab) -->
      <StackPanel Margin="0,0,0,20">
        <TextBlock Text="{loc:Str Settings_Tab_Providers}"
                   Style="{StaticResource PiaSettingsSectionLabelStyle}"/>
        <TextBlock Text="{loc:Str Settings_ProviderHint}"
                   Style="{StaticResource PiaSettingsDescriptionStyle}"/>
        <ui:HyperlinkButton Content="{loc:Str Settings_ProviderHint_Link}"
                            AutomationProperties.AutomationId="Settings_Optimize_GoToProvidersTab"
                            Command="{Binding ProvidersVm.GoToProvidersTabCommand}"
                            HorizontalAlignment="Left"
                            Margin="0,4,0,0"/>
      </StackPanel>

      <!-- Output section -->
      <TextBlock Text="{loc:Str Settings_Output_Section}"
                 FontSize="14"
                 FontWeight="SemiBold"
                 Foreground="{DynamicResource TextDefaultBrush}"
                 Margin="0,0,0,8"/>

      <!-- Output Action -->
      <StackPanel Margin="0,0,0,20">
        <TextBlock Text="{loc:Str Settings_OutputAction}"
                   Style="{StaticResource PiaSettingsSectionLabelStyle}"/>
        <ComboBox AutomationProperties.AutomationId="Settings_Optimize_OutputAction"
                  ItemsSource="{Binding OutputActions}"
                  SelectedItem="{Binding OutputAction}"
                  IsEnabled="{Binding IsOutputActionEnforced, Converter={StaticResource InverseBooleanConverter}}"
                  ToolTipService.ShowOnDisabled="True"
                  ToolTip="{Binding Policy.Reason[DefaultOutputAction]}"
                  Width="400"
                  HorizontalAlignment="Left">
          <ComboBox.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding Converter={StaticResource EnumToLocalizedStringConverter}}"/>
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
      </StackPanel>

      <!-- Auto-Type Delay -->
      <StackPanel Margin="0,0,0,20">
        <StackPanel.Style>
          <Style TargetType="StackPanel">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
              <DataTrigger Binding="{Binding OutputAction}" Value="AutoType">
                <Setter Property="Visibility" Value="Visible"/>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </StackPanel.Style>
        <TextBlock Text="{loc:Str Settings_AutoTypeDelay}"
                   Style="{StaticResource PiaSettingsSectionLabelStyle}"/>
        <ui:NumberBox AutomationProperties.AutomationId="Settings_Optimize_AutoTypeDelayMs"
                      Value="{Binding AutoTypeDelayMs, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                      IsEnabled="{Binding IsAutoTypeDelayEnforced, Converter={StaticResource InverseBooleanConverter}}"
                      ToolTipService.ShowOnDisabled="True"
                      ToolTip="{Binding Policy.Reason[AutoTypeDelayMs]}"
                      Minimum="5"
                      Maximum="100"
                      Width="200"
                      HorizontalAlignment="Left"/>
        <TextBlock Text="{loc:Str Settings_AutoTypeDelay_Description}"
                   Style="{StaticResource PiaSettingsDescriptionStyle}"/>
      </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- Its own tab, not a section below the settings: the master-detail pane needs a bounded height to
           scroll its list and its editor separately, which a page-level ScrollViewer would not give it. -->
      <TabItem Header="{loc:Str Settings_Tab_Templates}" Style="{DynamicResource SettingsInnerTabItemStyle}"
               AutomationProperties.AutomationId="Settings_Optimize_Tab_Templates">
        <localSettings:TemplatesView DataContext="{Binding TemplatesVm}"/>
      </TabItem>
    </TabControl>
  </Grid>
</UserControl>

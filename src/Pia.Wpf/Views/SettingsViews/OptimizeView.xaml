<UserControl x:Class="Pia.Views.SettingsViews.OptimizeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:converters="clr-namespace:Pia.Converters"
             xmlns:controls="clr-namespace:Pia.Controls"
             xmlns:loc="clr-namespace:Pia.Localization">
  <UserControl.Resources>
    <converters:EnumToLocalizedStringConverter x:Key="EnumToLocalizedStringConverter"/>
    <converters:InverseBooleanConverter x:Key="InverseBooleanConverter"/>
  </UserControl.Resources>
  <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <StackPanel MaxWidth="1080" HorizontalAlignment="Left">
      <!-- Provider hint (the default provider for this mode is set on the Providers tab) -->
      <StackPanel Margin="0,0,0,20">
        <TextBlock Text="{loc:Str Settings_Tab_Providers}"
                   Style="{StaticResource PiaSettingsSectionLabelStyle}"/>
        <TextBlock Text="{loc:Str Settings_ProviderHint}"
                   Style="{StaticResource PiaSettingsDescriptionStyle}"/>
        <ui:HyperlinkButton Content="{loc:Str Settings_ProviderHint_Link}"
                            AutomationProperties.AutomationId="Settings_Optimize_GoToProvidersTab"
                            Command="{Binding ProvidersVm.GoToProvidersTabCommand}"
                            HorizontalAlignment="Left"
                            Margin="0,4,0,0"/>
      </StackPanel>

      <!-- Output section -->
      <TextBlock Text="{loc:Str Settings_Output_Section}"
                 FontSize="14"
                 FontWeight="SemiBold"
                 Foreground="{DynamicResource TextDefaultBrush}"
                 Margin="0,0,0,8"/>

      <!-- Output Action -->
      <StackPanel Margin="0,0,0,20">
        <TextBlock Text="{loc:Str Settings_OutputAction}"
                   Style="{StaticResource PiaSettingsSectionLabelStyle}"/>
        <ComboBox AutomationProperties.AutomationId="Settings_Optimize_OutputAction"
                  ItemsSource="{Binding OutputActions}"
                  SelectedItem="{Binding OutputAction}"
                  IsEnabled="{Binding IsOutputActionEnforced, Converter={StaticResource InverseBooleanConverter}}"
                  Width="400"
                  HorizontalAlignment="Left">
          <ComboBox.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding Converter={StaticResource EnumToLocalizedStringConverter}}"/>
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
      </StackPanel>

      <!-- Auto-Type Delay -->
      <StackPanel Margin="0,0,0,20">
        <StackPanel.Style>
          <Style TargetType="StackPanel">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
              <DataTrigger Binding="{Binding OutputAction}" Value="AutoType">
                <Setter Property="Visibility" Value="Visible"/>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </StackPanel.Style>
        <TextBlock Text="{loc:Str Settings_AutoTypeDelay}"
                   Style="{StaticResource PiaSettingsSectionLabelStyle}"/>
        <ui:NumberBox AutomationProperties.AutomationId="Settings_Optimize_AutoTypeDelayMs"
                      Value="{Binding AutoTypeDelayMs, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                      IsEnabled="{Binding IsAutoTypeDelayEnforced, Converter={StaticResource InverseBooleanConverter}}"
                      Minimum="5"
                      Maximum="100"
                      Width="200"
                      HorizontalAlignment="Left"/>
        <TextBlock Text="{loc:Str Settings_AutoTypeDelay_Description}"
                   Style="{StaticResource PiaSettingsDescriptionStyle}"/>
      </StackPanel>

      <Border BorderThickness="0,1,0,0"
              BorderBrush="{DynamicResource BorderBrush_}"
              Margin="0,4,0,20"/>

      <!-- Templates section -->
      <Grid Margin="0,0,0,8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock Text="{loc:Str Settings_Tab_Templates}"
                   FontSize="14"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource TextDefaultBrush}"
                   VerticalAlignment="Center"/>
        <ui:Button Grid.Column="1"
                   Appearance="Secondary"
                   AutomationProperties.AutomationId="Templates_AddButton"
                   AutomationProperties.Name="{loc:Str Templates_Add}"
                   Command="{Binding AddTemplateCommand}">
          <StackPanel Orientation="Horizontal">
            <ui:SymbolIcon Symbol="Add24" FontSize="16" Margin="0,0,6,0"/>
            <TextBlock Text="{loc:Str Templates_Add}"/>
          </StackPanel>
        </ui:Button>
      </Grid>

      <TextBlock Text="{loc:Str Templates_Description}"
                 FontSize="12"
                 Foreground="{DynamicResource TextMutedBrush}"
                 TextWrapping="Wrap"
                 Margin="0,0,0,12"/>

      <ItemsControl ItemsSource="{Binding Templates}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <controls:ColumnsPanel MaxColumns="3" MinColumnWidth="260" ColumnSpacing="10" RowSpacing="10" UniformRowHeight="True" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Style="{StaticResource PiaSettingsCardStyle}"
                    Padding="14,12">
              <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Top">
                <TextBlock FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextDefaultBrush}"
                           Text="{Binding Name}"/>
                <TextBlock Text="{Binding Description}"
                           FontSize="12"
                           Foreground="{DynamicResource TextMutedBrush}"
                           Margin="0,2,0,0"
                           TextWrapping="Wrap"/>
                </StackPanel>
                <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:Button Command="{Binding DataContext.ViewTemplatePromptCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                               CommandParameter="{Binding}"
                               Appearance="Secondary"
                               Height="30"
                               Padding="8,0"
                               FontSize="12"
                               Margin="0,0,4,0"
                               AutomationProperties.Name="{loc:Str Templates_ViewPrompt}"
                               AutomationProperties.AutomationId="{Binding Id, StringFormat='Template_ViewPrompt_{0}'}">
                      <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Code24" FontSize="14" Margin="0,0,4,0"/>
                        <TextBlock Text="{loc:Str Templates_ViewPrompt}" FontSize="12"/>
                      </StackPanel>
                    </ui:Button>
                    <ui:Button Command="{Binding DataContext.SetDefaultTemplateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                               CommandParameter="{Binding}"
                               Appearance="Secondary"
                               Height="30"
                               Padding="8,0"
                               FontSize="12"
                               Margin="0,0,4,0"
                               AutomationProperties.Name="{loc:Str Templates_SetDefault}"
                               AutomationProperties.AutomationId="{Binding Id, StringFormat='Template_SetDefault_{0}'}">
                      <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Star24" FontSize="14" Margin="0,0,4,0" Filled="True"/>
                        <TextBlock Text="{loc:Str Templates_SetDefault}" FontSize="12"/>
                      </StackPanel>
                    </ui:Button>
                    <ui:Button Command="{Binding DataContext.EditTemplateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                              CommandParameter="{Binding}"
                              Appearance="Secondary"
                              Width="30"
                              Height="30"
                              Padding="0"
                                Margin="0,0,4,0"
                                AutomationProperties.Name="{loc:Str Templates_Edit}"
                                AutomationProperties.AutomationId="{Binding Id, StringFormat='Template_Edit_{0}'}"
                                Visibility="{Binding IsBuiltIn, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                      <ui:SymbolIcon Symbol="Edit24" FontSize="14"/>
                      <ui:Button.ToolTip>
                        <ToolTip Content="{loc:Str Templates_Edit}"/>
                      </ui:Button.ToolTip>
                    </ui:Button>
                    <ui:Button Command="{Binding DataContext.DeleteTemplateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                              CommandParameter="{Binding}"
                              Appearance="Secondary"
                              Width="30"
                              Height="30"
                                Padding="0"
                                AutomationProperties.Name="{loc:Str Templates_Delete}"
                                AutomationProperties.AutomationId="{Binding Id, StringFormat='Template_Delete_{0}'}"
                                Visibility="{Binding IsBuiltIn, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                      <ui:SymbolIcon Symbol="Delete24" FontSize="14"
                                     Foreground="{DynamicResource PiaDangerBrush}"/>
                      <ui:Button.ToolTip>
                        <ToolTip Content="{loc:Str Templates_Delete}"/>
                      </ui:Button.ToolTip>
                    </ui:Button>
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:Badge Content="{loc:Str Templates_BuiltIn}"
                              Visibility="{Binding IsBuiltIn, Converter={StaticResource BooleanToVisibilityConverter}}"
                              Appearance="Caution"
                              Margin="0,0,8,0"/>
                    <ui:Badge Content="{loc:Str Templates_Default}"
                               Appearance="Primary">
                      <ui:Badge.Visibility>
                        <MultiBinding Converter="{StaticResource IdEqualsVisibilityConverter}">
                          <Binding Path="Id"/>
                          <Binding Path="DataContext.DefaultTemplateId" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                        </MultiBinding>
                      </ui:Badge.Visibility>
                    </ui:Badge>
                  </StackPanel>
                </DockPanel>
              </DockPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>

<UserControl x:Class="Pia.Views.AssistantView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:Pia.Views"
             xmlns:nav="clr-namespace:Pia.Navigation"
             xmlns:loc="clr-namespace:Pia.Localization"
             xmlns:controls="clr-namespace:Pia.Controls"
             xmlns:chat="clr-namespace:Pia.Controls.Chat"
             xmlns:behaviors="clr-namespace:Pia.Behaviors"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900"
             nav:ViewModelLocator.AutoWireViewModel="True">
  <Grid x:Name="RootGrid"
        Background="Transparent"
        behaviors:FileDropBehavior.IsEnabled="True"
        behaviors:FileDropBehavior.AcceptedExtensions=".txt,.md,.json,.xml,.yaml,.yml,.csv,.log,.ini,.cs,.js,.ts,.py,.html,.htm,.css,.sql,.sh,.ps1,.bat,.cmd,.toml,.docx,.xlsx,.xlsm"
        behaviors:FileDropBehavior.FilesDroppedCommand="{Binding HandleFilesDroppedCommand}">
    <!-- Main content + panel overlay -->
    <Grid x:Name="MainContent">
      <Grid.Style>
        <Style TargetType="Grid">
          <Style.Triggers>
            <DataTrigger Binding="{Binding Path=(behaviors:FileDropBehavior.IsDragOver), ElementName=RootGrid}" Value="True">
              <Setter Property="Effect">
                <Setter.Value>
                  <BlurEffect Radius="6" KernelType="Gaussian" />
                </Setter.Value>
              </Setter>
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </Grid.Style>
      <Grid.RowDefinitions>
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

    <!-- Empty state -->
    <StackPanel Grid.Row="0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Visibility="{Binding HasMessages, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
      <ui:SymbolIcon Symbol="Chat48"
                     FontSize="48"
                     HorizontalAlignment="Center"
                     Margin="0,0,0,16"
                     Foreground="{DynamicResource TextPlaceholderColorBrush}" />
      <TextBlock Text="{loc:Str Assistant_EmptyState}"
                 FontSize="16"
                 HorizontalAlignment="Center"
                 Foreground="{DynamicResource TextPlaceholderColorBrush}" />

      <WrapPanel HorizontalAlignment="Center"
                 Margin="0,24,0,0"
                 MaxWidth="420">
        <ui:Button Appearance="Secondary"
                   Margin="4"
                   Padding="10,6"
                   CornerRadius="14"
                   Cursor="Hand"
                   Command="{Binding UseSuggestionCommand}"
                   CommandParameter="{Binding SuggestionReminder}">
          <TextBlock Text="{Binding SuggestionReminder}"
                     FontSize="12" />
        </ui:Button>
        <ui:Button Appearance="Secondary"
                   Margin="4"
                   Padding="10,6"
                   CornerRadius="14"
                   Cursor="Hand"
                   Command="{Binding UseSuggestionCommand}"
                   CommandParameter="{Binding SuggestionTodo}">
          <TextBlock Text="{Binding SuggestionTodo}"
                     FontSize="12" />
        </ui:Button>
        <ui:Button Appearance="Secondary"
                   Margin="4"
                   Padding="10,6"
                   CornerRadius="14"
                   Cursor="Hand"
                   Command="{Binding UseSuggestionCommand}"
                   CommandParameter="{Binding SuggestionMemory}">
          <TextBlock Text="{Binding SuggestionMemory}"
                     FontSize="12" />
        </ui:Button>
      </WrapPanel>
    </StackPanel>

    <!-- Message list -->
    <ScrollViewer x:Name="MessageScrollViewer"
                  Grid.Row="0"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="20,48,20,0"
                  ScrollChanged="MessageScrollViewer_ScrollChanged">
      <ScrollViewer.Style>
        <Style TargetType="ScrollViewer">
          <Setter Property="Visibility" Value="Visible" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding HasMessages}" Value="False">
              <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </ScrollViewer.Style>
      <ItemsControl ItemsSource="{Binding Messages}"
                    RequestBringIntoView="MessageItemsControl_RequestBringIntoView">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Grid Margin="0,0,0,12">
              <!-- User message (right-aligned) -->
              <StackPanel HorizontalAlignment="Right"
                          MaxWidth="{Binding ActualWidth, ElementName=MessageScrollViewer, Converter={StaticResource MultiplyConverter}, ConverterParameter=0.6}"
                          x:Name="UserMessagePanel">
                <StackPanel.Style>
                  <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsUser}" Value="True">
                        <Setter Property="Visibility" Value="Visible" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </StackPanel.Style>
                <Border Style="{StaticResource UserBubbleStyle}">
                  <TextBlock behaviors:AtCommandHighlightBehavior.Text="{Binding Content}"
                             Style="{StaticResource UserBubbleTextStyle}" />
                </Border>
                <!-- User message actions -->
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Left"
                            Margin="0,4,0,0">
                  <ui:Button Appearance="Transparent"
                             Padding="4"
                             Command="{Binding DataContext.CopyMessageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                             CommandParameter="{Binding}"
                             ToolTip="{loc:Str Assistant_Copy_Tooltip}">
                    <ui:Button.Style>
                      <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                        <Setter Property="Opacity" Value="0" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsMouseOver, ElementName=UserMessagePanel}" Value="True">
                            <Setter Property="Opacity" Value="1" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </ui:Button.Style>
                    <ui:SymbolIcon Symbol="Copy16" FontSize="12" />
                  </ui:Button>
                </StackPanel>
              </StackPanel>

              <!-- Assistant message (left-aligned).
                   Grid (Auto, *) instead of horizontal StackPanel so the width constraint
                   propagates into the markdown body — otherwise long content / code blocks
                   render at their natural width and overflow when the window narrows. -->
              <Grid HorizontalAlignment="Stretch"
                    x:Name="AssistantMessagePanel">
                <Grid.Style>
                  <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsUser}" Value="False">
                        <Setter Property="Visibility" Value="Visible" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Grid.Style>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ContentControl Grid.Column="0"
                                Style="{StaticResource PiaAvatarStyle}"
                                Margin="0,2,12,0"
                                VerticalAlignment="Top" />
                <chat:PiaAssistantMessage Grid.Column="1"
                    HorizontalAlignment="Left"
                    MaxWidth="640"
                    CopyCommand="{Binding DataContext.CopyMessageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    SpeakCommand="{Binding DataContext.PlayMessageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    AddToPiiRequested="OnAddToPiiRequested" />
              </Grid>
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <!-- Input area -->
    <Border Grid.Row="1" Padding="20,8,20,16">
      <Border Style="{StaticResource PiaComposerCardStyle}">
        <StackPanel Margin="8">
          <Grid>
            <ui:TextBox x:Name="InputTextBox"
                        Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                        PlaceholderText="{loc:Str Assistant_InputPlaceholder}"
                        PlaceholderEnabled="True"
                        TextWrapping="Wrap"
                        AcceptsReturn="True"
                        MaxHeight="120"
                        VerticalScrollBarVisibility="Auto"
                        FontSize="14"
                        Padding="6,6"
                        BorderThickness="0"
                        Background="Transparent"
                        ClearButtonEnabled="False"
                        PreviewKeyDown="InputTextBox_PreviewKeyDown"
                        behaviors:AtCommandAutocompleteBehavior.IsEnabled="True"
                        behaviors:AtCommandAutocompleteBehavior.PopupControl="{Binding ElementName=AtCommandPopup}"
                        behaviors:AtCommandAutocompleteBehavior.AutocompleteService="{Binding AutocompleteService}" />
            <controls:AutocompletePopup x:Name="AtCommandPopup" />
          </Grid>

          <Grid Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
              <!-- Clear button -->
              <ui:Button Command="{Binding ClearConversationCommand}"
                         Appearance="Transparent"
                         Padding="6,4"
                         Margin="0,0,2,0"
                         ToolTip="{loc:Str Assistant_ClearConversation_Tooltip}">
                <ui:SymbolIcon Symbol="Eraser24" FontSize="16" />
              </ui:Button>

              <!-- Cancel button (visible during streaming) -->
              <ui:Button Command="{Binding CancelStreamingCommand}"
                         Appearance="Transparent"
                         Padding="6,4"
                         Margin="0,0,2,0"
                         ToolTip="{loc:Str Assistant_Cancel_Tooltip}">
                <ui:Button.Style>
                  <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsStreaming}" Value="True">
                        <Setter Property="Visibility" Value="Visible" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </ui:Button.Style>
                <ui:SymbolIcon Symbol="Dismiss24" FontSize="16" />
              </ui:Button>

              <Separator Width="1" Margin="4,2" Background="{DynamicResource BorderBrush_}" />

              <!-- TTS toggle button -->
              <ui:Button Command="{Binding ToggleTtsCommand}"
                         Padding="6,4"
                         Margin="2,0"
                         ToolTip="{loc:Str Assistant_ToggleTts_Tooltip}">
                <ui:Button.Style>
                  <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                    <Setter Property="Appearance" Value="Transparent" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsTtsEnabled}" Value="True">
                        <Setter Property="Appearance" Value="Primary" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </ui:Button.Style>
                <ui:SymbolIcon Symbol="Speaker224" FontSize="16" />
              </ui:Button>

              <!-- Record button -->
              <ui:Button Command="{Binding ToggleRecordingCommand}"
                         Appearance="Transparent"
                         Padding="6,4"
                         Margin="2,0"
                         ToolTip="{loc:Str Assistant_Record_Tooltip}">
                <ui:SymbolIcon Symbol="Record24" FontSize="16" />
              </ui:Button>

              <!-- Voice Mode button -->
              <ui:Button Command="{Binding EnterVoiceModeCommand}"
                         Appearance="Transparent"
                         Padding="6,4"
                         Margin="2,0"
                         ToolTip="{loc:Str Assistant_VoiceConversation_Tooltip}">
                <ui:SymbolIcon Symbol="Mic24" FontSize="16" />
              </ui:Button>
            </StackPanel>

            <!-- Send button -->
            <ui:Button Grid.Column="1"
                       Command="{Binding SendMessageCommand}"
                       Appearance="Primary"
                       Padding="10,4"
                       ToolTip="{loc:Str Assistant_Send_Tooltip}">
              <ui:SymbolIcon Symbol="Send24" FontSize="16" />
            </ui:Button>
          </Grid>
        </StackPanel>
      </Border>
    </Border>
    </Grid>

    <!-- Todo panel toggle button -->
    <ui:Button x:Name="TodoPanelToggle"
               HorizontalAlignment="Right"
               VerticalAlignment="Top"
               Margin="0,8,12,0"
               Width="36"
               Height="36"
               Padding="0"
               Appearance="Secondary"
               ToolTip="{loc:Str Assistant_ToggleTodoPanel_Tooltip}"
               Command="{Binding DataContext.ToggleTodoPanelCommand, ElementName=TodoPanel}"
               Visibility="{Binding DataContext.IsTodoButtonVisible, ElementName=TodoPanel, Converter={StaticResource BooleanToVisibilityConverter}}">
      <Grid>
        <ui:SymbolIcon Symbol="TaskListSquareLtr24" FontSize="16" />
        <TextBlock Text="{Binding DataContext.PendingCount, ElementName=TodoPanel}"
                   FontSize="14"
                   FontWeight="Bold"
                   Foreground="{DynamicResource AccentFillColorDefaultBrush}"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Top"
                   Margin="0,-10,-7,0">
          <TextBlock.Style>
            <Style TargetType="TextBlock">
              <Setter Property="Visibility" Value="Visible" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.PendingCount, ElementName=TodoPanel}" Value="0">
                  <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
      </Grid>
    </ui:Button>

    <!-- Todo panel overlay (right side) -->
    <local:TodoPanelControl x:Name="TodoPanel"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Stretch"
                            Width="0"
                            Visibility="Collapsed">
      <local:TodoPanelControl.Style>
        <Style TargetType="local:TodoPanelControl">
          <Style.Triggers>
            <DataTrigger Binding="{Binding DataContext.IsTodoPanelOpen, ElementName=TodoPanel}" Value="True">
              <DataTrigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Visibility">
                      <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                    </ObjectAnimationUsingKeyFrames>
                    <DoubleAnimation Storyboard.TargetProperty="Width"
                                     From="0" To="280" Duration="0:0:0.25">
                      <DoubleAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseOut" />
                      </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                  </Storyboard>
                </BeginStoryboard>
              </DataTrigger.EnterActions>
              <DataTrigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Width"
                                     From="280" To="0" Duration="0:0:0.2">
                      <DoubleAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseIn" />
                      </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Visibility">
                      <DiscreteObjectKeyFrame KeyTime="0:0:0.2" Value="{x:Static Visibility.Collapsed}" />
                    </ObjectAnimationUsingKeyFrames>
                  </Storyboard>
                </BeginStoryboard>
              </DataTrigger.ExitActions>
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </local:TodoPanelControl.Style>
    </local:TodoPanelControl>

    <!-- Voice Mode Overlay -->
    <local:VoiceModeOverlay Grid.Row="0" Grid.RowSpan="2"
                            DataContext="{Binding VoiceMode}"
                            Panel.ZIndex="10"
                            Visibility="{Binding DataContext.IsVoiceModeActive,
                              RelativeSource={RelativeSource AncestorType=UserControl},
                              Converter={StaticResource BooleanToVisibilityConverter}}" />

    <!-- Drag-over overlay (visible while a file is being dragged onto the view) -->
    <Border IsHitTestVisible="False"
            Panel.ZIndex="20"
            Margin="8"
            CornerRadius="8"
            BorderThickness="2"
            BorderBrush="{DynamicResource AccentFillColorDefaultBrush}"
            Background="{DynamicResource AcrylicBackgroundFillColorBaseBrush}"
            Visibility="{Binding Path=(behaviors:FileDropBehavior.IsDragOver), ElementName=RootGrid, Converter={StaticResource BooleanToVisibilityConverter}}">
      <StackPanel HorizontalAlignment="Center"
                  VerticalAlignment="Center">
        <ui:SymbolIcon Symbol="ArrowDownload24"
                       FontSize="48"
                       HorizontalAlignment="Center"
                       Foreground="{DynamicResource AccentFillColorDefaultBrush}" />
        <TextBlock Text="{loc:Str FileDrop_Overlay_Hint}"
                   FontSize="16"
                   FontWeight="SemiBold"
                   Margin="0,12,0,0"
                   HorizontalAlignment="Center"
                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>

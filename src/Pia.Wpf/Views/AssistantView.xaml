<UserControl x:Class="Pia.Views.AssistantView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:Pia.Views"
             xmlns:nav="clr-namespace:Pia.Navigation"
             xmlns:loc="clr-namespace:Pia.Localization"
             xmlns:controls="clr-namespace:Pia.Controls"
             xmlns:chat="clr-namespace:Pia.Controls.Chat"
             xmlns:assistant="clr-namespace:Pia.Controls.Assistant"
             xmlns:shared="clr-namespace:Pia.Controls.Shared"
             xmlns:behaviors="clr-namespace:Pia.Behaviors"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900"
             nav:ViewModelLocator.AutoWireViewModel="True"
             PreviewKeyDown="UserControl_PreviewKeyDown">
  <UserControl.Resources>
    <DataTemplate x:Key="UserMessageTemplate">
      <StackPanel x:Name="UserMessagePanel"
                  HorizontalAlignment="Right"
                  Margin="0,0,0,12"
                  MaxWidth="{Binding ActualWidth, ElementName=MessageScrollViewer, Converter={StaticResource MultiplyConverter}, ConverterParameter=0.6}">
        <Border Style="{StaticResource UserBubbleStyle}">
          <StackPanel>
            <Image MaxWidth="300" MaxHeight="300"
                   Stretch="Uniform"
                   HorizontalAlignment="Left"
                   Margin="0,0,0,6">
              <Image.Style>
                <!-- Source is set by the trigger, not on the element: a null Attachment used to bind
                     silently, but an indexer against an empty collection throws and WPF logs it once
                     per image-less bubble. -->
                <Style TargetType="Image">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding HasAttachments}" Value="True">
                      <Setter Property="Visibility" Value="Visible" />
                      <Setter Property="Source" Value="{Binding Attachments[0].Thumbnail}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Image.Style>
            </Image>
            <chat:PiaCollapsibleMessageText
                Text="{Binding Content}"
                TextAutomationId="{Binding Id, StringFormat='Assistant_MessageText_{0}'}"
                ToggleAutomationId="{Binding Id, StringFormat='Assistant_ExpandMessage_{0}'}" />
          </StackPanel>
        </Border>
        <!-- What the user attached. Saved files reopen; the rest kept only their name. -->
        <ItemsControl ItemsSource="{Binding AttachedFiles}"
                      Margin="0,6,0,0"
                      HorizontalAlignment="Left"
                      Visibility="{Binding HasAttachedFiles, Converter={StaticResource BooleanToVisibilityConverter}}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <chat:PiaAttachedFileChip FileName="{Binding FileName}"
                                        SavedRelativePath="{Binding SavedRelativePath}"
                                        CommandParameter="{Binding}"
                                        Margin="0,0,6,4"
                                        OpenCommand="{Binding DataContext.OpenAttachedFileCommand,
                                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        RevealCommand="{Binding DataContext.RevealAttachedFileCommand,
                                                                RelativeSource={RelativeSource AncestorType=UserControl}}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Left"
                    Margin="0,4,0,0">
          <ui:Button Appearance="Transparent"
                     Padding="4"
                     Command="{Binding DataContext.CopyMessageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                     CommandParameter="{Binding}"
                     AutomationProperties.Name="{loc:Str Assistant_Copy_Tooltip}"
                     AutomationProperties.AutomationId="{Binding Id, StringFormat='Assistant_CopyMessage_{0}'}"
                     ToolTip="{loc:Str Assistant_Copy_Tooltip}">
            <ui:Button.Style>
              <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                <Setter Property="Opacity" Value="0" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsMouseOver, ElementName=UserMessagePanel}" Value="True">
                    <Setter Property="Opacity" Value="1" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </ui:Button.Style>
            <ui:SymbolIcon Symbol="Copy16" FontSize="12" />
          </ui:Button>
        </StackPanel>
      </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="AssistantMessageTemplate">
      <!-- Grid rather than a horizontal StackPanel, so the width constraint propagates into the markdown
           body instead of letting long content and code blocks render at their natural width. -->
      <Grid HorizontalAlignment="Stretch" Margin="0,0,0,12">
        <Grid.Style>
          <Style TargetType="Grid">
            <Style.Triggers>
              <!-- The avatar is the one part with no condition of its own, so a message whose every section
                   hid itself would otherwise render as a lone glyph. -->
              <DataTrigger Binding="{Binding IsEmptyShell}" Value="True">
                <Setter Property="Visibility" Value="Collapsed" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Grid.Style>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <chat:PiaPersonaAvatar Grid.Column="0"
                               PersonaId="{Binding PersonaGlyphId}"
                               Emoji="{Binding PersonaGlyphEmoji}"
                               Margin="0,2,12,0"
                               VerticalAlignment="Top" />
        <chat:PiaAssistantMessage Grid.Column="1"
            HorizontalAlignment="Left"
            MaxWidth="880"
            CopyCommand="{Binding DataContext.CopyMessageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
            SpeakCommand="{Binding DataContext.PlayMessageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
            RegenerateCommand="{Binding DataContext.RegenerateMessageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
            RegenerateStyledCommand="{Binding DataContext.RegenerateStyledCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
            ExportCommand="{Binding DataContext.ExportMessageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
            RateCommand="{Binding DataContext.RateMessageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
            SuggestionCommand="{Binding DataContext.UseFollowupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
            SwitchToAgentCommand="{Binding DataContext.SwitchToAgentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
            ManageToolPermissionsCommand="{Binding DataContext.NavigateToToolPermissionsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
            OpenSourceCommand="{Binding DataContext.OpenSourceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
            AddToPiiRequested="OnAddToPiiRequested" />
      </Grid>
    </DataTemplate>
  </UserControl.Resources>
  <Grid x:Name="RootGrid"
        Background="Transparent"
        behaviors:FileDropBehavior.IsEnabled="True"
        behaviors:FileDropBehavior.AcceptedExtensions=".txt,.md,.json,.xml,.yaml,.yml,.csv,.log,.ini,.cs,.js,.ts,.py,.html,.htm,.css,.sql,.sh,.ps1,.bat,.cmd,.toml,.docx,.xlsx,.xlsm,.pdf,.eml,.msg,.png,.jpg,.jpeg,.gif,.bmp,.webp"
        behaviors:FileDropBehavior.FilesDroppedCommand="{Binding HandleFilesDroppedCommand}"
        behaviors:FileDropBehavior.DropFailedCommand="{Binding HandleDropFailedCommand}">
    <!-- Main content + panel overlay -->
    <Grid x:Name="MainContent">
      <Grid.Style>
        <Style TargetType="Grid">
          <Style.Triggers>
            <DataTrigger Binding="{Binding Path=(behaviors:FileDropBehavior.IsDragOver), ElementName=RootGrid}" Value="True">
              <Setter Property="Effect">
                <Setter.Value>
                  <BlurEffect Radius="6" KernelType="Gaussian" />
                </Setter.Value>
              </Setter>
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </Grid.Style>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

    <!-- Chat title chip + run-progress panel -->
    <StackPanel Grid.Row="0">
      <assistant:PiaChatTitleChip DataContext="{Binding ChatTitleChip}"
                                  Margin="20,12,20,0" />
      <!-- Read-only run-progress panel (1.4). Embedded when the active chat has a live/selected run.
           DataContext = ActiveRunProgress; visibility resolves against the VM via the root UserControl. -->
      <assistant:RunProgressPanel Margin="20,8,20,0"
                                  DataContext="{Binding ActiveRunProgress}"
                                  Visibility="{Binding DataContext.ActiveRunProgress, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource NullToVisibilityConverter}}" />
    </StackPanel>

    <!-- Empty state -->
    <StackPanel Grid.Row="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Visibility="{Binding HasMessages, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
      <ui:SymbolIcon Symbol="Chat48"
                     FontSize="48"
                     HorizontalAlignment="Center"
                     Margin="0,0,0,16"
                     Foreground="{DynamicResource PiaAccentBrush}" />
      <TextBlock Text="{loc:Str Assistant_EmptyState}"
                 FontSize="16"
                 HorizontalAlignment="Center"
                 Foreground="{DynamicResource TextPlaceholderColorBrush}" />

      <!-- The folder this chat's file tools work in. Reads the title-chip VM, which every
           re-point already funnels through. -->
      <StackPanel Orientation="Horizontal"
                  HorizontalAlignment="Center"
                  Margin="0,6,0,0">
        <ui:Button Command="{Binding ChatTitleChip.OpenWorkingDirectoryCommand}"
                   Appearance="Transparent"
                   BorderThickness="0"
                   Padding="2"
                   Margin="0,0,3,0"
                   Cursor="Hand"
                   VerticalAlignment="Center"
                   AutomationProperties.Name="{loc:Str Assistant_OpenWorkingDirectory_Tooltip}"
                   AutomationProperties.AutomationId="Assistant_OpenWorkingDirectory"
                   ToolTip="{loc:Str Assistant_OpenWorkingDirectory_Tooltip}">
          <ui:SymbolIcon Symbol="Folder24"
                         FontSize="12"
                         Foreground="{DynamicResource TextPlaceholderColorBrush}" />
        </ui:Button>
        <!-- In-place re-point: an un-started chat is the only one whose folder can still change, so
             the edit lives on the empty state. Fill, outline and chevron surface on hover only. -->
        <Button x:Name="EmptyWorkingDirButton"
                Cursor="Hand"
                VerticalAlignment="Center"
                Click="EmptyWorkingDirButton_Click"
                AutomationProperties.AutomationId="Assistant_EditWorkingDirectory"
                ToolTip="{loc:Str AssistantChat_WorkingDir_Tooltip}">
          <Button.Template>
            <ControlTemplate TargetType="Button">
              <Border x:Name="Bd"
                      CornerRadius="{StaticResource SmallRadius}"
                      Padding="6,2"
                      Background="Transparent"
                      BorderThickness="1"
                      BorderBrush="Transparent"
                      TextBlock.Foreground="{DynamicResource TextPlaceholderColorBrush}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <ContentPresenter VerticalAlignment="Center" />
                  <ui:SymbolIcon x:Name="Chevron"
                                 Symbol="ChevronDown20"
                                 FontSize="11"
                                 Margin="4,0,0,0"
                                 Opacity="0"
                                 VerticalAlignment="Center" />
                </StackPanel>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceMutedBrush}" />
                  <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BorderBrush_}" />
                  <Setter TargetName="Bd" Property="TextBlock.Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                  <Setter TargetName="Chevron" Property="Opacity" Value="1" />
                </Trigger>
                <!-- Latch the hover look while the picker is open: the mouse is over the popup by
                     then, and a row that snapped back to bare text read as dismissed. -->
                <DataTrigger Binding="{Binding ChatTitleChip.IsInlinePickerOpen}" Value="True">
                  <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceMutedBrush}" />
                  <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BorderBrush_}" />
                  <Setter TargetName="Bd" Property="TextBlock.Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                  <Setter TargetName="Chevron" Property="Opacity" Value="1" />
                </DataTrigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Button.Template>
          <!-- Full path in the tooltip: CharacterEllipsis trims the trailing leaf folder. -->
          <TextBlock Text="{Binding ChatTitleChip.ActiveWorkingDirectoryDisplay}"
                     FontSize="12"
                     MaxWidth="360"
                     TextTrimming="CharacterEllipsis"
                     VerticalAlignment="Center"
                     ToolTip="{Binding ChatTitleChip.ActiveWorkingDirectoryDisplay}" />
        </Button>

        <Popup x:Name="EmptyWorkingDirPopup"
               IsOpen="{Binding ChatTitleChip.IsInlinePickerOpen, Mode=TwoWay}"
               PlacementTarget="{Binding ElementName=EmptyWorkingDirButton}"
               Placement="Bottom"
               StaysOpen="False"
               AllowsTransparency="True"
               PopupAnimation="Fade"
               Opened="EmptyWorkingDirPopup_Opened"
               Closed="EmptyWorkingDirPopup_Closed">
          <Border Background="{DynamicResource SurfaceBrush}"
                  BorderBrush="{DynamicResource BorderBrush_}"
                  BorderThickness="1"
                  CornerRadius="{StaticResource LargeRadius}"
                  Padding="6"
                  MinWidth="320"
                  MaxWidth="380"
                  MaxHeight="360"
                  DataContext="{Binding ChatTitleChip.WorkingDirectoryPicker}">
            <Border.Effect>
              <DropShadowEffect Color="#0F1729" BlurRadius="18" Opacity="0.16" ShadowDepth="4" />
            </Border.Effect>
            <shared:PiaWorkingDirectoryPicker x:Name="EmptyWorkingDirPicker"
                                              AutomationIdPrefix="Assistant_WorkingDir"
                                              CloseRequested="EmptyWorkingDirPicker_CloseRequested" />
          </Border>
        </Popup>
      </StackPanel>

      <!-- Drawn per visit from the capability groups the profile actually has data for, so the id is
           per-item: a literal here would make every chip report the same one. -->
      <ItemsControl ItemsSource="{Binding Suggestions}"
                    HorizontalAlignment="Center"
                    Margin="0,24,0,0"
                    MaxWidth="420">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel HorizontalAlignment="Center" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <ui:Button Appearance="Secondary"
                       Margin="4"
                       Padding="10,6"
                       CornerRadius="14"
                       Cursor="Hand"
                       Command="{Binding DataContext.UseSuggestionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       CommandParameter="{Binding Text}"
                       AutomationProperties.AutomationId="{Binding Id, StringFormat='Assistant_Suggestion_{0}'}">
              <TextBlock Text="{Binding Text}"
                         FontSize="12"
                         MaxWidth="380"
                         TextWrapping="Wrap" />
            </ui:Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>

    <!-- Message list -->
    <ScrollViewer x:Name="MessageScrollViewer"
                  AutomationProperties.AutomationId="MessageScrollViewer"
                  Grid.Row="1"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="20,12,20,0"
                  ScrollChanged="MessageScrollViewer_ScrollChanged">
      <!-- Absolute mapping, so the fade stays a fixed band under the run-progress panel instead of scaling
           with the viewport. -->
      <ScrollViewer.OpacityMask>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,24" MappingMode="Absolute">
          <GradientStop Offset="0" Color="#00000000" />
          <GradientStop Offset="1" Color="#FF000000" />
        </LinearGradientBrush>
      </ScrollViewer.OpacityMask>
      <ScrollViewer.Style>
        <Style TargetType="ScrollViewer">
          <Setter Property="Visibility" Value="Visible" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding HasMessages}" Value="False">
              <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </ScrollViewer.Style>
      <StackPanel>
        <!-- Scrolls with the transcript rather than floating over it, so it reads as the start of the
             conversation and takes no layout when there is nothing older. -->
        <Button x:Name="LoadOlderMessagesButton"
                HorizontalAlignment="Center"
                Margin="0,0,0,12"
                Padding="12,6"
                Cursor="Hand"
                Command="{Binding LoadOlderMessagesCommand}"
                Content="{Binding OlderMessageCount, Converter={StaticResource OlderMessagesLabelConverter}}"
                Visibility="{Binding HasOlderMessages, Converter={StaticResource BooleanToVisibilityConverter}}"
                AutomationProperties.AutomationId="Assistant_LoadOlderMessages"
                ToolTip="{loc:Str Assistant_LoadOlderMessages_Tooltip}" />
        <ItemsControl x:Name="MessageItemsControl"
                      ItemsSource="{Binding VisibleMessages}"
                      behaviors:AutomationPeerRefreshBehavior.RefreshOnContainersGenerated="True"
                      RequestBringIntoView="MessageItemsControl_RequestBringIntoView">
          <ItemsControl.ItemTemplateSelector>
            <local:MessageRoleTemplateSelector UserTemplate="{StaticResource UserMessageTemplate}"
                                               AssistantTemplate="{StaticResource AssistantMessageTemplate}" />
          </ItemsControl.ItemTemplateSelector>
        </ItemsControl>
        <!-- A headless step writes its reply only when it ENDS, so the transcript would otherwise sit still
             for the whole step. Rendered here rather than as a message: anything inside Messages would be
             persisted, replayed into the model's context and windowed with the transcript. Its text is the
             run panel's, so the two surfaces cannot drift apart. -->
        <Grid x:Name="LiveRunActivity"
              AutomationProperties.AutomationId="Assistant_LiveRunActivity"
              Margin="0,0,0,12">
          <Grid.Style>
            <Style TargetType="Grid">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <MultiDataTrigger>
                  <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding ForeignRunActive}" Value="True" />
                    <Condition Binding="{Binding ActiveRunProgress.HasToolActivity}" Value="True" />
                  </MultiDataTrigger.Conditions>
                  <Setter Property="Visibility" Value="Visible" />
                </MultiDataTrigger>
              </Style.Triggers>
            </Style>
          </Grid.Style>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <ui:ProgressRing Grid.Column="0"
                           Width="14" Height="14"
                           IsIndeterminate="True"
                           Margin="9,3,13,0"
                           VerticalAlignment="Top" />
          <!-- The ids live on the TextBlocks, not on the Grid above: a layout panel is outside UIA's control
               view, so an id there is unreachable to a script even while the line is on screen. -->
          <StackPanel Grid.Column="1">
            <TextBlock Text="{Binding ActiveRunProgress.CurrentActivity}"
                       AutomationProperties.AutomationId="Assistant_LiveRunActivity_Step"
                       FontSize="12"
                       TextTrimming="CharacterEllipsis"
                       Foreground="{DynamicResource TextSubtleBrush}" />
            <TextBlock Text="{Binding ActiveRunProgress.ToolActivity}"
                       AutomationProperties.AutomationId="Assistant_LiveRunActivity_Tools"
                       FontSize="12"
                       FontStyle="Italic"
                       TextTrimming="CharacterEllipsis"
                       Foreground="{DynamicResource TextMutedBrush}" />
          </StackPanel>
        </Grid>
      </StackPanel>
    </ScrollViewer>

    <!-- Input area -->
    <Border Grid.Row="2" Padding="20,8,20,16">
      <Border Style="{StaticResource PiaComposerCardStyle}">
        <StackPanel Margin="8">
          <!-- Weak-provider warning banner (§14.4). Non-blocking: a Planned send still runs (R10). -->
          <Border Background="{DynamicResource WarnSoftBrush}"
                  BorderBrush="{DynamicResource WarnBrush}"
                  BorderThickness="1"
                  CornerRadius="{StaticResource SmallRadius}"
                  Padding="10,8" Margin="0,0,0,6"
                  Visibility="{Binding WeakProviderWarningVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel Orientation="Horizontal">
              <ui:SymbolIcon Symbol="Warning24" FontSize="16"
                             Foreground="{DynamicResource WarnBrush}" Margin="0,0,8,0"
                             VerticalAlignment="Center" />
              <TextBlock Text="{loc:Str Agent_WeakProvider_Body}" VerticalAlignment="Center" />
              <Button Content="{loc:Str Agent_Warn_Continue}"
                      Command="{Binding DismissWeakWarningCommand}" Margin="8,0,0,0"
                      AutomationProperties.AutomationId="Assistant_WeakProvider_Continue" />
              <Button Content="{loc:Str Agent_Warn_ChooseProvider}"
                      Command="{Binding OpenProviderSettingsCommand}" Margin="4,0,0,0"
                      AutomationProperties.AutomationId="Assistant_WeakProvider_ChooseProvider" />
              <Button Content="{loc:Str Agent_Warn_StayInChat}"
                      Command="{Binding StayInChatCommand}" Margin="4,0,0,0"
                      AutomationProperties.AutomationId="Assistant_WeakProvider_StayInChat" />
            </StackPanel>
          </Border>

          <!-- Agent-context offer. Stacked below the weak-provider banner rather than merged: both can hold
               at once. BLOCKS sending until answered — "Off" must be a click, not an oversight. -->
          <Border Background="{DynamicResource AccentSoftBrush}"
                  BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                  BorderThickness="1"
                  CornerRadius="{StaticResource SmallRadius}"
                  Padding="10,8" Margin="0,0,0,6"
                  Visibility="{Binding AgentContextChoicePending, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel Orientation="Horizontal">
              <ui:SymbolIcon Symbol="Chat24" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center" />
              <TextBlock Text="{loc:Str Agent_Context_Body}" VerticalAlignment="Center"
                         TextWrapping="Wrap" MaxWidth="380" />
              <Button Content="{loc:Str Agent_Context_Summary}"
                      Command="{Binding SetAgentContextCommand}" CommandParameter="Summary"
                      Margin="8,0,0,0" VerticalAlignment="Center"
                      AutomationProperties.AutomationId="Assistant_AgentContext_Summary" />
              <Button Content="{loc:Str Agent_Context_Verbatim}"
                      Command="{Binding SetAgentContextCommand}" CommandParameter="Verbatim"
                      Margin="4,0,0,0" VerticalAlignment="Center"
                      AutomationProperties.AutomationId="Assistant_AgentContext_Verbatim" />
              <Button Content="{loc:Str Agent_Context_Off}"
                      Command="{Binding SetAgentContextCommand}" CommandParameter="Off"
                      Margin="4,0,0,0" VerticalAlignment="Center"
                      AutomationProperties.AutomationId="Assistant_AgentContext_Off" />
            </StackPanel>
          </Border>

          <!-- The settled state: what a recorded choice is doing, so it never acts invisibly. -->
          <StackPanel Orientation="Horizontal" Margin="2,0,0,6"
                      Visibility="{Binding AgentContextSettledVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock Text="{Binding AgentContextSettledLabel}"
                       FontSize="12" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       Foreground="{DynamicResource TextSubtleBrush}" />
            <ui:Button Content="{loc:Str Agent_Context_Change}"
                       Command="{Binding ChangeAgentContextCommand}"
                       Appearance="Transparent" Padding="6,0" Margin="4,0,0,0"
                       FontSize="12" VerticalAlignment="Center"
                       AutomationProperties.AutomationId="Assistant_AgentContext_Change" />
          </StackPanel>
          <Border Margin="0,0,0,6" Padding="6"
                  CornerRadius="6"
                  BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                  BorderThickness="1"
                  HorizontalAlignment="Left"
                  MaxWidth="560"
                  Visibility="{Binding HasPendingFiles, Converter={StaticResource BooleanToVisibilityConverter}}">
            <ItemsControl ItemsSource="{Binding PendingFiles}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border MinHeight="34" Margin="0,2,6,2" Padding="8,2,2,2"
                          CornerRadius="{StaticResource BubbleRadius}"
                          Background="{DynamicResource SurfaceBrush}"
                          BorderBrush="{DynamicResource BorderBrush_}"
                          BorderThickness="1"
                          ToolTip="{Binding FullPath}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                      <ui:SymbolIcon Symbol="{Binding Icon}" FontSize="16"
                                     Margin="0,0,6,0" VerticalAlignment="Center" />
                      <TextBlock Text="{Binding FileName}"
                                 MaxWidth="180"
                                 TextTrimming="CharacterEllipsis"
                                 VerticalAlignment="Center" />
                      <ui:Button Command="{Binding DataContext.SavePendingFileCommand,
                                                   RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                 CommandParameter="{Binding}"
                                 Appearance="Transparent"
                                 Padding="4"
                                 Margin="4,0,0,0"
                                 VerticalAlignment="Center"
                                 AutomationProperties.Name="{loc:Str Assistant_SavePendingFile_Tooltip}"
                                 AutomationProperties.AutomationId="{Binding FullPath, StringFormat='Assistant_SavePendingFile_{0}'}"
                                 ToolTip="{loc:Str Assistant_SavePendingFile_Tooltip}">
                        <ui:Button.Style>
                          <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                              <!-- Saved, or nothing to save into: the tick below takes over. -->
                              <DataTrigger Binding="{Binding IsSaved}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                              </DataTrigger>
                              <DataTrigger Binding="{Binding DataContext.CanSavePendingFiles,
                                                             RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                           Value="False">
                                <Setter Property="Visibility" Value="Collapsed" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </ui:Button.Style>
                        <ui:SymbolIcon Symbol="Save16" FontSize="12" />
                      </ui:Button>
                      <ui:SymbolIcon Symbol="CheckmarkCircle16"
                                     FontSize="14"
                                     Margin="6,0,0,0"
                                     VerticalAlignment="Center"
                                     Foreground="{DynamicResource PiaAccentBrush}"
                                     ToolTip="{loc:Str Assistant_PendingFileSaved_Tooltip}"
                                     Visibility="{Binding IsSaved, Converter={StaticResource BooleanToVisibilityConverter}}" />
                      <ui:Button Command="{Binding DataContext.RemovePendingFileCommand,
                                                   RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                 CommandParameter="{Binding}"
                                 Appearance="Transparent"
                                 Padding="4"
                                 Margin="4,0,0,0"
                                 VerticalAlignment="Center"
                                 AutomationProperties.Name="{loc:Str Assistant_RemovePendingFile_Tooltip}"
                                 AutomationProperties.AutomationId="{Binding FullPath, StringFormat='Assistant_RemovePendingFile_{0}'}"
                                 ToolTip="{loc:Str Assistant_RemovePendingFile_Tooltip}">
                        <ui:SymbolIcon Symbol="Dismiss16" FontSize="12" />
                      </ui:Button>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Border>
          <Border Margin="0,0,0,6" Padding="6"
                  CornerRadius="6"
                  BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                  BorderThickness="1"
                  HorizontalAlignment="Left">
            <Border.Style>
              <Style TargetType="Border">
                <Setter Property="Visibility" Value="Visible" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding PendingAttachment}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Border.Style>
            <StackPanel Orientation="Horizontal">
              <Image Source="{Binding PendingAttachment.Thumbnail}"
                     MaxWidth="64" MaxHeight="64"
                     Stretch="Uniform"
                     Margin="0,0,8,0" />
              <ui:Button Command="{Binding RemoveAttachmentCommand}"
                         Appearance="Transparent"
                         Padding="4"
                         VerticalAlignment="Center"
                         AutomationProperties.Name="{loc:Str Assistant_RemoveAttachment_Tooltip}"
                         AutomationProperties.AutomationId="Assistant_RemoveAttachment"
                         ToolTip="{loc:Str Assistant_RemoveAttachment_Tooltip}">
                <ui:SymbolIcon Symbol="Dismiss16" FontSize="12" />
              </ui:Button>
            </StackPanel>
          </Border>
          <!-- Says what the mode changed, in the spot the goal-too-short hint uses; the VM hides this one
               when that one appears. -->
          <TextBlock Text="{loc:Str Assistant_AgentMode_Hint}"
                     Margin="2,0,0,6"
                     FontSize="12"
                     TextWrapping="Wrap"
                     Foreground="{DynamicResource TextSubtleBrush}"
                     Visibility="{Binding AgentModeHintVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
          <!-- Explains the dead Run-in-background button; above the box so the composer's bottom edge stays put. -->
          <TextBlock Text="{loc:Str Assistant_GoalTooShort_Hint}"
                     Margin="2,0,0,6"
                     FontSize="12"
                     TextWrapping="Wrap"
                     Foreground="{DynamicResource TextSubtleBrush}"
                     Visibility="{Binding GoalTooShortHintVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
          <TextBlock Text="{loc:Str Assistant_PendingFilesBlockRun_Hint}"
                     Margin="2,0,0,6"
                     FontSize="12"
                     TextWrapping="Wrap"
                     Foreground="{DynamicResource TextSubtleBrush}"
                     Visibility="{Binding PendingFilesBlockRunHintVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
          <!-- A drop that produced no chip. Here rather than only in the corner toast: a drop leaves the source
               app in front, so a toast can land behind the window the user just dragged from. -->
          <TextBlock Text="{Binding DropFailureMessage}"
                     Margin="2,0,0,6"
                     FontSize="12"
                     TextWrapping="Wrap"
                     Foreground="{DynamicResource WarningBrush}"
                     Visibility="{Binding DropFailureMessage, Converter={StaticResource NullToVisibilityConverter}}" />
          <Grid>
            <ui:TextBox x:Name="InputTextBox"
                        AutomationProperties.AutomationId="InputTextBox"
                        FontFamily="{StaticResource EmojiCapableFontFamily}"
                        Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                        PlaceholderText="{loc:Str Assistant_InputPlaceholder}"
                        PlaceholderEnabled="True"
                        TextWrapping="Wrap"
                        AcceptsReturn="True"
                        VerticalScrollBarVisibility="Auto"
                        TextChanged="InputTextBox_TextChanged"
                        FontSize="14"
                        Padding="6,6"
                        BorderThickness="0"
                        Background="Transparent"
                        ClearButtonEnabled="False"
                        PreviewKeyDown="InputTextBox_PreviewKeyDown"
                        behaviors:AtCommandAutocompleteBehavior.IsEnabled="True"
                        behaviors:AtCommandAutocompleteBehavior.PopupControl="{Binding ElementName=AtCommandPopup}"
                        behaviors:AtCommandAutocompleteBehavior.AutocompleteService="{Binding AutocompleteService}" />
            <controls:AutocompletePopup x:Name="AtCommandPopup" />
          </Grid>

          <Grid Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
              <!-- Grow the composer past the few lines it collapses to. Only offered once the draft is
                   actually taller than that, so it does not sit there as a dead control. -->
              <ui:Button x:Name="ComposerExpandButton"
                         Click="ComposerExpandButton_Click"
                         Appearance="Transparent"
                         Padding="6,4"
                         Margin="0,0,2,0"
                         AutomationProperties.Name="{loc:Str Assistant_ExpandComposer_Tooltip}"
                         AutomationProperties.AutomationId="Assistant_ExpandComposer"
                         Visibility="{Binding IsComposerOverflowing, RelativeSource={RelativeSource AncestorType=local:AssistantView}, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ui:Button.ToolTip>
                  <ToolTip Content="{loc:Str Assistant_ExpandComposer_Tooltip}" />
                </ui:Button.ToolTip>
                <ui:SymbolIcon x:Name="ComposerExpandIcon" Symbol="ChevronUp24" FontSize="16" />
              </ui:Button>

              <!-- New chat: additive, so a turn in flight keeps streaming in the chat it belongs to. -->
              <ui:Button Command="{Binding NewChatCommand}"
                         Appearance="Transparent"
                         Padding="6,4"
                         Margin="0,0,2,0"
                         AutomationProperties.Name="{loc:Str Assistant_NewChat_Tooltip}"
                         AutomationProperties.AutomationId="Assistant_NewChat"
                         ToolTip="{loc:Str Assistant_NewChat_Tooltip}">
                <ui:SymbolIcon Symbol="Add24" FontSize="16" />
              </ui:Button>

              <!-- Delete the open chat. Dead on an empty chat, so the tooltip has to survive
                   the disabled state. -->
              <ui:Button Command="{Binding DeleteCurrentChatCommand}"
                         Appearance="Transparent"
                         Padding="6,4"
                         Margin="0,0,2,0"
                         ToolTipService.ShowOnDisabled="True"
                         AutomationProperties.Name="{loc:Str Assistant_DeleteChat_Tooltip}"
                         AutomationProperties.AutomationId="Assistant_DeleteChat"
                         ToolTip="{loc:Str Assistant_DeleteChat_Tooltip}">
                <ui:SymbolIcon Symbol="Delete24" FontSize="16"
                               Foreground="{DynamicResource PiaDangerBrush}">
                  <ui:SymbolIcon.Style>
                    <Style TargetType="ui:SymbolIcon">
                      <Style.Triggers>
                        <!-- The local Foreground above outranks the template's disabled brush, so a
                             disabled trash can would still read as fully live red. -->
                        <DataTrigger Binding="{Binding IsEnabled, RelativeSource={RelativeSource AncestorType=ui:Button}}" Value="False">
                          <Setter Property="Opacity" Value="0.4" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </ui:SymbolIcon.Style>
                </ui:SymbolIcon>
              </ui:Button>

              <!-- Cancel button (visible during streaming) -->
              <ui:Button Command="{Binding CancelStreamingCommand}"
                         Appearance="Transparent"
                         Padding="6,4"
                         Margin="0,0,2,0"
                         AutomationProperties.Name="{loc:Str Assistant_Cancel_Tooltip}"
                         AutomationProperties.AutomationId="Assistant_CancelStreaming"
                         ToolTip="{loc:Str Assistant_Cancel_Tooltip}">
                <ui:Button.Style>
                  <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsStreaming}" Value="True">
                        <Setter Property="Visibility" Value="Visible" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </ui:Button.Style>
                <ui:SymbolIcon Symbol="Dismiss24" FontSize="16" />
              </ui:Button>

              <Separator Width="1" Margin="4,2" Background="{DynamicResource BorderBrush_}" />

              <!-- Record button -->
              <ui:Button Command="{Binding ToggleRecordingCommand}"
                         Appearance="Transparent"
                         Padding="6,4"
                         Margin="2,0"
                         AutomationProperties.Name="{loc:Str Assistant_Record_Tooltip}"
                         AutomationProperties.AutomationId="Assistant_ToggleRecording"
                         ToolTip="{loc:Str Assistant_Record_Tooltip}">
                <ui:SymbolIcon Symbol="Record24" FontSize="16" />
              </ui:Button>

              <!-- Attach file button -->
              <ui:Button Appearance="Transparent"
                         Padding="6,4"
                         Margin="2,0"
                         AutomationProperties.Name="{loc:Str Assistant_Attach_Tooltip}"
                         AutomationProperties.AutomationId="Assistant_AttachFile"
                         ToolTip="{loc:Str Assistant_Attach_Tooltip}"
                         Click="AttachFileButton_Click">
                <ui:SymbolIcon Symbol="Attach24" FontSize="16" />
              </ui:Button>

              <!-- Screen capture button -->
              <ui:Button Command="{Binding CaptureScreenCommand}"
                         Appearance="Transparent"
                         Padding="6,4"
                         Margin="2,0"
                         ToolTipService.ShowOnDisabled="True"
                         AutomationProperties.Name="{loc:Str Assistant_CaptureScreen_Tooltip}"
                         AutomationProperties.AutomationId="Assistant_CaptureScreen">
                <ui:Button.Style>
                  <!-- Keyed on the provider gate, not on IsEnabled: the button is also disabled while a turn
                       runs, and then the provider tooltip would lie. -->
                  <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                    <Setter Property="ToolTip" Value="{loc:Str Assistant_CaptureScreen_Tooltip}" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsScreenCaptureAvailable}" Value="False">
                        <Setter Property="ToolTip" Value="{loc:Str Assistant_CaptureScreen_Unavailable_Tooltip}" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </ui:Button.Style>
                <ui:SymbolIcon Symbol="Screenshot24" FontSize="16" />
              </ui:Button>
              <!-- Join meeting (attendee) toggle -->
              <ui:Button Command="{Binding ToggleMeetingAttendeeCommand}"
                         Padding="6,4"
                         Margin="2,0"
                         Visibility="{Binding IsMeetingAttendeeAvailable, Converter={StaticResource BooleanToVisibilityConverter}}"
                         AutomationProperties.Name="{loc:Str MeetingAttendee_ToggleButton_Tooltip}"
                         AutomationProperties.AutomationId="Assistant_ToggleMeetingAttendee"
                         ToolTip="{loc:Str MeetingAttendee_ToggleButton_Tooltip}">
                <ui:Button.Style>
                  <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                    <Setter Property="Appearance" Value="Transparent" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsMeetingAttendeeVisible}" Value="True">
                        <Setter Property="Appearance" Value="Primary" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </ui:Button.Style>
                <ui:SymbolIcon Symbol="PersonCall24" FontSize="16" />
              </ui:Button>

              <!-- Direct transcription toggle -->
              <ui:Button Command="{Binding ToggleDirectTranscriptionCommand}"
                         Padding="6,4"
                         Margin="2,0"
                         Visibility="{Binding IsDirectTranscriptionAvailable, Converter={StaticResource BooleanToVisibilityConverter}}"
                         AutomationProperties.Name="{loc:Str DirectTrans_ToggleButton_Tooltip}"
                         AutomationProperties.AutomationId="Assistant_ToggleDirectTranscription"
                         ToolTip="{loc:Str DirectTrans_ToggleButton_Tooltip}">
                <ui:Button.Style>
                  <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                    <Setter Property="Appearance" Value="Transparent" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsDirectTranscriptionVisible}" Value="True">
                        <Setter Property="Appearance" Value="Primary" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </ui:Button.Style>
                <ui:SymbolIcon Symbol="Mic24" FontSize="16" />
              </ui:Button>

              <!-- Background assignment (only when the server offers the surface) -->
              <ui:Button Command="{Binding RunAssignmentCommand}"
                         Appearance="Transparent"
                         Padding="6,4"
                         Margin="2,0"
                         Visibility="{Binding IsAssignmentSurfaceAvailable, Converter={StaticResource BooleanToVisibilityConverter}}"
                         AutomationProperties.Name="{loc:Str Assistant_RunAssignment_Tooltip}"
                         AutomationProperties.AutomationId="Assistant_RunAssignment"
                         ToolTip="{loc:Str Assistant_RunAssignment_Tooltip}">
                <ui:SymbolIcon Symbol="Rocket24" FontSize="16" />
              </ui:Button>

              <Separator Width="1" Margin="4,2" Background="{DynamicResource BorderBrush_}" />

              <!-- Persona picker (applies from the next turn). MaxWidth widened 200 -> 240 to make room
                   for the "Managed" chip in the item template: the name trims with an ellipsis, and the
                   name is the part users actually read. -->
              <ComboBox ItemsSource="{Binding AvailablePersonas}"
                        SelectedItem="{Binding ActivePersona}"
                        MinWidth="140"
                        MaxWidth="240"
                        VerticalAlignment="Center"
                        AutomationProperties.AutomationId="Assistant_PersonaPicker"
                        ToolTip="{loc:Str Settings_Tab_Personas}">
                <ComboBox.ItemTemplate>
                  <DataTemplate>
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <controls:PersonaGlyph Grid.Column="0"
                                             PersonaId="{Binding Id}"
                                             Emoji="{Binding Emoji}"
                                             GlyphSize="14"
                                             Margin="0,0,6,0"
                                             VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1"
                                 Text="{Binding Name}"
                                 VerticalAlignment="Center"
                                 TextTrimming="CharacterEllipsis" />
                      <!-- Accent colour swatch (hidden when the persona has no accent set). -->
                      <Ellipse Grid.Column="2"
                               Width="10"
                               Height="10"
                               Margin="8,0,0,0"
                               VerticalAlignment="Center"
                               Fill="{Binding AccentColor, Converter={StaticResource HexToBrushConverter}}"
                               Stroke="{DynamicResource BorderBrush_}"
                               StrokeThickness="1"
                               Visibility="{Binding AccentColor, Converter={StaticResource NullToVisibilityConverter}}"
                               ToolTip="{Binding AccentColor}" />
                      <!-- Marks an admin-published persona here too, not only on the settings card — this
                           is where a user actually picks one. Same two loc keys as the settings badge. -->
                      <Border Grid.Column="3"
                              Style="{StaticResource PiaLabelChipStyle}"
                              Background="{DynamicResource PiaAccentSoftBrush}"
                              Margin="6,0,0,0"
                              Visibility="{Binding IsManaged, Converter={StaticResource BooleanToVisibilityConverter}}"
                              ToolTip="{loc:Str Personas_ManagedTooltip}">
                        <TextBlock Text="{loc:Str Personas_Managed}"
                                   FontSize="10.5"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource PiaInkBrush}" />
                      </Border>
                    </Grid>
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>

              <Separator Width="1" Margin="4,2" Background="{DynamicResource BorderBrush_}" />

              <!-- Chat/Agent lever (1.3). Disabled when the active persona has ToolScope==None. -->
              <Border Background="{DynamicResource SurfaceSunkBrush}"
                      CornerRadius="{StaticResource SmallRadius}"
                      Padding="2"
                      VerticalAlignment="Center"
                      ToolTipService.ShowOnDisabled="True"
                      IsEnabled="{Binding ActivePersona.ToolScope, Converter={StaticResource ToolScopeToBoolConverter}, FallbackValue=False}">
                <Border.Style>
                  <Style TargetType="Border">
                    <Style.Triggers>
                      <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="ToolTip" Value="{loc:Str Lever_Disabled_NoTools}" />
                      </Trigger>
                    </Style.Triggers>
                  </Style>
                </Border.Style>
                <StackPanel Orientation="Horizontal">
                  <RadioButton Style="{StaticResource PiaSegmentedButton}"
                               GroupName="ChatAgentLever"
                               Content="{loc:Str Lever_Chat}"
                               AutomationProperties.AutomationId="Assistant_Mode_Chat"
                               IsChecked="{Binding AgentModeEnabled, Converter={StaticResource InverseBooleanConverter}}" />
                  <Grid>
                    <RadioButton Style="{StaticResource PiaSegmentedButton}"
                                 GroupName="ChatAgentLever"
                                 Content="{loc:Str Lever_Agent}"
                                 AutomationProperties.AutomationId="Assistant_Mode_Agent"
                                 IsChecked="{Binding AgentModeEnabled}" />
                    <!-- Weak-provider adorner: subtle warn dot on the Agent segment. -->
                    <Ellipse Width="6" Height="6" Margin="0,3,3,0"
                             HorizontalAlignment="Right" VerticalAlignment="Top"
                             Fill="{DynamicResource WarnBrush}"
                             ToolTip="{loc:Str Lever_WeakProvider_Tooltip}"
                             Visibility="{Binding WeakProviderWarningVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
                  </Grid>
                </StackPanel>
              </Border>
            </StackPanel>

            <!-- Send / Run-in-background buttons -->
            <Grid Grid.Column="1">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <!-- Run in background: Agent mode only. Deliberately quieter than Send's Primary fill, so the
                   two sends never read as one control; the tooltip names what the icon detaches. -->
              <ui:Button Grid.Column="0"
                         Command="{Binding RunInBackgroundCommand}"
                         Appearance="Secondary"
                         Padding="10,4" Margin="0,0,4,0"
                         AutomationProperties.Name="{loc:Str Assistant_RunInBackground_Tooltip}"
                         AutomationProperties.AutomationId="Assistant_RunInBackground"
                         ToolTip="{loc:Str Assistant_RunInBackground_Tooltip}"
                         Visibility="{Binding AgentModeEnabled, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ui:SymbolIcon Symbol="WindowNew20" FontSize="16" />
              </ui:Button>
              <!-- Send. While a turn is in flight the command can't execute, and the greyed-out Primary
                   button read as nothing at all — so a busy pill covers it for the whole turn (covers,
                   not replaces: collapsing the button would resize this Auto cell). -->
              <Grid Grid.Column="1">
                <ui:Button Command="{Binding SendMessageCommand}"
                           Appearance="Primary"
                           Padding="10,4"
                           AutomationProperties.Name="{loc:Str Assistant_Send_Tooltip}"
                           AutomationProperties.AutomationId="Assistant_Send"
                           ToolTip="{loc:Str Assistant_Send_Tooltip}">
                  <ui:SymbolIcon Symbol="Send24" FontSize="16" />
                </ui:Button>
                <Border Background="{DynamicResource AccentFillColorDefaultBrush}"
                        CornerRadius="{DynamicResource ControlCornerRadius}"
                        ToolTip="{loc:Str Assistant_Working_Tooltip}"
                        Visibility="{Binding IsStreaming, Converter={StaticResource BooleanToVisibilityConverter}}">
                  <ui:SymbolIcon Symbol="ArrowSync24"
                                 FontSize="16"
                                 Foreground="White"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"
                                 RenderTransformOrigin="0.5,0.5">
                    <ui:SymbolIcon.RenderTransform>
                      <RotateTransform Angle="0" />
                    </ui:SymbolIcon.RenderTransform>
                    <ui:SymbolIcon.Style>
                      <Style TargetType="ui:SymbolIcon">
                        <Style.Triggers>
                          <!-- Rotation tracks Running, not IsStreaming: a turn parked on a tool-approval
                               card is waiting for the USER, and a turning wheel there would say "sit tight". -->
                          <DataTrigger Binding="{Binding ActiveState}" Value="Running">
                            <DataTrigger.EnterActions>
                              <BeginStoryboard x:Name="SendBusySpin" Storyboard="{StaticResource PiaSpinForever}" />
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                              <StopStoryboard BeginStoryboardName="SendBusySpin" />
                            </DataTrigger.ExitActions>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </ui:SymbolIcon.Style>
                  </ui:SymbolIcon>
                </Border>
              </Grid>
            </Grid>
          </Grid>

          <!-- W2 composer hint: a headless run owns this chat's writes, so Send stays disabled until it
               stops. The pinned run-progress panel in row 0 shows the run, but nothing there attributes the
               dead Send to it. Bound to ForeignRunActive alone, so it never appears for the streaming or
               empty-composer disabled states. Collapsed costs zero height in this StackPanel (the composer
               row is Auto), so the layout does not shift when the hint is hidden. -->
          <TextBlock Text="{loc:Str Assistant_RunActive_Hint}"
                     Margin="2,6,0,0"
                     FontSize="12"
                     TextWrapping="Wrap"
                     Foreground="{DynamicResource TextSubtleBrush}"
                     Visibility="{Binding ForeignRunActive, Converter={StaticResource BooleanToVisibilityConverter}}" />

          <!-- A sibling rather than a shared control: both the text and the condition differ, and the two
               states are mutually exclusive anyway (a parked run is not executing). -->
          <TextBlock Text="{loc:Str Assistant_PlanApprovalActive_Hint}"
                     Margin="2,6,0,0"
                     FontSize="12"
                     TextWrapping="Wrap"
                     Foreground="{DynamicResource TextSubtleBrush}"
                     Visibility="{Binding PlanApprovalParkActive, Converter={StaticResource BooleanToVisibilityConverter}}" />

        </StackPanel>
      </Border>
    </Border>
    </Grid>

    <!-- Todo panel overlay (right side) -->
    <local:TodoPanelControl x:Name="TodoPanel"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Stretch"
                            Width="0"
                            Visibility="Collapsed">
      <local:TodoPanelControl.Style>
        <Style TargetType="local:TodoPanelControl">
          <Style.Triggers>
            <DataTrigger Binding="{Binding DataContext.IsTodoPanelOpen, ElementName=TodoPanel}" Value="True">
              <DataTrigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Visibility">
                      <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                    </ObjectAnimationUsingKeyFrames>
                    <DoubleAnimation Storyboard.TargetProperty="Width"
                                     From="0" To="280" Duration="0:0:0.25">
                      <DoubleAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseOut" />
                      </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                  </Storyboard>
                </BeginStoryboard>
              </DataTrigger.EnterActions>
              <DataTrigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Width"
                                     From="280" To="0" Duration="0:0:0.2">
                      <DoubleAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseIn" />
                      </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Visibility">
                      <DiscreteObjectKeyFrame KeyTime="0:0:0.2" Value="{x:Static Visibility.Collapsed}" />
                    </ObjectAnimationUsingKeyFrames>
                  </Storyboard>
                </BeginStoryboard>
              </DataTrigger.ExitActions>
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </local:TodoPanelControl.Style>
    </local:TodoPanelControl>

    <!-- Quick switcher overlay (Ctrl+H) -->
    <assistant:PiaChatQuickSwitcher Grid.Row="0" Grid.RowSpan="3"
                                    DataContext="{Binding ChatTitleChip}"
                                    Panel.ZIndex="9"
                                    Visibility="{Binding IsQuickSwitcherOpen, Converter={StaticResource BooleanToVisibilityConverter}}" />

    <!-- Voice Mode Overlay -->
    <local:VoiceModeOverlay Grid.Row="0" Grid.RowSpan="3"
                            DataContext="{Binding VoiceMode}"
                            Panel.ZIndex="10"
                            Visibility="{Binding DataContext.IsVoiceModeActive,
                              RelativeSource={RelativeSource AncestorType=UserControl},
                              Converter={StaticResource BooleanToVisibilityConverter}}" />

    <!-- Meeting Attendee Overlay (Join meeting + transcribe) -->
    <local:MeetingAttendeeOverlay Grid.Row="0" Grid.RowSpan="3"
                                  DataContext="{Binding MeetingAttendee}"
                                  Panel.ZIndex="11"
                                  Visibility="{Binding DataContext.IsMeetingAttendeeVisible,
                                    RelativeSource={RelativeSource AncestorType=UserControl},
                                    Converter={StaticResource BooleanToVisibilityConverter}}" />

    <!-- Direct Transcription Overlay (local mic + system-audio live transcription with consent) -->
    <local:DirectTranscriptionOverlay Grid.Row="0" Grid.RowSpan="3"
                                      DataContext="{Binding DirectTranscription}"
                                      Panel.ZIndex="12"
                                      Visibility="{Binding DataContext.IsDirectTranscriptionVisible,
                                        RelativeSource={RelativeSource AncestorType=UserControl},
                                        Converter={StaticResource BooleanToVisibilityConverter}}" />

    <!-- Drag-over overlay (visible while a file is being dragged onto the view) -->
    <Border IsHitTestVisible="False"
            Panel.ZIndex="20"
            Margin="8"
            CornerRadius="8"
            BorderThickness="2"
            BorderBrush="{DynamicResource AccentFillColorDefaultBrush}"
            Background="{DynamicResource AcrylicBackgroundFillColorBaseBrush}"
            Visibility="{Binding Path=(behaviors:FileDropBehavior.IsDragOver), ElementName=RootGrid, Converter={StaticResource BooleanToVisibilityConverter}}">
      <StackPanel HorizontalAlignment="Center"
                  VerticalAlignment="Center">
        <ui:SymbolIcon Symbol="ArrowDownload24"
                       FontSize="48"
                       HorizontalAlignment="Center"
                       Foreground="{DynamicResource AccentFillColorDefaultBrush}" />
        <TextBlock Text="{loc:Str FileDrop_Overlay_Hint_Assistant}"
                   FontSize="16"
                   FontWeight="SemiBold"
                   Margin="0,12,0,0"
                   HorizontalAlignment="Center"
                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>

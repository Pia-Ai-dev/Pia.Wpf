<UserControl x:Class="Pia.Views.Controls.ImageViewerOverlay"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  xmlns:converters="clr-namespace:Pia.Converters"
  xmlns:loc="clr-namespace:Pia.Localization"
  mc:Ignorable="d"
  Visibility="Collapsed"
  Focusable="True"
  KeyboardNavigation.TabNavigation="Cycle"
  KeyboardNavigation.ControlTabNavigation="Cycle"
  KeyboardNavigation.DirectionalNavigation="Contained"
  FocusVisualStyle="{x:Null}">

  <UserControl.Resources>
    <converters:EncodedImageToBitmapConverter x:Key="EncodedImageToBitmap" />
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <Style x:Key="ViewerButton" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
      <Setter Property="Appearance" Value="Transparent" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="Padding" Value="8" />
      <Setter Property="Margin" Value="2,0" />
    </Style>
  </UserControl.Resources>

  <Grid MouseLeftButtonDown="OnRootMouseLeftButtonDown"
        MouseLeftButtonUp="OnRootMouseLeftButtonUp">
    <Border Background="#E6000000" />

    <ScrollViewer x:Name="ImageScroller"
                  Margin="96,96,96,16"
                  Focusable="False"
                  SizeChanged="OnScrollerSizeChanged"
                  PreviewMouseWheel="OnScrollerPreviewMouseWheel">
      <ScrollViewer.Style>
        <Style TargetType="ScrollViewer">
          <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
          <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding IsFitToWindow}" Value="True">
              <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
              <Setter Property="VerticalScrollBarVisibility" Value="Disabled" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </ScrollViewer.Style>
      <Image x:Name="ViewedImage"
             Source="{Binding CurrentImageBytes, Converter={StaticResource EncodedImageToBitmap}}"
             HorizontalAlignment="Center"
             VerticalAlignment="Center"
             RenderOptions.BitmapScalingMode="HighQuality"
             MouseLeftButtonDown="OnImageMouseLeftButtonDown"
             MouseMove="OnImageMouseMove"
             LostMouseCapture="OnImageLostMouseCapture"
             MouseLeftButtonUp="OnImageMouseLeftButtonUp">
        <Image.Style>
          <Style TargetType="Image">
            <Setter Property="Stretch" Value="None" />
            <Setter Property="LayoutTransform">
              <Setter.Value>
                <ScaleTransform ScaleX="{Binding Zoom}" ScaleY="{Binding Zoom}" />
              </Setter.Value>
            </Setter>
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsFitToWindow}" Value="True">
                <Setter Property="Stretch" Value="Uniform" />
                <Setter Property="StretchDirection" Value="DownOnly" />
                <Setter Property="LayoutTransform" Value="{x:Null}" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Image.Style>
      </Image>
    </ScrollViewer>

    <ui:Button Style="{StaticResource ViewerButton}"
               HorizontalAlignment="Left"
               VerticalAlignment="Center"
               Margin="42,0,0,0"
               Command="{Binding PreviousCommand}"
               Visibility="{Binding HasMany, Converter={StaticResource BoolToVisibility}}"
               AutomationProperties.AutomationId="ImageViewer_Previous"
               AutomationProperties.Name="{loc:Str ImageViewer_Previous_Tooltip}"
               ToolTip="{loc:Str ImageViewer_Previous_Tooltip}">
      <ui:SymbolIcon Symbol="ChevronLeft24" FontSize="28" />
    </ui:Button>

    <ui:Button Style="{StaticResource ViewerButton}"
               HorizontalAlignment="Right"
               VerticalAlignment="Center"
               Margin="0,0,42,0"
               Command="{Binding NextCommand}"
               Visibility="{Binding HasMany, Converter={StaticResource BoolToVisibility}}"
               AutomationProperties.AutomationId="ImageViewer_Next"
               AutomationProperties.Name="{loc:Str ImageViewer_Next_Tooltip}"
               ToolTip="{loc:Str ImageViewer_Next_Tooltip}">
      <ui:SymbolIcon Symbol="ChevronRight24" FontSize="28" />
    </ui:Button>

    <DockPanel VerticalAlignment="Top" Margin="16,52,16,8">
      <TextBlock DockPanel.Dock="Left"
                 VerticalAlignment="Center"
                 Foreground="White"
                 Text="{Binding PositionText}" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <ui:Button Style="{StaticResource ViewerButton}"
                   Command="{Binding ZoomOutCommand}"
                   AutomationProperties.AutomationId="ImageViewer_ZoomOut"
                   AutomationProperties.Name="{loc:Str ImageViewer_ZoomOut_Tooltip}"
                   ToolTip="{loc:Str ImageViewer_ZoomOut_Tooltip}">
          <ui:SymbolIcon Symbol="ZoomOut24" />
        </ui:Button>
        <ui:Button Style="{StaticResource ViewerButton}"
                   Command="{Binding ZoomInCommand}"
                   AutomationProperties.AutomationId="ImageViewer_ZoomIn"
                   AutomationProperties.Name="{loc:Str ImageViewer_ZoomIn_Tooltip}"
                   ToolTip="{loc:Str ImageViewer_ZoomIn_Tooltip}">
          <ui:SymbolIcon Symbol="ZoomIn24" />
        </ui:Button>
        <ui:Button Style="{StaticResource ViewerButton}"
                   Command="{Binding ActualSizeCommand}"
                   AutomationProperties.AutomationId="ImageViewer_ActualSize"
                   AutomationProperties.Name="{loc:Str ImageViewer_ActualSize_Tooltip}"
                   ToolTip="{loc:Str ImageViewer_ActualSize_Tooltip}">
          <TextBlock Text="1:1" Foreground="White" />
        </ui:Button>
        <ui:Button Style="{StaticResource ViewerButton}"
                   Command="{Binding FitToWindowCommand}"
                   AutomationProperties.AutomationId="ImageViewer_Fit"
                   AutomationProperties.Name="{loc:Str ImageViewer_Fit_Tooltip}"
                   ToolTip="{loc:Str ImageViewer_Fit_Tooltip}">
          <ui:SymbolIcon Symbol="ArrowMinimize24" />
        </ui:Button>
        <ui:Button Style="{StaticResource ViewerButton}"
                   Command="{Binding CopyCommand}"
                   AutomationProperties.AutomationId="ImageViewer_Copy"
                   AutomationProperties.Name="{loc:Str ImageViewer_Copy_Tooltip}"
                   ToolTip="{loc:Str ImageViewer_Copy_Tooltip}">
          <ui:SymbolIcon Symbol="Copy24" />
        </ui:Button>
        <ui:Button Style="{StaticResource ViewerButton}"
                   Command="{Binding SaveAsCommand}"
                   AutomationProperties.AutomationId="ImageViewer_Save"
                   AutomationProperties.Name="{loc:Str ImageViewer_Save_Tooltip}"
                   ToolTip="{loc:Str ImageViewer_Save_Tooltip}">
          <ui:SymbolIcon Symbol="Save24" />
        </ui:Button>
        <ui:Button Style="{StaticResource ViewerButton}"
                   Command="{Binding CloseCommand}"
                   AutomationProperties.AutomationId="ImageViewer_Close"
                   AutomationProperties.Name="{loc:Str ImageViewer_Close_Tooltip}"
                   ToolTip="{loc:Str ImageViewer_Close_Tooltip}">
          <ui:SymbolIcon Symbol="Dismiss24" />
        </ui:Button>
      </StackPanel>
    </DockPanel>
  </Grid>
</UserControl>

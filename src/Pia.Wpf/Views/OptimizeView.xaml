<UserControl x:Class="Pia.Views.OptimizeView"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
              xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
              xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
              xmlns:local="clr-namespace:Pia.Views"
              xmlns:nav="clr-namespace:Pia.Navigation"
              xmlns:models="clr-namespace:Pia.Models"
              xmlns:loc="clr-namespace:Pia.Localization"
              xmlns:behaviors="clr-namespace:Pia.Behaviors"
              mc:Ignorable="d"
              d:DesignHeight="600" d:DesignWidth="900"
              nav:ViewModelLocator.AutoWireViewModel="True"
              PreviewKeyDown="OptimizeView_PreviewKeyDown">
  <UserControl.Resources>
    <!-- Vector flags for the output-language picker (emoji flags don't render on Windows and
         there are no PNG assets; hand-drawn tricolors keep it dependency-free). -->
    <DrawingImage x:Key="FlagImageDE">
      <DrawingImage.Drawing>
        <DrawingGroup>
          <GeometryDrawing Brush="#000000"><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,30,6"/></GeometryDrawing.Geometry></GeometryDrawing>
          <GeometryDrawing Brush="#DD0000"><GeometryDrawing.Geometry><RectangleGeometry Rect="0,6,30,6"/></GeometryDrawing.Geometry></GeometryDrawing>
          <GeometryDrawing Brush="#FFCE00"><GeometryDrawing.Geometry><RectangleGeometry Rect="0,12,30,6"/></GeometryDrawing.Geometry></GeometryDrawing>
        </DrawingGroup>
      </DrawingImage.Drawing>
    </DrawingImage>

    <DrawingImage x:Key="FlagImageFR">
      <DrawingImage.Drawing>
        <DrawingGroup>
          <GeometryDrawing Brush="#0055A4"><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,10,20"/></GeometryDrawing.Geometry></GeometryDrawing>
          <GeometryDrawing Brush="#FFFFFF"><GeometryDrawing.Geometry><RectangleGeometry Rect="10,0,10,20"/></GeometryDrawing.Geometry></GeometryDrawing>
          <GeometryDrawing Brush="#EF4135"><GeometryDrawing.Geometry><RectangleGeometry Rect="20,0,10,20"/></GeometryDrawing.Geometry></GeometryDrawing>
        </DrawingGroup>
      </DrawingImage.Drawing>
    </DrawingImage>

    <DrawingImage x:Key="FlagImageEN">
      <DrawingImage.Drawing>
        <DrawingGroup ClipGeometry="M0,0 L60,0 L60,30 L0,30 Z">
          <GeometryDrawing Brush="#012169"><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,60,30"/></GeometryDrawing.Geometry></GeometryDrawing>
          <GeometryDrawing>
            <GeometryDrawing.Pen><Pen Brush="#FFFFFF" Thickness="6"/></GeometryDrawing.Pen>
            <GeometryDrawing.Geometry>
              <GeometryGroup>
                <LineGeometry StartPoint="0,0" EndPoint="60,30"/>
                <LineGeometry StartPoint="60,0" EndPoint="0,30"/>
              </GeometryGroup>
            </GeometryDrawing.Geometry>
          </GeometryDrawing>
          <GeometryDrawing>
            <GeometryDrawing.Pen><Pen Brush="#C8102E" Thickness="2"/></GeometryDrawing.Pen>
            <GeometryDrawing.Geometry>
              <GeometryGroup>
                <LineGeometry StartPoint="0,0" EndPoint="60,30"/>
                <LineGeometry StartPoint="60,0" EndPoint="0,30"/>
              </GeometryGroup>
            </GeometryDrawing.Geometry>
          </GeometryDrawing>
          <GeometryDrawing Brush="#FFFFFF">
            <GeometryDrawing.Geometry>
              <GeometryGroup>
                <RectangleGeometry Rect="25,0,10,30"/>
                <RectangleGeometry Rect="0,10,60,10"/>
              </GeometryGroup>
            </GeometryDrawing.Geometry>
          </GeometryDrawing>
          <GeometryDrawing Brush="#C8102E">
            <GeometryDrawing.Geometry>
              <GeometryGroup>
                <RectangleGeometry Rect="27,0,6,30"/>
                <RectangleGeometry Rect="0,12,60,6"/>
              </GeometryGroup>
            </GeometryDrawing.Geometry>
          </GeometryDrawing>
        </DrawingGroup>
      </DrawingImage.Drawing>
    </DrawingImage>
  </UserControl.Resources>

  <Grid x:Name="RootGrid"
        Background="Transparent"
        behaviors:FileDropBehavior.IsEnabled="True"
        behaviors:FileDropBehavior.AcceptedExtensions=".txt,.md,.json,.xml,.yaml,.yml,.csv,.log,.ini,.cs,.js,.ts,.py,.html,.htm,.css,.sql,.sh,.ps1,.bat,.cmd,.toml,.docx,.xlsx,.xlsm"
        behaviors:FileDropBehavior.FilesDroppedCommand="{Binding HandleFilesDroppedCommand}">
    <!-- Main content + panel overlay -->
    <Grid x:Name="MainContent">
      <Grid.Style>
        <Style TargetType="Grid">
          <Style.Triggers>
            <DataTrigger Binding="{Binding Path=(behaviors:FileDropBehavior.IsDragOver), ElementName=RootGrid}" Value="True">
              <Setter Property="Effect">
                <Setter.Value>
                  <BlurEffect Radius="6" KernelType="Gaussian" />
                </Setter.Value>
              </Setter>
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </Grid.Style>
      <Grid.RowDefinitions>
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

    <Grid Grid.Row="0" Margin="20">
      <Grid.RowDefinitions>
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <Grid x:Name="InputViewGrid" Grid.Row="0"
            Visibility="{Binding IsComparisonView, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
        <Grid Margin="40,40,40,20">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="120" />
          </Grid.RowDefinitions>

          <!-- Welcome Header -->
          <StackPanel Grid.Row="0">
            <ui:SymbolIcon Symbol="Sparkle24"
                           FontSize="48"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,16"
                           Foreground="{DynamicResource PiaAccentBrush}" />
            <TextBlock Text="{loc:Str Optimize_Title}"
                       FontSize="20"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,4" />
            <TextBlock Text="{loc:Str Optimize_Subtitle}"
                       FontSize="14"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextPlaceholderColorBrush}"
                       Margin="0,0,0,24" />
          </StackPanel>

          <!-- Composer Card -->
          <Border Grid.Row="1" Style="{StaticResource PiaComposerCardStyle}">
            <Grid Margin="8">
              <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>

              <ui:TextBox x:Name="InputTextBox" Grid.Row="0"
                          Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                          PlaceholderText="{loc:Str Optimize_InputPlaceholder}"
                          PlaceholderEnabled="True"
                          TextWrapping="Wrap"
                          AcceptsReturn="True"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          FontSize="14"
                          Padding="6,6"
                          BorderThickness="0"
                          Background="Transparent"
                          ClearButtonEnabled="False"
                          PreviewKeyDown="InputTextBox_PreviewKeyDown" />

              <Grid Grid.Row="1" Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                  <!-- Clear button -->
                  <ui:Button Command="{Binding ClearInputCommand}"
                             Appearance="Transparent"
                             Width="36"
                             Height="36"
                             Padding="0"
                             Margin="0,0,2,0"
                             ToolTip="{loc:Str Optimize_Clear_Tooltip}">
                    <ui:SymbolIcon Symbol="Eraser24" FontSize="16" />
                  </ui:Button>

                  <Separator Width="1" Margin="4,6" Background="{DynamicResource BorderBrush_}" />

                  <!-- Record button -->
                  <ui:Button Command="{Binding ToggleRecordingCommand}"
                             Appearance="Transparent"
                             Width="36"
                             Height="36"
                             Padding="0"
                             Margin="2,0"
                             ToolTip="{loc:Str Optimize_Record_Tooltip}">
                    <ui:SymbolIcon Symbol="Record24" FontSize="16" />
                  </ui:Button>

                  <!-- Attach file button -->
                  <ui:Button Appearance="Transparent"
                             Width="36"
                             Height="36"
                             Padding="0"
                             Margin="2,0"
                             ToolTip="{loc:Str Optimize_Attach_Tooltip}"
                             Click="AttachFileButton_Click">
                    <ui:SymbolIcon Symbol="Attach24" FontSize="16" />
                  </ui:Button>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                  <!-- Template combo -->
                  <ComboBox ItemsSource="{Binding Templates}"
                            SelectedValue="{Binding SelectedTemplateId}"
                            DisplayMemberPath="Name"
                            SelectedValuePath="Id"
                            Width="220"
                            Height="36"
                            FontSize="13"
                            Margin="2,0"
                            VerticalContentAlignment="Center"
                            ToolTip="{loc:Str Optimize_Template_Tooltip}"
                            local:ComboBoxBehaviors.DropDownOpenedCommand="{Binding LoadTemplatesCommand}" />

                  <!-- Language combo -->
                  <ComboBox ItemsSource="{Binding Languages}"
                            SelectedItem="{Binding SelectedLanguage, UpdateSourceTrigger=PropertyChanged}"
                            Width="84"
                            Height="36"
                            FontSize="13"
                            Margin="2,0,8,0"
                            HorizontalContentAlignment="Left"
                            VerticalContentAlignment="Center"
                            ToolTip="{loc:Str Optimize_Language_Tooltip}">
                    <ComboBox.ItemTemplate>
                      <DataTemplate>
                        <!-- Flag glyph; per-item tooltip shows the language name. -->
                        <Image Width="24" Height="16"
                               Stretch="Uniform"
                               SnapsToDevicePixels="True"
                               RenderOptions.BitmapScalingMode="HighQuality">
                          <Image.Style>
                            <Style TargetType="Image">
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding}" Value="EN">
                                  <Setter Property="Source" Value="{StaticResource FlagImageEN}"/>
                                  <Setter Property="ToolTip" Value="English"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding}" Value="DE">
                                  <Setter Property="Source" Value="{StaticResource FlagImageDE}"/>
                                  <Setter Property="ToolTip" Value="Deutsch"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding}" Value="FR">
                                  <Setter Property="Source" Value="{StaticResource FlagImageFR}"/>
                                  <Setter Property="ToolTip" Value="Français"/>
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </Image.Style>
                        </Image>
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>

                  <!-- Optimize button (Primary) -->
                  <ui:Button Command="{Binding OptimizeCommand}"
                             Appearance="Primary"
                             Height="36"
                             Padding="14,0"
                             ToolTip="{loc:Str Optimize_Optimize_Tooltip}">
                    <StackPanel Orientation="Horizontal">
                      <ui:SymbolIcon Symbol="Sparkle24" FontSize="16" Margin="0,0,6,0" />
                      <TextBlock Text="{loc:Str Optimize_Optimize}" VerticalAlignment="Center" FontSize="13" />
                    </StackPanel>
                  </ui:Button>
                </StackPanel>
              </Grid>
            </Grid>
          </Border>
        </Grid>
      </Grid>

      <Grid x:Name="ComparisonViewGrid" Grid.Row="0"
            Visibility="{Binding IsComparisonView, Converter={StaticResource BooleanToVisibilityConverter}}"
            Margin="4,4,4,0">
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="14" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <!-- Original card -->
          <Border Grid.Column="0" Style="{StaticResource PiaCardStyle}">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>

              <Border Grid.Row="0"
                      Padding="14,12"
                      BorderBrush="{DynamicResource BorderBrush_}"
                      BorderThickness="0,0,0,1">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <Border Background="{DynamicResource SurfaceMutedBrush}"
                          BorderBrush="{DynamicResource BorderBrush_}"
                          BorderThickness="1"
                          CornerRadius="10"
                          Padding="8,2"
                          VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                      <ui:SymbolIcon Symbol="DocumentText20"
                                     FontSize="12"
                                     Margin="0,0,4,0"
                                     VerticalAlignment="Center"
                                     Foreground="{DynamicResource TextMutedBrush}" />
                      <TextBlock Text="{loc:Str Optimize_Original}"
                                 FontSize="10.5"
                                 FontWeight="SemiBold"
                                 Foreground="{DynamicResource TextMutedBrush}" />
                    </StackPanel>
                  </Border>
                </StackPanel>
              </Border>

              <Grid Grid.Row="1" Margin="14,10,14,14">
                <Border Background="{DynamicResource SurfaceMutedBrush}"
                        BorderBrush="{DynamicResource BorderBrush_}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12">
                  <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <TextBox Text="{Binding InputText}"
                             IsReadOnly="True"
                             Background="Transparent"
                             BorderThickness="0"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             FontSize="13"
                             MinHeight="200"
                             Foreground="{DynamicResource TextDefaultBrush}" />
                  </ScrollViewer>
                </Border>
              </Grid>
            </Grid>
          </Border>

          <!-- Optimized card -->
          <Border Grid.Column="2" Style="{StaticResource PiaCardStyle}">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>

              <Border Grid.Row="0"
                      Padding="14,12"
                      BorderBrush="{DynamicResource BorderBrush_}"
                      BorderThickness="0,0,0,1">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <Border Background="{DynamicResource PiaAccentSoftBrush}"
                          CornerRadius="10"
                          Padding="8,2"
                          VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                      <ui:SymbolIcon Symbol="Sparkle20"
                                     FontSize="12"
                                     Margin="0,0,4,0"
                                     VerticalAlignment="Center"
                                     Foreground="{DynamicResource PiaAccentBrush}" />
                      <TextBlock Text="{loc:Str Optimize_Optimized}"
                                 FontSize="10.5"
                                 FontWeight="SemiBold"
                                 Foreground="{DynamicResource PiaAccentBrush}" />
                    </StackPanel>
                  </Border>
                </StackPanel>
              </Border>

              <Grid Grid.Row="1" Margin="14,10,14,14">
                <Border Background="{DynamicResource SurfaceMutedBrush}"
                        BorderBrush="{DynamicResource BorderBrush_}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12">
                  <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <TextBox Text="{Binding OptimizedText}"
                             Background="Transparent"
                             BorderThickness="0"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             FontSize="13"
                             MinHeight="200"
                             Foreground="{DynamicResource TextDefaultBrush}" />
                  </ScrollViewer>
                </Border>
              </Grid>
            </Grid>
          </Border>
        </Grid>

        <Grid Grid.Row="1" Margin="0,14,0,0">
          <StackPanel Orientation="Horizontal"
                      VerticalAlignment="Center"
                      HorizontalAlignment="Left"
                      Visibility="{Binding ShowTrackedWindowIndicator, Converter={StaticResource BooleanToVisibilityConverter}}">
            <ui:SymbolIcon Symbol="ArrowRight12"
                           FontSize="12"
                           Foreground="{DynamicResource TextSubtleBrush}"
                           Margin="0,0,6,0"
                           VerticalAlignment="Center" />
            <TextBlock Text="{Binding TrackedWindowInfo}"
                       FontSize="12"
                       Foreground="{DynamicResource TextMutedBrush}"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       MaxWidth="250"
                       ToolTip="{Binding TrackedWindowInfo}" />
          </StackPanel>

          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <ui:Button Command="{Binding CopyToClipboardCommand}"
                       Icon="{ui:SymbolIcon Symbol=Copy20}"
                       Appearance="Transparent"
                       Margin="0,0,4,0"
                       Visibility="{Binding ShowCopyButton, Converter={StaticResource BooleanToVisibilityConverter}}"
                       ToolTip="{loc:Str Optimize_Copy_Tooltip}" />
            <ui:Button Command="{Binding RejectCommand}"
                       Appearance="Secondary"
                       Height="36"
                       Padding="12,0"
                       Foreground="{DynamicResource PiaDangerBrush}"
                       Margin="0,0,8,0"
                       ToolTip="{loc:Str Optimize_Reject_Tooltip}">
              <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Symbol="DismissCircle20" FontSize="14" Margin="0,0,6,0" />
                <TextBlock Text="{loc:Str Optimize_Reject_Tooltip}" VerticalAlignment="Center" FontSize="13" />
              </StackPanel>
            </ui:Button>
            <ui:Button x:Name="SendToButton"
                       Appearance="Secondary"
                       Height="36"
                       Padding="12,0"
                       Margin="0,0,8,0"
                       ToolTip="{loc:Str Optimize_SendTo_Tooltip}"
                       Click="SendToButton_Click">
              <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Symbol="Send20" FontSize="14" Margin="0,0,6,0" />
                <TextBlock Text="{loc:Str Optimize_SendTo_Tooltip}" VerticalAlignment="Center" FontSize="13" />
              </StackPanel>
              <ui:Button.ContextMenu>
                <ContextMenu>
                  <MenuItem Header="{loc:Str Nav_Assistant}"
                            Command="{Binding SendToModeCommand}"
                            CommandParameter="Assistant">
                    <MenuItem.Icon>
                      <ui:SymbolIcon Symbol="Chat24" FontSize="14" />
                    </MenuItem.Icon>
                  </MenuItem>
                </ContextMenu>
              </ui:Button.ContextMenu>
            </ui:Button>
            <ui:Button Command="{Binding AcceptCommand}"
                       Appearance="Primary"
                       Height="36"
                       Padding="14,0"
                       ToolTip="{loc:Str Optimize_Accept_Tooltip}">
              <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Symbol="CheckmarkCircle20" FontSize="14" Margin="0,0,6,0" />
                <TextBlock Text="{loc:Str Optimize_Accept_Tooltip}" VerticalAlignment="Center" FontSize="13" />
              </StackPanel>
            </ui:Button>
          </StackPanel>
        </Grid>
      </Grid>
    </Grid>
    </Grid>

    <!-- Todo panel overlay (right side) -->
    <local:TodoPanelControl x:Name="OptimizeTodoPanel"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Stretch"
                            Width="0"
                            Visibility="Collapsed">
      <local:TodoPanelControl.Style>
        <Style TargetType="local:TodoPanelControl">
          <Style.Triggers>
            <DataTrigger Binding="{Binding DataContext.IsTodoPanelOpen, ElementName=OptimizeTodoPanel}" Value="True">
              <DataTrigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Visibility">
                      <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                    </ObjectAnimationUsingKeyFrames>
                    <DoubleAnimation Storyboard.TargetProperty="Width"
                                     From="0" To="280" Duration="0:0:0.25">
                      <DoubleAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseOut" />
                      </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                  </Storyboard>
                </BeginStoryboard>
              </DataTrigger.EnterActions>
              <DataTrigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Width"
                                     From="280" To="0" Duration="0:0:0.2">
                      <DoubleAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseIn" />
                      </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Visibility">
                      <DiscreteObjectKeyFrame KeyTime="0:0:0.2" Value="{x:Static Visibility.Collapsed}" />
                    </ObjectAnimationUsingKeyFrames>
                  </Storyboard>
                </BeginStoryboard>
              </DataTrigger.ExitActions>
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </local:TodoPanelControl.Style>
    </local:TodoPanelControl>

    <!-- Drag-over overlay (visible while a file is being dragged onto the view) -->
    <Border IsHitTestVisible="False"
            Margin="8"
            CornerRadius="8"
            BorderThickness="2"
            BorderBrush="{DynamicResource AccentFillColorDefaultBrush}"
            Background="{DynamicResource AcrylicBackgroundFillColorBaseBrush}"
            Visibility="{Binding Path=(behaviors:FileDropBehavior.IsDragOver), ElementName=RootGrid, Converter={StaticResource BooleanToVisibilityConverter}}">
      <StackPanel HorizontalAlignment="Center"
                  VerticalAlignment="Center">
        <ui:SymbolIcon Symbol="ArrowDownload24"
                       FontSize="48"
                       HorizontalAlignment="Center"
                       Foreground="{DynamicResource AccentFillColorDefaultBrush}" />
        <TextBlock Text="{loc:Str FileDrop_Overlay_Hint}"
                   FontSize="16"
                   FontWeight="SemiBold"
                   Margin="0,12,0,0"
                   HorizontalAlignment="Center"
                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>

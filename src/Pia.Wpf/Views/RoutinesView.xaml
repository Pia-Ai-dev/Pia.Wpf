<UserControl x:Class="Pia.Views.RoutinesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:loc="clr-namespace:Pia.Localization"
             xmlns:nav="clr-namespace:Pia.Navigation"
             xmlns:models="clr-namespace:Pia.Models"
             xmlns:shared="clr-namespace:Pia.Controls.Shared"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1200"
             nav:ViewModelLocator.AutoWireViewModel="True">
  <UserControl.Resources>
    <Style x:Key="RoutineStatusPillStyle" TargetType="Border" BasedOn="{StaticResource PiaLabelChipStyle}">
      <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding Status}" Value="{x:Static models:ScheduledJobStatus.Active}">
          <Setter Property="Background" Value="{DynamicResource PiaAccentSoftBrush}"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding Status}" Value="{x:Static models:ScheduledJobStatus.Completed}">
          <Setter Property="Background" Value="{DynamicResource SuccessSoftBrush}"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding Status}" Value="{x:Static models:ScheduledJobStatus.Failed}">
          <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="RoutineStatusTextStyle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding Status}" Value="{x:Static models:ScheduledJobStatus.Active}">
          <Setter Property="Foreground" Value="{DynamicResource PiaAccentBrush}"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding Status}" Value="{x:Static models:ScheduledJobStatus.Completed}">
          <Setter Property="Foreground" Value="{DynamicResource PiaSuccessBrush}"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding Status}" Value="{x:Static models:ScheduledJobStatus.Failed}">
          <Setter Property="Foreground" Value="{DynamicResource PiaDangerBrush}"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <!-- Cursor belongs on the template Border, not the container: set on a ListBoxItem it inherits
         into the content and cannot be taken back. -->
    <Style x:Key="RoutineRowStyle" TargetType="Border" BasedOn="{StaticResource PiaCardStyle}">
      <Setter Property="Padding" Value="14,12"/>
      <Setter Property="Margin" Value="0,0,0,10"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}"/>
        </Trigger>
        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                     Value="True">
          <Setter Property="Background" Value="{DynamicResource PiaAccentSoftBrush}"/>
          <Setter Property="BorderBrush" Value="{DynamicResource PiaAccentBrush}"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>

  </UserControl.Resources>

  <Grid Background="Transparent">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" Margin="24,20,24,14">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0" VerticalAlignment="Center">
        <TextBlock Text="{loc:Str Routines_Header}"
                   Style="{StaticResource PiaPageTitleStyle}"/>
        <TextBlock Text="{loc:Str Routines_Description}"
                   Style="{StaticResource PiaPageSubtitleStyle}"
                   MaxWidth="620"/>
      </StackPanel>
      <ui:Button Grid.Column="1"
                 Appearance="Secondary"
                 VerticalAlignment="Center"
                 ToolTip="{loc:Str Routines_New}"
                 AutomationProperties.AutomationId="Routines_NewJob"
                 Command="{Binding StartCreateCommand}">
        <StackPanel Orientation="Horizontal">
          <ui:SymbolIcon Symbol="Add24" FontSize="16" Margin="0,0,6,0"/>
          <TextBlock Text="{loc:Str Routines_New}"/>
        </StackPanel>
      </ui:Button>
    </Grid>

    <Border Grid.Row="1"
            Style="{StaticResource PiaStatusBannerStyle}"
            Margin="24,0,24,12"
            Visibility="{Binding HasStatusMessage, Converter={StaticResource BooleanToVisibilityConverter}}">
      <TextBlock Text="{Binding StatusMessage}"
                 Style="{StaticResource PiaDetailValueStyle}"
                 AutomationProperties.AutomationId="Routines_StatusMessage"/>
    </Border>

    <Grid Grid.Row="2" Margin="24,0,24,20">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="420"/>
        <ColumnDefinition Width="14"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <Grid Grid.Column="0">
        <ui:ProgressRing IsIndeterminate="True"
                         Width="40" Height="40"
                         VerticalAlignment="Top"
                         HorizontalAlignment="Center"
                         Margin="0,60,0,0"
                         Panel.ZIndex="1"
                         Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"/>

        <shared:PiaEmptyState Symbol="CalendarClock24"
                              Title="{loc:Str Routines_Empty}"
                              Hint="{loc:Str Routines_EmptyHint}"
                              Visibility="{Binding HasJobs, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>

        <ListBox ItemsSource="{Binding Jobs}"
                 SelectedItem="{Binding SelectedJob, Mode=TwoWay}"
                 BorderThickness="0"
                 Background="Transparent"
                 Padding="0,0,4,0"
                 ItemContainerStyle="{StaticResource PiaMemoryRowItemStyle}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 AutomationProperties.AutomationId="Routines_JobList"
                 Visibility="{Binding HasJobs, Converter={StaticResource BooleanToVisibilityConverter}}">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Border Style="{StaticResource RoutineRowStyle}">
                <StackPanel>
                  <StackPanel Orientation="Horizontal">
                    <Border Style="{StaticResource RoutineStatusPillStyle}" Margin="0,0,8,0">
                      <TextBlock Text="{Binding StatusLabel}" Style="{StaticResource RoutineStatusTextStyle}"/>
                    </Border>
                    <TextBlock Text="{Binding Name}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextDefaultBrush}"/>
                  </StackPanel>

                  <TextBlock Text="{Binding Query}"
                             Margin="0,8,0,0"
                             FontSize="12"
                             TextTrimming="CharacterEllipsis"
                             Foreground="{DynamicResource TextSubtleBrush}"/>

                  <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <TextBlock Text="{Binding KindLabel}" Style="{StaticResource PiaMetaTextStyle}"/>
                    <TextBlock Style="{StaticResource PiaMetaSeparatorStyle}"/>
                    <TextBlock Text="{Binding RecurrenceLabel}" Style="{StaticResource PiaMetaTextStyle}"/>
                    <TextBlock Style="{StaticResource PiaMetaSeparatorStyle}"
                               Visibility="{Binding HasRecentRuns, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <TextBlock Text="{Binding RecentRunsSummary}"
                               Style="{StaticResource PiaMetaTextStyle}"
                               Visibility="{Binding HasRecentRuns, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                  </StackPanel>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>

      <!-- Right pane, three states: the editor, the selected job, or the placeholder. -->
      <Border Grid.Column="2"
              Style="{StaticResource PiaCardStyle}"
              Padding="16">
        <Grid>
          <StackPanel HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      MaxWidth="320"
                      Visibility="{Binding ShowsPlaceholder, Converter={StaticResource BooleanToVisibilityConverter}}">
            <ui:SymbolIcon Symbol="CalendarClock24"
                           FontSize="36"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,12"
                           Foreground="{DynamicResource PiaAccentBrush}"/>
            <TextBlock Text="{loc:Str Routines_Placeholder}"
                       FontSize="13"
                       HorizontalAlignment="Center"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       Foreground="{DynamicResource TextMutedBrush}"/>
          </StackPanel>

          <ScrollViewer VerticalScrollBarVisibility="Auto"
                        Visibility="{Binding ShowsDetail, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel Margin="0,0,10,0">
              <Border Style="{StaticResource RoutineStatusPillStyle}"
                      DataContext="{Binding SelectedJob}"
                      HorizontalAlignment="Left">
                <TextBlock Text="{Binding StatusLabel}" Style="{StaticResource RoutineStatusTextStyle}"/>
              </Border>
              <TextBlock Text="{Binding SelectedJob.Name}"
                         FontSize="18"
                         FontWeight="SemiBold"
                         TextWrapping="Wrap"
                         Margin="0,8,0,0"
                         Foreground="{DynamicResource TextDefaultBrush}"/>
              <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <TextBlock Text="{Binding SelectedJob.KindLabel}" Style="{StaticResource PiaMetaTextStyle}"/>
                <TextBlock Style="{StaticResource PiaMetaSeparatorStyle}"/>
                <TextBlock Text="{Binding SelectedJob.RecurrenceLabel}" Style="{StaticResource PiaMetaTextStyle}"/>
                <TextBlock Style="{StaticResource PiaMetaSeparatorStyle}"/>
                <TextBlock Text="{Binding SelectedJob.TimeOfDay, StringFormat=HH\\:mm}"
                           Style="{StaticResource PiaMetaTextStyle}"/>
              </StackPanel>

              <TextBlock Text="{loc:Str Routines_Detail_NextRun}"
                         Style="{StaticResource PiaSettingsSectionLabelStyle}"
                         Margin="0,18,0,6"/>
              <TextBlock Text="{Binding SelectedJob.NextFireAt, StringFormat=g}"
                         Style="{StaticResource PiaDetailValueStyle}"
                         AutomationProperties.AutomationId="Routines_Detail_NextRun"/>

              <Border Margin="0,12,0,0"
                      Padding="12,8"
                      CornerRadius="6"
                      Background="{DynamicResource WarnSoftBrush}"
                      Visibility="{Binding SelectedJob.OwnedByThisDevice, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                <TextBlock Text="{loc:Str Routines_NotOwnedHere}"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource TextSubtleBrush}"/>
              </Border>

              <TextBlock Text="{loc:Str Settings_ScheduledJobs_Field_Goal}"
                         Style="{StaticResource PiaSettingsSectionLabelStyle}"
                         Margin="0,18,0,6"/>
              <TextBlock Text="{Binding SelectedJob.Query}"
                         Style="{StaticResource PiaDetailValueStyle}"/>

              <TextBlock Text="{loc:Str Settings_ScheduledJobs_Field_GrantedTools}"
                         Style="{StaticResource PiaSettingsSectionLabelStyle}"
                         Margin="0,18,0,6"
                         Visibility="{Binding SelectedJob.HasGrantedTools, Converter={StaticResource BooleanToVisibilityConverter}}"/>
              <TextBlock Text="{Binding SelectedJob.GrantedTools}"
                         Style="{StaticResource PiaDetailValueStyle}"
                         Visibility="{Binding SelectedJob.HasGrantedTools, Converter={StaticResource BooleanToVisibilityConverter}}"/>

              <TextBlock Text="{loc:Str Routines_Detail_RecentRuns}"
                         Style="{StaticResource PiaSettingsSectionLabelStyle}"
                         Margin="0,18,0,6"/>
              <TextBlock Text="{loc:Str Routines_Detail_NeverRun}"
                         FontSize="12"
                         FontStyle="Italic"
                         Foreground="{DynamicResource TextGhostBrush}"
                         Visibility="{Binding SelectedJob.HasRecentRuns, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
              <ItemsControl ItemsSource="{Binding SelectedJob.RecentRuns}"
                            AutomationProperties.AutomationId="Routines_RunHistory">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Background="{DynamicResource SurfaceSunkBrush}"
                            CornerRadius="6"
                            Padding="10,6"
                            Margin="0,0,0,4">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding SettledAt, StringFormat=g}"
                                   Style="{StaticResource PiaMetaTextStyle}"/>
                        <TextBlock Style="{StaticResource PiaMetaSeparatorStyle}"/>
                        <TextBlock Text="{Binding StateLabel}"
                                   Style="{StaticResource PiaMetaTextStyle}"
                                   FontWeight="SemiBold"/>
                        <!-- A failed firing produced no chat, so the link is hidden rather than dead. -->
                        <ui:HyperlinkButton Content="{loc:Str Routines_Detail_OpenChat}"
                                            Padding="0"
                                            Margin="10,0,0,0"
                                            FontSize="11"
                                            VerticalAlignment="Center"
                                            Visibility="{Binding HasChat, Converter={StaticResource BooleanToVisibilityConverter}}"
                                            Command="{Binding DataContext.OpenRunChatCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"/>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                <ui:Button Content="{loc:Str Settings_ScheduledJobs_Edit}"
                           Icon="{ui:SymbolIcon Edit24}"
                           Appearance="Secondary"
                           Margin="0,0,8,0"
                           AutomationProperties.AutomationId="Routines_Edit"
                           Command="{Binding StartEditCommand}"/>
                <ui:Button Content="{Binding SelectedJob.ToggleLabel}"
                           Icon="{ui:SymbolIcon Power24}"
                           Appearance="Secondary"
                           Margin="0,0,8,0"
                           AutomationProperties.AutomationId="Routines_Toggle"
                           Command="{Binding ToggleEnabledCommand}"/>
                <ui:Button Content="{loc:Str Settings_ScheduledJobs_RunNow}"
                           Icon="{ui:SymbolIcon Play24}"
                           Appearance="Secondary"
                           Margin="0,0,8,0"
                           IsEnabled="{Binding SelectedJob.CanRunNow}"
                           AutomationProperties.AutomationId="Routines_RunNow"
                           Command="{Binding RunNowCommand}"/>
                <ui:Button Content="{loc:Str Settings_ScheduledJobs_Delete}"
                           Icon="{ui:SymbolIcon Delete24}"
                           Appearance="Secondary"
                           Foreground="{DynamicResource PiaDangerBrush}"
                           AutomationProperties.AutomationId="Routines_Delete"
                           Command="{Binding DeleteCommand}"/>
              </StackPanel>
            </StackPanel>
          </ScrollViewer>

          <ScrollViewer VerticalScrollBarVisibility="Auto"
                        Visibility="{Binding IsEditorOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel Margin="0,0,10,0">
              <TextBlock Text="{loc:Str Settings_ScheduledJobs_Field_Name}"
                         Style="{StaticResource PiaSettingsSectionLabelStyle}"/>
              <ui:TextBox Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}"
                          AutomationProperties.AutomationId="Routines_Field_Name"
                          Margin="0,2,0,8"/>

              <TextBlock Text="{loc:Str Settings_ScheduledJobs_Field_Goal}"
                         Style="{StaticResource PiaSettingsSectionLabelStyle}"/>
              <ui:TextBox Text="{Binding EditQuery, UpdateSourceTrigger=PropertyChanged}"
                          AcceptsReturn="True"
                          TextWrapping="Wrap"
                          MinHeight="60"
                          AutomationProperties.AutomationId="Routines_Field_Goal"
                          Margin="0,2,0,8"/>

              <TextBlock Text="{loc:Str Settings_ScheduledJobs_Field_Kind}"
                         Style="{StaticResource PiaSettingsSectionLabelStyle}"/>
              <!-- SelectedValuePath, not SelectedItem: the list carries localized (value, label) pairs so the
                   ComboBox does not render the C# enum identifier, while the VM keeps holding the enum. -->
              <ComboBox ItemsSource="{Binding JobKinds}"
                        DisplayMemberPath="Label"
                        SelectedValuePath="Value"
                        SelectedValue="{Binding EditKind, Mode=TwoWay}"
                        HorizontalAlignment="Left" Width="240"
                        AutomationProperties.AutomationId="Routines_Field_Kind"
                        Margin="0,2,0,8"/>

              <TextBlock Text="{loc:Str Settings_ScheduledJobs_Field_Recurrence}"
                         Style="{StaticResource PiaSettingsSectionLabelStyle}"/>
              <ComboBox ItemsSource="{Binding Recurrences}"
                        DisplayMemberPath="Label"
                        SelectedValuePath="Value"
                        SelectedValue="{Binding EditRecurrence, Mode=TwoWay}"
                        HorizontalAlignment="Left" Width="240"
                        AutomationProperties.AutomationId="Routines_Field_Recurrence"
                        Margin="0,2,0,8"/>

              <!-- One row per recurrence field, each shown only for the recurrences that read it. Without these
                   the calculator substitutes today's day on every recompute and the job walks. -->
              <StackPanel Visibility="{Binding EditorWantsDayOfWeek, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="{loc:Str Routines_Field_DayOfWeek}"
                           Style="{StaticResource PiaSettingsSectionLabelStyle}"/>
                <ComboBox ItemsSource="{Binding DayOfWeekChoices}"
                          DisplayMemberPath="Label"
                          SelectedValuePath="Value"
                          SelectedValue="{Binding EditDayOfWeek, Mode=TwoWay}"
                          HorizontalAlignment="Left" Width="240"
                          AutomationProperties.AutomationId="Routines_Field_DayOfWeek"
                          Margin="0,2,0,8"/>
              </StackPanel>

              <StackPanel Visibility="{Binding EditorWantsMonth, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="{loc:Str Routines_Field_Month}"
                           Style="{StaticResource PiaSettingsSectionLabelStyle}"/>
                <ComboBox ItemsSource="{Binding MonthChoices}"
                          DisplayMemberPath="Label"
                          SelectedValuePath="Value"
                          SelectedValue="{Binding EditMonth, Mode=TwoWay}"
                          HorizontalAlignment="Left" Width="240"
                          AutomationProperties.AutomationId="Routines_Field_Month"
                          Margin="0,2,0,8"/>
              </StackPanel>

              <StackPanel Visibility="{Binding EditorWantsDayOfMonth, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="{loc:Str Routines_Field_DayOfMonth}"
                           Style="{StaticResource PiaSettingsSectionLabelStyle}"/>
                <ComboBox ItemsSource="{Binding DayOfMonthChoices}"
                          SelectedItem="{Binding EditDayOfMonth, Mode=TwoWay}"
                          HorizontalAlignment="Left" Width="120"
                          AutomationProperties.AutomationId="Routines_Field_DayOfMonth"
                          Margin="0,2,0,4"/>
                <TextBlock Text="{loc:Str Routines_Field_DayOfMonth_Hint}"
                           Style="{StaticResource PiaSettingsDescriptionStyle}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,8"/>
              </StackPanel>

              <TextBlock Text="{loc:Str Settings_ScheduledJobs_Field_Time}"
                         Style="{StaticResource PiaSettingsSectionLabelStyle}"/>
              <ui:TextBox Text="{Binding EditTimeOfDay, UpdateSourceTrigger=PropertyChanged}"
                          HorizontalAlignment="Left" Width="120"
                          AutomationProperties.AutomationId="Routines_Field_Time"
                          Margin="0,2,0,8"/>

              <StackPanel Visibility="{Binding EditorWantsSpecificDate, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="{loc:Str Settings_ScheduledJobs_Field_Date}"
                           Style="{StaticResource PiaSettingsSectionLabelStyle}"/>
                <DatePicker SelectedDate="{Binding EditSpecificDate, Mode=TwoWay}"
                            HorizontalAlignment="Left" Width="240"
                            AutomationProperties.AutomationId="Routines_Field_Date"
                            Margin="0,2,0,8"/>
              </StackPanel>

              <TextBlock Text="{loc:Str Settings_ScheduledJobs_Field_Provider}"
                         Style="{StaticResource PiaSettingsSectionLabelStyle}"/>
              <ComboBox ItemsSource="{Binding ProviderChoices}"
                        SelectedItem="{Binding EditProvider, Mode=TwoWay}"
                        DisplayMemberPath="Name"
                        HorizontalAlignment="Left" Width="240"
                        AutomationProperties.AutomationId="Routines_Field_Provider"
                        Margin="0,2,0,8"/>

              <TextBlock Text="{loc:Str Settings_ScheduledJobs_Field_GrantedTools}"
                         Style="{StaticResource PiaSettingsSectionLabelStyle}"/>
              <ui:TextBox Text="{Binding EditGrantedTools, UpdateSourceTrigger=PropertyChanged}"
                          AutomationProperties.AutomationId="Routines_Field_GrantedTools"
                          Margin="0,2,0,8"/>

              <!-- The label says SUCCESS out loud: failures always notify. -->
              <CheckBox Content="{loc:Str Settings_ScheduledJobs_Field_QuietOnSuccess}"
                        IsChecked="{Binding EditQuietOnSuccess, Mode=TwoWay}"
                        AutomationProperties.AutomationId="Routines_Field_Quiet"
                        Margin="0,2,0,4"/>
              <TextBlock Text="{loc:Str Settings_ScheduledJobs_Field_QuietOnSuccess_Hint}"
                         Style="{StaticResource PiaSettingsDescriptionStyle}"
                         TextWrapping="Wrap"
                         Margin="0,0,0,8"/>

              <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <ui:Button Content="{loc:Str Settings_ScheduledJobs_Save}"
                           Icon="{ui:SymbolIcon Save24}"
                           Appearance="Primary"
                           Margin="0,0,8,0"
                           AutomationProperties.AutomationId="Routines_Save"
                           Command="{Binding SaveCommand}"/>
                <ui:Button Content="{loc:Str Settings_ScheduledJobs_Cancel}"
                           Appearance="Secondary"
                           AutomationProperties.AutomationId="Routines_Cancel"
                           Command="{Binding CancelEditCommand}"/>
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>

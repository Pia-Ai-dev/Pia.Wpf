<UserControl x:Class="Pia.Views.RoutinesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:loc="clr-namespace:Pia.Localization"
             xmlns:nav="clr-namespace:Pia.Navigation"
             xmlns:models="clr-namespace:Pia.Models"
             xmlns:routines="clr-namespace:Pia.Controls.Routines"
             xmlns:shared="clr-namespace:Pia.Controls.Shared"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1200"
             nav:ViewModelLocator.AutoWireViewModel="True">
  <UserControl.Resources>
    <Style x:Key="RoutineStatusPillStyle" TargetType="Border" BasedOn="{StaticResource PiaLabelChipStyle}">
      <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding Status}" Value="{x:Static models:ScheduledJobStatus.Active}">
          <Setter Property="Background" Value="{DynamicResource PiaAccentSoftBrush}"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding Status}" Value="{x:Static models:ScheduledJobStatus.Completed}">
          <Setter Property="Background" Value="{DynamicResource SuccessSoftBrush}"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding Status}" Value="{x:Static models:ScheduledJobStatus.Failed}">
          <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="RoutineStatusTextStyle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding Status}" Value="{x:Static models:ScheduledJobStatus.Active}">
          <Setter Property="Foreground" Value="{DynamicResource PiaAccentBrush}"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding Status}" Value="{x:Static models:ScheduledJobStatus.Completed}">
          <Setter Property="Foreground" Value="{DynamicResource PiaSuccessBrush}"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding Status}" Value="{x:Static models:ScheduledJobStatus.Failed}">
          <Setter Property="Foreground" Value="{DynamicResource PiaDangerBrush}"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="RoutineBlueprintCardStyle" TargetType="Button">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Margin" Value="0,0,0,10"/>
      <Setter Property="Padding" Value="14,12"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Background" Value="{DynamicResource SurfaceSunkBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush_}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Card"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    Padding="{TemplateBinding Padding}"
                    CornerRadius="{StaticResource LargeRadius}"
                    SnapsToDevicePixels="True">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Card" Property="Background" Value="{DynamicResource PiaAccentSoftBrush}"/>
                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource PiaAccentBrush}"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource PiaAccentBrush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Reads as the enabled goal field it stands in for, not as a disabled one: the whole point is that it
         invites the click that swaps it for the real box. -->
    <Style x:Key="RoutineGoalPreviewStyle" TargetType="Button">
      <Setter Property="Cursor" Value="IBeam"/>
      <Setter Property="Padding" Value="10,8"/>
      <Setter Property="MinHeight" Value="150"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="VerticalContentAlignment" Value="Top"/>
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush_}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Field"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    Padding="{TemplateBinding Padding}"
                    CornerRadius="4"
                    SnapsToDevicePixels="True">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Field" Property="BorderBrush" Value="{DynamicResource PiaAccentBrush}"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Field" Property="BorderBrush" Value="{DynamicResource PiaAccentBrush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="ui:Button" BasedOn="{StaticResource PiaHandCursorButtonStyle}"/>

  </UserControl.Resources>

  <Grid Background="Transparent">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" Margin="24,20,24,14">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
        <TextBlock Text="{loc:Str Routines_Header}"
                   Style="{StaticResource PiaPageTitleStyle}"/>
        <shared:PiaHelpHint Text="{loc:Str Routines_Description}"
                            Margin="2,0,0,0"
                            AutomationProperties.AutomationId="Routines_Help"/>
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
        <ui:Button Appearance="Secondary"
                   Command="{Binding GoHomeCommand}"
                   AutomationProperties.Name="{loc:Str Routines_Home}"
                   AutomationProperties.AutomationId="Routines_Home"
                   ToolTip="{loc:Str Routines_Home}"
                   Margin="0,0,6,0">
          <ui:SymbolIcon Symbol="Home24" FontSize="16"/>
        </ui:Button>
        <ui:Button Appearance="Secondary"
                   ToolTip="{loc:Str Routines_New}"
                   AutomationProperties.AutomationId="Routines_NewJob"
                   Command="{Binding BrowseBlueprintsCommand}">
          <StackPanel Orientation="Horizontal">
            <ui:SymbolIcon Symbol="Add24" FontSize="16" Margin="0,0,6,0"/>
            <TextBlock Text="{loc:Str Routines_New}"/>
          </StackPanel>
        </ui:Button>
      </StackPanel>
    </Grid>

    <Border Grid.Row="1"
            Style="{StaticResource PiaStatusBannerStyle}"
            Margin="24,0,24,12"
            Visibility="{Binding HasStatusMessage, Converter={StaticResource BooleanToVisibilityConverter}}">
      <TextBlock Text="{Binding StatusMessage}"
                 Style="{StaticResource PiaDetailValueStyle}"
                 AutomationProperties.AutomationId="Routines_StatusMessage"/>
    </Border>

    <Grid Grid.Row="2" Margin="24,0,24,20">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="420"/>
        <ColumnDefinition Width="14"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <Grid Grid.Column="0">
        <ui:ProgressRing IsIndeterminate="True"
                         Width="40" Height="40"
                         VerticalAlignment="Top"
                         HorizontalAlignment="Center"
                         Margin="0,60,0,0"
                         Panel.ZIndex="1"
                         Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"/>

        <shared:PiaEmptyState Symbol="CalendarClock24"
                              Title="{loc:Str Routines_Empty}"
                              Hint="{loc:Str Routines_EmptyHint}"
                              Visibility="{Binding HasJobs, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>

        <ListBox ItemsSource="{Binding Jobs}"
                 SelectedItem="{Binding SelectedJob, Mode=TwoWay}"
                 BorderThickness="0"
                 Background="Transparent"
                 Padding="0,0,4,0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 AutomationProperties.AutomationId="Routines_JobList"
                 Visibility="{Binding HasJobs, Converter={StaticResource BooleanToVisibilityConverter}}">
          <ListBox.ItemContainerStyle>
            <!-- Named and identified on the CONTAINER, which is the node UIA offers for a row: without these
                 every row reports the view-model's ToString() and can only be reached by index. -->
            <Style TargetType="ListBoxItem" BasedOn="{StaticResource PiaMemoryRowItemStyle}">
              <Setter Property="AutomationProperties.AutomationId" Value="{Binding Id, StringFormat='Routines_Row_{0}'}"/>
              <Setter Property="AutomationProperties.Name" Value="{Binding Name}"/>
            </Style>
          </ListBox.ItemContainerStyle>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Border Style="{StaticResource PiaMasterRowCardStyle}">
                <StackPanel>
                  <StackPanel Orientation="Horizontal">
                    <Border Style="{StaticResource RoutineStatusPillStyle}" Margin="0,0,8,0">
                      <TextBlock Text="{Binding StatusLabel}" Style="{StaticResource RoutineStatusTextStyle}"/>
                    </Border>
                    <TextBlock Text="{Binding Name}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextDefaultBrush}"/>
                  </StackPanel>

                  <TextBlock Text="{Binding Query}"
                             Margin="0,8,0,0"
                             FontSize="12"
                             TextTrimming="CharacterEllipsis"
                             Foreground="{DynamicResource TextSubtleBrush}"/>

                  <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <TextBlock Text="{Binding KindLabel}" Style="{StaticResource PiaMetaTextStyle}"/>
                    <TextBlock Style="{StaticResource PiaMetaSeparatorStyle}"/>
                    <TextBlock Text="{Binding RecurrenceLabel}" Style="{StaticResource PiaMetaTextStyle}"/>
                    <TextBlock Style="{StaticResource PiaMetaSeparatorStyle}"
                               Visibility="{Binding HasRecentRuns, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <TextBlock Text="{Binding RecentRunsSummary}"
                               Style="{StaticResource PiaMetaTextStyle}"
                               Visibility="{Binding HasRecentRuns, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                  </StackPanel>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>

      <!-- Right pane, four states: the editor, the selected job, the blueprint catalog, or the placeholder. -->
      <Border Grid.Column="2"
              Style="{StaticResource PiaCardStyle}"
              Padding="16">
        <Grid>
          <ScrollViewer VerticalScrollBarVisibility="Auto"
                        Visibility="{Binding ShowsPlaceholder, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        MaxWidth="420"
                        Margin="0,0,10,0">
              <ui:SymbolIcon Symbol="CalendarClock24"
                             FontSize="36"
                             HorizontalAlignment="Center"
                             Margin="0,0,0,12"
                             Foreground="{DynamicResource PiaAccentBrush}"/>
              <TextBlock Text="{loc:Str Routines_Placeholder}"
                         FontSize="13"
                         HorizontalAlignment="Center"
                         TextWrapping="Wrap"
                         TextAlignment="Center"
                         Foreground="{DynamicResource TextMutedBrush}"/>

              <ui:Button Appearance="Secondary"
                         HorizontalAlignment="Center"
                         Margin="0,24,0,0"
                         AutomationProperties.AutomationId="Routines_BrowseCatalog"
                         Visibility="{Binding HasBlueprints, Converter={StaticResource BooleanToVisibilityConverter}}"
                         Command="{Binding BrowseBlueprintsCommand}">
                <StackPanel Orientation="Horizontal">
                  <ui:SymbolIcon Symbol="Sparkle24" FontSize="16" Margin="0,0,6,0"/>
                  <TextBlock Text="{loc:Str Routines_Catalog_Browse}"/>
                </StackPanel>
              </ui:Button>
            </StackPanel>
          </ScrollViewer>

          <!-- Disabled, not Hidden: a scrollable width measures as infinite and the card WrapPanel never wraps. -->
          <ScrollViewer VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled"
                        Visibility="{Binding ShowsCatalog, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel Margin="0,0,10,0">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                  <TextBlock Text="{loc:Str Routines_Blueprints_Header}"
                             Style="{StaticResource PiaSettingsSectionLabelStyle}"/>
                  <TextBlock Text="{loc:Str Routines_Blueprints_Hint}"
                             Style="{StaticResource PiaSettingsDescriptionStyle}"
                             TextWrapping="Wrap"/>
                </StackPanel>
                <ui:Button Grid.Column="1"
                           Appearance="Transparent"
                           VerticalAlignment="Top"
                           Content="{loc:Str Routines_Catalog_StartBlank}"
                           Margin="8,0,0,0"
                           AutomationProperties.AutomationId="Routines_StartBlank"
                           Command="{Binding StartCreateCommand}"/>
                <ui:Button Grid.Column="2"
                           Appearance="Transparent"
                           VerticalAlignment="Top"
                           Content="{loc:Str Routines_Catalog_Close}"
                           Margin="8,0,0,0"
                           AutomationProperties.AutomationId="Routines_CatalogClose"
                           Command="{Binding CloseCatalogCommand}"/>
              </Grid>

              <routines:PiaRoutinesSearchBar Query="{Binding SearchQuery, Mode=TwoWay}"
                                             Margin="0,12,0,0"/>

              <Grid Margin="0,12,0,0"
                    Visibility="{Binding DefaultProviderCannotSearchWeb, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <ui:SymbolIcon Grid.Column="0"
                               Symbol="Info24"
                               FontSize="14"
                               VerticalAlignment="Top"
                               Margin="0,1,6,0"
                               Foreground="{DynamicResource TextMutedBrush}"/>
                <TextBlock Grid.Column="1"
                           Text="{loc:Str Routines_Catalog_NoWebSearchHint}"
                           Style="{StaticResource PiaSettingsDescriptionStyle}"
                           TextWrapping="Wrap"/>
              </Grid>

              <TextBlock Text="{loc:Str Routines_Search_NoMatches}"
                         Style="{StaticResource PiaSettingsDescriptionStyle}"
                         Margin="0,16,0,0"
                         Visibility="{Binding HasBlueprintMatches, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>

              <ItemsControl ItemsSource="{Binding BlueprintGroups}"
                            Margin="0,16,0,0"
                            AutomationProperties.AutomationId="Routines_BlueprintList">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Expander IsExpanded="{Binding IsExpanded, Mode=TwoWay}"
                              Margin="0,0,0,12"
                              AutomationProperties.AutomationId="{Binding AutomationId}"
                              AutomationProperties.Name="{Binding Title}">
                      <Expander.Header>
                        <StackPanel>
                          <TextBlock Text="{Binding Title}"
                                     Style="{StaticResource PiaSettingsSectionLabelStyle}"/>
                          <TextBlock Text="{Binding Subtitle}"
                                     Style="{StaticResource PiaSettingsDescriptionStyle}"
                                     TextWrapping="Wrap"/>
                        </StackPanel>
                      </Expander.Header>

                      <!-- WrapPanel, not UniformGrid: a uniform cell would take the tallest card's height. -->
                      <ItemsControl ItemsSource="{Binding Cards}" Margin="0,10,0,0">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Button Style="{StaticResource RoutineBlueprintCardStyle}"
                                    Width="320"
                                    Margin="0,0,12,12"
                                    AutomationProperties.AutomationId="{Binding AutomationId}"
                                    AutomationProperties.Name="{Binding Title}"
                                    Command="{Binding DataContext.StartFromBlueprintCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding Key}">
                              <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                  <Border Style="{StaticResource PiaIconChipStyle}" Margin="0,0,8,0">
                                    <ui:SymbolIcon Symbol="Sparkle24"
                                                   FontSize="13"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource PiaAccentBrush}"/>
                                  </Border>
                                  <TextBlock Text="{Binding Title}"
                                             FontSize="13"
                                             FontWeight="SemiBold"
                                             VerticalAlignment="Center"
                                             TextWrapping="Wrap"
                                             Foreground="{DynamicResource TextDefaultBrush}"/>
                                </StackPanel>

                                <TextBlock Text="{Binding Description}"
                                           Margin="0,8,0,0"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextSubtleBrush}"/>

                                <!-- No kind here: every blueprint is Research, so the chip would repeat on all twenty. -->
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                  <TextBlock Text="{Binding RecurrenceLabel}" Style="{StaticResource PiaMetaTextStyle}"/>
                                  <TextBlock Style="{StaticResource PiaMetaSeparatorStyle}"/>
                                  <TextBlock Text="{Binding TimeLabel}" Style="{StaticResource PiaMetaTextStyle}"/>
                                </StackPanel>

                                <Border Style="{StaticResource PiaLabelChipStyle}"
                                        Background="{DynamicResource SurfaceMutedBrush}"
                                        HorizontalAlignment="Left"
                                        Margin="0,8,0,0"
                                        Visibility="{Binding RequiresWebSearch, Converter={StaticResource BooleanToVisibilityConverter}}">
                                  <TextBlock Text="{loc:Str Routines_Catalog_NeedsWebSearch}"
                                             Style="{StaticResource PiaMetaTextStyle}"/>
                                </Border>
                              </StackPanel>
                            </Button>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </Expander>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </ScrollViewer>

          <ScrollViewer VerticalScrollBarVisibility="Auto"
                        Visibility="{Binding ShowsDetail, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel Margin="0,0,10,0">
              <Border Style="{StaticResource RoutineStatusPillStyle}"
                      DataContext="{Binding SelectedJob}"
                      HorizontalAlignment="Left">
                <TextBlock Text="{Binding StatusLabel}" Style="{StaticResource RoutineStatusTextStyle}"/>
              </Border>
              <TextBlock Text="{Binding SelectedJob.Name}"
                         FontSize="18"
                         FontWeight="SemiBold"
                         TextWrapping="Wrap"
                         Margin="0,8,0,0"
                         Foreground="{DynamicResource TextDefaultBrush}"/>
              <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <TextBlock Text="{Binding SelectedJob.KindLabel}" Style="{StaticResource PiaMetaTextStyle}"/>
                <TextBlock Style="{StaticResource PiaMetaSeparatorStyle}"/>
                <TextBlock Text="{Binding SelectedJob.RecurrenceLabel}" Style="{StaticResource PiaMetaTextStyle}"/>
                <TextBlock Style="{StaticResource PiaMetaSeparatorStyle}"/>
                <TextBlock Text="{Binding SelectedJob.TimeOfDay, StringFormat=HH\\:mm}"
                           Style="{StaticResource PiaMetaTextStyle}"/>
              </StackPanel>

              <TextBlock Text="{loc:Str Routines_Detail_NextRun}"
                         Style="{StaticResource PiaSettingsSectionLabelStyle}"
                         Margin="0,18,0,6"/>
              <TextBlock Text="{Binding SelectedJob.NextFireAt, StringFormat=g}"
                         Style="{StaticResource PiaDetailValueStyle}"
                         AutomationProperties.AutomationId="Routines_Detail_NextRun"/>

              <Border Margin="0,12,0,0"
                      Padding="12,8"
                      CornerRadius="6"
                      Background="{DynamicResource WarnSoftBrush}"
                      Visibility="{Binding SelectedJob.OwnedByThisDevice, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                <TextBlock Text="{loc:Str Routines_NotOwnedHere}"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource TextSubtleBrush}"/>
              </Border>

              <TextBlock Text="{loc:Str Settings_ScheduledJobs_Field_Goal}"
                         Style="{StaticResource PiaSettingsSectionLabelStyle}"
                         Margin="0,18,0,6"/>
              <TextBlock Text="{Binding SelectedJob.Query}"
                         Style="{StaticResource PiaDetailValueStyle}"/>

              <!-- Always shown: an agent routine that stores no grants still gets write_file, and hiding the
                   line read as "this routine cannot write". -->
              <TextBlock Text="{loc:Str Routines_Detail_Tools}"
                         Style="{StaticResource PiaSettingsSectionLabelStyle}"
                         Margin="0,18,0,6"/>
              <TextBlock Text="{Binding SelectedJob.ToolsSummary}"
                         Style="{StaticResource PiaDetailValueStyle}"
                         TextWrapping="Wrap"
                         AutomationProperties.AutomationId="Routines_Detail_Tools"/>

              <TextBlock Text="{loc:Str Routines_Field_Persona}"
                         Style="{StaticResource PiaSettingsSectionLabelStyle}"
                         Margin="0,18,0,6"
                         Visibility="{Binding SelectedJob.HasPersonaPin, Converter={StaticResource BooleanToVisibilityConverter}}"/>
              <TextBlock Text="{Binding SelectedJob.PersonaLabel}"
                         Style="{StaticResource PiaDetailValueStyle}"
                         Visibility="{Binding SelectedJob.HasPersonaPin, Converter={StaticResource BooleanToVisibilityConverter}}"/>

              <TextBlock Text="{loc:Str Routines_Field_Effort}"
                         Style="{StaticResource PiaSettingsSectionLabelStyle}"
                         Margin="0,18,0,6"
                         Visibility="{Binding SelectedJob.HasEffortPin, Converter={StaticResource BooleanToVisibilityConverter}}"/>
              <TextBlock Text="{Binding SelectedJob.EffortLabel}"
                         Style="{StaticResource PiaDetailValueStyle}"
                         Visibility="{Binding SelectedJob.HasEffortPin, Converter={StaticResource BooleanToVisibilityConverter}}"/>

              <TextBlock Text="{loc:Str Routines_Detail_RecentRuns}"
                         Style="{StaticResource PiaSettingsSectionLabelStyle}"
                         Margin="0,18,0,6"/>
              <TextBlock Text="{loc:Str Routines_Detail_NeverRun}"
                         FontSize="12"
                         FontStyle="Italic"
                         Foreground="{DynamicResource TextGhostBrush}"
                         Visibility="{Binding SelectedJob.HasRecentRuns, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
              <ItemsControl ItemsSource="{Binding SelectedJob.RecentRuns}"
                            AutomationProperties.AutomationId="Routines_RunHistory">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Background="{DynamicResource SurfaceSunkBrush}"
                            CornerRadius="6"
                            Padding="10,6"
                            Margin="0,0,0,4">
                      <StackPanel>
                        <StackPanel Orientation="Horizontal">
                          <TextBlock Text="{Binding SettledAt, StringFormat=g}"
                                     Style="{StaticResource PiaMetaTextStyle}"/>
                          <TextBlock Style="{StaticResource PiaMetaSeparatorStyle}"/>
                          <TextBlock Text="{Binding StateLabel}"
                                     Style="{StaticResource PiaMetaTextStyle}"
                                     FontWeight="SemiBold"/>
                          <!-- A failed firing produced no chat, so the link is hidden rather than dead. -->
                          <ui:HyperlinkButton Content="{loc:Str Routines_Detail_OpenChat}"
                                              Cursor="Hand"
                                              Padding="0"
                                              Margin="10,0,0,0"
                                              FontSize="11"
                                              VerticalAlignment="Center"
                                              Visibility="{Binding HasChat, Converter={StaticResource BooleanToVisibilityConverter}}"
                                              Command="{Binding DataContext.OpenRunChatCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                              CommandParameter="{Binding}"
                                              AutomationProperties.AutomationId="{Binding ChatId, StringFormat='Routines_OpenRunChat_{0}'}"/>
                        </StackPanel>
                        <!-- The run's own failure reason; a server or exception message is shown verbatim. -->
                        <TextBlock Text="{Binding Reason}"
                                   Style="{StaticResource PiaMetaTextStyle}"
                                   TextWrapping="Wrap"
                                   Margin="0,2,0,0"
                                   Visibility="{Binding HasReason, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                <ui:Button Content="{loc:Str Settings_ScheduledJobs_Edit}"
                           Icon="{ui:SymbolIcon Edit24}"
                           Appearance="Secondary"
                           Margin="0,0,8,0"
                           AutomationProperties.AutomationId="Routines_Edit"
                           Command="{Binding StartEditCommand}"/>
                <ui:Button Content="{Binding SelectedJob.ToggleLabel}"
                           Icon="{ui:SymbolIcon Power24}"
                           Appearance="Secondary"
                           Margin="0,0,8,0"
                           AutomationProperties.AutomationId="Routines_Toggle"
                           Command="{Binding ToggleEnabledCommand}"/>
                <ui:Button Content="{loc:Str Settings_ScheduledJobs_RunNow}"
                           Icon="{ui:SymbolIcon Play24}"
                           Appearance="Secondary"
                           Margin="0,0,8,0"
                           IsEnabled="{Binding SelectedJob.CanRunNow}"
                           AutomationProperties.AutomationId="Routines_RunNow"
                           Command="{Binding RunNowCommand}"/>
                <ui:Button Content="{loc:Str Settings_ScheduledJobs_Delete}"
                           Icon="{ui:SymbolIcon Delete24}"
                           Appearance="Secondary"
                           Foreground="{DynamicResource PiaDangerBrush}"
                           AutomationProperties.AutomationId="Routines_Delete"
                           Command="{Binding DeleteCommand}"/>
              </StackPanel>
            </StackPanel>
          </ScrollViewer>

          <ScrollViewer VerticalScrollBarVisibility="Auto"
                        IsVisibleChanged="EditorPane_IsVisibleChanged"
                        Visibility="{Binding IsEditorOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel Margin="0,0,10,0">

              <!-- Save is bound to CanSave rather than gated by CanExecute, so the reason has to be visible
                   here. A Border/TextBlock rather than ui:InfoBar, which renders but exposes no automation peer. -->
              <Border Style="{StaticResource PiaRequiredHintStyle}"
                      Visibility="{Binding CanSave, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                <TextBlock Text="{loc:Str Dialog_Edit_RequiredHint}"
                           AutomationProperties.AutomationId="Routines_RequiredHint"
                           TextWrapping="Wrap"/>
              </Border>

              <!-- AI-assist: draft the whole routine from a description -->
              <TextBlock Text="{loc:Str Routines_Draft_Describe}"
                         Style="{StaticResource PiaSettingsSectionLabelStyle}"/>
              <TextBlock Text="{loc:Str Routines_Draft_DescribeHint}"
                         Style="{StaticResource PiaSettingsDescriptionStyle}"
                         TextWrapping="Wrap"
                         Margin="0,2,0,4"/>
              <ui:TextBox Text="{Binding EditDescription, UpdateSourceTrigger=PropertyChanged}"
                          TextWrapping="Wrap"
                          AcceptsReturn="True"
                          MinHeight="60"
                          IsReadOnly="{Binding IsDrafting}"
                          AutomationProperties.AutomationId="Routines_Draft_Description"
                          Margin="0,0,0,8"/>
              <ui:Button Command="{Binding GenerateDraftCommand}"
                         IsEnabled="{Binding IsDrafting, Converter={StaticResource InverseBooleanConverter}}"
                         AutomationProperties.AutomationId="Routines_Draft_Generate"
                         HorizontalAlignment="Left"
                         Margin="0,0,0,16">
                <Grid>
                  <StackPanel Orientation="Horizontal"
                              Visibility="{Binding IsDrafting, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                    <ui:SymbolIcon Symbol="Sparkle24" FontSize="16" Margin="0,0,8,0"/>
                    <TextBlock Text="{loc:Str Routines_Draft_Button}"/>
                  </StackPanel>
                  <StackPanel Orientation="Horizontal"
                              Visibility="{Binding IsDrafting, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ui:ProgressRing IsIndeterminate="True" Width="16" Height="16" Margin="0,0,8,0"/>
                    <TextBlock Text="{loc:Str Routines_Draft_Working}"/>
                  </StackPanel>
                </Grid>
              </ui:Button>

              <TextBlock Text="{loc:Str Routines_Field_Name}"
                         Style="{StaticResource PiaSettingsSectionLabelStyle}"/>
              <ui:TextBox x:Name="EditorNameBox"
                          Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}"
                          AutomationProperties.AutomationId="Routines_Field_Name"
                          Margin="0,2,0,8"/>

              <ItemsControl ItemsSource="{Binding EditSlots}"
                            Visibility="{Binding HasEditSlots, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Margin="0,0,0,8">
                      <TextBlock Text="{Binding Label}"
                                 Style="{StaticResource PiaSettingsSectionLabelStyle}"/>
                      <ui:TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                  AutomationProperties.AutomationId="{Binding Name, StringFormat='Routines_Slot_{0}'}"
                                  Margin="0,2,0,0"/>
                      <TextBlock Text="{Binding Help}"
                                 Style="{StaticResource PiaSettingsDescriptionStyle}"
                                 Margin="0,4,0,0"/>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <!-- A meeting routine has no goal: the link is the whole instruction. -->
              <StackPanel Visibility="{Binding EditorIsMeeting, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                <TextBlock Text="{loc:Str Routines_Field_Goal}"
                           Style="{StaticResource PiaSettingsSectionLabelStyle}"/>
                <!-- Tall enough for the whole instruction: a prefilled goal that has to be scrolled to be read
                     is the complaint this height answers. -->
                <!-- The slot value tinted inside the prose, which is the only thing tying the two fields
                     together. A TextBox cannot colour a substring, so this stands in for it until the user
                     clicks to write their own wording — and then it is gone for the rest of the edit. -->
                <Button Style="{StaticResource RoutineGoalPreviewStyle}"
                        Margin="0,2,0,8"
                        AutomationProperties.AutomationId="Routines_Field_Goal_Preview"
                        Visibility="{Binding ShowsGoalPreview, Converter={StaticResource BooleanToVisibilityConverter}}"
                        Command="{Binding EditGoalCommand}">
                  <TextBlock TextWrapping="Wrap">
                    <Run Text="{Binding GoalPrefix, Mode=OneWay}"/><Run Text="{Binding GoalHighlightText, Mode=OneWay}"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource PiaAccentBrush}"/><Run Text="{Binding GoalSuffix, Mode=OneWay}"/>
                  </TextBlock>
                </Button>

                <ui:TextBox x:Name="EditorGoalBox"
                            Text="{Binding EditQuery, UpdateSourceTrigger=PropertyChanged}"
                            AcceptsReturn="True"
                            TextWrapping="Wrap"
                            MinHeight="150"
                            VerticalContentAlignment="Top"
                            AutomationProperties.AutomationId="Routines_Field_Goal"
                            Visibility="{Binding ShowsGoalPreview, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                            Margin="0,2,0,8"/>
                <TextBlock Text="{loc:Str Routines_Field_Goal_SlotHint}"
                           Style="{StaticResource PiaSettingsDescriptionStyle}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,8"
                           Visibility="{Binding ShowsGoalPreview, Converter={StaticResource BooleanToVisibilityConverter}}"/>
              </StackPanel>

              <!-- Paired two-up from here down: one dropdown per row left half the editor empty and pushed the
                   goal box off the screen. -->
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="16"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                  <TextBlock Text="{loc:Str Settings_ScheduledJobs_Field_Kind}"
                             Style="{StaticResource PiaSettingsSectionLabelStyle}"/>
                  <!-- SelectedValuePath, not SelectedItem: the list carries localized (value, label) pairs so
                       the ComboBox does not render the C# enum identifier, while the VM keeps holding the enum. -->
                  <ComboBox ItemsSource="{Binding JobKinds}"
                            DisplayMemberPath="Label"
                            SelectedValuePath="Value"
                            SelectedValue="{Binding EditKind, Mode=TwoWay}"
                            AutomationProperties.AutomationId="Routines_Field_Kind"
                            Margin="0,2,0,8"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                  <TextBlock Text="{loc:Str Settings_ScheduledJobs_Field_Recurrence}"
                             Style="{StaticResource PiaSettingsSectionLabelStyle}"/>
                  <ComboBox ItemsSource="{Binding Recurrences}"
                            DisplayMemberPath="Label"
                            SelectedValuePath="Value"
                            SelectedValue="{Binding EditRecurrence, Mode=TwoWay}"
                            AutomationProperties.AutomationId="Routines_Field_Recurrence"
                            Margin="0,2,0,8"/>
                </StackPanel>
              </Grid>

              <StackPanel Visibility="{Binding EditorIsMeeting, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="{loc:Str Routines_Field_MeetingUrl}"
                           Style="{StaticResource PiaSettingsSectionLabelStyle}"/>
                <ui:TextBox Text="{Binding EditMeetingUrl, UpdateSourceTrigger=PropertyChanged}"
                            PlaceholderText="{loc:Str Routines_Field_MeetingUrl_Hint}"
                            AutomationProperties.AutomationId="Routines_Field_MeetingUrl"
                            Margin="0,2,0,8"/>
                <CheckBox Content="{loc:Str Routines_Field_MeetingConsent}"
                          IsChecked="{Binding EditMeetingConsent, Mode=TwoWay}"
                          AutomationProperties.AutomationId="Routines_Field_MeetingConsent"
                          Margin="0,0,0,8"/>
              </StackPanel>

              <!-- Time on the left because it is the only one of the pair that always shows; the recurrence
                   detail sits on the right, under the Repeats picker it belongs to. Each detail field is shown
                   only for the recurrences that read it — without them the calculator substitutes today's day
                   on every recompute and the job walks. Only Yearly shows two, which is why they stack. -->
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="16"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Top">
                  <TextBlock Text="{loc:Str Routines_Field_Time}"
                             Style="{StaticResource PiaSettingsSectionLabelStyle}"/>
                  <ui:TextBox Text="{Binding EditTimeOfDay, UpdateSourceTrigger=PropertyChanged}"
                              AutomationProperties.AutomationId="Routines_Field_Time"
                              Margin="0,2,0,8"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                  <StackPanel Visibility="{Binding EditorWantsDayOfWeek, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="{loc:Str Routines_Field_DayOfWeek}"
                               Style="{StaticResource PiaSettingsSectionLabelStyle}"/>
                    <ComboBox ItemsSource="{Binding DayOfWeekChoices}"
                              DisplayMemberPath="Label"
                              SelectedValuePath="Value"
                              SelectedValue="{Binding EditDayOfWeek, Mode=TwoWay}"
                              AutomationProperties.AutomationId="Routines_Field_DayOfWeek"
                              Margin="0,2,0,8"/>
                  </StackPanel>

                  <StackPanel Visibility="{Binding EditorWantsMonth, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="{loc:Str Routines_Field_Month}"
                               Style="{StaticResource PiaSettingsSectionLabelStyle}"/>
                    <ComboBox ItemsSource="{Binding MonthChoices}"
                              DisplayMemberPath="Label"
                              SelectedValuePath="Value"
                              SelectedValue="{Binding EditMonth, Mode=TwoWay}"
                              AutomationProperties.AutomationId="Routines_Field_Month"
                              Margin="0,2,0,8"/>
                  </StackPanel>

                  <StackPanel Visibility="{Binding EditorWantsDayOfMonth, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="{loc:Str Routines_Field_DayOfMonth}"
                               Style="{StaticResource PiaSettingsSectionLabelStyle}"/>
                    <ComboBox ItemsSource="{Binding DayOfMonthChoices}"
                              SelectedItem="{Binding EditDayOfMonth, Mode=TwoWay}"
                              AutomationProperties.AutomationId="Routines_Field_DayOfMonth"
                              Margin="0,2,0,4"/>
                    <TextBlock Text="{loc:Str Routines_Field_DayOfMonth_Hint}"
                               Style="{StaticResource PiaSettingsDescriptionStyle}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,8"/>
                  </StackPanel>

                  <StackPanel Visibility="{Binding EditorWantsSpecificDate, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="{loc:Str Settings_ScheduledJobs_Field_Date}"
                               Style="{StaticResource PiaSettingsSectionLabelStyle}"/>
                    <DatePicker SelectedDate="{Binding EditSpecificDate, Mode=TwoWay}"
                                AutomationProperties.AutomationId="Routines_Field_Date"
                                Margin="0,2,0,8"/>
                  </StackPanel>
                </StackPanel>
              </Grid>

              <!-- None of these apply to a meeting: there is no model call, no persona and no tool grant in
                   sitting in a call and writing down what was said. -->
              <StackPanel Visibility="{Binding EditorIsMeeting, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>

                  <StackPanel Grid.Column="0">
                    <TextBlock Text="{loc:Str Settings_ScheduledJobs_Field_Provider}"
                               Style="{StaticResource PiaSettingsSectionLabelStyle}"/>
                    <ComboBox ItemsSource="{Binding ProviderChoices}"
                              SelectedItem="{Binding EditProvider, Mode=TwoWay}"
                              DisplayMemberPath="Name"
                              AutomationProperties.AutomationId="Routines_Field_Provider"
                              Margin="0,2,0,8"/>
                  </StackPanel>

                  <!-- SelectedItem, not SelectedValue: both lists lead with a NULL-valued row, and WPF reads a
                       null SelectedValue as no selection at all, so that row could never be shown as chosen. -->
                  <StackPanel Grid.Column="2">
                    <TextBlock Text="{loc:Str Routines_Field_Persona}"
                               Style="{StaticResource PiaSettingsSectionLabelStyle}"/>
                    <ComboBox ItemsSource="{Binding PersonaChoices}"
                              SelectedItem="{Binding EditPersona, Mode=TwoWay}"
                              DisplayMemberPath="Name"
                              IsEnabled="{Binding EditorPinsEnabled}"
                              AutomationProperties.AutomationId="Routines_Field_Persona"
                              Margin="0,2,0,4"/>
                    <TextBlock Text="{loc:Str Routines_Field_Persona_Hint}"
                               Style="{StaticResource PiaSettingsDescriptionStyle}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,8"/>
                  </StackPanel>
                </Grid>

                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>

                  <StackPanel Grid.Column="0">
                    <TextBlock Text="{loc:Str Routines_Field_Effort}"
                               Style="{StaticResource PiaSettingsSectionLabelStyle}"/>
                    <ComboBox ItemsSource="{Binding EffortChoices}"
                              SelectedItem="{Binding EditEffort, Mode=TwoWay}"
                              DisplayMemberPath="Label"
                              IsEnabled="{Binding EditorPinsEnabled}"
                              AutomationProperties.AutomationId="Routines_Field_Effort"
                              Margin="0,2,0,4"/>
                    <TextBlock Text="{loc:Str Routines_Field_Effort_Hint}"
                               Style="{StaticResource PiaSettingsDescriptionStyle}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,4"/>
                  </StackPanel>
                </Grid>

                <!-- Disabled pickers with no explanation read as a bug, so the same banner says whose device owns them. -->
                <Border Margin="0,4,0,8"
                        Padding="12,8"
                        CornerRadius="6"
                        Background="{DynamicResource WarnSoftBrush}"
                        Visibility="{Binding EditorPinsEnabled, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                  <TextBlock Text="{loc:Str Routines_NotOwnedHere}"
                             FontSize="12"
                             TextWrapping="Wrap"
                             Foreground="{DynamicResource TextSubtleBrush}"/>
                </Border>

                <!-- Collapsed: the header line is what most users need, and 40-odd rows would own the editor. -->
                <ui:CardExpander IsExpanded="False"
                                 Margin="0,4,0,8"
                                 AutomationProperties.AutomationId="Routines_Tools_Picker">
                  <ui:CardExpander.Header>
                    <StackPanel>
                      <TextBlock Text="{loc:Str Routines_Field_Tools}"
                                 Style="{StaticResource PiaSettingsSectionLabelStyle}"/>
                      <TextBlock Text="{loc:Str Routines_Field_Tools_Hint}"
                                 Style="{StaticResource PiaSettingsDescriptionStyle}"
                                 TextWrapping="Wrap"/>
                      <TextBlock Text="{Binding EditToolsSummary}"
                                 Margin="0,6,0,0"
                                 FontSize="12"
                                 TextTrimming="CharacterEllipsis"
                                 Foreground="{DynamicResource TextSubtleBrush}"
                                 AutomationProperties.AutomationId="Routines_Tools_Summary"/>
                      <TextBlock Text="{loc:Str Routines_Field_Tools_Missing_Notice}"
                                 Margin="0,4,0,0"
                                 FontSize="12"
                                 TextWrapping="Wrap"
                                 Foreground="{DynamicResource WarnBrush}"
                                 Visibility="{Binding HasEditMissingTools, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    </StackPanel>
                  </ui:CardExpander.Header>

                  <StackPanel Margin="0,8,0,0">
                    <!-- A named list REPLACES the launcher's write_file floor rather than adding to it, so an
                         agent routine can lose file writes by ticking one unrelated tool. -->
                    <Border Padding="12,8"
                            CornerRadius="6"
                            Margin="0,0,0,10"
                            Background="{DynamicResource WarnSoftBrush}"
                            Visibility="{Binding EditorIsAgentTask, Converter={StaticResource BooleanToVisibilityConverter}}">
                      <TextBlock Text="{loc:Str Routines_Field_Tools_AgentDefault}"
                                 FontSize="12"
                                 TextWrapping="Wrap"
                                 Foreground="{DynamicResource TextSubtleBrush}"/>
                    </Border>

                    <TextBlock Text="{loc:Str Routines_Field_Tools_Empty}"
                               Style="{StaticResource PiaSettingsDescriptionStyle}"
                               TextWrapping="Wrap"
                               Visibility="{Binding HasEditToolCatalog, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>

                    <!-- Capped and scrolled: a default install already lists 26 tools, 42 once files and git are up. -->
                    <Border Style="{StaticResource PiaSettingsCardStyle}"
                            Padding="10"
                            MaxHeight="320"
                            Visibility="{Binding HasEditToolCatalog, Converter={StaticResource BooleanToVisibilityConverter}}">
                      <ScrollViewer VerticalScrollBarVisibility="Auto"
                                    HorizontalScrollBarVisibility="Disabled"
                                    PreviewMouseWheel="ToolPickerScroller_PreviewMouseWheel">
                        <ItemsControl ItemsSource="{Binding EditToolGroups}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <StackPanel Margin="0,0,0,12">
                                <TextBlock Text="{Binding Header}"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,6"
                                           Foreground="{DynamicResource TextDefaultBrush}"/>
                                <!-- Row state only, never a command through an ancestor: inside this template the
                                     nearest ItemsControl is the inner one. -->
                                <ItemsControl ItemsSource="{Binding Tools}">
                                  <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                      <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                Margin="0,0,0,10"
                                                AutomationProperties.AutomationId="{Binding ToolName, StringFormat='Routines_Tools_Allow_{0}'}"
                                                AutomationProperties.Name="{Binding ToolName}">
                                        <StackPanel>
                                          <TextBlock Text="{Binding ToolName}"
                                                     Foreground="{DynamicResource TextDefaultBrush}"/>
                                          <TextBlock Text="{Binding Description}"
                                                     FontSize="11"
                                                     TextWrapping="Wrap"
                                                     Margin="0,2,0,0"
                                                     Foreground="{DynamicResource TextMutedBrush}"
                                                     Visibility="{Binding HasDescription, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                          <TextBlock Text="{Binding UnavailableReason}"
                                                     FontSize="11"
                                                     TextWrapping="Wrap"
                                                     Margin="0,2,0,0"
                                                     Foreground="{DynamicResource WarnBrush}"
                                                     Visibility="{Binding IsUnavailable, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                          <TextBlock Text="{Binding CautionText}"
                                                     FontSize="11"
                                                     TextWrapping="Wrap"
                                                     Margin="0,2,0,0"
                                                     Foreground="{DynamicResource TextSubtleBrush}"
                                                     Visibility="{Binding HasCaution, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                        </StackPanel>
                                      </CheckBox>
                                    </DataTemplate>
                                  </ItemsControl.ItemTemplate>
                                </ItemsControl>
                              </StackPanel>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </ScrollViewer>
                    </Border>
                  </StackPanel>
                </ui:CardExpander>
              </StackPanel>

              <!-- The label says SUCCESS out loud: failures always notify. -->
              <CheckBox Content="{loc:Str Settings_ScheduledJobs_Field_QuietOnSuccess}"
                        IsChecked="{Binding EditQuietOnSuccess, Mode=TwoWay}"
                        AutomationProperties.AutomationId="Routines_Field_Quiet"
                        Margin="0,2,0,4"/>
              <TextBlock Text="{loc:Str Settings_ScheduledJobs_Field_QuietOnSuccess_Hint}"
                         Style="{StaticResource PiaSettingsDescriptionStyle}"
                         TextWrapping="Wrap"
                         Margin="0,0,0,8"/>

              <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <ui:Button Content="{loc:Str Settings_ScheduledJobs_Save}"
                           Icon="{ui:SymbolIcon Save24}"
                           Appearance="Primary"
                           Margin="0,0,8,0"
                           IsEnabled="{Binding CanSave}"
                           AutomationProperties.AutomationId="Routines_Save"
                           Command="{Binding SaveCommand}"/>
                <ui:Button Content="{loc:Str Settings_ScheduledJobs_Cancel}"
                           Appearance="Secondary"
                           AutomationProperties.AutomationId="Routines_Cancel"
                           Command="{Binding CancelEditCommand}"/>
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>

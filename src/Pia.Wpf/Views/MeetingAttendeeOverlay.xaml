<UserControl x:Class="Pia.Views.MeetingAttendeeOverlay"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  xmlns:loc="clr-namespace:Pia.Localization"
  xmlns:models="clr-namespace:Pia.Models"
  xmlns:controls="clr-namespace:Pia.Views.Controls"
  mc:Ignorable="d"
  d:DesignHeight="500" d:DesignWidth="600">

  <Grid Background="{DynamicResource ApplicationBackgroundBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Header: title + status + close -->
    <Border Grid.Row="0"
            BorderThickness="0,0,0,1"
            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
            Padding="20,12">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0"
                    Orientation="Vertical"
                    VerticalAlignment="Center">
          <TextBlock Text="{loc:Str MeetingAttendee_Title}"
                     FontSize="16"
                     FontWeight="SemiBold" />
          <!-- Status row: a busy spinner (shown while joining / leaving) next to the status text. -->
          <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
            <ui:ProgressRing Width="14"
                             Height="14"
                             IsIndeterminate="True"
                             VerticalAlignment="Center"
                             Margin="0,0,8,0"
                             Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <TextBlock Text="{Binding StatusText}"
                       FontSize="12"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource TextPlaceholderColorBrush}" />
          </StackPanel>
        </StackPanel>

        <ui:Button Grid.Column="1"
                   Command="{Binding CloseCommand}"
                   Width="36"
                   Height="36"
                   Padding="0"
                   Appearance="Secondary"
                   ToolTip="{loc:Str MeetingAttendee_Close}">
          <ui:SymbolIcon Symbol="Dismiss24" FontSize="14" />
        </ui:Button>
      </Grid>
    </Border>

    <!-- Join setup: URL input + consent + Join button. Hidden while running AND after a meeting has been
         attended and left (so leaving lands on the transcript alone, not the join form again). -->
    <Border Grid.Row="1"
            BorderThickness="0,0,0,1"
            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
            Padding="20,12"
            Visibility="{Binding IsJoinSetupVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
      <StackPanel Orientation="Vertical">
        <!-- Requirements: what this feature needs before joining. Always visible so the prerequisites
             (Teams link, host admission, first-run download, local model, background helpers) are clear. -->
        <Border Background="{DynamicResource ControlFillColorDefaultBrush}"
                CornerRadius="8"
                Padding="12,10"
                Margin="0,0,0,14">
          <StackPanel Orientation="Vertical">
            <TextBlock Text="{loc:Str MeetingAttendee_Requirements_Title}"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Margin="0,0,0,6" />
            <TextBlock Text="{loc:Str MeetingAttendee_Requirements_Teams}"
                       FontSize="12"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextPlaceholderColorBrush}" />
            <TextBlock Text="{loc:Str MeetingAttendee_Requirements_Lobby}"
                       FontSize="12"
                       TextWrapping="Wrap"
                       Margin="0,3,0,0"
                       Foreground="{DynamicResource TextPlaceholderColorBrush}" />
            <TextBlock Text="{loc:Str MeetingAttendee_Requirements_FirstRun}"
                       FontSize="12"
                       TextWrapping="Wrap"
                       Margin="0,3,0,0"
                       Foreground="{DynamicResource TextPlaceholderColorBrush}" />
            <TextBlock Text="{loc:Str MeetingAttendee_Requirements_Model}"
                       FontSize="12"
                       TextWrapping="Wrap"
                       Margin="0,3,0,0"
                       Foreground="{DynamicResource TextPlaceholderColorBrush}" />
            <TextBlock Text="{loc:Str MeetingAttendee_Requirements_Desktop}"
                       FontSize="12"
                       TextWrapping="Wrap"
                       Margin="0,3,0,0"
                       Foreground="{DynamicResource TextPlaceholderColorBrush}" />
            <TextBlock Text="{loc:Str MeetingAttendee_Requirements_Background}"
                       FontSize="12"
                       TextWrapping="Wrap"
                       Margin="0,3,0,0"
                       Foreground="{DynamicResource TextPlaceholderColorBrush}" />
          </StackPanel>
        </Border>

        <TextBlock Text="{loc:Str MeetingAttendee_Url_Label}"
                   FontSize="12"
                   Margin="0,0,0,4"
                   Foreground="{DynamicResource TextPlaceholderColorBrush}" />
        <ui:TextBox Text="{Binding MeetingUrl, UpdateSourceTrigger=PropertyChanged}"
                    PlaceholderText="{loc:Str MeetingAttendee_Url_Placeholder}"
                    PlaceholderEnabled="True"
                    FontSize="13" />

        <!-- Editable display name the assistant joins under (pre-filled with "{user}'s assistant"). -->
        <TextBlock Text="{loc:Str MeetingAttendee_DisplayName_Label}"
                   FontSize="12"
                   Margin="0,10,0,4"
                   Foreground="{DynamicResource TextPlaceholderColorBrush}" />
        <ui:TextBox Text="{Binding AssistantDisplayName, UpdateSourceTrigger=PropertyChanged}"
                    PlaceholderText="{loc:Str MeetingAttendee_DisplayName_Placeholder}"
                    PlaceholderEnabled="True"
                    FontSize="13" />

        <CheckBox IsChecked="{Binding ConsentAcknowledged}"
                  Margin="0,10,0,0"
                  Content="{loc:Str MeetingAttendee_Consent_Label}" />
        <!-- Join button + a quick link to the meeting settings (Assistant settings → Meeting tab):
             diarization, speaker matching, browser choice. The link sits to the right of Join and is
             only shown here on the join setup page (Row 1), so it cannot be clicked mid-meeting. -->
        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
          <ui:Button Command="{Binding StartCommand}"
                     Padding="20,8"
                     Appearance="Primary"
                     Content="{loc:Str MeetingAttendee_Join}" />
          <ui:HyperlinkButton Command="{Binding OpenMeetingSettingsCommand}"
                              Margin="12,0,0,0"
                              VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal">
              <ui:SymbolIcon Symbol="Settings24" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" />
              <TextBlock Text="{loc:Str MeetingAttendee_OpenSettings}" VerticalAlignment="Center" />
            </StackPanel>
          </ui:HyperlinkButton>
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- Bubble list -->
    <ScrollViewer x:Name="BubbleScroll"
                  Grid.Row="2"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="20,16,20,8">
      <ItemsControl ItemsSource="{Binding Bubbles}">
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="{x:Type models:TranscriptBubble}">
            <Grid Margin="0,0,0,10">
              <!-- "You" (right-aligned, accent) — unused by the attendee, kept for template parity -->
              <StackPanel HorizontalAlignment="Right"
                          MaxWidth="{Binding ActualWidth, ElementName=BubbleScroll, Converter={StaticResource MultiplyConverter}, ConverterParameter=0.65}">
                <StackPanel.Style>
                  <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding Speaker}" Value="{x:Static models:TranscriptSpeaker.You}">
                        <Setter Property="Visibility" Value="Visible" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </StackPanel.Style>
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,0,4,2">
                  <TextBlock Text="{Binding StartTimestamp, Converter={StaticResource DateTimeOffsetToShortTimeConverter}}"
                             FontSize="11"
                             Margin="0,0,8,0"
                             Foreground="{DynamicResource TextPlaceholderColorBrush}" />
                  <TextBlock FontSize="11"
                             Foreground="{DynamicResource TextPlaceholderColorBrush}">
                    <TextBlock.Text>
                      <MultiBinding Converter="{StaticResource SpeakerToDisplayNameConverter}">
                        <Binding Path="Speaker" />
                        <Binding Path="SpeakerLabel" />
                        <Binding Path="DataContext.CounterpartName"
                                 RelativeSource="{RelativeSource AncestorType=UserControl}" />
                      </MultiBinding>
                    </TextBlock.Text>
                  </TextBlock>
                </StackPanel>
                <Border Padding="12,8"
                        CornerRadius="12,12,0,12"
                        Background="{DynamicResource AccentFillColorDefaultBrush}">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="{Binding Text}"
                               TextWrapping="Wrap"
                               FontSize="14"
                               Foreground="White" />
                    <controls:ListeningIndicator Grid.Column="1"
                                                 Margin="8,0,0,0"
                                                 VerticalAlignment="Center"
                                                 Visibility="{Binding IsListening, Converter={StaticResource BooleanToVisibilityConverter}}" />
                  </Grid>
                </Border>
              </StackPanel>

              <!-- "Them" (left-aligned, secondary) — the meeting room -->
              <StackPanel HorizontalAlignment="Left"
                          MaxWidth="{Binding ActualWidth, ElementName=BubbleScroll, Converter={StaticResource MultiplyConverter}, ConverterParameter=0.65}">
                <StackPanel.Style>
                  <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding Speaker}" Value="{x:Static models:TranscriptSpeaker.Them}">
                        <Setter Property="Visibility" Value="Visible" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </StackPanel.Style>
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Left"
                            Margin="4,0,0,2">
                  <!-- Click-to-rename the diarized speaker: transparent button wrapping the speaker
                       name + an edit pencil. The MultiBinding stays the Unit-5-widened 3-value one
                       (Speaker, SpeakerLabel, CounterpartName). CommandParameter is the raw SpeakerLabel
                       so the command receives the diarizer label (e.g. "Speaker 2"), not the rendered
                       display name. -->
                  <ui:Button Padding="4,2"
                             Margin="-4,-2,4,-2"
                             Appearance="Transparent"
                             BorderThickness="0"
                             Cursor="Hand"
                             ToolTip="{loc:Str MeetingAttendee_RenameSpeaker_MenuItem}"
                             Command="{Binding DataContext.RenameSpeakerLabelCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                             CommandParameter="{Binding SpeakerLabel}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                      <TextBlock FontSize="11"
                                 VerticalAlignment="Center"
                                 Foreground="{DynamicResource TextPlaceholderColorBrush}">
                        <TextBlock.Text>
                          <MultiBinding Converter="{StaticResource SpeakerToDisplayNameConverter}">
                            <Binding Path="Speaker" />
                            <Binding Path="SpeakerLabel" />
                            <Binding Path="DataContext.CounterpartName"
                                     RelativeSource="{RelativeSource AncestorType=UserControl}" />
                          </MultiBinding>
                        </TextBlock.Text>
                      </TextBlock>
                      <ui:SymbolIcon Symbol="Edit24"
                                     FontSize="11"
                                     Margin="4,0,0,0"
                                     VerticalAlignment="Center"
                                     Foreground="{DynamicResource TextPlaceholderColorBrush}" />
                    </StackPanel>
                  </ui:Button>
                  <TextBlock Text="{Binding StartTimestamp, Converter={StaticResource DateTimeOffsetToShortTimeConverter}}"
                             FontSize="11"
                             VerticalAlignment="Center"
                             Foreground="{DynamicResource TextPlaceholderColorBrush}" />
                </StackPanel>
                <Border Padding="12,8"
                        CornerRadius="12,12,12,0">
                  <!-- Per-speaker coloring: the Background MUST live in the Style (default Setter +
                       ColorIndex DataTriggers). A local-value Background attribute would override the
                       Style triggers and silently force every "Them" bubble to one color. -->
                  <Border.Style>
                    <Style TargetType="Border">
                      <Setter Property="Background" Value="{DynamicResource SpeakerBubbleBackground1Brush}" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding ColorIndex}" Value="1">
                          <Setter Property="Background" Value="{DynamicResource SpeakerBubbleBackground2Brush}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ColorIndex}" Value="2">
                          <Setter Property="Background" Value="{DynamicResource SpeakerBubbleBackground3Brush}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ColorIndex}" Value="3">
                          <Setter Property="Background" Value="{DynamicResource SpeakerBubbleBackground4Brush}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ColorIndex}" Value="4">
                          <Setter Property="Background" Value="{DynamicResource SpeakerBubbleBackground5Brush}" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Border.Style>
                  <!-- Right-click variant of the rename affordance. The bubble's DataContext is the
                       TranscriptBubble, so the command (on the UserControl's DataContext) is reached via
                       the Border.Tag bridge; the parameter is the bubble's own SpeakerLabel. Coexists
                       with the ColorIndex Border.Style above. -->
                  <Border.ContextMenu>
                    <ContextMenu>
                      <MenuItem Header="{loc:Str MeetingAttendee_RenameSpeaker_MenuItem}"
                                Command="{Binding PlacementTarget.Tag.RenameSpeakerLabelCommand,
                                           RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                CommandParameter="{Binding PlacementTarget.DataContext.SpeakerLabel,
                                                    RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                    </ContextMenu>
                  </Border.ContextMenu>
                  <Border.Tag>
                    <Binding Path="DataContext" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                  </Border.Tag>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="{Binding Text}"
                               TextWrapping="Wrap"
                               FontSize="14" />
                    <controls:ListeningIndicator Grid.Column="1"
                                                 Margin="8,0,0,0"
                                                 VerticalAlignment="Center"
                                                 Visibility="{Binding IsListening, Converter={StaticResource BooleanToVisibilityConverter}}" />
                  </Grid>
                </Border>
              </StackPanel>
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <!-- Footer: stop / save buttons -->
    <Border Grid.Row="3"
            BorderThickness="0,1,0,0"
            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
            Padding="20,12">
      <StackPanel HorizontalAlignment="Center"
                  Orientation="Horizontal">
        <ui:Button Command="{Binding StopCommand}"
                   Padding="20,10"
                   Appearance="Danger"
                   Content="{loc:Str MeetingAttendee_Stop}"
                   Visibility="{Binding IsRunning, Converter={StaticResource BooleanToVisibilityConverter}}" />
        <ui:Button Command="{Binding SaveTranscriptCommand}"
                   Margin="8,0,0,0"
                   Padding="20,10"
                   Appearance="Primary"
                   Content="{loc:Str MeetingAttendee_Save}"
                   Visibility="{Binding IsRunning, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
        <ui:Button Command="{Binding SummarizeWithAssistantCommand}"
                   Margin="8,0,0,0"
                   Padding="20,10"
                   Appearance="Secondary"
                   Content="{loc:Str MeetingAttendee_Summarize}"
                   Visibility="{Binding IsRunning, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>

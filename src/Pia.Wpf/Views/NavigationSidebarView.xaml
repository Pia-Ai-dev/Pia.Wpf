<UserControl x:Class="Pia.Views.NavigationSidebarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:models="clr-namespace:Pia.Models"
             xmlns:loc="clr-namespace:Pia.Localization"
             mc:Ignorable="d">

  <ui:NavigationView x:Name="SidebarNavigationView"
                     PaneDisplayMode="Left"
                     IsPaneOpen="False"
                     OpenPaneLength="200"
                     Transition="FadeInWithSlide">

    <ui:NavigationView.MenuItems>
      <!-- Optimize mode items -->
      <ui:NavigationViewItem Command="{Binding NavigationCommand}"
                             CommandParameter="Optimize"
                             IsActive="{Binding CurrentNavigationItem, Converter={StaticResource StringEqualsBoolConverter}, ConverterParameter=Optimize}"
                             Visibility="{Binding Mode, Converter={StaticResource WindowModeToVisibilityConverter}, ConverterParameter=Optimize}">
        <ui:NavigationViewItem.Content>
          <Button Style="{StaticResource NavItemInvokeButtonStyle}"
                  Command="{Binding NavigationCommand}"
                  CommandParameter="Optimize"
                  AutomationProperties.AutomationId="NavItem_Optimize"
                  AutomationProperties.Name="{loc:Str Nav_Optimize}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="{loc:Str Nav_Optimize}" />
              <TextBlock Text="{Binding OptimizeHotkeyHint, StringFormat=' ({0})'}"
                         Opacity="0.5" />
            </StackPanel>
          </Button>
        </ui:NavigationViewItem.Content>
        <ui:NavigationViewItem.Icon>
          <ui:SymbolIcon Symbol="Sparkle24" />
        </ui:NavigationViewItem.Icon>
      </ui:NavigationViewItem>

      <!-- Assistant mode items -->
      <ui:NavigationViewItem Command="{Binding NavigationCommand}"
                             CommandParameter="Assistant"
                             IsActive="{Binding CurrentNavigationItem, Converter={StaticResource StringEqualsBoolConverter}, ConverterParameter=Assistant}"
                             Visibility="{Binding Mode, Converter={StaticResource WindowModeToVisibilityConverter}, ConverterParameter=Assistant}">
        <ui:NavigationViewItem.Content>
          <Button Style="{StaticResource NavItemInvokeButtonStyle}"
                  Command="{Binding NavigationCommand}"
                  CommandParameter="Assistant"
                  AutomationProperties.AutomationId="NavItem_AssistantChat"
                  AutomationProperties.Name="{loc:Str Nav_Assistant}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="{loc:Str Nav_Assistant}" />
              <TextBlock Text="{Binding AssistantHotkeyHint, StringFormat=' ({0})'}"
                         Opacity="0.5" />
            </StackPanel>
          </Button>
        </ui:NavigationViewItem.Content>
        <ui:NavigationViewItem.Icon>
          <ui:SymbolIcon Symbol="Chat24" />
        </ui:NavigationViewItem.Icon>
      </ui:NavigationViewItem>

      <!-- History (Optimize only) -->
      <ui:NavigationViewItem Command="{Binding NavigationCommand}"
                             CommandParameter="History"
                             IsActive="{Binding CurrentNavigationItem, Converter={StaticResource StringEqualsBoolConverter}, ConverterParameter=History}"
                             Visibility="{Binding Mode, Converter={StaticResource WindowModeToVisibilityConverter}, ConverterParameter=Optimize}">
        <ui:NavigationViewItem.Content>
          <Button Style="{StaticResource NavItemInvokeButtonStyle}"
                  Command="{Binding NavigationCommand}"
                  CommandParameter="History"
                  AutomationProperties.AutomationId="NavItem_History"
                  AutomationProperties.Name="{loc:Str Nav_History}">
            <TextBlock Text="{loc:Str Nav_History}" />
          </Button>
        </ui:NavigationViewItem.Content>
        <ui:NavigationViewItem.Icon>
          <ui:SymbolIcon Symbol="Clock24" />
        </ui:NavigationViewItem.Icon>
      </ui:NavigationViewItem>

      <!-- Chat history (Assistant only) -->
      <ui:NavigationViewItem Command="{Binding NavigationCommand}"
                             CommandParameter="AssistantHistory"
                             IsActive="{Binding CurrentNavigationItem, Converter={StaticResource StringEqualsBoolConverter}, ConverterParameter=AssistantHistory}"
                             Visibility="{Binding Mode, Converter={StaticResource WindowModeToVisibilityConverter}, ConverterParameter=Assistant}">
        <ui:NavigationViewItem.Content>
          <Button Style="{StaticResource NavItemInvokeButtonStyle}"
                  Command="{Binding NavigationCommand}"
                  CommandParameter="AssistantHistory"
                  AutomationProperties.AutomationId="NavItem_AssistantHistory"
                  AutomationProperties.Name="{loc:Str AssistantHistory_Nav}">
            <TextBlock Text="{loc:Str AssistantHistory_Nav}" />
          </Button>
        </ui:NavigationViewItem.Content>
        <ui:NavigationViewItem.Icon>
          <ui:SymbolIcon Symbol="Clock24" />
        </ui:NavigationViewItem.Icon>
      </ui:NavigationViewItem>

      <!-- Memory (Assistant only) -->
      <ui:NavigationViewItem Command="{Binding NavigationCommand}"
                             CommandParameter="Vault"
                             IsActive="{Binding CurrentNavigationItem, Converter={StaticResource StringEqualsBoolConverter}, ConverterParameter=Vault}"
                             Visibility="{Binding Mode, Converter={StaticResource WindowModeToVisibilityConverter}, ConverterParameter=Assistant}">
        <ui:NavigationViewItem.Content>
          <Button Style="{StaticResource NavItemInvokeButtonStyle}"
                  Command="{Binding NavigationCommand}"
                  CommandParameter="Vault"
                  AutomationProperties.AutomationId="NavItem_Memory"
                  AutomationProperties.Name="{loc:Str Nav_Memory}">
            <TextBlock Text="{loc:Str Nav_Memory}" />
          </Button>
        </ui:NavigationViewItem.Content>
        <ui:NavigationViewItem.Icon>
          <ui:SymbolIcon Symbol="BrainCircuit24" />
        </ui:NavigationViewItem.Icon>
      </ui:NavigationViewItem>

      <!-- Reminders (Assistant only) -->
      <ui:NavigationViewItem Command="{Binding NavigationCommand}"
                             CommandParameter="Reminders"
                             IsActive="{Binding CurrentNavigationItem, Converter={StaticResource StringEqualsBoolConverter}, ConverterParameter=Reminders}"
                             Visibility="{Binding Mode, Converter={StaticResource WindowModeToVisibilityConverter}, ConverterParameter=Assistant}">
        <ui:NavigationViewItem.Content>
          <Button Style="{StaticResource NavItemInvokeButtonStyle}"
                  Command="{Binding NavigationCommand}"
                  CommandParameter="Reminders"
                  AutomationProperties.AutomationId="NavItem_Reminders"
                  AutomationProperties.Name="{loc:Str Nav_Reminders}">
            <TextBlock Text="{loc:Str Nav_Reminders}" />
          </Button>
        </ui:NavigationViewItem.Content>
        <ui:NavigationViewItem.Icon>
          <ui:SymbolIcon Symbol="Alert24" />
        </ui:NavigationViewItem.Icon>
      </ui:NavigationViewItem>

      <!-- Routines (Assistant only) -->
      <ui:NavigationViewItem Command="{Binding NavigationCommand}"
                             CommandParameter="Routines"
                             IsActive="{Binding CurrentNavigationItem, Converter={StaticResource StringEqualsBoolConverter}, ConverterParameter=Routines}"
                             Visibility="{Binding Mode, Converter={StaticResource WindowModeToVisibilityConverter}, ConverterParameter=Assistant}">
        <ui:NavigationViewItem.Content>
          <Button Style="{StaticResource NavItemInvokeButtonStyle}"
                  Command="{Binding NavigationCommand}"
                  CommandParameter="Routines"
                  AutomationProperties.AutomationId="NavItem_Routines"
                  AutomationProperties.Name="{loc:Str Nav_Routines}">
            <TextBlock Text="{loc:Str Nav_Routines}" />
          </Button>
        </ui:NavigationViewItem.Content>
        <ui:NavigationViewItem.Icon>
          <ui:SymbolIcon Symbol="CalendarClock24" />
        </ui:NavigationViewItem.Icon>
      </ui:NavigationViewItem>

      <!-- Background assignments (Assistant only, and only when the server offers the surface) -->
      <ui:NavigationViewItem Command="{Binding NavigationCommand}"
                             CommandParameter="Assignments"
                             IsActive="{Binding CurrentNavigationItem, Converter={StaticResource StringEqualsBoolConverter}, ConverterParameter=Assignments}"
                             Visibility="{Binding IsAssignmentsNavVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
        <ui:NavigationViewItem.Content>
          <Button Style="{StaticResource NavItemInvokeButtonStyle}"
                  Command="{Binding NavigationCommand}"
                  CommandParameter="Assignments"
                  AutomationProperties.AutomationId="NavItem_Assignments"
                  AutomationProperties.Name="{loc:Str Nav_Assignments}">
            <TextBlock Text="{loc:Str Nav_Assignments}" />
          </Button>
        </ui:NavigationViewItem.Content>
        <ui:NavigationViewItem.Icon>
          <ui:SymbolIcon Symbol="Rocket24" />
        </ui:NavigationViewItem.Icon>
      </ui:NavigationViewItem>

      <!-- Todo (all modes) -->
      <ui:NavigationViewItem Command="{Binding NavigationCommand}"
                             CommandParameter="Todo">
        <ui:NavigationViewItem.Content>
          <Button Style="{StaticResource NavItemInvokeButtonStyle}"
                  Command="{Binding NavigationCommand}"
                  CommandParameter="Todo"
                  AutomationProperties.AutomationId="NavItem_Todo"
                  AutomationProperties.Name="{loc:Str Nav_Todo}">
            <TextBlock Text="{loc:Str Nav_Todo}" />
          </Button>
        </ui:NavigationViewItem.Content>
        <ui:NavigationViewItem.Icon>
          <ui:SymbolIcon Symbol="TaskListSquareLtr24" />
        </ui:NavigationViewItem.Icon>
      </ui:NavigationViewItem>

      <!-- Settings (all modes) -->
      <ui:NavigationViewItem Command="{Binding NavigationCommand}"
                             CommandParameter="Settings"
                             IsActive="{Binding CurrentNavigationItem, Converter={StaticResource StringEqualsBoolConverter}, ConverterParameter=Settings}">
        <ui:NavigationViewItem.Content>
          <Button Style="{StaticResource NavItemInvokeButtonStyle}"
                  Command="{Binding NavigationCommand}"
                  CommandParameter="Settings"
                  AutomationProperties.AutomationId="NavItem_Settings"
                  AutomationProperties.Name="{loc:Str Nav_Settings}">
            <TextBlock Text="{loc:Str Nav_Settings}" />
          </Button>
        </ui:NavigationViewItem.Content>
        <ui:NavigationViewItem.Icon>
          <ui:SymbolIcon Symbol="Settings24" />
        </ui:NavigationViewItem.Icon>
      </ui:NavigationViewItem>
    </ui:NavigationView.MenuItems>

    <ui:NavigationView.FooterMenuItems>
      <ui:NavigationViewItem x:Name="NewWindowNavItem"
                             ToolTip="{loc:Str Nav_NewWindow_Tooltip}">
        <ui:NavigationViewItem.Content>
          <Button Style="{StaticResource NavItemInvokeButtonStyle}"
                  AutomationProperties.AutomationId="NavItem_NewWindow"
                  AutomationProperties.Name="{loc:Str Nav_NewWindow}">
            <TextBlock Text="{loc:Str Nav_NewWindow}" />
          </Button>
        </ui:NavigationViewItem.Content>
        <ui:NavigationViewItem.Icon>
          <ui:SymbolIcon Symbol="WindowNew20" />
        </ui:NavigationViewItem.Icon>
        <ui:NavigationViewItem.ContextMenu>
          <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
            <MenuItem Header="{loc:Str Nav_Optimize}"
                      Command="{Binding OpenNewWindowCommand}"
                      CommandParameter="{x:Static models:WindowMode.Optimize}"
                      InputGestureText="{Binding OptimizeHotkeyHint}"
                      AutomationProperties.AutomationId="NavItem_OpenOptimizeWindow">
              <MenuItem.Icon>
                <ui:SymbolIcon Symbol="Sparkle24" />
              </MenuItem.Icon>
              <MenuItem.Style>
                <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding Mode}" Value="{x:Static models:WindowMode.Optimize}">
                      <Setter Property="IsEnabled" Value="False" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </MenuItem.Style>
            </MenuItem>
            <MenuItem Header="{loc:Str Nav_Assistant}"
                      Command="{Binding OpenNewWindowCommand}"
                      CommandParameter="{x:Static models:WindowMode.Assistant}"
                      InputGestureText="{Binding AssistantHotkeyHint}"
                      AutomationProperties.AutomationId="NavItem_OpenAssistantWindow">
              <MenuItem.Icon>
                <ui:SymbolIcon Symbol="Chat24" />
              </MenuItem.Icon>
              <MenuItem.Style>
                <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding Mode}" Value="{x:Static models:WindowMode.Assistant}">
                      <Setter Property="IsEnabled" Value="False" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </MenuItem.Style>
            </MenuItem>
          </ContextMenu>
        </ui:NavigationViewItem.ContextMenu>
      </ui:NavigationViewItem>
      <ui:NavigationViewItem Command="{Binding ToggleThemeCommand}"
                             Tag="ThemeToggle">
        <ui:NavigationViewItem.Content>
          <Button Style="{StaticResource NavItemInvokeButtonStyle}"
                  Command="{Binding ToggleThemeCommand}"
                  AutomationProperties.AutomationId="NavItem_ThemeToggle"
                  AutomationProperties.Name="{Binding Theme}">
            <TextBlock Text="{Binding Theme}" />
          </Button>
        </ui:NavigationViewItem.Content>
        <ui:NavigationViewItem.Icon>
          <ui:SymbolIcon>
            <ui:SymbolIcon.Style>
              <Style TargetType="ui:SymbolIcon">
                <Setter Property="Symbol" Value="Desktop24" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Theme}" Value="Dark">
                    <Setter Property="Symbol"
                            Value="WeatherMoon24" />
                  </DataTrigger>
                  <DataTrigger Binding="{Binding Theme}" Value="Light">
                    <Setter Property="Symbol"
                            Value="WeatherSunny24" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </ui:SymbolIcon.Style>
          </ui:SymbolIcon>
        </ui:NavigationViewItem.Icon>
      </ui:NavigationViewItem>
    </ui:NavigationView.FooterMenuItems>
  </ui:NavigationView>
</UserControl>

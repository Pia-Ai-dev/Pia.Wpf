<UserControl x:Class="Pia.Controls.PersonaGlyph"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Pia.Controls"
             Focusable="False">
  <Grid>
    <!-- The two built-in Pia personas use the Pia mark (same as the assistant chat avatar). -->
    <Path x:Name="PiaIcon"
          Data="{StaticResource PiaMarkGeometry}"
          Fill="{DynamicResource PiaAccentBrush}"
          Stretch="Uniform"
          Visibility="Collapsed" />
    <!-- All other personas keep their emoji glyph, rendered in color via the OS text stack. -->
    <controls:EmojiPresenter x:Name="EmojiImage"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center" />
  </Grid>
</UserControl>

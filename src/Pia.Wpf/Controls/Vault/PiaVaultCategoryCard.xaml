<UserControl x:Class="Pia.Controls.Vault.PiaVaultCategoryCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:mem="clr-namespace:Pia.Controls.Vault"
             xmlns:views="clr-namespace:Pia.Views"
             x:Name="Root">
  <Border CornerRadius="{StaticResource LargeRadius}"
          Background="{DynamicResource SurfaceBrush}"
          BorderBrush="{DynamicResource BorderBrush_}"
          BorderThickness="1">
    <Border.Effect>
      <DropShadowEffect Color="#0F1729" Opacity="0.04"
                        BlurRadius="6" ShadowDepth="1"/>
    </Border.Effect>
    <StackPanel>

      <Button Style="{StaticResource UnstyledButton}"
              Click="ToggleHeader_Click"
              AutomationProperties.AutomationId="{Binding Type, StringFormat='Memory_CategoryToggle_{0}'}"
              HorizontalContentAlignment="Stretch">
        <Grid Margin="14,11">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>

          <ui:SymbolIcon Symbol="ChevronDown20"
                         Grid.Column="0"
                         Foreground="{DynamicResource TextMutedBrush}"
                         RenderTransformOrigin="0.5,0.5"
                         VerticalAlignment="Center">
            <ui:SymbolIcon.RenderTransform>
              <RotateTransform Angle="{Binding IsExpanded,
                                       Converter={StaticResource BoolToAngleConverter},
                                       ConverterParameter='0|-90'}"/>
            </ui:SymbolIcon.RenderTransform>
          </ui:SymbolIcon>

          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="{Binding DisplayName}"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextDefaultBrush}"
                       VerticalAlignment="Center"/>
            <Border Background="{DynamicResource PiaAccentBrush}"
                    CornerRadius="10"
                    Padding="6,1"
                    Margin="8,0,0,0"
                    VerticalAlignment="Center">
              <TextBlock Text="{Binding ItemCount}"
                         Foreground="White"
                         FontSize="10.5"
                         FontWeight="Bold"/>
            </Border>
          </StackPanel>

          <TextBlock Grid.Column="2"
                     Foreground="{DynamicResource TextSubtleBrush}"
                     FontSize="11"
                     VerticalAlignment="Center">
            <Run Text="updated "/><Run Text="{Binding LastUpdated, StringFormat='{}{0:yyyy-MM-dd}', Mode=OneWay}"/>
          </TextBlock>
        </Grid>
      </Button>

      <Border Height="1"
              Background="{DynamicResource BorderBrush_}"
              Visibility="{Binding IsExpanded, Converter={StaticResource BooleanToVisibilityConverter}}"/>

      <ListBox x:Name="ItemList"
               AutomationProperties.AutomationId="{Binding Type, StringFormat='Memory_ItemList_{0}'}"
               ItemsSource="{Binding Items}"
               SelectionChanged="ItemList_SelectionChanged"
               Background="Transparent"
               BorderThickness="0"
               Padding="0,4,0,4"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled"
               Visibility="{Binding IsExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
        <ListBox.ItemContainerStyle>
          <Style TargetType="ListBoxItem" BasedOn="{StaticResource PiaMemoryRowItemStyle}">
            <Setter Property="AutomationProperties.AutomationId" Value="{Binding Reference, StringFormat='MemoryVault_Row_{0}'}"/>
            <Setter Property="AutomationProperties.Name" Value="{Binding Title}"/>
          </Style>
        </ListBox.ItemContainerStyle>
        <ListBox.ItemTemplate>
          <DataTemplate>
            <mem:PiaVaultRow/>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </StackPanel>
  </Border>
</UserControl>

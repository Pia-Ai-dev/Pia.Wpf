<UserControl x:Class="Pia.Controls.Vault.PiaVaultOverview"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:behaviors="clr-namespace:Pia.Behaviors"
             xmlns:loc="clr-namespace:Pia.Localization">
  <!-- The whole overview is a file-drop target (same mechanism as the Assistant view): FileDropBehavior
       filters by extension, drives IsDragOver, and routes the accepted paths to the view-model's
       AddSourceFilesCommand, which copies text files under sources/ and starts ingest. -->
  <Grid x:Name="DropRoot"
        Background="Transparent"
        behaviors:FileDropBehavior.IsEnabled="True"
        behaviors:FileDropBehavior.AcceptedExtensions=".txt,.md,.markdown,.text,.csv,.json,.log,.html,.htm,.xml"
        behaviors:FileDropBehavior.FilesDroppedCommand="{Binding AddSourceFilesCommand}">
    <!-- Card content; blurred while a file is dragged over, mirroring the Assistant composer. -->
    <Border Padding="14,12">
      <Border.Style>
        <Style TargetType="Border" BasedOn="{StaticResource PiaCardStyle}">
          <Style.Triggers>
            <DataTrigger Binding="{Binding Path=(behaviors:FileDropBehavior.IsDragOver), ElementName=DropRoot}"
                         Value="True">
              <Setter Property="Effect">
                <Setter.Value>
                  <BlurEffect Radius="6" KernelType="Gaussian"/>
                </Setter.Value>
              </Setter>
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </Border.Style>
    <!-- Content is anchored top-left: the ScrollViewer fills the card and only scrolls when the list
         outgrows it, so nothing ever renders outside the card. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
      <StackPanel HorizontalAlignment="Stretch">
        <TextBlock Text="{loc:Str Memory_VaultOverview_Title}"
                   FontSize="14"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource TextDefaultBrush}"/>

        <!-- Composition by category — hidden entirely for a sources-only vault (no displayable
             memories), where an empty bar strip would just read as a rendering bug. -->
        <StackPanel Visibility="{Binding VaultComposition.Count, Converter={StaticResource IntToVisibilityConverter}}">
          <TextBlock Text="{loc:Str Memory_VaultOverview_Subtitle}"
                     FontSize="12"
                     Margin="0,2,0,16"
                     Foreground="{DynamicResource TextMutedBrush}"/>

          <!-- Proportional segmented bar. Each segment's width = Fraction * host width via the multi-value
               converter, so it fills the available width exactly (fractions sum to 1.0) and is resize-safe.
               Rounded corners come from a SizeChanged-driven clip (see code-behind). -->
          <Grid x:Name="BarHost"
                Height="16"
                HorizontalAlignment="Stretch"
                UseLayoutRounding="False"
                SnapsToDevicePixels="False"
                SizeChanged="BarHost_SizeChanged">
            <ItemsControl ItemsSource="{Binding VaultComposition}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Rectangle Height="16"
                             Fill="{Binding Type, Converter={StaticResource VaultCategoryBrushBg}}">
                    <Rectangle.Width>
                      <MultiBinding Converter="{StaticResource FractionToWidthConverter}">
                        <Binding Path="Fraction"/>
                        <Binding Path="ActualWidth"
                                 RelativeSource="{RelativeSource AncestorType={x:Type ItemsControl}}"/>
                      </MultiBinding>
                    </Rectangle.Width>
                  </Rectangle>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Grid>

          <!-- Legend: swatch | name | count | percentage, counts/percentages right-aligned in fixed columns. -->
          <ItemsControl ItemsSource="{Binding VaultComposition}" Margin="0,16,0,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid Margin="0,0,0,8">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <Rectangle Grid.Column="0"
                             Width="10"
                             Height="10"
                             RadiusX="3"
                             RadiusY="3"
                             Margin="0,0,10,0"
                             VerticalAlignment="Center"
                             Fill="{Binding Type, Converter={StaticResource VaultCategoryBrushBg}}"/>
                  <TextBlock Grid.Column="1"
                             Text="{Binding DisplayName}"
                             FontSize="13"
                             VerticalAlignment="Center"
                             TextTrimming="CharacterEllipsis"
                             Foreground="{DynamicResource TextDefaultBrush}"/>
                  <TextBlock Grid.Column="2"
                             Text="{Binding Count}"
                             FontSize="13"
                             MinWidth="40"
                             Margin="12,0,0,0"
                             TextAlignment="Right"
                             VerticalAlignment="Center"
                             Foreground="{DynamicResource TextMutedBrush}"/>
                  <TextBlock Grid.Column="3"
                             Text="{Binding Fraction, StringFormat=P0}"
                             FontSize="13"
                             MinWidth="52"
                             Margin="12,0,0,0"
                             TextAlignment="Right"
                             VerticalAlignment="Center"
                             Foreground="{DynamicResource TextMutedBrush}"/>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <Border Height="1"
                  Background="{DynamicResource SurfaceMutedBrush}"
                  Margin="0,12,0,0"/>
        </StackPanel>

        <!-- Source documents: the vault's sources/ RAW layer, each file with its ingest provenance
             (compiled into N topic pages, from the pages' `sources:` frontmatter). -->
        <TextBlock Text="{loc:Str Memory_Sources_Title}"
                   FontSize="14"
                   FontWeight="SemiBold"
                   Margin="0,20,0,0"
                   Foreground="{DynamicResource TextDefaultBrush}"/>
        <TextBlock Text="{Binding SourcesSummaryText}"
                   FontSize="12"
                   Margin="0,2,0,14"
                   Foreground="{DynamicResource TextMutedBrush}"
                   Visibility="{Binding SourceFiles.Count, Converter={StaticResource IntToVisibilityConverter}}"/>

        <TextBlock Text="{loc:Str Memory_Sources_Empty}"
                   FontSize="12"
                   TextWrapping="Wrap"
                   Margin="0,6,0,2"
                   Foreground="{DynamicResource TextSubtleBrush}"
                   Visibility="{Binding SourceFiles.Count, Converter={StaticResource ZeroToVisibilityConverter}}"/>

        <ItemsControl ItemsSource="{Binding SourceFiles}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid Margin="0,0,0,10" Background="Transparent" ToolTip="{Binding RelativePath}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <!-- Status glyph: a static swatch normally, swapped for an indeterminate spinner while
                     this document is actively being compiled (IsIngesting). -->
                <Grid Grid.Column="0" Width="14" Margin="1,3,9,0" VerticalAlignment="Top">
                  <Ellipse Width="8"
                           Height="8"
                           VerticalAlignment="Top"
                           HorizontalAlignment="Center"
                           Margin="0,2,0,0"
                           Visibility="{Binding IsIngesting,
                                                Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                    <Ellipse.Style>
                      <Style TargetType="Ellipse">
                        <Setter Property="Fill" Value="{DynamicResource TextSubtleBrush}"/>
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsIngested}" Value="True">
                            <Setter Property="Fill" Value="{DynamicResource PiaSuccessBrush}"/>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Ellipse.Style>
                  </Ellipse>
                  <ui:ProgressRing Width="14"
                                   Height="14"
                                   IsIndeterminate="True"
                                   VerticalAlignment="Top"
                                   Visibility="{Binding IsIngesting,
                                                        Converter={StaticResource BooleanToVisibilityConverter}}"/>
                </Grid>
                <StackPanel Grid.Column="1">
                  <TextBlock Text="{Binding Name}"
                             FontSize="13"
                             TextTrimming="CharacterEllipsis"
                             Foreground="{DynamicResource TextDefaultBrush}"/>
                  <!-- Status line normally; "Ingesting…" (accent) while the compile is running. -->
                  <TextBlock FontSize="11"
                             Margin="0,1,0,0"
                             TextTrimming="CharacterEllipsis">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Setter Property="Text" Value="{Binding StatusText}"/>
                        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsIngesting}" Value="True">
                            <Setter Property="Text" Value="{loc:Str Memory_Sources_Ingesting}"/>
                            <Setter Property="Foreground" Value="{DynamicResource PiaAccentBrush}"/>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                </StackPanel>
                <TextBlock Grid.Column="2"
                           Text="{Binding SizeText}"
                           FontSize="12"
                           Margin="12,0,0,0"
                           VerticalAlignment="Top"
                           Foreground="{DynamicResource TextMutedBrush}"/>
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Re-synthesize every topic page from its sources — how an edited memory/templates.md reaches
             pages already on disk. Hidden with no sources, since there is then nothing to rebuild from. -->
        <StackPanel Orientation="Horizontal"
                    Margin="0,16,0,0"
                    Visibility="{Binding SourceFiles.Count, Converter={StaticResource IntToVisibilityConverter}}">
          <ui:Button Appearance="Secondary"
                     AutomationProperties.AutomationId="MemoryOverview_RebuildAll"
                     IsEnabled="{Binding IsRebuilding, Converter={StaticResource InverseBooleanConverter}}"
                     Command="{Binding RebuildAllPagesCommand}">
            <StackPanel Orientation="Horizontal">
              <ui:SymbolIcon Symbol="ArrowSync24" FontSize="16" Margin="0,0,6,0"/>
              <TextBlock Text="{loc:Str Memory_RebuildAll}"/>
            </StackPanel>
          </ui:Button>
          <ui:Button Appearance="Secondary"
                     Margin="8,0,0,0"
                     AutomationProperties.AutomationId="MemoryOverview_CleanUp"
                     IsEnabled="{Binding IsRebuilding, Converter={StaticResource InverseBooleanConverter}}"
                     Command="{Binding CleanUpVaultCommand}">
            <StackPanel Orientation="Horizontal">
              <ui:SymbolIcon Symbol="Broom24" FontSize="16" Margin="0,0,6,0"/>
              <TextBlock Text="{loc:Str Memory_CleanUp}"/>
            </StackPanel>
          </ui:Button>
          <ui:Button Appearance="Transparent"
                     Margin="8,0,0,0"
                     AutomationProperties.AutomationId="MemoryOverview_RebuildCancel"
                     Visibility="{Binding IsRebuilding, Converter={StaticResource BooleanToVisibilityConverter}}"
                     Command="{Binding CancelRebuildCommand}">
            <TextBlock Text="{loc:Str Memory_Cancel}"/>
          </ui:Button>
          <TextBlock Text="{Binding RebuildStatusText}"
                     FontSize="12"
                     Margin="12,0,0,0"
                     VerticalAlignment="Center"
                     Foreground="{DynamicResource TextMutedBrush}"/>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
    </Border>

    <!-- Drag-over overlay (styled to match AssistantView): shown while a droppable file is dragged over.
         IsHitTestVisible=False so the behavior's Preview drag events keep flowing to the drop target. -->
    <Border IsHitTestVisible="False"
            Panel.ZIndex="20"
            Margin="8"
            CornerRadius="8"
            BorderThickness="2"
            BorderBrush="{DynamicResource AccentFillColorDefaultBrush}"
            Background="{DynamicResource AcrylicBackgroundFillColorBaseBrush}"
            Visibility="{Binding Path=(behaviors:FileDropBehavior.IsDragOver), ElementName=DropRoot, Converter={StaticResource BooleanToVisibilityConverter}}">
      <StackPanel HorizontalAlignment="Center"
                  VerticalAlignment="Center">
        <ui:SymbolIcon Symbol="ArrowDownload24"
                       FontSize="48"
                       HorizontalAlignment="Center"
                       Foreground="{DynamicResource AccentFillColorDefaultBrush}"/>
        <TextBlock Text="{loc:Str Memory_DropSources_Hint}"
                   FontSize="16"
                   FontWeight="SemiBold"
                   Margin="0,12,0,0"
                   HorizontalAlignment="Center"
                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>

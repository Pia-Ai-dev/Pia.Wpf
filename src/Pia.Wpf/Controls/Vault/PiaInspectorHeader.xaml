<UserControl x:Class="Pia.Controls.Vault.PiaInspectorHeader"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:mem="clr-namespace:Pia.Controls.Vault"
             xmlns:loc="clr-namespace:Pia.Localization"
             xmlns:behaviors="clr-namespace:Pia.Behaviors"
             xmlns:views="clr-namespace:Pia.Views">
  <Border Padding="14,14,14,14"
          BorderBrush="{DynamicResource BorderBrush_}"
          BorderThickness="0,0,0,1">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <StackPanel Grid.Row="0" Grid.Column="0"
                  Orientation="Horizontal"
                  VerticalAlignment="Center"
                  Margin="0,0,0,6">
        <mem:PiaTypeChip Type="{Binding TypeKind}"/>
      </StackPanel>

      <StackPanel Grid.Row="0" Grid.Column="1"
                  Orientation="Horizontal"
                  VerticalAlignment="Top">
        <ui:Button Icon="{ui:SymbolIcon Symbol=Edit20}"
                   Appearance="Transparent"
                   ToolTip="{loc:Str Memory_Edit}"
                   Command="{Binding DataContext.EditMemoryCommand, RelativeSource={RelativeSource AncestorType=views:VaultView}}"
                   CommandParameter="{Binding}"/>
        <ui:Button Icon="{ui:SymbolIcon Symbol=Copy20}"
                   Appearance="Transparent"
                   ToolTip="{loc:Str Common_Copy}"
                   Command="{Binding DataContext.CopyMarkdownCommand, RelativeSource={RelativeSource AncestorType=views:VaultView}}"
                   CommandParameter="{Binding}"/>
        <ui:Button Icon="{ui:SymbolIcon Symbol=Delete20}"
                   Appearance="Transparent"
                   ToolTip="{loc:Str Memory_Delete}"
                   Foreground="{DynamicResource PiaDangerBrush}"
                   Command="{Binding DataContext.DeleteMemoryCommand, RelativeSource={RelativeSource AncestorType=views:VaultView}}"
                   CommandParameter="{Binding}"/>
      </StackPanel>

      <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                 behaviors:EmojiTextBehavior.Text="{Binding Title}"
                 FontSize="18"
                 FontWeight="SemiBold"
                 TextWrapping="Wrap"
                 Foreground="{DynamicResource TextDefaultBrush}"/>

      <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                 FontSize="11.5"
                 Margin="0,8,0,0"
                 TextWrapping="Wrap"
                 Visibility="{Binding Updated, Converter={StaticResource NullToVisibilityConverter}}">
        <Run Text="{loc:Str Memory_Meta_Updated}" Foreground="{DynamicResource TextMutedBrush}"/>
        <Run Text=" "/>
        <Run Text="{Binding Updated, StringFormat='{}{0:yyyy-MM-dd HH:mm}', Mode=OneWay}" Foreground="{DynamicResource TextDefaultBrush}"/>
      </TextBlock>
    </Grid>
  </Border>
</UserControl>

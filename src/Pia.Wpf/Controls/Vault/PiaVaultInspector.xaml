<UserControl x:Class="Pia.Controls.Vault.PiaVaultInspector"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:controls="clr-namespace:Pia.Controls"
             xmlns:mem="clr-namespace:Pia.Controls.Vault"
             xmlns:loc="clr-namespace:Pia.Localization"
             xmlns:views="clr-namespace:Pia.Views">
  <Border Style="{StaticResource PiaCardStyle}">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <mem:PiaInspectorHeader Grid.Row="0"/>

      <Grid Grid.Row="1" Margin="14,14,14,14">
        <Grid.RowDefinitions>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Read: render the memory body as markdown -->
        <Border Grid.Row="0"
                Background="{DynamicResource SurfaceSunkBrush}"
                BorderBrush="{DynamicResource BorderBrush_}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12,10"
                Visibility="{Binding DataContext.IsEditing,
                                     RelativeSource={RelativeSource AncestorType=views:VaultView},
                                     Converter={StaticResource InverseBooleanToVisibilityConverter}}">
          <!-- Horizontal scrolling MUST stay Disabled: the inner RichTextBox, if measured with infinite
               width, lays out to zero height and renders blank. Disabled constrains its width so the
               body wraps and the vertical scrollbar engages for long content. -->
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <!-- WikiLinkConverter rewrites [[target]] wikilinks into clickable pia-memory: links (read-only,
                 display-only — the stored Body and the edit/copy paths keep the raw Obsidian syntax). -->
            <controls:MarkdownMessageControl x:Name="BodyMarkdown"
                                             MarkdownText="{Binding DisplayBody, Converter={StaticResource WikiLinkConverter}}"/>
          </ScrollViewer>
        </Border>

        <!-- Edit: raw markdown body editor -->
        <Border Grid.Row="0"
                Background="{DynamicResource SurfaceSunkBrush}"
                BorderBrush="{DynamicResource PiaAccentBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="0"
                Visibility="{Binding DataContext.IsEditing,
                                     RelativeSource={RelativeSource AncestorType=views:VaultView},
                                     Converter={StaticResource BooleanToVisibilityConverter}}">
          <TextBox Text="{Binding DataContext.EditingData,
                                  RelativeSource={RelativeSource AncestorType=views:VaultView},
                                  UpdateSourceTrigger=PropertyChanged}"
                   AcceptsReturn="True"
                   AcceptsTab="True"
                   TextWrapping="NoWrap"
                   VerticalScrollBarVisibility="Auto"
                   HorizontalScrollBarVisibility="Auto"
                   FontFamily="{DynamicResource PiaMonoFont}"
                   FontSize="12.5"
                   Background="Transparent"
                   BorderThickness="0"
                   Padding="12,10"
                   Foreground="{DynamicResource TextDefaultBrush}"/>
        </Border>

        <!-- Edit action row -->
        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,10,0,0"
                    Visibility="{Binding DataContext.IsEditing,
                                         RelativeSource={RelativeSource AncestorType=views:VaultView},
                                         Converter={StaticResource BooleanToVisibilityConverter}}">
          <ui:Button Appearance="Secondary"
                     Margin="0,0,8,0"
                     Command="{Binding DataContext.CancelEditCommand,
                                       RelativeSource={RelativeSource AncestorType=views:VaultView}}">
            <TextBlock Text="{loc:Str Memory_Cancel}"/>
          </ui:Button>
          <ui:Button Appearance="Primary"
                     Command="{Binding DataContext.SaveEditCommand,
                                       RelativeSource={RelativeSource AncestorType=views:VaultView}}">
            <StackPanel Orientation="Horizontal">
              <ui:SymbolIcon Symbol="Save24" FontSize="16" Margin="0,0,6,0"/>
              <TextBlock Text="{loc:Str Memory_Save}"/>
            </StackPanel>
          </ui:Button>
        </StackPanel>
      </Grid>
    </Grid>
  </Border>
</UserControl>

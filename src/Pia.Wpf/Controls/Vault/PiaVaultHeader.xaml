<UserControl x:Class="Pia.Controls.Vault.PiaVaultHeader"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:loc="clr-namespace:Pia.Localization"
             xmlns:shared="clr-namespace:Pia.Controls.Shared">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="Auto"/>
    </Grid.ColumnDefinitions>

    <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
      <TextBlock Text="{loc:Str Memory_Title}"
                 Style="{StaticResource PiaPageTitleStyle}"/>
      <shared:PiaHelpHint Text="{loc:Str Memory_HeaderHelp}"
                          Margin="2,0,0,0"
                          AutomationProperties.AutomationId="Memory_Help"/>
    </StackPanel>

    <StackPanel Grid.Row="0" Grid.Column="1"
                Orientation="Horizontal"
                VerticalAlignment="Center">
      <ui:Button Appearance="Secondary"
                 Command="{Binding GoBackCommand}"
                 AutomationProperties.Name="{loc:Str Memory_Back}"
                 AutomationProperties.AutomationId="Memory_Back"
                 ToolTip="{loc:Str Memory_Back}"
                 Margin="0,0,6,0">
        <ui:SymbolIcon Symbol="ArrowLeft24" FontSize="16"/>
      </ui:Button>
      <ui:Button Appearance="Secondary"
                 Command="{Binding GoHomeCommand}"
                 AutomationProperties.Name="{loc:Str Memory_Home}"
                 AutomationProperties.AutomationId="Memory_Home"
                 ToolTip="{loc:Str Memory_Home}"
                 Margin="0,0,6,0">
        <ui:SymbolIcon Symbol="Home24" FontSize="16"/>
      </ui:Button>
      <ui:Button Appearance="Secondary"
                 Command="{Binding RefreshCommand}"
                 AutomationProperties.Name="{loc:Str Memory_Refresh}"
                 AutomationProperties.AutomationId="Memory_Refresh"
                 ToolTip="{loc:Str Memory_Refresh}"
                 Margin="0,0,6,0">
        <ui:SymbolIcon Symbol="ArrowSync24" FontSize="16"/>
      </ui:Button>
      <ui:Button Appearance="Secondary"
                 Command="{Binding OpenVaultFolderCommand}"
                 AutomationProperties.Name="{loc:Str Memory_OpenFolder}"
                 AutomationProperties.AutomationId="Memory_OpenFolder"
                 ToolTip="{loc:Str Memory_OpenFolder}"
                 Margin="0,0,6,0">
        <ui:SymbolIcon Symbol="FolderOpen24" FontSize="16"/>
      </ui:Button>
      <ui:Button Appearance="Secondary"
                 Command="{Binding ShowHelpCommand}"
                 AutomationProperties.Name="{loc:Str Memory_Help_Tooltip}"
                 AutomationProperties.AutomationId="Memory_ShowHelp"
                 ToolTip="{loc:Str Memory_Help_Tooltip}">
        <ui:SymbolIcon Symbol="BookQuestionMark24" FontSize="16"/>
      </ui:Button>
    </StackPanel>

    <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
               Style="{StaticResource PiaPageStatsStyle}">
      <Run Text="{Binding TotalObjectCount, Mode=OneWay}"/><Run Text=" "/><Run Text="{loc:Str Memory_StatsObjects}"/>
      <Run Text=" · "/>
      <Run Text="{Binding StorageSizeText, Mode=OneWay}"/>
    </TextBlock>
  </Grid>
</UserControl>

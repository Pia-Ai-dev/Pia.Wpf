<UserControl x:Class="Pia.Controls.Chat.PiaCallout"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             x:Name="Root">
  <Border CornerRadius="0,8,8,0"
          BorderThickness="3,0,0,0"
          BorderBrush="{Binding AccentBrush, ElementName=Root}"
          Background="{Binding SoftBrush, ElementName=Root}"
          Padding="14,12">
    <StackPanel Orientation="Horizontal">
      <ui:SymbolIcon Symbol="{Binding IconSymbol, ElementName=Root}"
                     FontSize="16"
                     VerticalAlignment="Top"
                     Margin="0,2,0,0"
                     Foreground="{Binding AccentBrush, ElementName=Root}" />
      <StackPanel Margin="10,0,0,0">
        <TextBlock Text="{Binding Title, ElementName=Root}"
                   FontWeight="SemiBold"
                   FontSize="13"
                   Margin="0,0,0,2"
                   Foreground="{DynamicResource TextDefaultBrush}">
          <TextBlock.Style>
            <Style TargetType="TextBlock">
              <Setter Property="Visibility" Value="Visible" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding Title, ElementName=Root}" Value="{x:Null}">
                  <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Title, ElementName=Root}" Value="">
                  <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
        <TextBlock Text="{Binding Body, ElementName=Root}"
                   TextWrapping="Wrap"
                   FontSize="13"
                   LineHeight="20"
                   Foreground="{DynamicResource TextDefaultBrush}" />
      </StackPanel>
    </StackPanel>
  </Border>
</UserControl>

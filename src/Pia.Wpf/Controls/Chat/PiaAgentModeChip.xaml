<UserControl x:Class="Pia.Controls.Chat.PiaAgentModeChip"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:loc="clr-namespace:Pia.Localization"
             x:Name="Root">
  <!-- R8: a typed "switch to Agent mode" chip, visually distinct from the plain string suggestion
       chips (accent-outlined pill + Bot glyph) so it never reads as a text-paste suggestion. -->
  <ItemsControl ItemsSource="{Binding ItemsSource, ElementName=Root}">
    <ItemsControl.ItemsPanel>
      <ItemsPanelTemplate>
        <WrapPanel Orientation="Horizontal" />
      </ItemsPanelTemplate>
    </ItemsControl.ItemsPanel>
    <ItemsControl.ItemTemplate>
      <DataTemplate>
        <Button Margin="0,0,8,8"
                MinHeight="34"
                Padding="12,0"
                Cursor="Hand"
                FontSize="12"
                Background="{DynamicResource PiaAccentSoftBrush}"
                BorderBrush="{DynamicResource PiaAccentBrush}"
                BorderThickness="1"
                Foreground="{DynamicResource PiaInkBrush}"
                ToolTip="{Binding Reason}"
                Command="{Binding ItemClickCommand, ElementName=Root}"
                CommandParameter="{Binding}">
          <Button.Template>
            <ControlTemplate TargetType="Button">
              <Border CornerRadius="{StaticResource SmallRadius}"
                      Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}"
                      Padding="{TemplateBinding Padding}"
                      SnapsToDevicePixels="True">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <ui:SymbolIcon Symbol="Bot24" FontSize="14" Margin="0,0,6,0"
                                 VerticalAlignment="Center"
                                 Foreground="{DynamicResource PiaAccentBrush}" />
                  <TextBlock Text="{loc:Str Suggestion_TryAgent}"
                             Foreground="{TemplateBinding Foreground}"
                             FontSize="{TemplateBinding FontSize}"
                             VerticalAlignment="Center" />
                </StackPanel>
              </Border>
            </ControlTemplate>
          </Button.Template>
        </Button>
      </DataTemplate>
    </ItemsControl.ItemTemplate>
  </ItemsControl>
</UserControl>

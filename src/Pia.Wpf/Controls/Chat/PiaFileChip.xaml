<UserControl x:Class="Pia.Controls.Chat.PiaFileChip"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:loc="clr-namespace:Pia.Localization"
             xmlns:models="clr-namespace:Pia.Models"
             x:Name="Root">
  <UserControl.Resources>
    <Style x:Key="ChipRegionStyle" TargetType="Button">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ContentPresenter VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceMutedBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>
  <Border MinHeight="34"
          CornerRadius="{StaticResource BubbleRadius}"
          Background="{DynamicResource SurfaceBrush}"
          BorderBrush="{DynamicResource BorderBrush_}"
          BorderThickness="1"
          Padding="2"
          SnapsToDevicePixels="True">
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
      <!-- Open the file with its default app -->
      <Button Style="{StaticResource ChipRegionStyle}"
              Padding="6,2"
              Click="OnOpenClick"
              ToolTip="{Binding AbsolutePath, ElementName=Root}">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <ui:SymbolIcon FontSize="14"
                         Margin="0,0,6,0"
                         VerticalAlignment="Center"
                         Foreground="{DynamicResource PiaAccentBrush}">
            <ui:SymbolIcon.Style>
              <Style TargetType="ui:SymbolIcon">
                <Setter Property="Symbol" Value="Document24" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Kind, ElementName=Root}" Value="{x:Static models:FileRefKind.Exported}">
                    <Setter Property="Symbol" Value="Globe24" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </ui:SymbolIcon.Style>
          </ui:SymbolIcon>
          <TextBlock Text="{Binding FileName, ElementName=Root}"
                     VerticalAlignment="Center"
                     FontSize="13"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource TextDefaultBrush}" />
        </StackPanel>
      </Button>
      <!-- Reveal in the containing folder -->
      <Button Style="{StaticResource ChipRegionStyle}"
              Padding="6,2"
              Margin="2,0,0,0"
              Click="OnRevealClick"
              ToolTip="{loc:Str Assistant_OpenFolder_Tooltip}">
        <ui:SymbolIcon Symbol="FolderOpen24"
                       FontSize="14"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource TextMutedBrush}" />
      </Button>
    </StackPanel>
  </Border>
</UserControl>

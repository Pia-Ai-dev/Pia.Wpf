<UserControl x:Class="Pia.Controls.Chat.PiaCollapsibleMessageText"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:loc="clr-namespace:Pia.Localization"
             xmlns:behaviors="clr-namespace:Pia.Behaviors"
             x:Name="Root">
  <StackPanel>
    <Border x:Name="TextClip" ClipToBounds="True">
      <Grid>
        <!-- Hidden twin. A RichTextBox fills whatever width it is offered, so the bubble would always be
             its widest; this is what knows the text's real extent, and MeasureOverride sizes and clips the
             box to it. -->
        <TextBlock x:Name="Sizer"
                   Visibility="Hidden"
                   LineStackingStrategy="BlockLineHeight"
                   behaviors:AtCommandHighlightBehavior.Text="{Binding Text, ElementName=Root}"
                   Style="{StaticResource UserBubbleTextStyle}" />
        <RichTextBox x:Name="Body"
                     Style="{x:Null}"
                     IsReadOnly="True"
                     IsReadOnlyCaretVisible="False"
                     IsUndoEnabled="False"
                     IsDocumentEnabled="False"
                     BorderThickness="0"
                     Background="Transparent"
                     Padding="0"
                     MinWidth="0"
                     MinHeight="0"
                     FontSize="{Binding FontSize, ElementName=Sizer}"
                     Foreground="{DynamicResource UserBubbleFgBrush}"
                     SelectionBrush="{DynamicResource UserBubbleSelectionBrush}"
                     HorizontalScrollBarVisibility="Disabled"
                     VerticalScrollBarVisibility="Disabled"
                     VerticalAlignment="Top"
                     AutomationProperties.AutomationId="{Binding TextAutomationId, ElementName=Root}"
                     behaviors:AtCommandHighlightBehavior.Text="{Binding Text, ElementName=Root}">
          <RichTextBox.ContextMenu>
            <ContextMenu>
              <MenuItem Command="ApplicationCommands.Copy" />
            </ContextMenu>
          </RichTextBox.ContextMenu>
          <FlowDocument x:Name="BodyDocument"
                        PagePadding="0"
                        LineStackingStrategy="BlockLineHeight">
            <Paragraph Margin="0" />
          </FlowDocument>
        </RichTextBox>
      </Grid>
    </Border>

    <ui:Button x:Name="Toggle"
               Click="Toggle_Click"
               Appearance="Transparent"
               Padding="0"
               Margin="0,6,0,0"
               HorizontalAlignment="Right"
               Foreground="{DynamicResource UserBubbleFgBrush}"
               Cursor="Hand"
               AutomationProperties.AutomationId="{Binding ToggleAutomationId, ElementName=Root}"
               Visibility="{Binding IsOverflowing, ElementName=Root, Converter={StaticResource BooleanToVisibilityConverter}}">
      <StackPanel Orientation="Horizontal">
        <TextBlock x:Name="MoreLabel"
                   Text="{loc:Str Assistant_ExpandMessage}"
                   FontSize="12"
                   Opacity="0.85"
                   VerticalAlignment="Center" />
        <TextBlock x:Name="LessLabel"
                   Text="{loc:Str Assistant_CollapseMessage}"
                   FontSize="12"
                   Opacity="0.85"
                   Visibility="Collapsed"
                   VerticalAlignment="Center" />
        <ui:SymbolIcon x:Name="ToggleIcon"
                       Symbol="ChevronDown24"
                       FontSize="14"
                       Margin="4,0,0,0"
                       VerticalAlignment="Center" />
      </StackPanel>
    </ui:Button>
  </StackPanel>
</UserControl>

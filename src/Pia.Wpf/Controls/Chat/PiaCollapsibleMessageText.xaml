<UserControl x:Class="Pia.Controls.Chat.PiaCollapsibleMessageText"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:loc="clr-namespace:Pia.Localization"
             xmlns:behaviors="clr-namespace:Pia.Behaviors"
             x:Name="Root">
  <StackPanel>
    <Border x:Name="TextClip" ClipToBounds="True">
      <!-- The inner StackPanel hands the text infinite height, so its DesiredSize stays the full one and
           the clip's MaxHeight cannot hide the overflow the toggle is offered on. -->
      <StackPanel>
        <!-- The style's LineHeight only binds the line box under BlockLineHeight; on the default strategy
             the font's natural box wins and the fold cuts through a row of glyphs. -->
        <TextBlock x:Name="Body"
                   LineStackingStrategy="BlockLineHeight"
                   behaviors:AtCommandHighlightBehavior.Text="{Binding Text, ElementName=Root}"
                   Style="{StaticResource UserBubbleTextStyle}" />
      </StackPanel>
    </Border>

    <ui:Button x:Name="Toggle"
               Click="Toggle_Click"
               Appearance="Transparent"
               Padding="0"
               Margin="0,6,0,0"
               HorizontalAlignment="Right"
               Foreground="White"
               Cursor="Hand"
               AutomationProperties.AutomationId="{Binding ToggleAutomationId, ElementName=Root}"
               Visibility="{Binding IsOverflowing, ElementName=Root, Converter={StaticResource BooleanToVisibilityConverter}}">
      <StackPanel Orientation="Horizontal">
        <TextBlock x:Name="MoreLabel"
                   Text="{loc:Str Assistant_ExpandMessage}"
                   FontSize="12"
                   Opacity="0.85"
                   VerticalAlignment="Center" />
        <TextBlock x:Name="LessLabel"
                   Text="{loc:Str Assistant_CollapseMessage}"
                   FontSize="12"
                   Opacity="0.85"
                   Visibility="Collapsed"
                   VerticalAlignment="Center" />
        <ui:SymbolIcon x:Name="ToggleIcon"
                       Symbol="ChevronDown24"
                       FontSize="14"
                       Margin="4,0,0,0"
                       VerticalAlignment="Center" />
      </StackPanel>
    </ui:Button>
  </StackPanel>
</UserControl>

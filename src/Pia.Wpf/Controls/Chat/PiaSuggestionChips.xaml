<UserControl x:Class="Pia.Controls.Chat.PiaSuggestionChips"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
  <ItemsControl ItemsSource="{Binding ItemsSource, ElementName=Root}">
    <ItemsControl.ItemsPanel>
      <ItemsPanelTemplate>
        <WrapPanel Orientation="Horizontal" />
      </ItemsPanelTemplate>
    </ItemsControl.ItemsPanel>
    <ItemsControl.ItemTemplate>
      <DataTemplate>
        <Button Margin="0,0,6,6"
                Padding="10,4"
                Cursor="Hand"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush_}"
                BorderThickness="1"
                Foreground="{DynamicResource TextDefaultBrush}"
                Command="{Binding ItemClickCommand, ElementName=Root}"
                CommandParameter="{Binding}">
          <Button.Template>
            <ControlTemplate TargetType="Button">
              <Border CornerRadius="999"
                      Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}"
                      Padding="{TemplateBinding Padding}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <Ellipse Width="5" Height="5" Margin="0,0,6,0"
                           Fill="{DynamicResource PiaAccentBrush}" />
                  <ContentPresenter VerticalAlignment="Center" />
                </StackPanel>
              </Border>
            </ControlTemplate>
          </Button.Template>
        </Button>
      </DataTemplate>
    </ItemsControl.ItemTemplate>
  </ItemsControl>
</UserControl>

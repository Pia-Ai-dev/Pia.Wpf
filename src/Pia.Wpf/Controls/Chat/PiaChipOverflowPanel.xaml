<UserControl x:Class="Pia.Controls.Chat.PiaChipOverflowPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:loc="clr-namespace:Pia.Localization"
             x:Name="Root">
  <UserControl.Resources>
    <Style x:Key="OverflowChipButtonStyle" TargetType="Button">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <ContentPresenter />
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Opacity" Value="0.85" />
        </Trigger>
      </Style.Triggers>
    </Style>
  </UserControl.Resources>

  <!-- Three fixed slots plus the dropdown as SIBLINGS of one WrapPanel: an inner ItemsControl would
       wrap within its own width and push the dropdown to a line of its own. -->
  <WrapPanel Orientation="Horizontal">
    <ContentPresenter Content="{Binding Slot1, ElementName=Root}"
                      ContentTemplate="{Binding ItemTemplate, ElementName=Root}"
                      Visibility="{Binding Slot1, ElementName=Root, Converter={StaticResource NullToVisibilityConverter}}" />
    <ContentPresenter Content="{Binding Slot2, ElementName=Root}"
                      ContentTemplate="{Binding ItemTemplate, ElementName=Root}"
                      Visibility="{Binding Slot2, ElementName=Root, Converter={StaticResource NullToVisibilityConverter}}" />
    <ContentPresenter Content="{Binding Slot3, ElementName=Root}"
                      ContentTemplate="{Binding ItemTemplate, ElementName=Root}"
                      Visibility="{Binding Slot3, ElementName=Root, Converter={StaticResource NullToVisibilityConverter}}" />

    <Grid Margin="0,0,6,6"
          Visibility="{Binding HasOverflow, ElementName=Root, Converter={StaticResource BooleanToVisibilityConverter}}">
      <Button x:Name="MoreButton"
              Style="{StaticResource OverflowChipButtonStyle}"
              Click="MoreButton_Click"
              AutomationProperties.AutomationId="{Binding GroupName, ElementName=Root, StringFormat='ChipOverflow_More_{0}'}"
              ToolTip="{loc:Str Assistant_MoreChips_Tooltip}">
        <Border MinHeight="34"
                CornerRadius="{StaticResource BubbleRadius}"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush_}"
                BorderThickness="1"
                Padding="10,0"
                SnapsToDevicePixels="True">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="{Binding OverflowLabel, ElementName=Root}"
                       VerticalAlignment="Center"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextDefaultBrush}" />
            <ui:SymbolIcon Symbol="ChevronDown20"
                           FontSize="12"
                           Margin="6,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextMutedBrush}" />
          </StackPanel>
        </Border>
      </Button>

      <Popup x:Name="MorePopup"
             PlacementTarget="{Binding ElementName=MoreButton}"
             Placement="Bottom"
             StaysOpen="False"
             AllowsTransparency="True"
             PopupAnimation="Fade"
             Opened="MorePopup_Opened"
             Closed="MorePopup_Closed">
        <Border Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush_}"
                BorderThickness="1"
                CornerRadius="{StaticResource LargeRadius}"
                Padding="8,8,2,2"
                MaxWidth="460"
                ButtonBase.Click="PopupContent_Click">
          <Border.Effect>
            <DropShadowEffect Color="#0F1729" BlurRadius="18" Opacity="0.16" ShadowDepth="4" />
          </Border.Effect>
          <ScrollViewer MaxHeight="320"
                        VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding OverflowItems, ElementName=Root}"
                          ItemTemplate="{Binding ItemTemplate, ElementName=Root}" />
          </ScrollViewer>
        </Border>
      </Popup>
    </Grid>
  </WrapPanel>
</UserControl>

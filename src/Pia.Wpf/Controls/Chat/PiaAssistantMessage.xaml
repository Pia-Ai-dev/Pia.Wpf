<UserControl x:Class="Pia.Controls.Chat.PiaAssistantMessage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:controls="clr-namespace:Pia.Controls"
             xmlns:chat="clr-namespace:Pia.Controls.Chat"
             xmlns:loc="clr-namespace:Pia.Localization"
             x:Name="Root">
  <StackPanel>

    <!-- Reasoning: live rolling window while thinking, then a "Thought for Ns" toggle.
         Sits ABOVE the answer (DataContext is the AssistantMessage). -->
    <chat:PiaReasoningView />

    <!-- Awaiting-confirmation accent: left bar + soft fill while a card is pending.
         Wraps bubble + cards so it survives an empty-content tool-call message.
         AssistantBubbleStyle is Background=Transparent, so WarnSoftBrush shows through. -->
    <Border>
      <Border.Style>
        <Style TargetType="Border">
          <Setter Property="BorderThickness" Value="0" />
          <Setter Property="Background" Value="Transparent" />
          <Setter Property="Padding" Value="0" />
          <Setter Property="CornerRadius" Value="{StaticResource SmallRadius}" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding HasPendingConfirmation}" Value="True">
              <Setter Property="BorderThickness" Value="3,0,0,0" />
              <Setter Property="BorderBrush" Value="{DynamicResource WarnBrush}" />
              <Setter Property="Background" Value="{DynamicResource WarnSoftBrush}" />
              <Setter Property="Padding" Value="8" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </Border.Style>
      <StackPanel>

        <!-- Markdown body (visible only when content present) -->
        <Border>
          <Border.Style>
            <Style TargetType="Border" BasedOn="{StaticResource AssistantBubbleStyle}">
              <Style.Triggers>
                <DataTrigger Binding="{Binding HasContent}" Value="False">
                  <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Border.Style>
          <controls:MarkdownMessageControl x:Name="Markdown"
                                           MarkdownText="{Binding Content}"
                                           IsStreaming="{Binding IsStreaming}"
                                           AddToPiiRequested="Markdown_AddToPiiRequested" />
        </Border>

        <!-- Inline action cards (existing behavior) -->
        <ItemsControl ItemsSource="{Binding ActionCards}" Margin="0,6,0,0"
                      Visibility="{Binding HasActionCards, Converter={StaticResource BooleanToVisibilityConverter}}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <controls:ActionCardControl />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>

    <!-- Protected-route indicator: neutral shield shown when the server routed this answer to the
         protected/private model (guardrail HIT/ERROR). No outcome or model detail is exposed. Placed as a
         sibling of the bubble (not inside the toolbar) so its visibility depends only on IsProtectedRoute,
         never on the toolbar's own collapse rules (hidden while streaming / when the answer is empty). -->
    <Border CornerRadius="9"
            Padding="6,2"
            Margin="0,8,0,0"
            HorizontalAlignment="Left"
            Background="{DynamicResource SurfaceBrush}"
            ToolTip="{loc:Str Assistant_ProtectedRoute_Tooltip}"
            Visibility="{Binding IsProtectedRoute, Converter={StaticResource BooleanToVisibilityConverter}}">
      <StackPanel Orientation="Horizontal">
        <ui:SymbolIcon Symbol="ShieldKeyhole24"
                       FontSize="11"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource TextSubtleBrush}" />
        <TextBlock Text="{loc:Str Assistant_ProtectedRoute_Label}"
                   FontSize="10"
                   FontWeight="SemiBold"
                   Margin="4,0,0,0"
                   VerticalAlignment="Center"
                   Foreground="{DynamicResource TextSubtleBrush}" />
      </StackPanel>
    </Border>

    <!-- Sources — first three inline, the rest behind the "+N" dropdown -->
    <chat:PiaChipOverflowPanel ItemsSource="{Binding Sources}" Margin="0,10,0,0"
                               Visibility="{Binding HasSources, Converter={StaticResource BooleanToVisibilityConverter}}">
      <chat:PiaChipOverflowPanel.ItemTemplate>
        <DataTemplate>
          <chat:PiaSourceChip Number="{Binding Number}"
                              Source="{Binding Source}"
                              Meta="{Binding Meta}"
                              Url="{Binding Url}"
                              Margin="0,0,6,6" />
        </DataTemplate>
      </chat:PiaChipOverflowPanel.ItemTemplate>
    </chat:PiaChipOverflowPanel>

    <!-- Local file chips (read / created / updated / exported / @File-referenced) -->
    <chat:PiaChipOverflowPanel ItemsSource="{Binding FileRefs}" Margin="0,10,0,0"
                               Visibility="{Binding HasFileRefs, Converter={StaticResource BooleanToVisibilityConverter}}">
      <chat:PiaChipOverflowPanel.ItemTemplate>
        <DataTemplate>
          <chat:PiaFileChip AbsolutePath="{Binding AbsolutePath}"
                            FileName="{Binding FileName}"
                            Kind="{Binding Kind}"
                            Margin="0,0,6,6" />
        </DataTemplate>
      </chat:PiaChipOverflowPanel.ItemTemplate>
    </chat:PiaChipOverflowPanel>

    <!-- Toolbar -->
    <chat:PiaAnswerToolbar Margin="-6,6,0,0"
                           CopyCommand="{Binding CopyCommand, ElementName=Root}"
                           SpeakCommand="{Binding SpeakCommand, ElementName=Root}"
                           RegenerateCommand="{Binding RegenerateCommand, ElementName=Root}"
                           RegenerateStyledCommand="{Binding RegenerateStyledCommand, ElementName=Root}"
                           ExportCommand="{Binding ExportCommand, ElementName=Root}"
                           RateCommand="{Binding RateCommand, ElementName=Root}"
                           CommandParameter="{Binding}"
                           Stats="{Binding Stats}"
                           PersonaName="{Binding Persona.Name}">
      <chat:PiaAnswerToolbar.Style>
        <Style TargetType="chat:PiaAnswerToolbar">
          <Setter Property="Visibility" Value="Visible" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding HasContent}" Value="False">
              <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsStreaming}" Value="True">
              <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </chat:PiaAnswerToolbar.Style>
    </chat:PiaAnswerToolbar>

    <!-- Suggestion chips -->
    <chat:PiaSuggestionChips Margin="0,8,0,0"
                             ItemsSource="{Binding Suggestions}"
                             ItemClickCommand="{Binding SuggestionCommand, ElementName=Root}"
                             Visibility="{Binding HasSuggestions, Converter={StaticResource BooleanToVisibilityConverter}}" />

    <!-- Agent-mode suggestion chip (R8) — switches to a Planned run, not text-paste -->
    <chat:PiaAgentModeChip Margin="0,8,0,0"
                           ItemsSource="{Binding AgentModeSuggestions}"
                           ItemClickCommand="{Binding SwitchToAgentCommand, ElementName=Root}"
                           Visibility="{Binding HasAgentModeSuggestion, Converter={StaticResource BooleanToVisibilityConverter}}" />

  </StackPanel>
</UserControl>

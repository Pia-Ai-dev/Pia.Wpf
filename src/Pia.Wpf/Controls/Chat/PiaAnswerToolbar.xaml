<UserControl x:Class="Pia.Controls.Chat.PiaAnswerToolbar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:loc="clr-namespace:Pia.Localization"
             x:Name="Root">
  <Border BorderBrush="{DynamicResource BorderBrush_}"
          BorderThickness="0,1,0,0"
          Padding="0,6,0,0">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
      <!-- Copy -->
      <Button Padding="8,4"
              Margin="0,0,4,0"
              Cursor="Hand"
              BorderThickness="0"
              FontSize="12"
              Command="{Binding CopyCommand, ElementName=Root}"
              CommandParameter="{Binding CommandParameter, ElementName=Root}"
              Visibility="{Binding CopyCommand, ElementName=Root, Converter={StaticResource NullToVisibilityConverter}}">
        <Button.Style>
          <Style TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="Button">
                  <Border x:Name="Bd"
                          Background="{TemplateBinding Background}"
                          CornerRadius="6"
                          Padding="{TemplateBinding Padding}">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceMutedBrush}" />
                      <Setter Property="Foreground" Value="{DynamicResource TextDefaultBrush}" />
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                      <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PiaAccentSoftBrush}" />
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
        </Button.Style>
        <StackPanel Orientation="Horizontal">
          <ui:SymbolIcon Symbol="Copy20" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" />
          <TextBlock Text="{loc:Str Assistant_Copy_Tooltip}" VerticalAlignment="Center" />
        </StackPanel>
      </Button>

      <!-- Read aloud / Stop reading -->
      <Button Padding="8,4"
              Margin="0,0,4,0"
              Cursor="Hand"
              BorderThickness="0"
              FontSize="12"
              Command="{Binding SpeakCommand, ElementName=Root}"
              CommandParameter="{Binding CommandParameter, ElementName=Root}"
              Visibility="{Binding SpeakCommand, ElementName=Root, Converter={StaticResource NullToVisibilityConverter}}">
        <Button.Style>
          <Style TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="Button">
                  <Border x:Name="Bd"
                          Background="{TemplateBinding Background}"
                          CornerRadius="6"
                          Padding="{TemplateBinding Padding}">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceMutedBrush}" />
                      <Setter Property="Foreground" Value="{DynamicResource TextDefaultBrush}" />
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                      <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PiaAccentSoftBrush}" />
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
            <Style.Triggers>
              <DataTrigger Binding="{Binding CommandParameter.IsSpeaking, ElementName=Root}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource PiaAccentBrush}" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Button.Style>
        <Grid>
          <!-- Idle: Read aloud -->
          <StackPanel Orientation="Horizontal">
            <StackPanel.Style>
              <Style TargetType="StackPanel">
                <Setter Property="Visibility" Value="Visible" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding CommandParameter.IsSpeaking, ElementName=Root}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </StackPanel.Style>
            <ui:SymbolIcon Symbol="Speaker220" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" />
            <TextBlock Text="{loc:Str Assistant_ReadAloud_Tooltip}" VerticalAlignment="Center" />
          </StackPanel>
          <!-- Active: Stop reading, with pulsing indicator -->
          <StackPanel Orientation="Horizontal">
            <StackPanel.Style>
              <Style TargetType="StackPanel">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding CommandParameter.IsSpeaking, ElementName=Root}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </StackPanel.Style>
            <Grid Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center">
              <Ellipse Fill="{DynamicResource PiaAccentBrush}" Opacity="0.35">
                <Ellipse.Triggers>
                  <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard>
                      <Storyboard RepeatBehavior="Forever">
                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                         From="0.35" To="0" Duration="0:0:1.1" />
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                       Duration="0:0:1.1">
                          <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0.6" />
                          <LinearDoubleKeyFrame KeyTime="0:0:1.1" Value="1.6" />
                        </DoubleAnimationUsingKeyFrames>
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                       Duration="0:0:1.1">
                          <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0.6" />
                          <LinearDoubleKeyFrame KeyTime="0:0:1.1" Value="1.6" />
                        </DoubleAnimationUsingKeyFrames>
                      </Storyboard>
                    </BeginStoryboard>
                  </EventTrigger>
                </Ellipse.Triggers>
                <Ellipse.RenderTransformOrigin>0.5,0.5</Ellipse.RenderTransformOrigin>
                <Ellipse.RenderTransform>
                  <ScaleTransform ScaleX="1" ScaleY="1" />
                </Ellipse.RenderTransform>
              </Ellipse>
              <Ellipse Width="7" Height="7"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Fill="{DynamicResource PiaAccentBrush}" />
            </Grid>
            <TextBlock Text="{loc:Str Assistant_StopReading_Tooltip}" VerticalAlignment="Center" />
          </StackPanel>
        </Grid>
      </Button>

      <!-- Regenerate -->
      <Button Padding="8,4"
              Margin="0,0,4,0"
              Cursor="Hand"
              BorderThickness="0"
              FontSize="12"
              Command="{Binding RegenerateCommand, ElementName=Root}"
              CommandParameter="{Binding CommandParameter, ElementName=Root}"
              Visibility="{Binding RegenerateCommand, ElementName=Root, Converter={StaticResource NullToVisibilityConverter}}">
        <Button.Style>
          <Style TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="Button">
                  <Border x:Name="Bd"
                          Background="{TemplateBinding Background}"
                          CornerRadius="6"
                          Padding="{TemplateBinding Padding}">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceMutedBrush}" />
                      <Setter Property="Foreground" Value="{DynamicResource TextDefaultBrush}" />
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                      <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PiaAccentSoftBrush}" />
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
        </Button.Style>
        <StackPanel Orientation="Horizontal">
          <ui:SymbolIcon Symbol="ArrowClockwise20" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" />
          <TextBlock Text="{loc:Str Assistant_Regenerate_Tooltip}" VerticalAlignment="Center" />
        </StackPanel>
      </Button>

      <Separator Width="1" Margin="4,2"
                 Background="{DynamicResource BorderBrush_}"
                 Visibility="{Binding RateCommand, ElementName=Root, Converter={StaticResource NullToVisibilityConverter}}" />

      <ui:Button Appearance="Transparent"
                 Padding="6,3"
                 Margin="0,0,2,0"
                 Command="{Binding RateCommand, ElementName=Root}"
                 CommandParameter="Up"
                 Visibility="{Binding RateCommand, ElementName=Root, Converter={StaticResource NullToVisibilityConverter}}">
        <ui:SymbolIcon Symbol="ThumbLike20" FontSize="13" />
      </ui:Button>

      <ui:Button Appearance="Transparent"
                 Padding="6,3"
                 Command="{Binding RateCommand, ElementName=Root}"
                 CommandParameter="Down"
                 Visibility="{Binding RateCommand, ElementName=Root, Converter={StaticResource NullToVisibilityConverter}}">
        <ui:SymbolIcon Symbol="ThumbDislike20" FontSize="13" />
      </ui:Button>
    </StackPanel>

    <TextBlock Grid.Column="1"
               HorizontalAlignment="Right"
               VerticalAlignment="Center"
               Margin="8,0,4,0"
               FontSize="11"
               Foreground="{DynamicResource TextSubtleBrush}"
               Text="{Binding StatsSummary, ElementName=Root}" />
  </Grid>
  </Border>
</UserControl>

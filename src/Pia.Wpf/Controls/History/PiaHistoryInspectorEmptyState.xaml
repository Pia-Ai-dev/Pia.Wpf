<UserControl x:Class="Pia.Controls.History.PiaHistoryInspectorEmptyState"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:loc="clr-namespace:Pia.Localization">
  <Border Style="{StaticResource PiaCardStyle}">
    <StackPanel HorizontalAlignment="Center"
                VerticalAlignment="Center"
                MaxWidth="320">
      <ui:SymbolIcon Symbol="History24"
                     FontSize="36"
                     HorizontalAlignment="Center"
                     Margin="0,0,0,12"
                     Foreground="{DynamicResource PiaAccentBrush}"/>
      <TextBlock Text="{loc:Str History_EmptyInspector_Title}"
                 FontSize="14"
                 FontWeight="SemiBold"
                 HorizontalAlignment="Center"
                 Foreground="{DynamicResource TextDefaultBrush}"/>
      <TextBlock Text="{loc:Str History_EmptyInspector_Hint}"
                 FontSize="12"
                 TextWrapping="Wrap"
                 TextAlignment="Center"
                 HorizontalAlignment="Center"
                 Margin="0,6,0,12"
                 Foreground="{DynamicResource TextMutedBrush}"/>
    </StackPanel>
  </Border>
</UserControl>

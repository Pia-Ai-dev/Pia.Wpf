<UserControl x:Class="Pia.Controls.History.PiaHistorySearchBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:loc="clr-namespace:Pia.Localization"
             x:Name="Root">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="Auto"/>
      <ColumnDefinition Width="Auto"/>
      <ColumnDefinition Width="Auto"/>
      <ColumnDefinition Width="Auto"/>
    </Grid.ColumnDefinitions>

    <Border Grid.Column="0"
            Style="{StaticResource PiaComposerCardStyle}"
            Padding="0">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <ui:SymbolIcon Grid.Column="0"
                       Symbol="Search24"
                       FontSize="16"
                       Margin="14,0,8,0"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource TextSubtleBrush}"/>

        <TextBox Grid.Column="1"
                 Text="{Binding Query, ElementName=Root, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 Background="Transparent"
                 BorderThickness="0"
                 FontSize="13"
                 Padding="0,10"
                 Margin="0,0,12,0"
                 VerticalContentAlignment="Center"/>
      </Grid>
    </Border>

    <DatePicker Grid.Column="1"
                SelectedDate="{Binding StartDate, ElementName=Root, Mode=TwoWay}"
                Width="150"
                Margin="10,0,0,0"
                VerticalAlignment="Center"/>

    <DatePicker Grid.Column="2"
                SelectedDate="{Binding EndDate, ElementName=Root, Mode=TwoWay}"
                Width="150"
                Margin="6,0,0,0"
                VerticalAlignment="Center"/>

    <ComboBox Grid.Column="3"
              ItemsSource="{Binding Templates, ElementName=Root}"
              SelectedValuePath="Id"
              SelectedValue="{Binding TemplateId, ElementName=Root, Mode=TwoWay}"
              Width="170"
              Margin="10,0,0,0"
              VerticalAlignment="Center">
      <ComboBox.ItemTemplate>
        <DataTemplate>
          <TextBlock Text="{Binding Name}"/>
        </DataTemplate>
      </ComboBox.ItemTemplate>
    </ComboBox>

    <ui:Button Grid.Column="4"
               Command="{Binding ClearFilterCommand}"
               Appearance="Secondary"
               Width="36"
               Height="36"
               Padding="0"
               Margin="10,0,0,0"
               VerticalAlignment="Center"
               AutomationProperties.Name="{loc:Str History_ClearFilters}"
               ToolTip="{loc:Str History_ClearFilters}">
      <ui:SymbolIcon Symbol="FilterDismiss24" FontSize="16"/>
    </ui:Button>
  </Grid>
</UserControl>

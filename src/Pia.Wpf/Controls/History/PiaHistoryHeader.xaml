<UserControl x:Class="Pia.Controls.History.PiaHistoryHeader"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:loc="clr-namespace:Pia.Localization"
             xmlns:shared="clr-namespace:Pia.Controls.Shared">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="Auto"/>
    </Grid.ColumnDefinitions>

    <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
      <TextBlock Text="{loc:Str History_Title}"
                 Style="{StaticResource PiaPageTitleStyle}"/>
      <shared:PiaHelpHint Text="{loc:Str History_HeaderHelp}"
                          Margin="2,0,0,0"
                          AutomationProperties.AutomationId="History_Help"/>
    </StackPanel>

    <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
      <ui:Button Appearance="Secondary"
                 Command="{Binding RefreshCommand}"
                 AutomationProperties.AutomationId="History_Refresh"
                 ToolTip="{loc:Str History_Refresh}"
                 Margin="0,0,6,0">
        <StackPanel Orientation="Horizontal">
          <ui:SymbolIcon Symbol="ArrowSync24" FontSize="16" Margin="0,0,6,0"
                         Visibility="{Binding IsLoading, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
          <ui:ProgressRing IsIndeterminate="True"
                           Width="16" Height="16"
                           Margin="0,0,6,0"
                           Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"/>
          <TextBlock Text="{loc:Str History_Refresh}"/>
        </StackPanel>
      </ui:Button>
      <ui:Button Appearance="Secondary"
                 Command="{Binding DeleteAllCommand}"
                 AutomationProperties.AutomationId="History_DeleteAll"
                 ToolTip="{loc:Str History_DeleteAllTooltip}">
        <StackPanel Orientation="Horizontal">
          <ui:SymbolIcon Symbol="Delete24" FontSize="16" Margin="0,0,6,0"
                         Foreground="{DynamicResource PiaDangerBrush}"/>
          <TextBlock Text="{loc:Str History_DeleteAll}"
                     Foreground="{DynamicResource PiaDangerBrush}"/>
        </StackPanel>
      </ui:Button>
    </StackPanel>

    <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
               Style="{StaticResource PiaPageStatsStyle}">
      <Run Text="{Binding TotalCount, Mode=OneWay}"/><Run Text=" "/><Run Text="sessions"/>
    </TextBlock>
  </Grid>
</UserControl>

<UserControl x:Class="Pia.Controls.History.PiaHistoryInspectorHeader"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:loc="clr-namespace:Pia.Localization"
             xmlns:views="clr-namespace:Pia.Views">
  <Border Padding="14,14,14,14"
          BorderBrush="{DynamicResource BorderBrush_}"
          BorderThickness="0,0,0,1">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <StackPanel Grid.Row="0" Grid.Column="0"
                  Orientation="Horizontal"
                  VerticalAlignment="Center"
                  Margin="0,0,0,6">
        <Border Background="{DynamicResource PiaAccentSoftBrush}"
                CornerRadius="10"
                Padding="8,2"
                VerticalAlignment="Center">
          <TextBlock Text="{Binding TemplateName, FallbackValue='—'}"
                     FontSize="10.5"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource PiaAccentBrush}"/>
        </Border>
        <TextBlock Text="{Binding CreatedAt, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}', Mode=OneWay}"
                   FontFamily="{DynamicResource PiaMonoFont}"
                   FontSize="11"
                   Foreground="{DynamicResource TextSubtleBrush}"
                   Margin="8,0,0,0"
                   VerticalAlignment="Center"/>
      </StackPanel>

      <StackPanel Grid.Row="0" Grid.Column="1"
                  Orientation="Horizontal"
                  VerticalAlignment="Top">
        <ui:Button Icon="{ui:SymbolIcon Symbol=Delete20}"
                   Appearance="Transparent"
                   ToolTip="{loc:Str History_Delete}"
                   AutomationProperties.AutomationId="HistorySession_Delete"
                   Foreground="{DynamicResource PiaDangerBrush}"
                   Command="{Binding DataContext.DeleteSessionCommand, RelativeSource={RelativeSource AncestorType=views:HistoryView}}"/>
      </StackPanel>

      <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                 Text="{Binding OptimizedText}"
                 FontSize="16"
                 FontWeight="SemiBold"
                 TextWrapping="Wrap"
                 MaxHeight="48"
                 TextTrimming="CharacterEllipsis"
                 Foreground="{DynamicResource TextDefaultBrush}"/>

      <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                 FontSize="11.5"
                 Margin="0,8,0,0"
                 TextWrapping="Wrap">
        <Run Text="{loc:Str History_Inspector_Meta_Provider}" Foreground="{DynamicResource TextMutedBrush}"/>
        <Run Text=" "/>
        <Run Text="{Binding ProviderName, Mode=OneWay, FallbackValue='—'}" Foreground="{DynamicResource TextDefaultBrush}"/>
        <Run Text="   ·   " Foreground="{DynamicResource TextSubtleBrush}"/>
        <Run Text="{loc:Str History_Inspector_Meta_Tokens}" Foreground="{DynamicResource TextMutedBrush}"/>
        <Run Text=" "/>
        <Run Text="{Binding TokensUsed, Mode=OneWay}" Foreground="{DynamicResource TextDefaultBrush}"/>
        <Run Text="   ·   " Foreground="{DynamicResource TextSubtleBrush}"/>
        <Run Text="{loc:Str History_Inspector_Meta_ProcessingTime}" Foreground="{DynamicResource TextMutedBrush}"/>
        <Run Text=" "/>
        <Run Text="{Binding ProcessingTimeMs, Mode=OneWay, StringFormat='{}{0} ms'}" Foreground="{DynamicResource TextDefaultBrush}"/>
      </TextBlock>
    </Grid>
  </Border>
</UserControl>

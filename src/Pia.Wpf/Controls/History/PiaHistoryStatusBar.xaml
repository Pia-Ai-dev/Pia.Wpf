<UserControl x:Class="Pia.Controls.History.PiaHistoryStatusBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:loc="clr-namespace:Pia.Localization">
  <Border Background="{DynamicResource SurfaceBrush}"
          BorderBrush="{DynamicResource BorderBrush_}"
          BorderThickness="0,1,0,0"
          Padding="14,6">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>

      <TextBlock Grid.Column="0"
                 VerticalAlignment="Center"
                 FontSize="12"
                 Foreground="{DynamicResource TextMutedBrush}">
        <Run Text="{Binding Sessions.Count, Mode=OneWay}"/>
        <Run Text=" / "/>
        <Run Text="{Binding TotalCount, Mode=OneWay}"/>
        <Run Text=" sessions"/>
      </TextBlock>

      <Button Grid.Column="1"
              Command="{Binding LoadMoreCommand}"
              Content="{loc:Str History_LoadMore}"
              Style="{StaticResource UnstyledButton}"
              Foreground="{DynamicResource PiaAccentBrush}"
              Padding="10,4"
              Visibility="{Binding IsLoading, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
    </Grid>
  </Border>
</UserControl>

<UserControl x:Class="Pia.Controls.History.PiaHistoryInspector"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:hist="clr-namespace:Pia.Controls.History"
             xmlns:loc="clr-namespace:Pia.Localization"
             xmlns:views="clr-namespace:Pia.Views">
  <Border Style="{StaticResource PiaCardStyle}">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <hist:PiaHistoryInspectorHeader Grid.Row="0"/>

      <Grid Grid.Row="1" Margin="14,12,14,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush_}"
                BorderThickness="1"
                CornerRadius="9"
                Padding="2"
                HorizontalAlignment="Left">
          <StackPanel Orientation="Horizontal">
            <RadioButton x:Name="OptimizedTab"
                         Content="{loc:Str History_Inspector_Tab_Optimized}"
                         GroupName="HistoryInspectorTabs"
                         IsChecked="True"
                         AutomationProperties.AutomationId="HistorySession_TabOptimized"
                         Style="{StaticResource PiaSegmentedButton}"/>
            <RadioButton x:Name="OriginalTab"
                         Content="{loc:Str History_Inspector_Tab_Original}"
                         GroupName="HistoryInspectorTabs"
                         AutomationProperties.AutomationId="HistorySession_TabOriginal"
                         Style="{StaticResource PiaSegmentedButton}"/>
          </StackPanel>
        </Border>

        <ui:Button Grid.Column="2"
                   Icon="{ui:SymbolIcon Symbol=Copy20}"
                   Appearance="Transparent"
                   ToolTip="{loc:Str History_CopyOptimized}"
                   AutomationProperties.AutomationId="HistorySession_CopyOptimized"
                   Command="{Binding DataContext.CopyOptimizedCommand, RelativeSource={RelativeSource AncestorType=views:HistoryView}}"
                   Visibility="{Binding ElementName=OptimizedTab, Path=IsChecked, Converter={StaticResource BooleanToVisibilityConverter}}"/>

        <ui:Button Grid.Column="2"
                   Icon="{ui:SymbolIcon Symbol=Copy20}"
                   Appearance="Transparent"
                   ToolTip="{loc:Str History_CopyOriginal}"
                   AutomationProperties.AutomationId="HistorySession_CopyOriginal"
                   Command="{Binding DataContext.CopyOriginalCommand, RelativeSource={RelativeSource AncestorType=views:HistoryView}}"
                   Visibility="{Binding ElementName=OriginalTab, Path=IsChecked, Converter={StaticResource BooleanToVisibilityConverter}}"/>
      </Grid>

      <Grid Grid.Row="2" Margin="14,10,14,14">
        <Border Background="{DynamicResource SurfaceMutedBrush}"
                BorderBrush="{DynamicResource BorderBrush_}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12"
                Visibility="{Binding ElementName=OptimizedTab, Path=IsChecked, Converter={StaticResource BooleanToVisibilityConverter}}">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <TextBox Text="{Binding OptimizedText, Mode=OneWay}"
                     AutomationProperties.AutomationId="HistorySession_OptimizedText"
                     IsReadOnly="True"
                     Background="Transparent"
                     BorderThickness="0"
                     TextWrapping="Wrap"
                     AcceptsReturn="True"
                     FontSize="13"
                     Foreground="{DynamicResource TextDefaultBrush}"/>
          </ScrollViewer>
        </Border>

        <Border Background="{DynamicResource SurfaceMutedBrush}"
                BorderBrush="{DynamicResource BorderBrush_}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12"
                Visibility="{Binding ElementName=OriginalTab, Path=IsChecked, Converter={StaticResource BooleanToVisibilityConverter}}">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <TextBox Text="{Binding OriginalText, Mode=OneWay}"
                     AutomationProperties.AutomationId="HistorySession_OriginalText"
                     IsReadOnly="True"
                     Background="Transparent"
                     BorderThickness="0"
                     TextWrapping="Wrap"
                     AcceptsReturn="True"
                     FontSize="13"
                     Foreground="{DynamicResource TextDefaultBrush}"/>
          </ScrollViewer>
        </Border>
      </Grid>
    </Grid>
  </Border>
</UserControl>

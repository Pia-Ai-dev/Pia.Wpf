<UserControl x:Class="Pia.Controls.Shared.PiaHelpHint"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:loc="clr-namespace:Pia.Localization"
             x:Name="HelpHintRoot"
             VerticalAlignment="Center"
             AutomationProperties.Name="{loc:Str Common_Help}"
             AutomationProperties.HelpText="{Binding Text, ElementName=HelpHintRoot}">
  <!-- The tooltip body is a popup outside this tree, so ElementName cannot reach it; its data
       context is wired in the constructor instead. -->
  <Border x:Name="HintTarget"
          Background="Transparent"
          Padding="4"
          Cursor="Help"
          ToolTipService.InitialShowDelay="300"
          ToolTipService.BetweenShowDelay="0"
          ToolTipService.ShowDuration="30000"
          ToolTipService.Placement="Bottom">
    <Border.Style>
      <Style TargetType="Border">
        <Style.Triggers>
          <DataTrigger Binding="{Binding Text, ElementName=HelpHintRoot}" Value="{x:Null}">
            <Setter Property="Visibility" Value="Collapsed"/>
          </DataTrigger>
        </Style.Triggers>
      </Style>
    </Border.Style>

    <Border.ToolTip>
      <ToolTip x:Name="HintBody" MaxWidth="360">
        <TextBlock Text="{Binding Text}" TextWrapping="Wrap"/>
      </ToolTip>
    </Border.ToolTip>

    <ui:SymbolIcon Symbol="QuestionCircle24"
                   FontSize="{Binding IconSize, ElementName=HelpHintRoot}">
      <ui:SymbolIcon.Style>
        <Style TargetType="ui:SymbolIcon">
          <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
          <Style.Triggers>
            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Border}}"
                         Value="True">
              <Setter Property="Foreground" Value="{DynamicResource PiaAccentBrush}"/>
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </ui:SymbolIcon.Style>
    </ui:SymbolIcon>
  </Border>
</UserControl>

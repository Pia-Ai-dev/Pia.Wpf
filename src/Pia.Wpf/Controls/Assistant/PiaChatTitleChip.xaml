<UserControl x:Class="Pia.Controls.Assistant.PiaChatTitleChip"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:loc="clr-namespace:Pia.Localization"
             xmlns:vm="clr-namespace:Pia.ViewModels"
             x:Name="ChipRoot"
             HorizontalAlignment="Left">
  <Grid>
    <ui:Button x:Name="ChipButton"
               Appearance="Secondary"
               CornerRadius="14"
               Padding="10,4"
               Cursor="Hand"
               Click="ChipButton_Click"
               ToolTip="{loc:Str AssistantChat_Chip_Tooltip}">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <ui:SymbolIcon Symbol="Chat24"
                       FontSize="14"
                       Margin="0,0,6,0"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        <TextBlock Text="{Binding CurrentTitle}"
                   FontSize="12"
                   TextTrimming="CharacterEllipsis"
                   MaxWidth="240"
                   VerticalAlignment="Center" />
        <ui:SymbolIcon Symbol="ChevronDown20"
                       FontSize="12"
                       Margin="6,0,0,0"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
      </StackPanel>
    </ui:Button>

    <Popup x:Name="FlyoutPopup"
           IsOpen="{Binding IsFlyoutOpen, Mode=TwoWay}"
           PlacementTarget="{Binding ElementName=ChipButton}"
           Placement="Bottom"
           StaysOpen="False"
           AllowsTransparency="True"
           PopupAnimation="Fade"
           Opened="FlyoutPopup_Opened">
      <Border Background="{DynamicResource ApplicationBackgroundBrush}"
              BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
              BorderThickness="1"
              CornerRadius="8"
              Padding="6"
              MinWidth="320"
              MaxWidth="380"
              MaxHeight="460">
        <Border.Effect>
          <DropShadowEffect BlurRadius="16" Opacity="0.22" ShadowDepth="4" />
        </Border.Effect>
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <ui:TextBox Grid.Row="0"
                      x:Name="SearchBox"
                      Margin="2"
                      PlaceholderText="{loc:Str AssistantChat_Flyout_SearchPlaceholder}"
                      PlaceholderEnabled="True"
                      Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" />

          <ui:Button Grid.Row="1"
                     HorizontalAlignment="Stretch"
                     HorizontalContentAlignment="Left"
                     Appearance="Transparent"
                     Margin="2,4,2,0"
                     Padding="8,6"
                     Cursor="Hand"
                     Command="{Binding NewChatCommand}">
            <StackPanel Orientation="Horizontal">
              <ui:SymbolIcon Symbol="Add24" FontSize="14" Margin="0,0,8,0" />
              <TextBlock Text="{loc:Str AssistantChat_Flyout_NewChat}"
                         VerticalAlignment="Center" />
            </StackPanel>
          </ui:Button>

          <ScrollViewer Grid.Row="2"
                        Margin="0,4,0,0"
                        VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
              <TextBlock Margin="8,12,8,8"
                         FontSize="12"
                         Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                         Visibility="{Binding Groups.Count, Converter={StaticResource ZeroToVisibilityConverter}}"
                         Text="{loc:Str AssistantChat_Flyout_Empty}" />

              <ItemsControl ItemsSource="{Binding Groups}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="{x:Type vm:ChatChipGroupViewModel}">
                    <StackPanel Margin="0,4,0,0">
                      <TextBlock Text="{Binding DisplayName}"
                                 FontSize="11"
                                 FontWeight="SemiBold"
                                 Margin="8,8,8,4"
                                 Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                      <ItemsControl ItemsSource="{Binding Items}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate DataType="{x:Type vm:ChatChipItemViewModel}">
                            <ui:Button HorizontalAlignment="Stretch"
                                       HorizontalContentAlignment="Left"
                                       Appearance="Transparent"
                                       Margin="0,1"
                                       Padding="8,6"
                                       Cursor="Hand"
                                       Command="{Binding DataContext.ResumeChatCommand, ElementName=ChipRoot}"
                                       CommandParameter="{Binding Id}">
                              <TextBlock Text="{Binding Title}"
                                         FontSize="13"
                                         TextTrimming="CharacterEllipsis" />
                            </ui:Button>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </ScrollViewer>

          <Border Grid.Row="3" Margin="0,6,0,0"
                  BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                  BorderThickness="0,1,0,0">
            <ui:Button HorizontalAlignment="Stretch"
                       HorizontalContentAlignment="Left"
                       Appearance="Transparent"
                       Margin="2,4,2,0"
                       Padding="8,6"
                       Cursor="Hand"
                       Command="{Binding ShowAllChatsCommand}">
              <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Symbol="History24" FontSize="14" Margin="0,0,8,0" />
                <TextBlock Text="{loc:Str AssistantChat_Flyout_ShowAll}"
                           VerticalAlignment="Center" />
              </StackPanel>
            </ui:Button>
          </Border>
        </Grid>
      </Border>
    </Popup>
  </Grid>
</UserControl>

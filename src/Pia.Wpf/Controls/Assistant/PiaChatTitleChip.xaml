<UserControl x:Class="Pia.Controls.Assistant.PiaChatTitleChip"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:loc="clr-namespace:Pia.Localization"
             xmlns:vm="clr-namespace:Pia.ViewModels"
             xmlns:vmm="clr-namespace:Pia.ViewModels.Models"
             xmlns:ah="clr-namespace:Pia.Controls.AssistantHistory"
             xmlns:behaviors="clr-namespace:Pia.Behaviors"
             x:Name="ChipRoot"
             HorizontalAlignment="Left">
  <Grid>
    <ui:Button x:Name="ChipButton"
               Appearance="Secondary"
               CornerRadius="14"
               Padding="10,4"
               Cursor="Hand"
               Click="ChipButton_Click"
               AutomationProperties.AutomationId="ChatChip_Toggle"
               ToolTip="{loc:Str AssistantChat_Chip_Tooltip}">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <ui:SymbolIcon Symbol="Chat24"
                       FontSize="14"
                       Margin="0,0,6,0"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        <TextBlock behaviors:EmojiTextBehavior.Text="{Binding CurrentTitle}"
                   FontSize="12"
                   TextTrimming="CharacterEllipsis"
                   MaxWidth="240"
                   VerticalAlignment="Center" />

        <!-- Live state badge — hidden when Idle. -->
        <Border CornerRadius="9"
                Padding="6,1"
                Margin="8,0,0,0"
                VerticalAlignment="Center"
                Background="{Binding ActiveState, Converter={StaticResource ChatStateToBrushBg}}"
                Visibility="{Binding ActiveState, Converter={StaticResource ChatStateIsBadgeVisibleConverter}}">
          <StackPanel Orientation="Horizontal">
            <!-- Running spins the glyph the converter already picks (ArrowSync) — the badge is the
                 only always-visible sign that a turn is in flight, and a static wheel read as settled. -->
            <ui:SymbolIcon Symbol="{Binding ActiveState, Converter={StaticResource ChatStateToGlyphConverter}}"
                           FontSize="11"
                           VerticalAlignment="Center"
                           RenderTransformOrigin="0.5,0.5"
                           Foreground="{Binding ActiveState, Converter={StaticResource ChatStateToBrushFg}}">
              <ui:SymbolIcon.RenderTransform>
                <RotateTransform Angle="0" />
              </ui:SymbolIcon.RenderTransform>
              <ui:SymbolIcon.Style>
                <Style TargetType="ui:SymbolIcon">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding ActiveState}" Value="Running">
                      <DataTrigger.EnterActions>
                        <BeginStoryboard x:Name="ChipStateSpin" Storyboard="{StaticResource PiaSpinForever}" />
                      </DataTrigger.EnterActions>
                      <DataTrigger.ExitActions>
                        <StopStoryboard BeginStoryboardName="ChipStateSpin" />
                      </DataTrigger.ExitActions>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </ui:SymbolIcon.Style>
            </ui:SymbolIcon>
            <TextBlock Text="{Binding ActiveState, Converter={StaticResource ChatStateToLabelConverter}}"
                       FontSize="10"
                       FontWeight="SemiBold"
                       Margin="4,0,0,0"
                       VerticalAlignment="Center"
                       Foreground="{Binding ActiveState, Converter={StaticResource ChatStateToBrushFg}}" />
          </StackPanel>
        </Border>

        <ui:SymbolIcon Symbol="ChevronDown20"
                       FontSize="12"
                       Margin="6,0,0,0"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
      </StackPanel>
    </ui:Button>

    <Popup x:Name="FlyoutPopup"
           IsOpen="{Binding IsFlyoutOpen, Mode=TwoWay}"
           PlacementTarget="{Binding ElementName=ChipButton}"
           Placement="Bottom"
           StaysOpen="False"
           AllowsTransparency="True"
           PopupAnimation="Fade"
           Opened="FlyoutPopup_Opened"
           Closed="FlyoutPopup_Closed">
      <Border Background="{DynamicResource SurfaceBrush}"
              BorderBrush="{DynamicResource BorderBrush_}"
              BorderThickness="1"
              CornerRadius="{StaticResource LargeRadius}"
              Padding="4"
              MinWidth="360"
              MaxWidth="420"
              MaxHeight="460">
        <Border.Effect>
          <DropShadowEffect Color="#0F1729" BlurRadius="18" Opacity="0.16" ShadowDepth="4" />
        </Border.Effect>
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <ui:TextBox Grid.Row="0"
                      x:Name="SearchBox"
                      Margin="2"
                      Padding="8,4"
                      Icon="{ui:SymbolIcon Symbol=Search24}"
                      PlaceholderText="{loc:Str AssistantChat_Flyout_SearchPlaceholder}"
                      PlaceholderEnabled="True"
                      AutomationProperties.AutomationId="ChatChip_Search"
                      Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" />

          <!-- Split pill: [ ⌂ \  ▾ | + New Chat ]. One bordered container with a folder
               selector on the left (drill-down working-dir picker) and the primary
               "+ New Chat" on the right, separated by a divider. The New-Chat region reuses
               the accent-soft→accent hover vocabulary from PiaSegmentedButton's selected state. -->
          <Border Grid.Row="1"
                  Margin="2,4,2,0"
                  CornerRadius="{StaticResource SmallRadius}"
                  BorderBrush="{DynamicResource BorderBrush_}"
                  BorderThickness="1"
                  Background="Transparent">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>

              <!-- Folder selector: shows the active chat's working dir; click opens the picker. -->
              <Button x:Name="WorkingDirButton"
                      Grid.Column="0"
                      Style="{StaticResource UnstyledButton}"
                      Cursor="Hand"
                      Padding="10,6"
                      HorizontalContentAlignment="Left"
                      Click="WorkingDirButton_Click"
                      AutomationProperties.AutomationId="ChatChip_WorkingDir"
                      ToolTip="{loc:Str AssistantChat_WorkingDir_Tooltip}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <ui:SymbolIcon Symbol="Home24"
                                 FontSize="15"
                                 Margin="0,0,6,0"
                                 VerticalAlignment="Center"
                                 Foreground="{DynamicResource PiaAccentBrush}"
                                 Visibility="{Binding IsWorkingDirectoryRoot, Converter={StaticResource BooleanToVisibilityConverter}}" />
                  <ui:SymbolIcon Symbol="Folder24"
                                 FontSize="15"
                                 Margin="0,0,6,0"
                                 VerticalAlignment="Center"
                                 Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                 Visibility="{Binding IsWorkingDirectoryRoot, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                  <!-- Full path in the tooltip: CharacterEllipsis trims the trailing leaf
                       folder (the pinned dir), so surface the whole path on hover. -->
                  <TextBlock Text="{Binding WorkingDirectoryDisplay}"
                             FontSize="12"
                             TextTrimming="CharacterEllipsis"
                             MaxWidth="220"
                             VerticalAlignment="Center"
                             ToolTip="{Binding WorkingDirectoryDisplay}"
                             Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                  <ui:SymbolIcon Symbol="ChevronDown20"
                                 FontSize="11"
                                 Margin="6,0,0,0"
                                 VerticalAlignment="Center"
                                 Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
              </Button>

              <!-- Divider -->
              <Border Grid.Column="1"
                      Width="1"
                      Margin="0,6"
                      Background="{DynamicResource BorderBrush_}" />

              <!-- + New Chat -->
              <Button Grid.Column="2"
                      Cursor="Hand"
                      AutomationProperties.AutomationId="ChatChip_NewChat"
                      Command="{Binding NewChatCommand}">
                <Button.Template>
                  <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            CornerRadius="{StaticResource SmallRadius}"
                            Padding="10,6"
                            Background="{DynamicResource PiaAccentSoftBrush}">
                      <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon x:Name="Glyph"
                                       Symbol="Add24"
                                       FontSize="16"
                                       Margin="0,0,8,0"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource PiaAccentBrush}" />
                        <TextBlock x:Name="Label"
                                   Text="{loc:Str AssistantChat_Flyout_NewChat}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource PiaAccentBrush}" />
                      </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PiaAccentBrush}" />
                        <Setter TargetName="Glyph" Property="Foreground" Value="White" />
                        <Setter TargetName="Label" Property="Foreground" Value="White" />
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Button.Template>
              </Button>
            </Grid>
          </Border>

          <!-- Drill-down working-directory picker: breadcrumb header (each crumb jumps up)
               + immediate child folders (entering a row re-points the active chat). Matches
               the flyout styling (Surface, BorderBrush_, LargeRadius, shadow). -->
          <Popup x:Name="WorkingDirPopup"
                 Grid.Row="1"
                 IsOpen="{Binding IsPickerOpen, Mode=TwoWay}"
                 PlacementTarget="{Binding ElementName=WorkingDirButton}"
                 Placement="Bottom"
                 StaysOpen="False"
                 AllowsTransparency="True"
                 PopupAnimation="Fade"
                 Opened="WorkingDirPopup_Opened"
                 Closed="WorkingDirPopup_Closed">
            <Border Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush_}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource LargeRadius}"
                    Padding="6"
                    MinWidth="320"
                    MaxWidth="380"
                    MaxHeight="360"
                    DataContext="{Binding WorkingDirectoryPicker}">
              <Border.Effect>
                <DropShadowEffect Color="#0F1729" BlurRadius="18" Opacity="0.16" ShadowDepth="4" />
              </Border.Effect>
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Breadcrumb header + New-folder trigger (creates a subfolder in the current folder). -->
                <Grid Grid.Row="0" Margin="4,2,4,6">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                <ItemsControl Grid.Column="0"
                              ItemsSource="{Binding Crumbs}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vmm:WorkingDirectoryCrumb}">
                      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource UnstyledButton}"
                                Cursor="Hand"
                                Padding="4,2"
                                Command="{Binding DataContext.JumpToCrumbCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding Index}"
                                AutomationProperties.AutomationId="{Binding Index, StringFormat='ChatChip_Crumb_{0}'}">
                          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="Home24"
                                           FontSize="13"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource PiaAccentBrush}"
                                           Visibility="{Binding IsRoot, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <TextBlock Text="{Binding Name}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                       Visibility="{Binding IsRoot, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                          </StackPanel>
                        </Button>
                        <ui:SymbolIcon Symbol="ChevronRight20"
                                       FontSize="11"
                                       Margin="2,0"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextMutedBrush}" />
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                  <Button Grid.Column="1"
                          x:Name="NewFolderButton"
                          Style="{StaticResource UnstyledButton}"
                          Cursor="Hand"
                          Padding="4,2"
                          VerticalAlignment="Center"
                          Click="NewFolderButton_Click"
                          AutomationProperties.AutomationId="ChatChip_AddFolder"
                          ToolTip="{loc:Str AssistantChat_WorkingDir_NewFolder_Tooltip}">
                    <ui:SymbolIcon Symbol="FolderAdd24"
                                   FontSize="15"
                                   Foreground="{DynamicResource PiaAccentBrush}" />
                  </Button>
                </Grid>

                <!-- Inline new-folder input row — shown while creating; creates a subfolder in the
                     current picker folder. Enter/Checkmark confirm, Escape/Dismiss cancel. Focus is
                     moved back onto the header button on close (see code-behind) so collapsing the
                     row can't dismiss the StaysOpen=False popup. -->
                <Border Grid.Row="1"
                        Margin="4,0,4,6"
                        Visibility="{Binding IsCreatingFolder, Converter={StaticResource BooleanToVisibilityConverter}}">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:SymbolIcon Grid.Column="0"
                                   Symbol="Folder24"
                                   FontSize="15"
                                   Margin="6,0,8,0"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <ui:TextBox Grid.Column="1"
                                x:Name="NewFolderTextBox"
                                Text="{Binding NewFolderName, UpdateSourceTrigger=PropertyChanged}"
                                PlaceholderText="{loc:Str AssistantChat_WorkingDir_NewFolder_Placeholder}"
                                PlaceholderEnabled="True"
                                AutomationProperties.AutomationId="ChatChip_NewFolderName"
                                PreviewKeyDown="NewFolderTextBox_PreviewKeyDown" />
                    <Button Grid.Column="2"
                            Style="{StaticResource UnstyledButton}"
                            Cursor="Hand"
                            Padding="6,2"
                            Margin="4,0,0,0"
                            VerticalAlignment="Center"
                            Command="{Binding ConfirmCreateFolderCommand}"
                            Click="ConfirmCreateFolderButton_Click"
                            AutomationProperties.AutomationId="ChatChip_NewFolderConfirm"
                            ToolTip="{loc:Str AssistantChat_WorkingDir_NewFolder_Confirm}">
                      <ui:SymbolIcon Symbol="Checkmark24"
                                     FontSize="15"
                                     Foreground="{DynamicResource PiaAccentBrush}" />
                    </Button>
                    <Button Grid.Column="3"
                            Style="{StaticResource UnstyledButton}"
                            Cursor="Hand"
                            Padding="6,2"
                            VerticalAlignment="Center"
                            Command="{Binding CancelCreateFolderCommand}"
                            Click="CancelCreateFolderButton_Click"
                            AutomationProperties.AutomationId="ChatChip_NewFolderCancel"
                            ToolTip="{loc:Str AssistantChat_WorkingDir_NewFolder_Cancel}">
                      <ui:SymbolIcon Symbol="Dismiss24"
                                     FontSize="14"
                                     Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </Button>
                  </Grid>
                </Border>

                <!-- Immediate child folders + empty state. ListBox gives arrow-key navigation
                     and a selection highlight; the popup's Opened handler moves focus here so
                     Up/Down stay in the picker instead of falling through to the chat list.
                     Activation (Enter/Space/click), Backspace (ascend) and Escape are handled
                     in code-behind. Virtualization off keeps container lookup synchronous. -->
                <Grid Grid.Row="2">
                  <TextBlock Margin="10,8"
                             FontSize="12"
                             Foreground="{DynamicResource TextMutedBrush}"
                             Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}"
                             Text="{loc:Str AssistantChat_WorkingDir_PickerEmpty}" />

                  <!-- Entries are bare folder-name strings, so a per-row id would have to key on the
                       name itself; scope a name match inside this list instead. -->
                  <ListBox x:Name="WorkingDirEntries"
                           AutomationProperties.AutomationId="ChatChip_FolderEntries"
                           ItemsSource="{Binding Entries}"
                           Background="Transparent"
                           BorderThickness="0"
                           Padding="0"
                           VirtualizingPanel.IsVirtualizing="False"
                           ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                           ScrollViewer.VerticalScrollBarVisibility="Auto"
                           PreviewKeyDown="WorkingDirEntries_PreviewKeyDown"
                           PreviewMouseLeftButtonUp="WorkingDirEntries_PreviewMouseLeftButtonUp">
                    <ListBox.ItemContainerStyle>
                      <Style TargetType="ListBoxItem">
                        <Setter Property="Margin" Value="0,1" />
                        <Setter Property="Padding" Value="10,7" />
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Template">
                          <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                              <Border x:Name="Bd"
                                      CornerRadius="9"
                                      Padding="{TemplateBinding Padding}"
                                      Background="Transparent">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="Center" />
                              </Border>
                              <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                  <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceMutedBrush}" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                  <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceMutedBrush}" />
                                </Trigger>
                              </ControlTemplate.Triggers>
                            </ControlTemplate>
                          </Setter.Value>
                        </Setter>
                      </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                      <DataTemplate>
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <ui:SymbolIcon Grid.Column="0"
                                         Symbol="Folder24"
                                         FontSize="15"
                                         Margin="0,0,10,0"
                                         VerticalAlignment="Center"
                                         Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                          <TextBlock Grid.Column="1"
                                     Text="{Binding}"
                                     FontSize="13"
                                     TextTrimming="CharacterEllipsis"
                                     VerticalAlignment="Center"
                                     Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                          <ui:SymbolIcon Grid.Column="2"
                                         Symbol="ChevronRight20"
                                         FontSize="12"
                                         VerticalAlignment="Center"
                                         Foreground="{DynamicResource TextMutedBrush}" />
                        </Grid>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </Grid>
              </Grid>
            </Border>
          </Popup>

          <ScrollViewer Grid.Row="2"
                        Margin="0,2,0,0"
                        VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
              <TextBlock Margin="10,8"
                         FontSize="12"
                         Foreground="{DynamicResource TextMutedBrush}"
                         Visibility="{Binding Groups.Count, Converter={StaticResource ZeroToVisibilityConverter}}"
                         Text="{loc:Str AssistantChat_Flyout_Empty}" />

              <ItemsControl ItemsSource="{Binding Groups}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="{x:Type vmm:ChatChipGroupViewModel}">
                    <StackPanel>
                      <TextBlock Text="{Binding DisplayName}"
                                 FontSize="11"
                                 FontWeight="SemiBold"
                                 Margin="10,6,8,1"
                                 Foreground="{DynamicResource TextMutedBrush}" />
                      <ItemsControl ItemsSource="{Binding Items}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate DataType="{x:Type vmm:ChatChipItemViewModel}">
                            <Button Style="{StaticResource UnstyledButton}"
                                    Padding="10,4"
                                    Command="{Binding DataContext.ResumeChatCommand, ElementName=ChipRoot}"
                                    CommandParameter="{Binding Id}"
                                    AutomationProperties.AutomationId="{Binding Id, StringFormat='ChatChip_Resume_{0}'}">
                              <!-- time | title | state badge | date; badge State is a
                                   snapshot read once at flyout build. Hover reveals a quick-delete
                                   trash (replaces the date) wired to the chip's delete command. -->
                              <ah:PiaAssistantChatRowContent
                                  DeleteCommand="{Binding DataContext.DeleteChatCommand, ElementName=ChipRoot}"
                                  RenameCommand="{Binding DataContext.RenameChatCommand, ElementName=ChipRoot}"
                                  EditableTitle="{Binding Title}"/>
                            </Button>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </ScrollViewer>

          <Border Grid.Row="3" Margin="0,4,0,0"
                  BorderBrush="{DynamicResource BorderBrush_}"
                  BorderThickness="0,1,0,0">
            <Button Style="{StaticResource UnstyledButton}"
                    Margin="0,3,0,0"
                    Padding="10,5"
                    AutomationProperties.AutomationId="ChatChip_ShowAllChats"
                    Command="{Binding ShowAllChatsCommand}">
              <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Symbol="History24"
                               FontSize="14"
                               Margin="0,0,10,0"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextMutedBrush}" />
                <TextBlock Text="{loc:Str AssistantChat_Flyout_ShowAll}"
                           FontSize="13"
                           Foreground="{DynamicResource TextMutedBrush}"
                           VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </Border>
        </Grid>
      </Border>
    </Popup>
  </Grid>
</UserControl>

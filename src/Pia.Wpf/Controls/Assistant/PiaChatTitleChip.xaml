<UserControl x:Class="Pia.Controls.Assistant.PiaChatTitleChip"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:loc="clr-namespace:Pia.Localization"
             xmlns:vm="clr-namespace:Pia.ViewModels"
             xmlns:vmm="clr-namespace:Pia.ViewModels.Models"
             xmlns:ah="clr-namespace:Pia.Controls.AssistantHistory"
             xmlns:behaviors="clr-namespace:Pia.Behaviors"
             x:Name="ChipRoot"
             HorizontalAlignment="Left">
  <Grid>
    <ui:Button x:Name="ChipButton"
               Appearance="Secondary"
               CornerRadius="14"
               Padding="10,4"
               Cursor="Hand"
               Click="ChipButton_Click"
               ToolTip="{loc:Str AssistantChat_Chip_Tooltip}">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <ui:SymbolIcon Symbol="Chat24"
                       FontSize="14"
                       Margin="0,0,6,0"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        <TextBlock behaviors:EmojiTextBehavior.Text="{Binding CurrentTitle}"
                   FontSize="12"
                   TextTrimming="CharacterEllipsis"
                   MaxWidth="240"
                   VerticalAlignment="Center" />

        <!-- Live state badge — hidden when Idle. -->
        <Border CornerRadius="9"
                Padding="6,1"
                Margin="8,0,0,0"
                VerticalAlignment="Center"
                Background="{Binding ActiveState, Converter={StaticResource ChatStateToBrushBg}}"
                Visibility="{Binding ActiveState, Converter={StaticResource ChatStateIsBadgeVisibleConverter}}">
          <StackPanel Orientation="Horizontal">
            <ui:SymbolIcon Symbol="{Binding ActiveState, Converter={StaticResource ChatStateToGlyphConverter}}"
                           FontSize="11"
                           VerticalAlignment="Center"
                           Foreground="{Binding ActiveState, Converter={StaticResource ChatStateToBrushFg}}" />
            <TextBlock Text="{Binding ActiveState, Converter={StaticResource ChatStateToLabelConverter}}"
                       FontSize="10"
                       FontWeight="SemiBold"
                       Margin="4,0,0,0"
                       VerticalAlignment="Center"
                       Foreground="{Binding ActiveState, Converter={StaticResource ChatStateToBrushFg}}" />
          </StackPanel>
        </Border>

        <ui:SymbolIcon Symbol="ChevronDown20"
                       FontSize="12"
                       Margin="6,0,0,0"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
      </StackPanel>
    </ui:Button>

    <Popup x:Name="FlyoutPopup"
           IsOpen="{Binding IsFlyoutOpen, Mode=TwoWay}"
           PlacementTarget="{Binding ElementName=ChipButton}"
           Placement="Bottom"
           StaysOpen="False"
           AllowsTransparency="True"
           PopupAnimation="Fade"
           Opened="FlyoutPopup_Opened">
      <Border Background="{DynamicResource SurfaceBrush}"
              BorderBrush="{DynamicResource BorderBrush_}"
              BorderThickness="1"
              CornerRadius="{StaticResource LargeRadius}"
              Padding="6"
              MinWidth="360"
              MaxWidth="420"
              MaxHeight="460">
        <Border.Effect>
          <DropShadowEffect Color="#0F1729" BlurRadius="18" Opacity="0.16" ShadowDepth="4" />
        </Border.Effect>
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <ui:TextBox Grid.Row="0"
                      x:Name="SearchBox"
                      Margin="2"
                      Icon="{ui:SymbolIcon Symbol=Search24}"
                      PlaceholderText="{loc:Str AssistantChat_Flyout_SearchPlaceholder}"
                      PlaceholderEnabled="True"
                      Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" />

          <!-- New chat: the primary action, lifted out of the row list with an
               accent-soft fill that flips to solid accent on hover (same vocabulary
               as PiaSegmentedButton's selected state). -->
          <Button Grid.Row="1"
                  Margin="2,6,2,2"
                  Cursor="Hand"
                  HorizontalContentAlignment="Stretch"
                  Command="{Binding NewChatCommand}">
            <Button.Template>
              <ControlTemplate TargetType="Button">
                <Border x:Name="Bd"
                        CornerRadius="{StaticResource SmallRadius}"
                        Padding="10,8"
                        Background="{DynamicResource PiaAccentSoftBrush}">
                  <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon x:Name="Glyph"
                                   Symbol="Add24"
                                   FontSize="16"
                                   Margin="0,0,10,0"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource PiaAccentBrush}" />
                    <TextBlock x:Name="Label"
                               Text="{loc:Str AssistantChat_Flyout_NewChat}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource PiaAccentBrush}" />
                  </StackPanel>
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PiaAccentBrush}" />
                    <Setter TargetName="Glyph" Property="Foreground" Value="White" />
                    <Setter TargetName="Label" Property="Foreground" Value="White" />
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Button.Template>
          </Button>

          <ScrollViewer Grid.Row="2"
                        Margin="0,4,0,0"
                        VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
              <TextBlock Margin="10,8"
                         FontSize="12"
                         Foreground="{DynamicResource TextMutedBrush}"
                         Visibility="{Binding Groups.Count, Converter={StaticResource ZeroToVisibilityConverter}}"
                         Text="{loc:Str AssistantChat_Flyout_Empty}" />

              <ItemsControl ItemsSource="{Binding Groups}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="{x:Type vmm:ChatChipGroupViewModel}">
                    <StackPanel Margin="0,2,0,0">
                      <TextBlock Text="{Binding DisplayName}"
                                 FontSize="11"
                                 FontWeight="SemiBold"
                                 Margin="10,10,8,2"
                                 Foreground="{DynamicResource TextMutedBrush}" />
                      <ItemsControl ItemsSource="{Binding Items}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate DataType="{x:Type vmm:ChatChipItemViewModel}">
                            <Button Style="{StaticResource UnstyledButton}"
                                    Margin="0,1"
                                    Padding="10,7"
                                    Command="{Binding DataContext.ResumeChatCommand, ElementName=ChipRoot}"
                                    CommandParameter="{Binding Id}">
                              <!-- time | title | state badge | date; badge State is a
                                   snapshot read once at flyout build. -->
                              <ah:PiaAssistantChatRowContent/>
                            </Button>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </ScrollViewer>

          <Border Grid.Row="3" Margin="0,6,0,0"
                  BorderBrush="{DynamicResource BorderBrush_}"
                  BorderThickness="0,1,0,0">
            <Button Style="{StaticResource UnstyledButton}"
                    Margin="0,6,0,0"
                    Padding="10,7"
                    Command="{Binding ShowAllChatsCommand}">
              <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Symbol="History24"
                               FontSize="14"
                               Margin="0,0,10,0"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextMutedBrush}" />
                <TextBlock Text="{loc:Str AssistantChat_Flyout_ShowAll}"
                           FontSize="13"
                           Foreground="{DynamicResource TextMutedBrush}"
                           VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </Border>
        </Grid>
      </Border>
    </Popup>
  </Grid>
</UserControl>

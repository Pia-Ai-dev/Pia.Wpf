<UserControl x:Class="Pia.Controls.Assistant.RunEarlierAttempts"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:controls="clr-namespace:Pia.Controls"
             Visibility="{Binding HasEarlierAttempts, Converter={StaticResource BooleanToVisibilityConverter}}">
  <!-- DataContext: a RunProgressViewModel. Replies whose step a re-plan replaced, folded by default. -->
  <StackPanel>
    <Button Style="{StaticResource UnstyledButton}" Height="24" HorizontalContentAlignment="Left"
            Command="{Binding ToggleEarlierAttemptsCommand}"
            AutomationProperties.AutomationId="{Binding RunId, StringFormat='RunReplies_EarlierAttempts_{0}'}">
      <StackPanel Orientation="Horizontal">
        <ui:SymbolIcon FontSize="12" Width="16" Margin="0,0,9,0" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextSubtleBrush}">
          <ui:SymbolIcon.Style>
            <Style TargetType="ui:SymbolIcon">
              <Setter Property="Symbol" Value="ChevronRight24" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsEarlierAttemptsExpanded}" Value="True">
                  <Setter Property="Symbol" Value="ChevronDown24" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </ui:SymbolIcon.Style>
        </ui:SymbolIcon>
        <TextBlock Text="{Binding EarlierAttemptsLabel}" VerticalAlignment="Center" FontSize="11.5"
                   Foreground="{DynamicResource TextMutedBrush}" />
      </StackPanel>
    </Button>
    <ItemsControl ItemsSource="{Binding EarlierAttemptReplies}" Margin="25,0,0,6"
                  Visibility="{Binding IsEarlierAttemptsExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Border Margin="0,2,0,0" Padding="10,6" CornerRadius="6" Opacity="0.8"
                  Background="{DynamicResource SurfaceMutedBrush}">
            <controls:MarkdownMessageControl MarkdownText="{Binding Content}" AutomationIdSuffix="{Binding Id}" />
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </StackPanel>
</UserControl>

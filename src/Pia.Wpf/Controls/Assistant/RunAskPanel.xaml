<UserControl x:Class="Pia.Controls.Assistant.RunAskPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:loc="clr-namespace:Pia.Localization">
  <!-- A chat job's questions on its block. Tool arguments and the question are user content: bound, never logged. -->
  <StackPanel>
    <Border Margin="14,12,14,4" Padding="10,9" CornerRadius="7" BorderThickness="1"
            Background="{DynamicResource PiaAccentSoftBrush}"
            BorderBrush="{DynamicResource AccentBorderBrush}"
            Visibility="{Binding ShowToolAsk, Converter={StaticResource BooleanToVisibilityConverter}}">
      <StackPanel>
        <TextBlock FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"
                   Foreground="{DynamicResource PiaAccentBrush}"
                   Text="{Binding AskToolHeading}" />
        <TextBlock Text="{Binding AskToolArguments}" Margin="0,6,0,0" FontSize="11.5" TextWrapping="Wrap"
                   FontFamily="Consolas" Foreground="{DynamicResource TextSubtleBrush}" />
        <WrapPanel Margin="0,8,0,0">
          <ui:Button Content="{loc:Str RunAsk_AllowOnce}" Appearance="Primary" Padding="13,6" Margin="0,0,6,4"
                     Command="{Binding AllowOnceAskCommand}"
                     AutomationProperties.AutomationId="{Binding RunId, StringFormat='RunAsk_AllowOnce_{0}'}" />
          <ui:Button Content="{loc:Str RunAsk_AllowForSession}" Appearance="Secondary" Padding="13,6" Margin="0,0,6,4"
                     Command="{Binding AllowForSessionAskCommand}"
                     Visibility="{Binding OffersSessionAsk, Converter={StaticResource BooleanToVisibilityConverter}}"
                     AutomationProperties.AutomationId="{Binding RunId, StringFormat='RunAsk_AllowForSession_{0}'}" />
          <ui:Button Content="{loc:Str RunAsk_AlwaysAllow}" Appearance="Secondary" Padding="13,6" Margin="0,0,6,4"
                     Command="{Binding AlwaysAllowAskCommand}"
                     AutomationProperties.AutomationId="{Binding RunId, StringFormat='RunAsk_AlwaysAllow_{0}'}" />
          <ui:Button Content="{loc:Str RunAsk_Deny}" Appearance="Secondary" Padding="13,6" Margin="0,0,6,4"
                     Command="{Binding DenyAskCommand}"
                     AutomationProperties.AutomationId="{Binding RunId, StringFormat='RunAsk_Deny_{0}'}" />
        </WrapPanel>
      </StackPanel>
    </Border>

    <Border Margin="14,12,14,4" Padding="10,9" CornerRadius="7" BorderThickness="1"
            Background="{DynamicResource PiaAccentSoftBrush}"
            BorderBrush="{DynamicResource AccentBorderBrush}"
            Visibility="{Binding ShowUserInputAsk, Converter={StaticResource BooleanToVisibilityConverter}}">
      <StackPanel>
        <TextBlock Text="{loc:Str RunAsk_Question_Label}" FontSize="11" FontWeight="SemiBold"
                   Foreground="{DynamicResource PiaAccentBrush}" />
        <TextBlock Text="{Binding UserInputQuestion}" Margin="0,4,0,0" FontSize="12.5" TextWrapping="Wrap" />
        <ui:TextBox Text="{Binding UserInputAnswer, UpdateSourceTrigger=PropertyChanged}" Margin="0,8,0,0"
                    PlaceholderText="{loc:Str RunAsk_Answer_Placeholder}" PlaceholderEnabled="True"
                    AutomationProperties.AutomationId="{Binding RunId, StringFormat='RunAsk_Answer_{0}'}"
                    MinHeight="30" FontSize="12" TextWrapping="Wrap" AcceptsReturn="True" />
        <ui:Button Content="{loc:Str RunAsk_SendAnswer}" Appearance="Primary" Padding="13,6" Margin="0,8,0,0"
                   HorizontalAlignment="Left" Command="{Binding AnswerUserInputCommand}"
                   AutomationProperties.AutomationId="{Binding RunId, StringFormat='RunAsk_SendAnswer_{0}'}" />
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>

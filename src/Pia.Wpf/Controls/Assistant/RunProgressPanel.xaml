<UserControl x:Class="Pia.Controls.Assistant.RunProgressPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:loc="clr-namespace:Pia.Localization"
             xmlns:chat="clr-namespace:Pia.Controls.Chat"
             x:Name="Root">
  <!-- Read-only run-progress panel (§15.1/15.2). The dense step list + ledger strip is the one
       signature element; everything else stays quiet. Derives every brush from theme tokens. -->
  <Border Style="{StaticResource PiaCardStyle}" Margin="0,0,0,8">
    <StackPanel>
      <!-- Header: state chip + live ledger strip -->
      <Grid Margin="0,0,0,6">
        <StackPanel Orientation="Horizontal">
          <ui:ProgressRing Width="16" Height="16" IsIndeterminate="True" Margin="0,0,8,0"
                           VerticalAlignment="Center"
                           Visibility="{Binding State, Converter={StaticResource RunStateToSpinnerVisibilityConverter}}" />
          <TextBlock Text="{Binding State, Converter={StaticResource RunStateToLabelConverter}}"
                     FontWeight="SemiBold"
                     VerticalAlignment="Center"
                     Foreground="{Binding State, Converter={StaticResource RunStateToBrushConverter}}" />
          <!-- Truncation chip: the VM resolves WHY (unverified vs. a pre-pause budget stop) from the
               persisted reason — never a hardcoded "stopped at budget". Muted, never the danger brush (R5). -->
          <TextBlock Text="{Binding TruncationNote}" Margin="8,0,0,0"
                     VerticalAlignment="Center"
                     Foreground="{DynamicResource TextMutedBrush}"
                     Visibility="{Binding IsTruncated, Converter={StaticResource BooleanToVisibilityConverter}}" />
        </StackPanel>
        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <!-- Batch 08 D1: user pause. Visibility hides it off the pausable states; CanExecute also disables it
               while a request is in flight (the CAS in the loop is the hard guard, exactly as for Continue). -->
          <ui:Button Content="{Binding PauseLabel}" Command="{Binding PauseCommand}"
                     Appearance="Secondary" Padding="10,3" Margin="0,0,8,0" FontSize="12"
                     Visibility="{Binding CanPause, Converter={StaticResource BooleanToVisibilityConverter}}" />
          <!-- Budget-pause / user-pause Continue: the one sanctioned Phase-2 mutation on this read-only panel,
               widened by Batch 08 D1 item 8 to the Paused state too. CanContinue hides it off both states;
               CanExecute also disables it (IsResuming) so a double-click can't launch two resumes (the CAS is
               the hard guard). CanPause and CanContinue are mutually exclusive by construction, so at most one
               of these two buttons is ever visible. -->
          <ui:Button Content="{loc:Str Run_Action_Continue}" Command="{Binding ContinueCommand}"
                     Appearance="Primary" Padding="10,3" Margin="0,0,8,0" FontSize="12"
                     Visibility="{Binding CanContinue, Converter={StaticResource BooleanToVisibilityConverter}}" />
          <!-- The deny beside Continue, only on a tool-approval park: the one pause whose question has a
               "no". Declining resumes the run with the tool recorded as denied; the re-run step adapts. -->
          <ui:Button Content="{loc:Str Run_Action_Deny}" Command="{Binding DeclineToolCommand}"
                     Appearance="Secondary" Padding="10,3" Margin="0,0,8,0" FontSize="12"
                     Visibility="{Binding CanDeclineTool, Converter={StaticResource BooleanToVisibilityConverter}}" />
          <!-- Batch 06 / plan D3: a failed or cancelled run's work is still in its workspace, so the panel
               offers to publish it rather than promoting behind the user's back. A clean run never shows
               this — it promoted before it was marked complete. Same visibility/CanExecute shape as
               Continue: CanPublish hides it, and it disables itself while a publish is in flight. -->
          <ui:Button Content="{loc:Str Run_Action_Publish}" Command="{Binding PublishCommand}"
                     Appearance="Secondary" Padding="10,3" Margin="0,0,8,0" FontSize="12"
                     Visibility="{Binding CanPublish, Converter={StaticResource BooleanToVisibilityConverter}}" />
          <TextBlock Foreground="{DynamicResource TextMutedBrush}" FontSize="12"
                     VerticalAlignment="Center" Text="{Binding LedgerSummary}" />
        </StackPanel>
      </Grid>

      <!-- Current-activity line (D1): the active step / a planning note. Quiet by design — the dense
           step list + ledger is the one signature element. Live per-tool status stays in the transcript. -->
      <TextBlock Text="{Binding CurrentActivity}" Margin="0,0,0,6"
                 TextTrimming="CharacterEllipsis" FontSize="12" FontStyle="Italic"
                 Foreground="{DynamicResource TextSubtleBrush}"
                 Visibility="{Binding HasCurrentActivity, Converter={StaticResource BooleanToVisibilityConverter}}" />

      <!-- Batch 06: three muted note lines, all mutually quiet on an ordinary run.
           (1) the standing offer, while a settled run's files are still in its workspace;
           (2) the result of a publish the user asked for;
           (3) plan D5b — in worktree mode NOTHING is copied and the branch IS the deliverable, so the panel
               must say where the output is or the honest user question is "where is my file?". -->
      <TextBlock Text="{loc:Str Run_Publish_Pending}" Margin="0,0,0,6"
                 TextWrapping="Wrap" FontSize="12"
                 Foreground="{DynamicResource TextMutedBrush}"
                 Visibility="{Binding CanPublish, Converter={StaticResource BooleanToVisibilityConverter}}" />
      <TextBlock Text="{Binding PublishNote}" Margin="0,0,0,6"
                 TextWrapping="Wrap" FontSize="12"
                 Foreground="{DynamicResource TextMutedBrush}"
                 Visibility="{Binding PublishNote, Converter={StaticResource NullToVisibilityConverter}}" />
      <TextBlock Text="{Binding OutputBranchNote}" Margin="0,0,0,6"
                 TextWrapping="Wrap" FontSize="12"
                 Foreground="{DynamicResource TextMutedBrush}"
                 Visibility="{Binding HasOutputBranch, Converter={StaticResource BooleanToVisibilityConverter}}" />

      <!-- Batch 08 D3: "the UI can require a pause first" — stated as a note, never a silently-frozen plan.
           Batch 08 F12: gated on ShowPauseFirstNote (== CanPause), NOT on CanMutatePlan inverted. The inverse
           form rendered in EVERY state except Paused: a run parked at its budget showed "Pause the run to
           change its plan." with no Pause button to press, and a Completed/Failed run kept nagging forever.
           An instruction is only honest while the button it names is on screen. -->
      <TextBlock Text="{loc:Str Run_Plan_Note_PauseFirst}" Margin="0,0,0,6"
                 TextWrapping="Wrap" FontSize="12"
                 Foreground="{DynamicResource TextMutedBrush}"
                 Visibility="{Binding ShowPauseFirstNote, Converter={StaticResource BooleanToVisibilityConverter}}" />
      <!-- The muted result of the last plan mutation — the PublishNote shape, same NullToVisibilityConverter,
           cleared by the VM on the next successful mutation. -->
      <TextBlock Text="{Binding PlanMutationNote}" Margin="0,0,0,6"
                 TextWrapping="Wrap" FontSize="12"
                 Foreground="{DynamicResource TextMutedBrush}"
                 Visibility="{Binding PlanMutationNote, Converter={StaticResource NullToVisibilityConverter}}" />

      <!-- Batch 08 F6: a pause the service REFUSED. Same muted shape again; separate from PlanMutationNote
           because that one is wiped by every projection that is not Paused, which is every projection a
           refused pause can possibly be followed by. -->
      <TextBlock Text="{Binding PauseNote}" Margin="0,0,0,6"
                 TextWrapping="Wrap" FontSize="12"
                 Foreground="{DynamicResource TextMutedBrush}"
                 Visibility="{Binding PauseNote, Converter={StaticResource NullToVisibilityConverter}}" />

      <!-- Batch 08 D4: the steering note. Offered only while a resume is available — CanContinue already
           covers both the budget-paused and the user-paused case. Placed BEFORE the step list deliberately, so
           its binding counts toward the parse test's raised floor. SENSITIVE (user content): bound only, never
           logged — Continue() carries it to the resume service, this panel never does. -->
      <StackPanel Margin="0,0,0,6"
                  Visibility="{Binding CanContinue, Converter={StaticResource BooleanToVisibilityConverter}}">
        <TextBlock Text="{loc:Str Run_Nudge_Label}" Margin="0,0,0,2" FontSize="11"
                   Foreground="{DynamicResource TextMutedBrush}" />
        <ui:TextBox Text="{Binding NudgeText, UpdateSourceTrigger=PropertyChanged}"
                    PlaceholderText="{loc:Str Run_Nudge_Placeholder}" PlaceholderEnabled="True"
                    FontSize="12" TextWrapping="Wrap" />
        <TextBlock Text="{loc:Str Run_Nudge_Scope_Note}" Margin="0,2,0,0" FontSize="11"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource TextMutedBrush}" />
      </StackPanel>

      <!-- Step list -->
      <ItemsControl ItemsSource="{Binding Steps}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Padding="6,4" Margin="0,1"
                    CornerRadius="{StaticResource SmallRadius}"
                    Background="{Binding IsRunning, Converter={StaticResource BoolToRunningRowBrushConverter}}">
              <StackPanel>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <ui:SymbolIcon Grid.Column="0" FontSize="14" Margin="0,0,6,0"
                                 VerticalAlignment="Center"
                                 Symbol="{Binding Status, Converter={StaticResource StepStatusToGlyphConverter}}"
                                 Foreground="{Binding Status, Converter={StaticResource StepStatusToBrushConverter}}" />
                  <chat:PiaPersonaAvatar Grid.Column="1" Width="20" Height="20" Margin="0,0,6,0"
                                         VerticalAlignment="Center"
                                         PersonaId="{Binding PersonaId}"
                                         Emoji="{Binding PersonaEmoji}"
                                         AccentColor="{Binding PersonaAccent}"
                                         Visibility="{Binding HasPersona, Converter={StaticResource BooleanToVisibilityConverter}}" />
                  <!-- Read-mode title; hidden while this row's inline editor (below) is open. -->
                  <TextBlock Grid.Column="2" Text="{Binding Title}"
                             TextTrimming="CharacterEllipsis"
                             VerticalAlignment="Center"
                             Foreground="{DynamicResource TextDefaultBrush}"
                             Visibility="{Binding IsEditing, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                  <TextBlock Grid.Column="3" VerticalAlignment="Center" FontSize="11"
                             Foreground="{DynamicResource TextSubtleBrush}"
                             Text="{Binding InputTokens, StringFormat={}{0:N0} in}" />
                </Grid>

                <!-- Batch 08 D3: the inline editor — embedded, never a dialog (the panel lives inside a
                     chat). Title/Intent only; every other column of the row (Ordinal, persona, ExtraJson) is
                     carried forward verbatim by the service and untouched by an edit. -->
                <StackPanel Margin="0,4,0,0"
                            Visibility="{Binding IsEditing, Converter={StaticResource BooleanToVisibilityConverter}}">
                  <!-- Batch 08 F7: both boxes carried no label and no placeholder, so nothing told the user
                       which one the model actually receives — and it is the SECOND one (both executors build
                       the step turn from Intent alone; neither reads Title). -->
                  <ui:TextBox Text="{Binding EditTitle, UpdateSourceTrigger=PropertyChanged}"
                              PlaceholderText="{loc:Str Run_Plan_Edit_Title}"
                              FontSize="12" Margin="0,0,0,4" />
                  <ui:TextBox Text="{Binding EditIntent, UpdateSourceTrigger=PropertyChanged}"
                              PlaceholderText="{loc:Str Run_Plan_Edit_Intent}"
                              FontSize="12" Margin="0,0,0,4" TextWrapping="Wrap" AcceptsReturn="True" />
                  <StackPanel Orientation="Horizontal">
                    <ui:Button Content="{loc:Str Common_Save}" FontSize="11" Margin="0,0,6,0"
                               Command="{Binding DataContext.SaveStepEditCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                               CommandParameter="{Binding}" />
                    <ui:Button Content="{loc:Str Common_Cancel}" FontSize="11"
                               Command="{Binding DataContext.CancelStepEditCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                               CommandParameter="{Binding}" />
                  </StackPanel>
                </StackPanel>

                <!-- Batch 08 D3: the five plan-mutation verbs — hidden while this row is being edited (the
                     editor's own Save/Cancel are the only actions offered then), and hidden entirely while the
                     run is live (CanMutatePlan, bound off the ItemsControl's own DataContext — the VM). A
                     settled step's five buttons stay VISIBLE but each individually disabled (IsMutable) rather
                     than vanishing, so the row's shape does not shift as steps finish.

                     Batch 08 F15, so the repaint is not read as a bug: a SKIPPED row sorts with the settled
                     work, so the NEXT mutation moves it up above the still-pending rows. Cosmetic only — a
                     skipped step never drains — and deliberately not fixed; see ApplyPlanMutationAsync's
                     prefix comment for the four-sided change it would take. -->
                <StackPanel Visibility="{Binding IsEditing, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                  <StackPanel Orientation="Horizontal" Margin="0,4,0,0"
                              Visibility="{Binding DataContext.CanMutatePlan, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ui:Button Content="{loc:Str Run_Plan_Action_Edit}" FontSize="11" Margin="0,0,6,0"
                               IsEnabled="{Binding IsMutable}"
                               Command="{Binding DataContext.EditStepCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                               CommandParameter="{Binding}" />
                    <ui:Button Content="{loc:Str Run_Plan_Action_Insert}" FontSize="11" Margin="0,0,6,0"
                               IsEnabled="{Binding IsMutable}"
                               Command="{Binding DataContext.InsertStepBelowCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                               CommandParameter="{Binding}" />
                    <ui:Button Content="{loc:Str Run_Plan_Action_MoveUp}" FontSize="11" Margin="0,0,6,0"
                               IsEnabled="{Binding IsMutable}"
                               Command="{Binding DataContext.MoveStepUpCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                               CommandParameter="{Binding}" />
                    <ui:Button Content="{loc:Str Run_Plan_Action_MoveDown}" FontSize="11" Margin="0,0,6,0"
                               IsEnabled="{Binding IsMutable}"
                               Command="{Binding DataContext.MoveStepDownCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                               CommandParameter="{Binding}" />
                    <ui:Button Content="{loc:Str Run_Plan_Action_Skip}" FontSize="11"
                               IsEnabled="{Binding IsMutable}"
                               Command="{Binding DataContext.SkipStepCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                               CommandParameter="{Binding}" />
                  </StackPanel>
                </StackPanel>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <!-- Audit timeline (Batch 03): read-only, collapsed, loaded on first expand. Metadata only — the store
           holds no tool args, results or paths, so there is nothing here to reveal. Every StaticResource and
           DynamicResource below is already used elsewhere in this file, deliberately: an unresolved one
           throws at TEMPLATE INSTANTIATION, i.e. the first time a user opens the expander, which no test in
           the suite reaches. That is also why the empty state binds the VM's own HasNoTimeline bool instead
           of introducing an inverse converter. -->
      <Expander Header="{loc:Str Run_Timeline_Header}"
                IsExpanded="{Binding IsTimelineExpanded}"
                Margin="0,6,0,0" FontSize="12">
        <StackPanel>
          <TextBlock Text="{Binding TimelineNote}" Margin="0,2,0,4" FontSize="11" TextWrapping="Wrap"
                     Foreground="{DynamicResource TextMutedBrush}"
                     Visibility="{Binding IsTimelineTruncated, Converter={StaticResource BooleanToVisibilityConverter}}" />
          <TextBlock Text="{loc:Str Run_Timeline_Empty}" Margin="0,2,0,2" FontSize="11" TextWrapping="Wrap"
                     Foreground="{DynamicResource TextMutedBrush}"
                     Visibility="{Binding HasNoTimeline, Converter={StaticResource BooleanToVisibilityConverter}}" />
          <!-- "Could not be read" is NOT the empty state: a read that faulted must never render as the
               positive claim that the run recorded no decisions. -->
          <TextBlock Text="{loc:Str Run_Timeline_ReadFailed}" Margin="0,2,0,2" FontSize="11" TextWrapping="Wrap"
                     Foreground="{DynamicResource TextMutedBrush}"
                     Visibility="{Binding HasTimelineReadError, Converter={StaticResource BooleanToVisibilityConverter}}" />
          <ItemsControl ItemsSource="{Binding Timeline}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <!-- Five columns: time, step attribution, tool, outcome, decision. The outcome column is what
                     keeps an Error row from rendering byte-identically to a successful one — on an audit
                     surface that is the most interesting fact in the row. Both StepLabel and OutcomeSuffix are
                     null on the ordinary row and a null Text is a zero-width TextBlock, so neither needs a
                     converter (and this template still introduces no new resource lookup). -->
                <Grid Margin="0,1">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="{Binding TimeLabel}" FontSize="11" Margin="0,0,8,0"
                             VerticalAlignment="Center"
                             Foreground="{DynamicResource TextSubtleBrush}" />
                  <TextBlock Grid.Column="1" Text="{Binding StepLabel}" FontSize="11" Margin="0,0,8,0"
                             VerticalAlignment="Center"
                             Foreground="{DynamicResource TextSubtleBrush}" />
                  <TextBlock Grid.Column="2" Text="{Binding ToolName}" FontSize="11"
                             VerticalAlignment="Center"
                             TextTrimming="CharacterEllipsis"
                             Foreground="{DynamicResource TextDefaultBrush}" />
                  <TextBlock Grid.Column="3" Text="{Binding OutcomeSuffix}" FontSize="11" Margin="8,0,0,0"
                             VerticalAlignment="Center"
                             Foreground="{DynamicResource TextMutedBrush}" />
                  <TextBlock Grid.Column="4" Text="{Binding DecisionLabel}" FontSize="11" Margin="8,0,0,0"
                             VerticalAlignment="Center"
                             Foreground="{DynamicResource TextMutedBrush}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Expander>

      <!-- Sub-agents (Batch 07 D17): the delegated child runs, each expanding to ITS OWN trace. Two per-run
           views side by side and never one interleaved list — Seq is monotonic only within a run id, each child
           has its own 500-event cap, and CreatedAt is explicitly rejected as an ordering source, so a merged
           timeline needs a new cross-run key and is its own work. Hidden entirely on an ordinary run.
           Same resource discipline as the timeline expander above: every StaticResource/DynamicResource used
           here already appears earlier in this file, because an unresolved one throws at TEMPLATE
           INSTANTIATION — the first time a user expands this — which no test in the suite reaches. -->
      <Expander Header="{loc:Str Run_Children_Header}"
                Margin="0,6,0,0" FontSize="12"
                Visibility="{Binding HasChildren, Converter={StaticResource BooleanToVisibilityConverter}}">
        <StackPanel>
          <TextBlock Text="{Binding ChildrenNote}" Margin="0,2,0,4" FontSize="11" TextWrapping="Wrap"
                     Foreground="{DynamicResource TextMutedBrush}"
                     Visibility="{Binding ChildrenNote, Converter={StaticResource NullToVisibilityConverter}}" />
          <ItemsControl ItemsSource="{Binding Children}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Expander IsExpanded="{Binding IsExpanded}" Margin="0,1" FontSize="11">
                  <Expander.Header>
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Grid.Column="0" FontSize="11" Margin="0,0,8,0"
                                 VerticalAlignment="Center"
                                 Text="{Binding State, Converter={StaticResource RunStateToLabelConverter}}"
                                 Foreground="{Binding State, Converter={StaticResource RunStateToBrushConverter}}" />
                      <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="11"
                                 VerticalAlignment="Center"
                                 TextTrimming="CharacterEllipsis"
                                 Foreground="{DynamicResource TextDefaultBrush}" />
                      <TextBlock Grid.Column="2" FontSize="11" Margin="8,0,0,0"
                                 VerticalAlignment="Center"
                                 Foreground="{DynamicResource TextSubtleBrush}"
                                 Text="{Binding InputTokens, StringFormat={}{0:N0} in}" />
                    </Grid>
                  </Expander.Header>
                  <StackPanel>
                    <TextBlock Text="{loc:Str Run_Children_Timeline_Empty}" Margin="0,2,0,2" FontSize="11"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextMutedBrush}"
                               Visibility="{Binding HasNoTimeline, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <!-- "Could not be read" is NOT the empty state, for the reason the parent's own trace
                         records: a read that faulted must never render as a positive claim about the run. -->
                    <TextBlock Text="{loc:Str Run_Timeline_ReadFailed}" Margin="0,2,0,2" FontSize="11"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextMutedBrush}"
                               Visibility="{Binding HasTimelineReadError, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <ItemsControl ItemsSource="{Binding Timeline}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <!-- The parent's five-column trace row, minus the step-attribution column: a child's
                               events carry the CHILD's step ids, which are not in the parent's projected plan,
                               so StepLabel is null on every one of them by construction. -->
                          <Grid Margin="0,1">
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="Auto" />
                              <ColumnDefinition Width="*" />
                              <ColumnDefinition Width="Auto" />
                              <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding TimeLabel}" FontSize="11" Margin="0,0,8,0"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSubtleBrush}" />
                            <TextBlock Grid.Column="1" Text="{Binding ToolName}" FontSize="11"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource TextDefaultBrush}" />
                            <TextBlock Grid.Column="2" Text="{Binding OutcomeSuffix}" FontSize="11" Margin="8,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextMutedBrush}" />
                            <TextBlock Grid.Column="3" Text="{Binding DecisionLabel}" FontSize="11" Margin="8,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextMutedBrush}" />
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Expander>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Expander>
    </StackPanel>
  </Border>
</UserControl>

<UserControl x:Class="Pia.Controls.Memory.PiaInspectorMeta"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mem="clr-namespace:Pia.Controls.Memory"
             xmlns:loc="clr-namespace:Pia.Localization"
             Width="260">
  <UserControl.Resources>
    <Style x:Key="MetaOverlineStyle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="10.5"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{DynamicResource TextSubtleBrush}"/>
      <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>
    <Style x:Key="MetaLabelStyle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11.5"/>
      <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
    </Style>
    <Style x:Key="MetaValueStyle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11.5"/>
      <Setter Property="Foreground" Value="{DynamicResource TextDefaultBrush}"/>
      <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
  </UserControl.Resources>
  <StackPanel Margin="14,14,16,14">

    <!-- Lifecycle -->
    <TextBlock Text="{loc:Str Memory_Meta_Lifecycle}" Style="{StaticResource MetaOverlineStyle}"/>
    <Grid Margin="0,0,0,16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="80"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Str Memory_Meta_Created}" Style="{StaticResource MetaLabelStyle}" Margin="0,2"/>
      <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding CreatedAt, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" Style="{StaticResource MetaValueStyle}" Margin="0,2"/>
      <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Str Memory_Meta_Updated}" Style="{StaticResource MetaLabelStyle}" Margin="0,2"/>
      <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding UpdatedAt, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" Style="{StaticResource MetaValueStyle}" Margin="0,2"/>
      <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:Str Memory_Meta_Accessed}" Style="{StaticResource MetaLabelStyle}" Margin="0,2"/>
      <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding LastAccessedAt, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" Style="{StaticResource MetaValueStyle}" Margin="0,2"/>
    </Grid>

    <!-- Access · 14d -->
    <Grid Margin="0,0,0,8">
      <TextBlock Text="{loc:Str Memory_Meta_Access14d}" Style="{StaticResource MetaOverlineStyle}"/>
      <TextBlock Text="{Binding AccessCount, Mode=OneWay}"
                 HorizontalAlignment="Right"
                 FontSize="11.5"
                 FontWeight="SemiBold"
                 Foreground="{DynamicResource TextDefaultBrush}"/>
    </Grid>
    <mem:PiaSparkline Values="{Binding AccessTimeline}" Margin="0,0,0,16"/>

    <!-- Embedding -->
    <TextBlock Text="{loc:Str Memory_Meta_Embedding}" Style="{StaticResource MetaOverlineStyle}"/>
    <Grid Margin="0,0,0,16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="80"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Str Memory_Meta_Model}" Style="{StaticResource MetaLabelStyle}" Margin="0,2"/>
      <TextBlock Grid.Row="0" Grid.Column="1" Text="{loc:Str Memory_Meta_ModelDefault}" Style="{StaticResource MetaValueStyle}" Margin="0,2"/>
      <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Str Memory_Meta_Size}" Style="{StaticResource MetaLabelStyle}" Margin="0,2"/>
      <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource MetaValueStyle}" Margin="0,2">
        <Run Text="{Binding Embedding.Length, FallbackValue=0, Mode=OneWay}"/><Run Text=" B"/>
      </TextBlock>
    </Grid>

    <!-- Related -->
    <TextBlock Text="{loc:Str Memory_Meta_Related}" Style="{StaticResource MetaOverlineStyle}"/>
    <ItemsControl ItemsSource="{Binding Related}">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Border Background="{DynamicResource SurfaceSunkBrush}"
                  BorderBrush="{DynamicResource BorderBrush_}"
                  BorderThickness="1"
                  CornerRadius="7"
                  Padding="8,6"
                  Margin="0,0,0,6">
            <StackPanel>
              <TextBlock Text="{Binding Title}"
                         FontSize="12"
                         FontWeight="Medium"
                         Foreground="{DynamicResource TextDefaultBrush}"
                         TextTrimming="CharacterEllipsis"/>
              <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                <mem:PiaTypeChip Type="{Binding Type}"/>
                <TextBlock Foreground="{DynamicResource TextSubtleBrush}"
                           FontSize="10.5"
                           Margin="6,0,0,0"
                           VerticalAlignment="Center"
                           FontFamily="{DynamicResource PiaMonoFont}">
                  <Run Text="sim "/><Run Text="{Binding Score, StringFormat='{}{0:0.00}', Mode=OneWay}"/>
                </TextBlock>
              </StackPanel>
            </StackPanel>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <TextBlock Text="{loc:Str Memory_Meta_NoRelated}"
               FontSize="11"
               Foreground="{DynamicResource TextSubtleBrush}"
               FontStyle="Italic"
               Visibility="{Binding Related.Count, Converter={StaticResource ZeroToVisibilityConverter}}"/>
  </StackPanel>
</UserControl>

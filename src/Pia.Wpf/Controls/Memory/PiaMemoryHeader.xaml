<UserControl x:Class="Pia.Controls.Memory.PiaMemoryHeader"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:loc="clr-namespace:Pia.Localization">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="Auto"/>
    </Grid.ColumnDefinitions>

    <TextBlock Grid.Row="0" Grid.Column="0"
               Text="{loc:Str Memory_Title}"
               FontSize="22"
               FontWeight="SemiBold"
               Foreground="{DynamicResource TextDefaultBrush}"
               VerticalAlignment="Center"/>

    <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
      <ui:Button Appearance="Secondary"
                 Command="{Binding ExportCommand}"
                 ToolTip="{loc:Str Memory_ExportTooltip}"
                 Margin="0,0,6,0">
        <StackPanel Orientation="Horizontal">
          <ui:SymbolIcon Symbol="ArrowDownload24" FontSize="16" Margin="0,0,6,0"/>
          <TextBlock Text="{loc:Str Memory_Export}"/>
        </StackPanel>
      </ui:Button>
      <ui:Button Appearance="Secondary"
                 Command="{Binding ReviewStaleCommand}"
                 ToolTip="{loc:Str Memory_ReviewStaleTooltip}"
                 Margin="0,0,6,0">
        <StackPanel Orientation="Horizontal">
          <ui:SymbolIcon Symbol="Clock24" FontSize="16" Margin="0,0,6,0"/>
          <TextBlock Text="{loc:Str Memory_ReviewStale}"/>
        </StackPanel>
      </ui:Button>
      <ui:Button Appearance="Primary"
                 Command="{Binding NewMemoryCommand}">
        <StackPanel Orientation="Horizontal">
          <ui:SymbolIcon Symbol="Add24" FontSize="16" Margin="0,0,6,0"/>
          <TextBlock Text="{loc:Str Memory_NewMemory}"/>
        </StackPanel>
      </ui:Button>
    </StackPanel>

    <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
               Margin="0,8,0,0"
               FontSize="12"
               Foreground="{DynamicResource TextMutedBrush}">
      <Run Text="{Binding TotalObjectCount, Mode=OneWay}"/><Run Text=" "/><Run Text="{loc:Str Memory_StatsObjects}"/>
      <Run Text=" · "/>
      <Run Text="{Binding StorageSizeText, Mode=OneWay}"/>
      <Run Text=" · "/>
      <Run Text="{Binding EmbeddingDim, Mode=OneWay}"/><Run Text="-dim"/>
      <Run Text=" · "/>
      <Run Text="{Binding StaleCount, Mode=OneWay}"/><Run Text=" "/><Run Text="{loc:Str Memory_StatsStale}"/>
    </TextBlock>
  </Grid>
</UserControl>

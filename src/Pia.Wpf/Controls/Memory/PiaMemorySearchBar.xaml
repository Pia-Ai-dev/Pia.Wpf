<UserControl x:Class="Pia.Controls.Memory.PiaMemorySearchBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             x:Name="Root">
  <Border Style="{StaticResource PiaComposerCardStyle}"
          Padding="0">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <Grid Grid.Column="0"
            Width="16"
            Height="16"
            Margin="14,0,8,0"
            VerticalAlignment="Center">
        <ui:SymbolIcon Symbol="Search24"
                       FontSize="16"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource TextSubtleBrush}">
          <ui:SymbolIcon.Style>
            <Style TargetType="ui:SymbolIcon">
              <Setter Property="Visibility" Value="Visible"/>
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsBusy, ElementName=Root}" Value="True">
                  <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </ui:SymbolIcon.Style>
        </ui:SymbolIcon>
        <ui:ProgressRing IsIndeterminate="True"
                         Width="16"
                         Height="16"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         Visibility="{Binding IsBusy, ElementName=Root, Converter={StaticResource BooleanToVisibilityConverter}}"/>
      </Grid>

      <TextBox Grid.Column="1"
               Text="{Binding Query, ElementName=Root, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
               Background="Transparent"
               BorderThickness="0"
               FontSize="13"
               Padding="0,10"
               Margin="0,0,12,0"
               VerticalContentAlignment="Center"/>
    </Grid>
  </Border>
</UserControl>

<UserControl x:Class="Pia.Controls.Memory.PiaMemorySearchBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:loc="clr-namespace:Pia.Localization"
             x:Name="Root">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="Auto"/>
    </Grid.ColumnDefinitions>

    <Border Grid.Column="0"
            Style="{StaticResource PiaComposerCardStyle}"
            Padding="0">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <ui:SymbolIcon Grid.Column="0"
                       Symbol="Search24"
                       FontSize="16"
                       Margin="14,0,8,0"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource TextSubtleBrush}"/>

        <TextBox Grid.Column="1"
                 Text="{Binding Query, ElementName=Root, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 Background="Transparent"
                 BorderThickness="0"
                 FontSize="13"
                 Padding="0,10"
                 VerticalContentAlignment="Center"/>

        <Border Grid.Column="2"
                Background="{DynamicResource SurfaceMutedBrush}"
                BorderBrush="{DynamicResource BorderBrush_}"
                BorderThickness="1"
                CornerRadius="4"
                Padding="6,2"
                Margin="0,0,12,0"
                VerticalAlignment="Center">
          <TextBlock Text="⌘K"
                     FontFamily="{DynamicResource PiaMonoFont}"
                     FontSize="10.5"
                     Foreground="{DynamicResource TextSubtleBrush}"/>
        </Border>
      </Grid>
    </Border>

    <Border Grid.Column="1"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush_}"
            BorderThickness="1"
            CornerRadius="9"
            Padding="2"
            Margin="10,0,0,0"
            VerticalAlignment="Center">
      <StackPanel Orientation="Horizontal">
        <RadioButton Content="{loc:Str Memory_Filter_All}"
                     GroupName="MemoryFilter"
                     IsChecked="{Binding ActiveFilter, ElementName=Root, Converter={StaticResource StringEqualsBoolConverter}, ConverterParameter=All}"
                     Style="{StaticResource PiaSegmentedButton}"/>
        <RadioButton Content="{loc:Str Memory_Filter_Pinned}"
                     GroupName="MemoryFilter"
                     IsChecked="{Binding ActiveFilter, ElementName=Root, Converter={StaticResource StringEqualsBoolConverter}, ConverterParameter=Pinned}"
                     Style="{StaticResource PiaSegmentedButton}"/>
        <RadioButton Content="{loc:Str Memory_Filter_Stale}"
                     GroupName="MemoryFilter"
                     IsChecked="{Binding ActiveFilter, ElementName=Root, Converter={StaticResource StringEqualsBoolConverter}, ConverterParameter=Stale}"
                     Style="{StaticResource PiaSegmentedButton}"/>
        <RadioButton Content="{loc:Str Memory_Filter_Today}"
                     GroupName="MemoryFilter"
                     IsChecked="{Binding ActiveFilter, ElementName=Root, Converter={StaticResource StringEqualsBoolConverter}, ConverterParameter=Today}"
                     Style="{StaticResource PiaSegmentedButton}"/>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>

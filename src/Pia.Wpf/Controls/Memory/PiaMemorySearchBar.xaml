<UserControl x:Class="Pia.Controls.Memory.PiaMemorySearchBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:loc="clr-namespace:Pia.Localization"
             x:Name="Root">
  <Border Style="{StaticResource PiaComposerCardStyle}"
          Padding="0">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <ui:SymbolIcon Grid.Column="0"
                     Symbol="Search24"
                     FontSize="16"
                     Margin="14,0,8,0"
                     VerticalAlignment="Center"
                     Foreground="{DynamicResource TextSubtleBrush}"/>

      <TextBox Grid.Column="1"
               Text="{Binding Query, ElementName=Root, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
               Background="Transparent"
               BorderThickness="0"
               FontSize="13"
               Padding="0,10"
               Margin="0,0,12,0"
               VerticalContentAlignment="Center"/>
    </Grid>
  </Border>
</UserControl>

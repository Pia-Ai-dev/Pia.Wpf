<UserControl x:Class="Pia.Controls.Memory.PiaMemoryInspector"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mem="clr-namespace:Pia.Controls.Memory">
  <Border Style="{StaticResource PiaCardStyle}">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <mem:PiaInspectorHeader Grid.Row="0"/>

      <Grid Grid.Row="1" Margin="14,14,14,14">
        <mem:PiaJsonView/>
      </Grid>
    </Grid>
  </Border>
</UserControl>

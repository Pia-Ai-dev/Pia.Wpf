<UserControl x:Class="Pia.Controls.Memory.PiaMemoryHelpCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:loc="clr-namespace:Pia.Localization">
  <Border Style="{StaticResource PiaCardStyle}">
    <StackPanel>
      <Border Style="{StaticResource PiaCardHeaderStripeStyle}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>

          <StackPanel Grid.Column="0" Orientation="Horizontal">
            <Border Style="{StaticResource PiaIconChipStyle}" Margin="0,0,10,0">
              <ui:SymbolIcon Symbol="Info24"
                             FontSize="13"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"
                             Foreground="{DynamicResource PiaAccentBrush}"/>
            </Border>
            <TextBlock Text="{loc:Str Memory_Help_Title}"
                       FontSize="13"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource TextDefaultBrush}"/>
          </StackPanel>

          <ui:Button Grid.Column="1"
                     Icon="{ui:SymbolIcon Symbol=Dismiss24}"
                     Appearance="Transparent"
                     Padding="4"
                     VerticalAlignment="Center"
                     ToolTip="{loc:Str Memory_Help_Dismiss}"
                     Command="{Binding ToggleHelpCommand}"/>
        </Grid>
      </Border>

      <StackPanel Margin="14,12">
        <TextBlock Text="{loc:Str Memory_Help_What}"
                   FontSize="12"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource TextMutedBrush}"/>
        <TextBlock Text="{loc:Str Memory_Help_Auto}"
                   FontSize="12"
                   TextWrapping="Wrap"
                   Margin="0,4,0,0"
                   Foreground="{DynamicResource TextMutedBrush}"/>
        <TextBlock Text="{loc:Str Memory_Help_Control}"
                   FontSize="12"
                   TextWrapping="Wrap"
                   Margin="0,4,0,0"
                   Foreground="{DynamicResource TextMutedBrush}"/>
        <TextBlock Text="{loc:Str Memory_Help_Search}"
                   FontSize="12"
                   TextWrapping="Wrap"
                   Margin="0,4,0,0"
                   Foreground="{DynamicResource TextMutedBrush}"/>
        <TextBlock Text="{loc:Str Memory_Help_Files}"
                   FontSize="12"
                   TextWrapping="Wrap"
                   Margin="0,4,0,0"
                   Foreground="{DynamicResource TextMutedBrush}"/>
        <TextBlock Text="{loc:Str Memory_Help_Sources}"
                   FontSize="12"
                   TextWrapping="Wrap"
                   Margin="0,4,0,0"
                   Foreground="{DynamicResource TextMutedBrush}"/>
        <ui:HyperlinkButton Command="{Binding OpenVaultFolderCommand}"
                            HorizontalAlignment="Left"
                            Margin="0,8,0,0">
          <StackPanel Orientation="Horizontal">
            <ui:SymbolIcon Symbol="FolderOpen24"
                           FontSize="14"
                           Margin="0,0,6,0"
                           VerticalAlignment="Center"/>
            <TextBlock Text="{loc:Str Memory_OpenFolder}" VerticalAlignment="Center"/>
          </StackPanel>
        </ui:HyperlinkButton>
      </StackPanel>
    </StackPanel>
  </Border>
</UserControl>

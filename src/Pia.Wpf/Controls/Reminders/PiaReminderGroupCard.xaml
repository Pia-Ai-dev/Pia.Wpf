<UserControl x:Class="Pia.Controls.Reminders.PiaReminderGroupCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:rem="clr-namespace:Pia.Controls.Reminders"
             x:Name="Root">
  <Border CornerRadius="{StaticResource LargeRadius}"
          Background="{DynamicResource SurfaceBrush}"
          BorderBrush="{DynamicResource BorderBrush_}"
          BorderThickness="1">
    <Border.Effect>
      <DropShadowEffect Color="#0F1729" Opacity="0.04"
                        BlurRadius="6" ShadowDepth="1"/>
    </Border.Effect>
    <StackPanel>

      <Button Style="{StaticResource UnstyledButton}"
              Click="ToggleHeader_Click"
              HorizontalContentAlignment="Stretch">
        <Grid Margin="14,11">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>

          <ui:SymbolIcon Symbol="ChevronDown20"
                         Grid.Column="0"
                         Foreground="{DynamicResource TextMutedBrush}"
                         RenderTransformOrigin="0.5,0.5"
                         VerticalAlignment="Center">
            <ui:SymbolIcon.RenderTransform>
              <RotateTransform Angle="{Binding IsExpanded,
                                       Converter={StaticResource BoolToAngleConverter},
                                       ConverterParameter='0|-90'}"/>
            </ui:SymbolIcon.RenderTransform>
          </ui:SymbolIcon>

          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="{Binding DisplayName}"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextDefaultBrush}"
                       VerticalAlignment="Center"/>
            <Border CornerRadius="10"
                    Padding="6,1"
                    Margin="8,0,0,0"
                    VerticalAlignment="Center">
              <Border.Style>
                <Style TargetType="Border">
                  <Setter Property="Background" Value="{DynamicResource PiaAccentBrush}"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsOverdueBucket}" Value="True">
                      <Setter Property="Background" Value="{DynamicResource PiaDangerBrush}"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Border.Style>
              <TextBlock Text="{Binding ItemCount}"
                         Foreground="White"
                         FontSize="10.5"
                         FontWeight="Bold"/>
            </Border>
          </StackPanel>
        </Grid>
      </Button>

      <Border Height="1"
              Background="{DynamicResource BorderBrush_}"
              Visibility="{Binding IsExpanded, Converter={StaticResource BooleanToVisibilityConverter}}"/>

      <ListBox x:Name="ItemList"
               ItemsSource="{Binding Items}"
               SelectionChanged="ItemList_SelectionChanged"
               Background="Transparent"
               BorderThickness="0"
               Padding="0,4,0,4"
               ItemContainerStyle="{StaticResource PiaMemoryRowItemStyle}"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled"
               Visibility="{Binding IsExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <rem:PiaReminderRow/>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </StackPanel>
  </Border>
</UserControl>

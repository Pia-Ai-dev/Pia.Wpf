<UserControl x:Class="Pia.Controls.Reminders.PiaReminderRow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:loc="clr-namespace:Pia.Localization"
             xmlns:behaviors="clr-namespace:Pia.Behaviors"
             xmlns:rem="clr-namespace:Pia.Controls.Reminders"
             xmlns:views="clr-namespace:Pia.Views">
  <Border x:Name="Root"
          CornerRadius="8"
          Padding="28,8,12,8"
          Background="Transparent"
          Cursor="Hand">
    <Border.Style>
      <Style TargetType="Border">
        <Style.Triggers>
          <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                       Value="True">
            <Setter Property="Background" Value="{DynamicResource PiaAccentSoftBrush}"/>
          </DataTrigger>
          <Trigger Property="IsMouseOver" Value="True">
            <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}"/>
          </Trigger>
        </Style.Triggers>
      </Style>
    </Border.Style>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <StackPanel Grid.Column="0">
        <TextBlock behaviors:EmojiTextBehavior.Text="{Binding Description}"
                   FontSize="13"
                   Foreground="{DynamicResource TextDefaultBrush}"
                   TextTrimming="CharacterEllipsis"/>
        <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
          <TextBlock Text="{Binding Recurrence}"
                     FontSize="11.5"
                     Foreground="{DynamicResource TextSubtleBrush}"/>
          <TextBlock Text=" · "
                     FontSize="11.5"
                     Foreground="{DynamicResource TextSubtleBrush}"/>
          <TextBlock Text="{Binding TimeOfDay, StringFormat='{}{0:hh\\:mm}'}"
                     FontSize="11.5"
                     Foreground="{DynamicResource TextSubtleBrush}"/>
        </StackPanel>
      </StackPanel>

      <rem:PiaReminderStatusChip Grid.Column="1"
                                 Status="{Binding Status}"
                                 Margin="10,0"
                                 VerticalAlignment="Center"/>

      <!-- On-hover action buttons -->
      <StackPanel Grid.Column="2"
                  Orientation="Horizontal"
                  Margin="6,0,8,0"
                  VerticalAlignment="Center">
        <StackPanel.Style>
          <Style TargetType="StackPanel">
            <Setter Property="Opacity" Value="0"/>
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsMouseOver, ElementName=Root}" Value="True">
                <Setter Property="Opacity" Value="1"/>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </StackPanel.Style>
        <ui:Button Appearance="Transparent"
                   Padding="4"
                   Margin="0,0,2,0"
                   Command="{Binding DataContext.ToggleEnableCommand, RelativeSource={RelativeSource AncestorType=views:RemindersView}}"
                   CommandParameter="{Binding}"
                   AutomationProperties.Name="{loc:Str Reminders_ToggleEnable}"
                   ToolTip="{loc:Str Reminders_ToggleEnable}">
          <ui:SymbolIcon Symbol="ToggleRight24" FontSize="14"/>
        </ui:Button>
        <ui:Button Appearance="Transparent"
                   Padding="4"
                   Margin="0,0,2,0"
                   Command="{Binding DataContext.SnoozeCommand, RelativeSource={RelativeSource AncestorType=views:RemindersView}}"
                   CommandParameter="{Binding}"
                   AutomationProperties.Name="{loc:Str Reminders_Snooze}"
                   ToolTip="{loc:Str Reminders_Snooze}">
          <ui:SymbolIcon Symbol="ClockAlarm24" FontSize="14"/>
        </ui:Button>
        <ui:Button Appearance="Transparent"
                   Padding="4"
                   Margin="0,0,2,0"
                   Command="{Binding DataContext.DismissCommand, RelativeSource={RelativeSource AncestorType=views:RemindersView}}"
                   CommandParameter="{Binding}"
                   AutomationProperties.Name="{loc:Str Reminders_Dismiss}"
                   ToolTip="{loc:Str Reminders_Dismiss}">
          <ui:SymbolIcon Symbol="Checkmark24" FontSize="14"/>
        </ui:Button>
        <ui:Button Appearance="Transparent"
                   Padding="4"
                   Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=views:RemindersView}}"
                   CommandParameter="{Binding}"
                   AutomationProperties.Name="{loc:Str Reminders_Delete}"
                   ToolTip="{loc:Str Reminders_Delete}">
          <ui:SymbolIcon Symbol="Delete24" FontSize="14"
                         Foreground="{DynamicResource PiaDangerBrush}"/>
        </ui:Button>
      </StackPanel>

      <TextBlock Grid.Column="3"
                 Text="{Binding NextFireAt, Converter={StaticResource NextFireAtToShortStringConverter}}"
                 FontSize="11"
                 FontFamily="{DynamicResource PiaMonoFont}"
                 Foreground="{DynamicResource TextSubtleBrush}"
                 TextAlignment="Right"
                 MinWidth="64"
                 VerticalAlignment="Center"/>
    </Grid>
  </Border>
</UserControl>

<UserControl x:Class="Pia.Controls.Cards.CardDecisionBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:cards="clr-namespace:Pia.Controls.Cards">
  <!-- Strictly presentational. Renders DecisionButton items right-aligned in a horizontal row.
       Per-item appearance is chosen by Emphasis; IsEnabled is wired automatically by WPF from
       Command.CanExecute. No code-behind state beyond the ItemsSource DP. -->
  <ItemsControl ItemsSource="{Binding ItemsSource, RelativeSource={RelativeSource AncestorType=UserControl}}"
                HorizontalAlignment="Right">
    <ItemsControl.ItemsPanel>
      <ItemsPanelTemplate>
        <!-- WrapPanel, not StackPanel: a card can show four buttons, and a narrow chat column would clip the
             last one out of reach. Identical layout while the row fits. -->
        <WrapPanel Orientation="Horizontal" HorizontalAlignment="Right" />
      </ItemsPanelTemplate>
    </ItemsControl.ItemsPanel>
    <ItemsControl.ItemTemplate>
      <DataTemplate>
        <ui:Button Content="{Binding Label}"
                   Command="{Binding Command}"
                   FontSize="12"
                   Padding="12,4"
                   Margin="6,2,0,2">
          <ui:Button.Style>
            <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
              <!-- Default emphasis → Secondary (matches the Action Card footer's Decline button). -->
              <Setter Property="Appearance" Value="Secondary" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding Emphasis}" Value="{x:Static cards:DecisionEmphasis.Primary}">
                  <Setter Property="Appearance" Value="Primary" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Emphasis}" Value="{x:Static cards:DecisionEmphasis.Danger}">
                  <Setter Property="Appearance" Value="Caution" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </ui:Button.Style>
        </ui:Button>
      </DataTemplate>
    </ItemsControl.ItemTemplate>
  </ItemsControl>
</UserControl>

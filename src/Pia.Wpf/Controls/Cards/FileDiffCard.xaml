<UserControl x:Class="Pia.Controls.Cards.FileDiffCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:loc="clr-namespace:Pia.Localization"
             xmlns:converters="clr-namespace:Pia.Converters"
             xmlns:models="clr-namespace:Pia.Models">
  <!-- DataContext is the hosting ActionCardInfo (inherited from ActionCardControl's diff child). -->
  <UserControl.Resources>
    <converters:UnchangedLinesLabelConverter x:Key="UnchangedLinesLabelConverter" />
  </UserControl.Resources>

  <Border CornerRadius="8"
          Background="{DynamicResource SurfaceBrush}"
          BorderBrush="{DynamicResource BorderStrongBrush}"
          BorderThickness="1"
          Margin="0,4,0,0"
          ClipToBounds="True">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- Header stripe: chevron · file icon · path · +N/−N stats -->
      <Border Grid.Row="0"
              Background="{DynamicResource SurfaceMutedBrush}"
              BorderBrush="{DynamicResource BorderStrongBrush}"
              BorderThickness="0,0,0,1"
              Padding="4,3,8,3">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <ui:Button Grid.Column="0"
                     Appearance="Transparent"
                     Padding="4"
                     Command="{Binding ToggleDiffExpandCommand}"
                     VerticalAlignment="Center">
            <ui:SymbolIcon FontSize="12">
              <ui:SymbolIcon.Style>
                <Style TargetType="ui:SymbolIcon">
                  <Setter Property="Symbol" Value="ChevronDown24" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsDiffExpanded}" Value="True">
                      <Setter Property="Symbol" Value="ChevronUp24" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </ui:SymbolIcon.Style>
            </ui:SymbolIcon>
          </ui:Button>

          <ui:SymbolIcon Grid.Column="1"
                         Symbol="Document24"
                         FontSize="14"
                         Margin="2,0,6,0"
                         VerticalAlignment="Center"
                         Foreground="{DynamicResource TextMutedBrush}" />

          <TextBlock Grid.Column="2"
                     VerticalAlignment="Center"
                     FontFamily="{StaticResource CodeFontFamily}"
                     FontSize="12"
                     TextTrimming="CharacterEllipsis"
                     Foreground="{DynamicResource TextDefaultBrush}">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <!-- Fall back to the action Summary when there is no target path. -->
                <Setter Property="Text" Value="{Binding FilePath}" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding FilePath}" Value="">
                    <Setter Property="Text" Value="{Binding Summary}" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>

          <TextBlock Grid.Column="3"
                     VerticalAlignment="Center"
                     Margin="8,0,0,0"
                     FontSize="12"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource DiffAddedBrush}"
                     Text="{Binding AddedCount, StringFormat='+{0}'}" />
          <TextBlock Grid.Column="4"
                     VerticalAlignment="Center"
                     Margin="6,0,2,0"
                     FontSize="12"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource DiffRemovedBrush}"
                     Text="{Binding RemovedCount, StringFormat='−{0}'}" />
        </Grid>
      </Border>

      <!-- Body: dual line-number gutter, no-wrap + horizontal scroll. Collapsed when the diff is folded. -->
      <ScrollViewer Grid.Row="1"
                    MaxHeight="360"
                    HorizontalScrollBarVisibility="Auto"
                    VerticalScrollBarVisibility="Auto">
        <ScrollViewer.Style>
          <Style TargetType="ScrollViewer">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsDiffExpanded}" Value="True">
                <Setter Property="Visibility" Value="Visible" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </ScrollViewer.Style>

        <ItemsControl ItemsSource="{Binding DiffRows}">
          <ItemsControl.Resources>
            <!-- One diff row: [old #][new #][marker][code]. Fixed 36px number columns
                 (400-row cap ⇒ ≤4 digits), 18px marker, code fills the rest with NoWrap. -->
            <DataTemplate DataType="{x:Type models:DiffLine}">
              <Border>
                <Border.Style>
                  <Style TargetType="Border">
                    <Setter Property="Background" Value="Transparent" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding Kind}" Value="{x:Static models:DiffLineKind.Added}">
                        <Setter Property="Background" Value="{DynamicResource DiffAddedSoftBrush}" />
                      </DataTrigger>
                      <DataTrigger Binding="{Binding Kind}" Value="{x:Static models:DiffLineKind.Removed}">
                        <Setter Property="Background" Value="{DynamicResource DiffRemovedSoftBrush}" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Border.Style>
                <Grid>
                  <!-- Line numbers now reflect true file position (folding shows a change anywhere in
                       the file), so the number columns are sized for up to ~6 digits. -->
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="46" />
                    <ColumnDefinition Width="46" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>

                  <!-- Neutral gutter behind the two number cells (renders under the numbers). -->
                  <Border Grid.Column="0" Grid.ColumnSpan="2"
                          Background="{DynamicResource DiffGutterBgBrush}" />

                  <TextBlock Grid.Column="0"
                             Text="{Binding OldLineNumber}"
                             TextAlignment="Right"
                             Padding="0,1,6,1"
                             FontFamily="{StaticResource CodeFontFamily}"
                             FontSize="11"
                             Foreground="{DynamicResource TextSubtleBrush}" />
                  <TextBlock Grid.Column="1"
                             Text="{Binding NewLineNumber}"
                             TextAlignment="Right"
                             Padding="0,1,6,1"
                             FontFamily="{StaticResource CodeFontFamily}"
                             FontSize="11"
                             Foreground="{DynamicResource TextSubtleBrush}" />

                  <TextBlock Grid.Column="2"
                             Text="{Binding Gutter}"
                             TextAlignment="Center"
                             Padding="0,1"
                             FontFamily="{StaticResource CodeFontFamily}"
                             FontSize="12"
                             FontWeight="SemiBold">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{DynamicResource TextSubtleBrush}" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding Kind}" Value="{x:Static models:DiffLineKind.Added}">
                            <Setter Property="Foreground" Value="{DynamicResource DiffAddedBrush}" />
                          </DataTrigger>
                          <DataTrigger Binding="{Binding Kind}" Value="{x:Static models:DiffLineKind.Removed}">
                            <Setter Property="Foreground" Value="{DynamicResource DiffRemovedBrush}" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>

                  <TextBlock Grid.Column="3"
                             Padding="4,1,8,1"
                             FontFamily="{StaticResource CodeFontFamily}"
                             FontSize="12"
                             TextWrapping="NoWrap">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Setter Property="Text" Value="{Binding Text}" />
                        <Setter Property="Foreground" Value="{DynamicResource TextDefaultBrush}" />
                        <Setter Property="FontStyle" Value="Normal" />
                        <Style.Triggers>
                          <!-- The synthetic truncation row: localized italic notice, no numbers/marker. -->
                          <DataTrigger Binding="{Binding Kind}" Value="{x:Static models:DiffLineKind.TruncationNotice}">
                            <Setter Property="Text" Value="{loc:Str ActionCard_Diff_TruncatedNotice}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextSubtleBrush}" />
                            <Setter Property="FontStyle" Value="Italic" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                </Grid>
              </Border>
            </DataTemplate>

            <!-- A folded run of unchanged lines: full-width clickable separator bar. -->
            <DataTemplate DataType="{x:Type models:CollapsedDiffRun}">
              <Button Command="{Binding ExpandCommand}"
                      Cursor="Hand"
                      HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Left"
                      FontSize="12"
                      Foreground="{DynamicResource TextMutedBrush}"
                      Content="{Binding Count, Converter={StaticResource UnchangedLinesLabelConverter}}">
                <Button.Template>
                  <ControlTemplate TargetType="Button">
                    <Border x:Name="Bar"
                            Background="{DynamicResource DiffSeparatorBgBrush}"
                            Padding="12,3">
                      <ContentPresenter HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Bar" Property="Opacity" Value="0.85" />
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Button.Template>
              </Button>
            </DataTemplate>
          </ItemsControl.Resources>
        </ItemsControl>
      </ScrollViewer>
    </Grid>
  </Border>
</UserControl>

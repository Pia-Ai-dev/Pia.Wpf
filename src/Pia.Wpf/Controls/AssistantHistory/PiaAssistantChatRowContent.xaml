<UserControl x:Class="Pia.Controls.AssistantHistory.PiaAssistantChatRowContent"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:Pia.Behaviors">
  <!-- Presentation-only row body: time | title | date. Carries no padding,
       background or selection chrome so each host (history list, chat-title
       flyout) supplies its own. Bound by convention to anything exposing
       UpdatedAt (DateTime) and Title (string). -->
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="48"/>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="Auto"/>
    </Grid.ColumnDefinitions>

    <TextBlock Grid.Column="0"
               Text="{Binding UpdatedAt, StringFormat='{}{0:HH:mm}', ConverterCulture=en-US}"
               FontSize="11.5"
               FontFamily="{DynamicResource PiaMonoFont}"
               Foreground="{DynamicResource TextSubtleBrush}"
               VerticalAlignment="Center"/>

    <StackPanel Grid.Column="1" VerticalAlignment="Center">
      <TextBlock FontSize="13"
                 FontWeight="SemiBold"
                 Foreground="{DynamicResource TextDefaultBrush}"
                 behaviors:EmojiTextBehavior.Text="{Binding Title, FallbackValue='—'}"
                 TextTrimming="CharacterEllipsis"
                 TextWrapping="NoWrap"/>
    </StackPanel>

    <TextBlock Grid.Column="2"
               Text="{Binding UpdatedAt, StringFormat='{}{0:MM-dd}'}"
               FontSize="10.5"
               FontFamily="{DynamicResource PiaMonoFont}"
               Foreground="{DynamicResource TextSubtleBrush}"
               TextAlignment="Right"
               MinWidth="42"
               VerticalAlignment="Center"
               Margin="10,0,0,0"/>
  </Grid>
</UserControl>

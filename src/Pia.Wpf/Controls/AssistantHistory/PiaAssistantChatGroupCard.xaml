<UserControl x:Class="Pia.Controls.AssistantHistory.PiaAssistantChatGroupCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:ah="clr-namespace:Pia.Controls.AssistantHistory"
             x:Name="Root">
  <Border CornerRadius="{StaticResource LargeRadius}"
          Background="{DynamicResource SurfaceBrush}"
          BorderBrush="{DynamicResource BorderBrush_}"
          BorderThickness="1">
    <Border.Effect>
      <DropShadowEffect Color="#0F1729" Opacity="0.04"
                        BlurRadius="6" ShadowDepth="1"/>
    </Border.Effect>
    <StackPanel>

      <Button Style="{StaticResource UnstyledButton}"
              Click="ToggleHeader_Click"
              AutomationProperties.AutomationId="{Binding Bucket, StringFormat='AssistantHistory_GroupToggle_{0}'}"
              HorizontalContentAlignment="Stretch">
        <Grid Margin="14,11">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>

          <ui:SymbolIcon Symbol="ChevronDown20"
                         Grid.Column="0"
                         Foreground="{DynamicResource TextMutedBrush}"
                         RenderTransformOrigin="0.5,0.5"
                         VerticalAlignment="Center">
            <ui:SymbolIcon.RenderTransform>
              <RotateTransform Angle="{Binding IsExpanded,
                                       Converter={StaticResource BoolToAngleConverter},
                                       ConverterParameter='0|-90'}"/>
            </ui:SymbolIcon.RenderTransform>
          </ui:SymbolIcon>

          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="{Binding DisplayName}"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextDefaultBrush}"
                       VerticalAlignment="Center"/>
            <Border Background="{DynamicResource PiaAccentBrush}"
                    CornerRadius="10"
                    Padding="6,1"
                    Margin="8,0,0,0"
                    VerticalAlignment="Center">
              <TextBlock Text="{Binding ItemCount}"
                         Foreground="White"
                         FontSize="10.5"
                         FontWeight="Bold"/>
            </Border>
          </StackPanel>
        </Grid>
      </Button>

      <Border Height="1"
              Background="{DynamicResource BorderBrush_}"
              Visibility="{Binding IsExpanded, Converter={StaticResource BooleanToVisibilityConverter}}"/>

      <ListBox x:Name="ItemList"
               ItemsSource="{Binding Items}"
               SelectionChanged="ItemList_SelectionChanged"
               Background="Transparent"
               BorderThickness="0"
               Padding="0,4,0,4"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled"
               Visibility="{Binding IsExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
        <ListBox.ItemContainerStyle>
          <!-- Named and identified on the CONTAINER, which is the node UIA offers for a row: without these
               every row reports the view-model's ToString() and can only be reached by index. -->
          <Style TargetType="ListBoxItem" BasedOn="{StaticResource PiaMemoryRowItemStyle}">
            <Setter Property="AutomationProperties.AutomationId" Value="{Binding Id, StringFormat='AssistantChat_Row_{0}'}"/>
            <Setter Property="AutomationProperties.Name" Value="{Binding Title}"/>
          </Style>
        </ListBox.ItemContainerStyle>
        <ListBox.ItemTemplate>
          <DataTemplate>
            <ah:PiaAssistantChatRow/>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </StackPanel>
  </Border>
</UserControl>

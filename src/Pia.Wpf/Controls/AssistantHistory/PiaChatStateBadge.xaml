<UserControl x:Class="Pia.Controls.AssistantHistory.PiaChatStateBadge"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
  <!-- Inline chat-state pill: glyph + localized label on a soft state fill. Binds
       {Binding State} on the inherited DataContext (history row VM with a live State,
       or the flyout chip item with a snapshot State); collapses when Idle. Shared by
       the history list row and the chat-title flyout row so the badge stays identical. -->
  <Border CornerRadius="9"
          Padding="6,2"
          VerticalAlignment="Center"
          Background="{Binding State, Converter={StaticResource ChatStateToBrushBg}}"
          Visibility="{Binding State, Converter={StaticResource ChatStateIsBadgeVisibleConverter}}">
    <StackPanel Orientation="Horizontal">
      <ui:SymbolIcon Symbol="{Binding State, Converter={StaticResource ChatStateToGlyphConverter}}"
                     FontSize="11"
                     VerticalAlignment="Center"
                     Foreground="{Binding State, Converter={StaticResource ChatStateToBrushFg}}" />
      <TextBlock Text="{Binding State, Converter={StaticResource ChatStateToLabelConverter}}"
                 FontSize="10"
                 FontWeight="SemiBold"
                 Margin="4,0,0,0"
                 VerticalAlignment="Center"
                 Foreground="{Binding State, Converter={StaticResource ChatStateToBrushFg}}" />
    </StackPanel>
  </Border>
</UserControl>

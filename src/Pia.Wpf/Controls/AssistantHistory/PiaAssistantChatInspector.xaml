<UserControl x:Class="Pia.Controls.AssistantHistory.PiaAssistantChatInspector"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:loc="clr-namespace:Pia.Localization"
             xmlns:chat="clr-namespace:Pia.Controls.Chat"
             xmlns:behaviors="clr-namespace:Pia.Behaviors"
             xmlns:views="clr-namespace:Pia.Views">
  <Border Style="{StaticResource PiaCardStyle}">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <Border Grid.Row="0"
              Padding="14,14,14,14"
              BorderBrush="{DynamicResource BorderBrush_}"
              BorderThickness="0,0,0,1">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <TextBlock Grid.Row="0" Grid.Column="0"
                     behaviors:EmojiTextBehavior.Text="{Binding Title, FallbackValue='—'}"
                     FontSize="16"
                     FontWeight="SemiBold"
                     TextWrapping="Wrap"
                     MaxHeight="48"
                     TextTrimming="CharacterEllipsis"
                     Foreground="{DynamicResource TextDefaultBrush}"/>

          <ui:Button Grid.Row="0" Grid.Column="1"
                     Appearance="Primary"
                     Margin="10,0,0,0"
                     Padding="10,4"
                     AutomationProperties.AutomationId="AssistantHistory_Resume"
                     Command="{Binding DataContext.ResumeChatCommand, RelativeSource={RelativeSource AncestorType=views:AssistantHistoryView}}">
            <StackPanel Orientation="Horizontal">
              <ui:SymbolIcon Symbol="Play24" FontSize="14" Margin="0,0,6,0"/>
              <TextBlock Text="{loc:Str AssistantHistory_Resume}" VerticalAlignment="Center"/>
            </StackPanel>
          </ui:Button>

          <ui:Button Grid.Row="0" Grid.Column="2"
                     Icon="{ui:SymbolIcon Symbol=ArrowDownload20}"
                     Appearance="Transparent"
                     ToolTip="{loc:Str AssistantHistory_ExportMarkdown}"
                     Margin="6,0,0,0"
                     AutomationProperties.AutomationId="AssistantHistory_ExportMarkdown"
                     Command="{Binding DataContext.ExportChatCommand, RelativeSource={RelativeSource AncestorType=views:AssistantHistoryView}}"/>

          <ui:Button Grid.Row="0" Grid.Column="3"
                     Icon="{ui:SymbolIcon Symbol=ArrowExportLtr20}"
                     Appearance="Transparent"
                     ToolTip="{loc:Str AssistantHistory_ExportArchive}"
                     Margin="6,0,0,0"
                     AutomationProperties.AutomationId="AssistantHistory_ExportArchive"
                     Command="{Binding DataContext.ExportChatArchiveCommand, RelativeSource={RelativeSource AncestorType=views:AssistantHistoryView}}"/>

          <ui:Button Grid.Row="0" Grid.Column="4"
                     Icon="{ui:SymbolIcon Symbol=Delete20}"
                     Appearance="Transparent"
                     ToolTip="{loc:Str History_Delete}"
                     Margin="6,0,0,0"
                     Foreground="{DynamicResource PiaDangerBrush}"
                     AutomationProperties.AutomationId="AssistantHistory_Delete"
                     Command="{Binding DataContext.DeleteChatCommand, RelativeSource={RelativeSource AncestorType=views:AssistantHistoryView}}"/>

          <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="5"
                     Margin="0,8,0,0"
                     FontSize="11.5"
                     TextWrapping="Wrap">
            <Run Text="{loc:Str Memory_Meta_Created}" Foreground="{DynamicResource TextMutedBrush}"/>
            <Run Text=" "/>
            <Run Text="{Binding CreatedAt, Converter={StaticResource UtcToLocalDateTimeConverter}, StringFormat='{}{0:yyyy-MM-dd HH:mm}', Mode=OneWay}" Foreground="{DynamicResource TextDefaultBrush}"/>
            <Run Text="   ·   " Foreground="{DynamicResource TextSubtleBrush}"/>
            <Run Text="{loc:Str Memory_Meta_Updated}" Foreground="{DynamicResource TextMutedBrush}"/>
            <Run Text=" "/>
            <Run Text="{Binding UpdatedAt, Converter={StaticResource UtcToLocalDateTimeConverter}, StringFormat='{}{0:yyyy-MM-dd HH:mm}', Mode=OneWay}" Foreground="{DynamicResource TextDefaultBrush}"/>
            <Run Text="   ·   " Foreground="{DynamicResource TextSubtleBrush}"/>
            <Run Text="{loc:Str Memory_Meta_Accessed}" Foreground="{DynamicResource TextMutedBrush}"/>
            <Run Text=" "/>
            <Run Text="{Binding LastAccessedAt, Converter={StaticResource UtcToLocalDateTimeConverter}, StringFormat='{}{0:yyyy-MM-dd HH:mm}', Mode=OneWay}" Foreground="{DynamicResource TextDefaultBrush}"/>
          </TextBlock>
        </Grid>
      </Border>

      <ScrollViewer Grid.Row="1"
                    Padding="14,12,14,14"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled">
        <ItemsControl ItemsSource="{Binding DataContext.SelectedChatMessages, RelativeSource={RelativeSource AncestorType=views:AssistantHistoryView}}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid Margin="0,0,0,12">
                <StackPanel HorizontalAlignment="Right"
                            MaxWidth="540">
                  <StackPanel.Style>
                    <Style TargetType="StackPanel">
                      <Setter Property="Visibility" Value="Collapsed"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsUser}" Value="True">
                          <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </StackPanel.Style>
                  <Border Style="{StaticResource UserBubbleStyle}">
                    <TextBlock behaviors:AtCommandHighlightBehavior.Text="{Binding Content}"
                               Style="{StaticResource UserBubbleTextStyle}"/>
                  </Border>
                  <!-- What the user attached. Saved files reopen; the rest kept only their name. -->
                  <ItemsControl ItemsSource="{Binding AttachedFiles}"
                                Margin="0,6,0,0"
                                HorizontalAlignment="Left"
                                Visibility="{Binding HasAttachedFiles, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <chat:PiaAttachedFileChip FileName="{Binding FileName}"
                                                  SavedRelativePath="{Binding SavedRelativePath}"
                                                  CommandParameter="{Binding}"
                                                  Margin="0,0,6,4"
                                                  OpenCommand="{Binding DataContext.OpenAttachedFileCommand,
                                                                        RelativeSource={RelativeSource AncestorType=views:AssistantHistoryView}}"
                                                  RevealCommand="{Binding DataContext.RevealAttachedFileCommand,
                                                                          RelativeSource={RelativeSource AncestorType=views:AssistantHistoryView}}"/>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>

                <Grid HorizontalAlignment="Stretch">
                  <Grid.Style>
                    <Style TargetType="Grid">
                      <Setter Property="Visibility" Value="Collapsed"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsUser}" Value="False">
                          <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Grid.Style>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <chat:PiaPersonaAvatar Grid.Column="0"
                                         PersonaId="{Binding PersonaGlyphId}"
                                         Emoji="{Binding PersonaGlyphEmoji}"
                                         Margin="0,2,12,0"
                                         VerticalAlignment="Top"/>
                  <chat:PiaAssistantMessage Grid.Column="1"
                                            HorizontalAlignment="Left"
                                            MaxWidth="880"
                                            ExportCommand="{Binding DataContext.ExportMessageHtmlCommand, RelativeSource={RelativeSource AncestorType=views:AssistantHistoryView}}"/>
                </Grid>
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Grid>
  </Border>
</UserControl>

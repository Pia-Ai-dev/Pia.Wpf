<UserControl x:Class="Pia.Controls.MarkdownMessageControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <RichTextBox x:Name="MarkdownViewer"
                 AutomationProperties.AutomationId="{Binding AutomationIdSuffix, ElementName=Root, StringFormat='MarkdownViewer_{0}'}"
                 IsReadOnly="True"
                 IsDocumentEnabled="True"
                 BorderThickness="0"
                 Background="Transparent"
                 Padding="0"
                 IsUndoEnabled="False"
                 AcceptsReturn="False"
                 AcceptsTab="False"
                 HorizontalScrollBarVisibility="Disabled"
                 VerticalScrollBarVisibility="Disabled"
                 ContextMenu="{StaticResource MarkdownMessageContextMenu}"
                 ContextMenuOpening="MarkdownViewer_ContextMenuOpening" />
</UserControl>

<UserControl x:Class="Pia.Controls.MarkdownMessageControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Pia.Localization"
             x:Name="Root">
    <RichTextBox x:Name="MarkdownViewer"
                 AutomationProperties.AutomationId="{Binding AutomationIdSuffix, ElementName=Root, StringFormat='MarkdownViewer_{0}'}"
                 IsReadOnly="True"
                 IsDocumentEnabled="True"
                 BorderThickness="0"
                 Background="Transparent"
                 Padding="0"
                 IsUndoEnabled="False"
                 AcceptsReturn="False"
                 AcceptsTab="False"
                 HorizontalScrollBarVisibility="Disabled"
                 VerticalScrollBarVisibility="Disabled"
                 ContextMenuOpening="MarkdownViewer_ContextMenuOpening">
        <RichTextBox.ContextMenu>
            <ContextMenu>
                <MenuItem Command="ApplicationCommands.Copy" />
                <Separator />
                <MenuItem x:Name="AddToPiiMenu" Header="{loc:Str Assistant_AddToPiiList}"
                          AutomationProperties.AutomationId="PiiMenu_Open">
                    <MenuItem Header="{loc:Str PiiCategory_Person}" Tag="Person" Click="AddToPii_Click"
                              AutomationProperties.AutomationId="PiiMenu_Person" />
                    <MenuItem Header="{loc:Str PiiCategory_Nickname}" Tag="Nickname" Click="AddToPii_Click"
                              AutomationProperties.AutomationId="PiiMenu_Nickname" />
                    <MenuItem Header="{loc:Str PiiCategory_Email}" Tag="Email" Click="AddToPii_Click"
                              AutomationProperties.AutomationId="PiiMenu_Email" />
                    <MenuItem Header="{loc:Str PiiCategory_Phone}" Tag="Phone" Click="AddToPii_Click"
                              AutomationProperties.AutomationId="PiiMenu_Phone" />
                    <MenuItem Header="{loc:Str PiiCategory_Address}" Tag="Address" Click="AddToPii_Click"
                              AutomationProperties.AutomationId="PiiMenu_Address" />
                    <MenuItem Header="{loc:Str PiiCategory_Date}" Tag="Date" Click="AddToPii_Click"
                              AutomationProperties.AutomationId="PiiMenu_Date" />
                    <MenuItem Header="{loc:Str PiiCategory_Custom}" Tag="Custom" Click="AddToPii_Click"
                              AutomationProperties.AutomationId="PiiMenu_Custom" />
                </MenuItem>
            </ContextMenu>
        </RichTextBox.ContextMenu>
    </RichTextBox>
</UserControl>

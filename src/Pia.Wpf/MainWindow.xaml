<ui:FluentWindow x:Class="Pia.MainWindow"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                  xmlns:local="clr-namespace:Pia"
                  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                  xmlns:vm="clr-namespace:Pia.ViewModels"
                  xmlns:views="clr-namespace:Pia.Views"
                  xmlns:controls="clr-namespace:Pia.Views.Controls"
                  xmlns:models="clr-namespace:Pia.Models"
                  xmlns:loc="clr-namespace:Pia.Localization"
                  mc:Ignorable="d"
                  Title="{Binding WindowTitle}"
                  Icon="pack://application:,,,/Resources/Icons/Pia.ico"
                  Height="600"
                  Width="900"
                  MinHeight="400"
                  MinWidth="600"
                  WindowBackdropType="Mica"
                  ExtendsContentIntoTitleBar="True"
                  WindowCornerPreference="Round"
                  WindowStartupLocation="CenterScreen">

  <Window.InputBindings>
    <KeyBinding Key="D1" Modifiers="Control" Command="{Binding NavigationCommand}" CommandParameter="Shortcut1" />
    <KeyBinding Key="D2" Modifiers="Control" Command="{Binding NavigationCommand}" CommandParameter="Shortcut2" />
    <KeyBinding Key="D3" Modifiers="Control" Command="{Binding NavigationCommand}" CommandParameter="Shortcut3" />
    <KeyBinding Key="D4" Modifiers="Control" Command="{Binding NavigationCommand}" CommandParameter="Shortcut4" />
  </Window.InputBindings>
  <Grid>
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <views:NavigationSidebarView Grid.Column="0" />

    <Grid Grid.Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="36" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <!-- Update info bar -->
      <Border Grid.Row="1"
              Background="{DynamicResource SystemAccentColorPrimaryBrush}"
              Padding="12,6"
              Visibility="{Binding ShowUpdateBar, Converter={StaticResource BooleanToVisibilityConverter}}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <TextBlock Grid.Column="0"
                     VerticalAlignment="Center"
                     Foreground="White"
                     FontSize="13">
            <Run Text="Pia v"/>
            <Run Text="{Binding UpdateVersion, Mode=OneWay}"/>
            <Run Text=" is ready. Restart to update."/>
          </TextBlock>

          <ui:Button Grid.Column="1"
                     Content="Restart Now"
                     Command="{Binding RestartToUpdateCommand}"
                     Appearance="Light"
                     Margin="8,0"
                     Padding="12,4"/>

          <ui:Button Grid.Column="2"
                     Content="&#x2715;"
                     Command="{Binding DismissUpdateBarCommand}"
                     Appearance="Transparent"
                     Foreground="White"
                     Padding="6,2"/>
        </Grid>
      </Border>

      <!-- E2EE onboarding required bar -->
      <Border Grid.Row="2"
              Background="{DynamicResource SystemFillColorCautionBrush}"
              Padding="12,6"
              Visibility="{Binding ShowE2EEOnboardingBar, Converter={StaticResource BooleanToVisibilityConverter}}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <ui:SymbolIcon Grid.Column="0"
                         Symbol="ShieldKeyhole24"
                         VerticalAlignment="Center"
                         Margin="0,0,8,0"/>

          <TextBlock Grid.Column="1"
                     VerticalAlignment="Center"
                     FontSize="13"
                     TextWrapping="Wrap"
                     Text="{loc:Str E2EE_Onboarding_Bar_Message}"/>

          <ui:Button Grid.Column="2"
                     Content="{loc:Str E2EE_Onboarding_Bar_Action}"
                     Command="{Binding OpenE2EEOnboardingCommand}"
                     Appearance="Primary"
                     Margin="8,0,0,0"
                     Padding="12,4"/>
        </Grid>
      </Border>

      <ContentPresenter x:Name="NavigationContentPresenter"
                        Grid.Row="3"
                        Content="{Binding CurrentView, NotifyOnTargetUpdated=True}"
                        Style="{StaticResource NavigationFadeContentPresenterStyle}" />

      <!-- Setup Required Overlay -->
      <Border Grid.Row="1" Grid.RowSpan="3"
              Panel.ZIndex="10"
              Visibility="{Binding ShowSetupOverlay, Converter={StaticResource BooleanToVisibilityConverter}}"
              IsHitTestVisible="True">
        <Border.Background>
          <SolidColorBrush Color="{DynamicResource SmokeFillColorDefault}" />
        </Border.Background>
        <Border Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                CornerRadius="12"
                Padding="40,36"
                MaxWidth="560"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
          <Border.Effect>
            <DropShadowEffect ShadowDepth="0"
                              BlurRadius="32"
                              Opacity="0.35"
                              Color="Black" />
          </Border.Effect>
          <StackPanel>
            <ui:SymbolIcon Symbol="ShieldKeyhole24"
                           FontSize="56"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,20"
                           Foreground="{DynamicResource TextPlaceholderColorBrush}" />
            <TextBlock Text="{loc:Str Setup_Overlay_Title}"
                       FontSize="22"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,8" />
            <TextBlock Text="{loc:Str Setup_Overlay_Description}"
                       FontSize="14"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextPlaceholderColorBrush}"
                       Margin="0,0,0,28" />
            <WrapPanel HorizontalAlignment="Center"
                       ItemHeight="44">
              <ui:Button Command="{Binding NavigateToSettingsCommand}"
                         Appearance="Primary"
                         Padding="20,0"
                         Margin="0,0,12,8">
                <StackPanel Orientation="Horizontal">
                  <ui:SymbolIcon Symbol="Settings24" FontSize="16" Margin="0,0,8,0" />
                  <TextBlock Text="{loc:Str Setup_Overlay_OpenSettings}" VerticalAlignment="Center" />
                </StackPanel>
              </ui:Button>
              <ui:Button Command="{Binding OpenFirstRunWizardCommand}"
                         Appearance="Secondary"
                         Padding="20,0"
                         Margin="0,0,0,8">
                <StackPanel Orientation="Horizontal">
                  <ui:SymbolIcon Symbol="Flash24" FontSize="16" Margin="0,0,8,0" />
                  <TextBlock Text="{loc:Str Setup_Overlay_RunWizard}" VerticalAlignment="Center" />
                </StackPanel>
              </ui:Button>
            </WrapPanel>
          </StackPanel>
        </Border>
      </Border>

    </Grid>
    </Grid>

    <controls:DialogOverlayHost x:Name="RootDialogOverlayHost"
                                Panel.ZIndex="20" />
    <ui:ContentDialogHost x:Name="RootContentDialogPresenter" />
    <ui:SnackbarPresenter x:Name="RootSnackbarPresenter"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Top"
                          Margin="0,36,0,0"
                          Panel.ZIndex="15" />
    <ui:TitleBar x:Name="TitleBar"
                 Title="{Binding WindowTitle}"
                 CloseWindowByDoubleClickOnIcon="True">
      <ui:TitleBar.Icon>
        <ui:ImageIcon Source="pack://application:,,,/Resources/Icons/Pia.ico" />
      </ui:TitleBar.Icon>
    </ui:TitleBar>
  </Grid>
</ui:FluentWindow>

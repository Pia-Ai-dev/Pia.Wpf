{
  "version": "1",
  "mode": "test",
  "launchPath": "{{APP_EXE}}",
  "runConfig": {
    "captureScreenshots": false,
    "screenshotFormat": "png",
    "screenshotOnFailureOnly": false,
    "continueOnFailure": false,
    "stepTimeoutMs": 10000,
    "maxFailures": 0
  },
  "testCases": [
    {
      "id": "TC-001",
      "title": "Settings Speech: picking Nemotron reveals its download button",
      "steps": [
        {
          "tool": "ww_invoke",
          "selector": "automationId=NavItem_Settings",
          "testCaseId": "TC-001"
        },
        {
          "tool": "ww_select",
          "selector": "automationId=Settings_CategoryList",
          "extra": "General",
          "testCaseId": "TC-001"
        },
        {
          "tool": "ww_select",
          "selector": "type=TabControl",
          "extra": "Speech",
          "testCaseId": "TC-001"
        },
        {
          "tool": "ww_set_value",
          "selector": "automationId=Settings_General_SttEngine",
          "extra": "Nemotron",
          "assertion": {
            "type": "assert",
            "selector": "automationId=Settings_General_DownloadNemotronModel",
            "property": "enabled",
            "op": "eq",
            "expected": "true",
            "message": "Nemotron's download button is not merely hidden but absent from the tree until its backend is selected, so resolving it at all is the assertion"
          },
          "testCaseId": "TC-001"
        }
      ]
    },
    {
      "id": "TC-002",
      "title": "Settings Speech: switching back to Parakeet brings its button back",
      "steps": [
        {
          "tool": "ww_select",
          "selector": "type=TabControl",
          "extra": "Speech",
          "testCaseId": "TC-002"
        },
        {
          "tool": "ww_set_value",
          "selector": "automationId=Settings_General_SttEngine",
          "extra": "Parakeet",
          "assertion": {
            "type": "assert",
            "selector": "automationId=Settings_General_DownloadParakeetModel",
            "property": "enabled",
            "op": "eq",
            "expected": "true",
            "message": "Each backend renders its own download button; a third enum value must not leave Parakeet's panel hidden"
          },
          "testCaseId": "TC-002"
        }
      ]
    }
  ]
}
